        <dependency id="BlackSharp.Core" version="1.0.11" exclude="Build,Analyzers" />
        <dependency id="System.Management" version="10.0.3" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net9.0">
        <dependency id="BlackSharp.Core" version="1.0.11" exclude="Build,Analyzers" />
        <dependency id="System.Management" version="10.0.3" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net10.0">
        <dependency id="BlackSharp.Core" version="1.0.11" exclude="Build,Analyzers" />

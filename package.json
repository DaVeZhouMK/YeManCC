{
  "name": "yemancc",
  "private": true,
  "version": "0.0.8",
  "packageManager": "pnpm@11.16.0",
  "type": "module",
  "description": "YeManCC — 野蛮系统控制中心 (Vue3 + QiangQiang WebView2 shell)",
  "scripts": {
    "version:write": "node scripts/write-version.mjs",
    "bump": "node scripts/bump-version.mjs",
    "predev": "node scripts/write-version.mjs",
    "dev": "vite",
    "prebuild": "node scripts/write-version.mjs",
    "build": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build-workspace.ps1",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/package-release.ps1",
    "release": "pnpm run build && pnpm run package",
    "preview": "vite preview --outDir ../../Build/App/Web",
    "type-check": "vue-tsc --noEmit",
    "test:m2": "esbuild tools/m2_selftest.ts --bundle --platform=node --format=cjs --outfile=../../Build/Validation/SelfTests/m2_selftest.cjs --alias:@=./src && node ../../Build/Validation/SelfTests/m2_selftest.cjs",
    "test:speedhack": "esbuild tools/speedhack_selftest.ts --bundle --platform=node --format=cjs --outfile=../../Build/Validation/SelfTests/speedhack_selftest.cjs --alias:@=./src && node ../../Build/Validation/SelfTests/speedhack_selftest.cjs",
    "test:power-resume": "esbuild tools/power_resume_selftest.ts --bundle --platform=node --format=cjs --outfile=../../Build/Validation/SelfTests/power_resume_selftest.cjs --alias:@=./src && node ../../Build/Validation/SelfTests/power_resume_selftest.cjs",
    "test:schedule-tdp": "esbuild tools/performance_schedule_tdp_selftest.ts --bundle --platform=node --format=cjs --outfile=../../Build/Validation/SelfTests/performance_schedule_tdp_selftest.cjs --alias:@=./src && node ../../Build/Validation/SelfTests/performance_schedule_tdp_selftest.cjs",
    "test:updater": "esbuild tools/updater_policy_selftest.ts --bundle --platform=node --format=cjs --outfile=../../Build/Validation/SelfTests/updater_policy_selftest.cjs --alias:@=./src && node ../../Build/Validation/SelfTests/updater_policy_selftest.cjs",
    "test:updater-rollback": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/updater_rollback_selftest.ps1",
    "publish": "pnpm run release"
  },
  "dependencies": {
    "pinia": "^2.1.7",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "esbuild": "^0.21.5",
    "typescript": "^5.4.5",
    "vite": "^5.2.8",
    "vue-tsc": "^2.0.13"
  }
}

{
  "name": "yemancc",
  "private": true,
  "version": "0.0.22",
  "packageManager": "pnpm@11.16.0",
  "type": "module",
  "description": "YeManCC — 野蛮系统控制中心 (Vue3 + QiangQiang WebView2 shell)",
  "scripts": {
    "version:write": "node scripts/write-version.mjs",
    "bump": "node scripts/bump-version.mjs",
    "predev": "node scripts/write-version.mjs",
    "dev": "vite",
    "prebuild": "node scripts/write-version.mjs",
    "build": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build-workspace.ps1",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/package-release.ps1",
    "release": "pnpm run build && pnpm run package",
    "preview": "vite preview --outDir ../../Build/App/Web",
    "type-check": "vue-tsc --noEmit",
    "test:m2": "esbuild tools/m2_selftest.ts --bundle --platform=node --format=cjs --outfile=../../Build/Validation/SelfTests/m2_selftest.cjs --alias:@=./src && node ../../Build/Validation/SelfTests/m2_selftest.cjs",
    "test:speedhack": "esbuild tools/speedhack_selftest.ts --bundle --platform=node --format=cjs --outfile=../../Build/Validation/SelfTests/speedhack_selftest.cjs --alias:@=./src && node ../../Build/Validation/SelfTests/speedhack_selftest.cjs",
    "test:power-resume": "esbuild tools/power_resume_selftest.ts --bundle --platform=node --format=cjs --outfile=../../Build/Validation/SelfTests/power_resume_selftest.cjs --alias:@=./src && node ../../Build/Validation/SelfTests/power_resume_selftest.cjs",
    "test:sleep-task": "esbuild tools/sleep_task_policy_selftest.ts --bundle --platform=node --format=cjs --outfile=../../Build/Validation/SelfTests/sleep_task_policy_selftest.cjs && node ../../Build/Validation/SelfTests/sleep_task_policy_selftest.cjs",
    "test:t0-sleep-hang": "esbuild tools/t0_sleep_hang_recovery_selftest.ts --bundle --platform=node --format=cjs --outfile=../../Build/Validation/SelfTests/t0_sleep_hang_recovery_selftest.cjs && node ../../Build/Validation/SelfTests/t0_sleep_hang_recovery_selftest.cjs",
    "test:game-valve-race": "esbuild tools/game_valve_race_selftest.ts --bundle --platform=node --format=cjs --outfile=../../Build/Validation/SelfTests/game_valve_race_selftest.cjs --alias:@=./src && node ../../Build/Validation/SelfTests/game_valve_race_selftest.cjs",
    "test:gamepad-spatial": "esbuild tools/gamepad_spatial_selftest.ts --bundle --platform=node --format=cjs --outfile=../../Build/Validation/SelfTests/gamepad_spatial_selftest.cjs --alias:@=./src && node ../../Build/Validation/SelfTests/gamepad_spatial_selftest.cjs",
    "test:custom-steam-library-integration": "esbuild tools/custom_steam_library_integration_selftest.ts --bundle --platform=node --format=cjs --outfile=../../Build/Validation/SelfTests/custom_steam_library_integration_selftest.cjs && node ../../Build/Validation/SelfTests/custom_steam_library_integration_selftest.cjs",
    "test:custom-steam-library-health": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/custom_steam_library_health_selftest.ps1",
    "test:fan-import": "esbuild tools/fan_import_selftest.ts --bundle --platform=node --format=esm --outfile=../../Build/Validation/SelfTests/fan_import_selftest.mjs --alias:@=./src && node ../../Build/Validation/SelfTests/fan_import_selftest.mjs",
    "test:fan-curve": "esbuild tools/fan_curve_selftest.ts --bundle --platform=node --format=esm --outfile=../../Build/Validation/SelfTests/fan_curve_selftest.mjs --alias:@=./src && node ../../Build/Validation/SelfTests/fan_curve_selftest.mjs",
    "test:fan-preset-memory": "esbuild tools/fan_preset_memory_selftest.ts --bundle --platform=node --format=esm --outfile=../../Build/Validation/SelfTests/fan_preset_memory_selftest.mjs --alias:@=./src && node ../../Build/Validation/SelfTests/fan_preset_memory_selftest.mjs",
    "test:fan-host-lifecycle": "esbuild tools/fan_host_lifecycle_selftest.ts --bundle --platform=node --format=esm --outfile=../../Build/Validation/SelfTests/fan_host_lifecycle_selftest.mjs --alias:@=./src && node ../../Build/Validation/SelfTests/fan_host_lifecycle_selftest.mjs",
    "test:fan-hc-enable-alignment": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/fan_hc_enable_alignment_selftest.ps1",
    "test:fan-hc-route-capability": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File tools/fan_hc_route_capability_selftest.ps1 -HcDevicesRoot ../../FanLab/hc-upstream/HandheldCompanion/Devices -FactorySource ../../FanLab/hc-upstream/HandheldCompanion/Devices/IDevice.cs -HostSource ../../FanLab/real-host/Program.cs",
    "test:fan-hc-route-deep": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File tools/fan_hc_route_deep_audit.ps1 -HcDevicesRoot ../../FanLab/hc-upstream/HandheldCompanion/Devices -FactorySource ../../FanLab/hc-upstream/HandheldCompanion/Devices/IDevice.cs -HostSource ../../FanLab/real-host/Program.cs -OutputRoot ../../Build/Validation/HC-Parity/T2-Routes",
    "test:fan-hc-close-route-audit": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File tools/fan_hc_close_route_audit.ps1 -HcDevicesRoot ../../FanLab/hc-upstream/HandheldCompanion/Devices -HostSource ../../FanLab/real-host/Program.cs",
    "test:fan-hc-lifecycle-order": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File tools/fan_hc_lifecycle_order_audit.ps1 -HcRoot ../../FanLab/hc-upstream/HandheldCompanion -HostSource ../../FanLab/real-host/Program.cs",
    "test:fan-hc-lifecycle-deep": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File tools/fan_hc_lifecycle_deep_selftest.ps1 -HcRoot ../../FanLab/hc-upstream/HandheldCompanion -HostSource ../../FanLab/real-host/Program.cs -NativeSource native/main.cpp -FrontendSource src/bridge/fanHost.ts -OutputRoot ../../Build/Validation/HC-Parity/T1-Lifecycle",
    "test:fan-hc-profile-boundary": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File tools/fan_hc_profile_boundary_selftest.ps1 -HcRoot ../../FanLab/hc-upstream/HandheldCompanion -HostSource ../../FanLab/real-host/Program.cs",
    "test:fan-hc-profile-events-t3": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File tools/fan_hc_profile_events_full_audit.ps1 -HcRoot ../../FanLab/hc-upstream/HandheldCompanion -HostSource ../../FanLab/real-host/Program.cs -YeManRoot . -OutputDirectory ../../Build/Validation/HC-Parity/T3-Profile-Events",
    "test:fan-hc-profile-events-model": "esbuild tools/fan_hc_profile_events_model_selftest.ts --bundle --platform=node --format=esm --outfile=../../Build/Validation/SelfTests/fan_hc_profile_events_model_selftest.mjs && node ../../Build/Validation/SelfTests/fan_hc_profile_events_model_selftest.mjs",
    "test:fan-t4-parity": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File tools/fan_t4_hc_parity_audit.ps1 -HcRoot ../../FanLab/hc-upstream/HandheldCompanion -HostSource ../../FanLab/real-host/Program.cs -NativeSource native/main.cpp -FrontendSource src/bridge/fanHost.ts -ApiSource src/bridge/fanApi.ts -NavSource src/components/NavRail.vue -OutputRoot ../../Build/Validation/HC-Parity/T4-Parity",
    "test:fan-exit-cleanup": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/fan_exit_cleanup_selftest.ps1",
    "test:fan-host-parent-watchdog": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/fan_host_parent_watchdog_selftest.ps1",
    "test:fan-payload": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/fan_payload_selftest.ps1",
    "test:fan-payload-acl-integration": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File tools/fan_payload_acl_integration_selftest.ps1",
    "test:fan-hc-device-closure": "pwsh -NoLogo -NoProfile -ExecutionPolicy Bypass -File tools/fan_hc_device_closure_selftest.ps1 -HcRuntimeRoot ../../FanLab/build/batch11-runtime-09 -PayloadRoot PowerControl/fan-host",
    "test:fan-sleep-priority": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/fan_sleep_priority_selftest.ps1",
    "test:fan-sleep-extreme": "esbuild tools/fan_sleep_extreme_selftest.ts --bundle --platform=node --format=esm --outfile=../../Build/Validation/SelfTests/fan_sleep_extreme_selftest.mjs && node ../../Build/Validation/SelfTests/fan_sleep_extreme_selftest.mjs",
    "test:fan-sleep-apply-conflict": "esbuild tools/fan_sleep_apply_conflict_selftest.ts --bundle --platform=node --format=esm --outfile=../../Build/Validation/SelfTests/fan_sleep_apply_conflict_selftest.mjs && node ../../Build/Validation/SelfTests/fan_sleep_apply_conflict_selftest.mjs",
    "test:schedule-tdp": "esbuild tools/performance_schedule_tdp_selftest.ts --bundle --platform=node --format=cjs --outfile=../../Build/Validation/SelfTests/performance_schedule_tdp_selftest.cjs --alias:@=./src && node ../../Build/Validation/SelfTests/performance_schedule_tdp_selftest.cjs",
    "test:updater": "esbuild tools/updater_policy_selftest.ts --bundle --platform=node --format=cjs --outfile=../../Build/Validation/SelfTests/updater_policy_selftest.cjs --alias:@=./src && node ../../Build/Validation/SelfTests/updater_policy_selftest.cjs",
    "test:updater-retry": "esbuild tools/updater_retry_selftest.ts --bundle --platform=node --format=cjs --outfile=../../Build/Validation/SelfTests/updater_retry_selftest.cjs && node ../../Build/Validation/SelfTests/updater_retry_selftest.cjs",
    "test:updater-rollback": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/updater_rollback_selftest.ps1",
    "test:updater-install-chain": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/updater_install_chain_selftest.ps1",
    "publish": "pnpm run release"
  },
  "dependencies": {
    "pinia": "^2.1.7",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "esbuild": "^0.21.5",
    "typescript": "^5.4.5",
    "vite": "^5.2.8",
    "vue-tsc": "^2.0.13"
  }
}

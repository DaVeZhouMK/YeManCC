* text=auto

# Windows scripts keep native line endings.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.vbs text eol=crlf

# Web and source files use stable LF endings across local and CI builds.
*.css text eol=lf
*.html text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.vue text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Runtime and SDK payloads are binary.
*.bin binary
*.dll binary
*.exe binary
*.ico binary
*.lib binary
*.ovl binary
*.png binary
*.pow binary
*.pyd binary
*.sys binary

# Immutable SHA-bound payloads must survive checkout without EOL rewriting.
PowerControl/fan-host/** -text
PowerControl/handheldcompanion-runtime/** -text
PowerControl/redist/** -text
deps/handheldcompanion-runtime/** -text
deps/hidmaestro/** -text

# Fan source-freeze indices also bind the exact original source bytes.
FanLab/real-host/** -text
FanLab/fan-backend/** -text
FanLab/LightSetter/** -text
FanLab/fanhost-source-files.sha256 -text
FanLab/FANHOST-SOURCE-BASELINE.json -text

# release-assets.lock.json binds these fallback assets byte-for-byte.
PowerControl/MG-AUTO/** -text
PowerControl/pawnio/** -text
PowerControl/OpenSpeedy/** -text

# Pinned Decky SDK and redistribution licenses bind their original bytes.
decky-plugin/vendor/decky-api-1.1.3/** -text
decky-plugin/LICENSE.decky-api -text
PowerControl/decky/LICENSE.decky-loader -text
PowerControl/decky/plugins/ymcc-sidebar/LICENSE.decky-api -text
*.tsx text eol=lf

# steam_live_script_embed.mjs emits LF and verifies exact generated bytes.
native/steam_live_script.h text eol=lf

# Official Decky consumer identity is generated and verified byte-for-byte.
native/decky_loader_identity.h text eol=lf

# Steam theme manifest binds exact CSS, JSON and license bytes on every machine.
PowerControl/steam-appearance/themes/** -text

# Frozen catalog reference bytes are part of the Git build inputs.
deps/hc-runtime-upstream/HC-CANDIDATE-0.32.4.0-06c0b954-20260902/** -text

# Native sources include SHA-bound capability recipes and embedded scripts.
# Preserve the reviewed bytes on hosted Windows checkouts.
native/** -text

# Battery provenance hashes bind these original source bytes.
docs/battery-charge-capabilities.json -text
tools/battery-charge-generate-routes.mjs -text

# Generated capability consumers and source tools are compared byte-for-byte.
capabilities/** -text
tools/** -text

# Dependency/runtime manifests bind the original bytes across Windows and CI.
deps/** -text
PowerControl/** -text

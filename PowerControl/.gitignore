# PowerControl 运行时用户数据：由程序生成，更新时保留、不覆盖、不入库。
# 安装器（native/main.cpp app.installUpdate）在部署时也会排除这些模式，双保险。
build/
dist/
__pycache__/
*.pyc
*.bak
*.bak_*
*.tmp
*.log
*.pid
*.hb
tdp-*.txt
FPS-*.txt
Power.txt
*.json
!fan-host/YeManFanHost.payload.json
*.log
*.pid
*.hb
hwinfo-ok
Sleep/Enable.txt
Sleep/Escalation.txt
Sleep/target.txt
Sleep/sleepguard.json
Sleep/controlled-sleep*
Sleep/quickapp_suspended.json
Sleep/sleep-trigger-last.txt
Sleep/resleep-last.txt

# 包内明文解压密码不参与发布（仅为本机手动解压提示，避免上传到公开仓库）
手动解压密码.txt

# 以下为代码/资产，正常入库（不被上面的通配误伤）
!*.bat
!*.vbs
!*.ps1
!*.xml
!*.reg
!*.exe
!*.png
!*.md
!*.pow
!*/

# Build outputs remain local even when they contain executable files.
pawnio/build/
pawnio/dist/
pawnio/__pycache__/

# Immutable program metadata is source input, not mutable user JSON.
!/fan-host/YeManFanHost.deps.json
!/fan-host/YeManFanHost.json
!/fan-host/YeManFanHost.payload.json
!/fan-host/YeManFanHost.runtimeconfig.json
!/handheldcompanion-runtime/HC-CANDIDATE-0.32.4.0-06c0b954-20260902/HandheldCompanion.deps.json
!/handheldcompanion-runtime/HC-CANDIDATE-0.32.4.0-06c0b954-20260902/HandheldCompanion.json
!/handheldcompanion-runtime/HC-CANDIDATE-0.32.4.0-06c0b954-20260902/HandheldCompanion.runtime.json
!/redist/HIDMaestroSetup.deps.json
!/redist/HIDMaestroSetup.manifest.json
!/redist/HIDMaestroSetup.runtimeconfig.json

# Immutable YMCC theme definitions/defaults, not a live user homebrew profile.
!steam-appearance/manifest.json
!steam-appearance/themes/*/theme.json
!steam-appearance/themes/*/config_USER.json
# Immutable battery helper runtime metadata; user settings live in LocalAppData.
!/battery-host/YeManBatteryHost.deps.json
!/battery-host/YeManBatteryHost.runtimeconfig.json
!/battery-host/battery-host.payload.json

# Immutable release inputs must survive a clean Git checkout.
# Keep mutable user JSON ignored; allow only the source-owned contracts below.
!/GameTitlePolicy.json
!/settings-baseline.json
!/settings-defaults-v1.json
!/MemoryScan/MemoryScanHost.payload.json
!/decky/plugins/ymcc-sidebar/package.json
!/decky/plugins/ymcc-sidebar/plugin.json
!/handheldcompanion-runtime/YMCC-DEVICECORE-20261018-v1/HandheldCompanion.deps.json
!/handheldcompanion-runtime/YMCC-DEVICECORE-20261018-v1/HandheldCompanion.json
!/handheldcompanion-runtime/YMCC-DEVICECORE-20261018-v1/HandheldCompanion.runtime.json
!/light-setter/YeManLightSetter.deps.json
!/light-setter/YeManLightSetter.json
!/light-setter/YeManLightSetter.runtimeconfig.json
!/ymcc-shared-runtime/manifest.json

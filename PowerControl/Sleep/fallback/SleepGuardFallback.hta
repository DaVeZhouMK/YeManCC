<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>睡眠稳定优化 - 待恢复游戏</title>
<HTA:APPLICATION
  ID="sleepGuardFallback"
  APPLICATIONNAME="YeManCC Sleep Guard Fallback"
  BORDER="thin"
  CAPTION="yes"
  SHOWINTASKBAR="yes"
  SINGLEINSTANCE="yes"
  SYSMENU="yes"
  WINDOWSTATE="normal"
  SCROLL="no"
/>
<style>
  * { box-sizing: border-box; }
  html, body {
    margin: 0; padding: 0;
    background: #161a1f;
    color: #e6edf3;
    font-family: "Segoe UI", "Microsoft YaHei", system-ui, sans-serif;
    font-size: 13px;
  }
  .wrap { padding: 16px 18px; width: 380px; }
  h2 {
    margin: 0 0 4px;
    font-size: 16px;
    color: #58a6ff;
    display: flex; align-items: center; gap: 8px;
  }
  .hint { margin: 0 0 12px; color: #9da7b3; line-height: 1.5; }
  .list {
    background: #0f1318;
    border: 1px solid #2a313c;
    border-radius: 8px;
    padding: 8px;
    margin-bottom: 14px;
    max-height: 180px;
    overflow-y: auto;
  }
  .row {
    padding: 7px 10px;
    background: #1b2129;
    border: 1px solid #2a313c;
    border-radius: 6px;
    margin-bottom: 6px;
    color: #e6edf3;
  }
  .row:last-child { margin-bottom: 0; }
  .row .pid { color: #6e7681; font-size: 11px; margin-left: 6px; }
  .btns { display: flex; gap: 8px; }
  button {
    flex: 1;
    padding: 10px 6px;
    border: 1px solid #2a313c;
    border-radius: 8px;
    background: #21262d;
    color: #e6edf3;
    font-size: 13px;
    cursor: pointer;
    transition: background .15s, border-color .15s;
  }
  button:hover:not(:disabled) { background: #2d333b; }
  #btnRecover { border-color: #2ea043; color: #56d364; }
  #btnRecover:hover:not(:disabled) { background: #1b2b1f; }
  #btnEnd { border-color: #da3633; color: #ff7b72; }
  #btnEnd:hover:not(:disabled) { background: #2b1b1c; }
  button:disabled { opacity: .4; cursor: default; }
</style>
</head>
<body>
<div class="wrap">
  <h2>🌙 睡眠稳定优化</h2>
  <p class="hint" id="hint">检测到以下游戏在睡眠前被冻结，但 YeManCC 未运行。请选择如何处理：</p>
  <div class="list" id="list"></div>
  <div class="btns">
    <button id="btnRecover" onclick="run('recover')">恢复游戏</button>
    <button id="btnEnd" onclick="run('end')">结束游戏</button>
    <button onclick="window.close()">取消</button>
  </div>
</div>

<script language="javascript">
  var SG = "C:\\SOFT\\YeMan\\PowerControl\\Sleep";
  var FALLBACK = "C:\\SOFT\\YeMan\\PowerControl\\Sleep\\fallback";

  function loadList() {
    try {
      var fso = new ActiveXObject("Scripting.FileSystemObject");
      var dir = fso.GetFolder(SG + "\\suspended");
      var list = document.getElementById("list");
      list.innerHTML = "";
      var any = false;
      var e = new Enumerator(dir.Files);
      for (; !e.atEnd(); e.moveNext()) {
        var f = e.item();
        var name = f.Name.toLowerCase();
        if (name.indexOf(".txt") !== name.length - 4) continue;
        any = true;
        var c = fso.OpenTextFile(f.Path, 1).ReadAll();
        var exeName = "";
        var m = c.match(/name=([^|]+)/);
        if (m) exeName = m[1];
        var pid = f.Name.replace(".txt", "");
        var div = document.createElement("div");
        div.className = "row";
        div.innerHTML = (exeName || "未知进程") + ' <span class="pid">PID ' + pid + "</span>";
        list.appendChild(div);
      }
      if (!any) {
        document.getElementById("hint").innerText = "没有检测到需要恢复的游戏，可安全关闭。";
        document.getElementById("btnRecover").disabled = true;
        document.getElementById("btnEnd").disabled = true;
      }
    } catch (err) {
      document.getElementById("hint").innerText = "读取挂起列表失败：" + err.message;
    }
  }

  function run(mode) {
    try {
      var shell = new ActiveXObject("WScript.Shell");
      var ps = 'powershell.exe -NoProfile -ExecutionPolicy Bypass -File "' +
               FALLBACK + '\\SleepGuardFallback-action.ps1" -Mode ' + mode;
      shell.Run(ps, 0, true);
    } catch (e) { }
    window.close();
  }

  window.onload = loadList;
  // Safety: auto-dismiss after 120s if nobody is at the machine.
  setTimeout(function () { window.close(); }, 120000);
</script>
</body>
</html>

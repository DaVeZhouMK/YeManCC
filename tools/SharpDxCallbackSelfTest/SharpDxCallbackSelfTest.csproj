  <ItemGroup><Reference Include="Mono.Cecil"><HintPath>$(UserProfile)/.nuget/packages/microsoft.net.illink.tasks/10.0.11/tools/net/Mono.Cecil.dll</HintPath></Reference></ItemGroup>
</Project>

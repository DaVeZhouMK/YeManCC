BOOL toScreen(HWND h,LPPOINT p){const auto& f=facts(h);const auto o=f.originKnown?f.origin:offset;p->x+=o.x;p->y+=o.y;return screenOk;}
BOOL fromScreen(HWND h,LPPOINT p){const auto& f=facts(h);const auto o=f.originKnown?f.origin:offset;p->x-=o.x;p->y-=o.y;return screenOk;}

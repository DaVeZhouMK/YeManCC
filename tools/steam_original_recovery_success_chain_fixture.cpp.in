 run("runtime-config-future-or-truncated-after-storage-is-off",[](const auto& dir){for(const auto& bad:std::vector<std::string>{"{",R"({"schema":"ymcc.steam-original-recovery-enabled.v99","enabled":true})","null","[]"}){auto c=runtimeSetup(dir,R"({"enabled":false})");RuntimeOwner::runtimeState.storageReady=[&]{runtimeFile(dir/L"runtime"/L"enabled.json",bad);};RuntimeOwner::run(c);check(!c->enabled,"unknown-second-read-treated-as-enabled");}});

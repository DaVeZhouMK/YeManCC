};
J sourceGetterContext(Scope&,const Snapshot&,U64,QueryActor&,J&){requireCurrent();++fixture.source;fixture.order.push_back("source");if(fixture.failSource)throw std::runtime_error("fixture-source-failed");if(fixture.recoverInSource)fixture.flags=8196;return {{"tid",991u},{"threadBirthFileTime","134371000000000001"}};}
J runTrial(const J& request,QueryActor&,Current beforeMutation={}){
 requireCurrent();fixture.order.push_back("driver-preflight");
 if(fixture.failPreflight)return {{"status","failed"},{"reason","loaded-client-ui-compatibility-contract"},{"publisherCalls",0},{"mutationCommitAccepted",false},{"remoteAllocationAttempted",false}};
 need(bool(beforeMutation)&&beforeMutation(),"fixture-mutation-commit-missing");
 ++fixture.drivers;fixture.order.push_back("driver");fixture.request=request;
 need(ledgerCount()==fixture.priorLedger+2,"driver-started-before-durable-consume");
 if(fixture.failDriver)throw std::runtime_error("fixture-driver-failed");fixture.flags=fixture.postFlags;
 return {{"mutationCommitAccepted",true},{"remoteAllocationAttempted",true},{"entryRestored",fixture.cleanup},{"debugRegistersRestored",true},{"debuggerDetached",true},{"disarmConfirmed",true},{"mutationResult",{{"publisherCalls",1},{"publisherReturned",true},{"guardBefore",true},{"guardAfter",true}}}};
}
struct WakeProbeReader {
 Scope& scope;U64 calls=0,bytes=0;explicit WakeProbeReader(Scope& s):scope(s){}
 bool owned()const{return fixture.current&&observationCurrent();}
 DWORD flags(const Snapshot&){++calls;bytes+=4;if(fixture.tick>=fixture.lossAt)fixture.flags=4;return fixture.flags;}
};
DWORD fixtureWait(DWORD, const HANDLE*,BOOL,DWORD ms){++fixture.waits;fixture.tick+=ms;fixture.utc+=U64(ms)*10000;return WAIT_TIMEOUT;}

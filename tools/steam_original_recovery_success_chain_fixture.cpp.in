  if(selection=="runtime-config"&&!n.starts_with("runtime-config-"))return;
  if(selection=="config-storm"&&!n.starts_with("runtime-config-")&&!n.starts_with("config-storm-")&&n!="original-startup-lost-recovers"&&n!="no-reference-cannot-invent-one-while-lost"&&n!="record-replaced-after-publish-refuses"&&n!="new-mutation-failure-overrules-old-readonly-audit")return;
  if(selection=="negative-startup"&&n!="original-startup-lost-recovers")return;
  if(selection=="negative-pins"&&n!="record-replaced-after-publish-refuses")return;
  std::cerr<<"CASE "<<name<<std::endl;J row={{"name",name}};const auto dir=root/std::to_wstring(cases.size());reset(dir);fixture.lastReceipt=J::object();try{body(dir);row["passed"]=true;}catch(const std::exception& e){row["passed"]=false;row["reason"]=e.what();}catch(...){row["passed"]=false;row["reason"]="non-standard exception escaped consumer";}row["lastStatus"]=fixture.lastReceipt.value("status",std::string());row["lastReason"]=fixture.lastReceipt.value("reason",std::string());row["queries"]=fixture.queries;row["drivers"]=fixture.drivers;row["ledgerKeys"]=ledgerCount();row["trace"]=fixture.order;cases.push_back(row);};

 run("runtime-config-duplicate-after-storage-is-off",[](const auto& dir){auto c=runtimeSetup(dir,R"({"enabled":false})");RuntimeOwner::runtimeState.storageReady=[&]{runtimeFile(dir/L"runtime"/L"enabled.json",R"({"enabled":false,"enabled":true})");};RuntimeOwner::run(c);check(!c->enabled&&!c->ownsRunning,"duplicate-second-read-enabled-recovery");});
 run("runtime-config-deep-after-storage-is-off",[](const auto& dir){auto c=runtimeSetup(dir,R"({"enabled":false})");RuntimeOwner::runtimeState.storageReady=[&]{runtimeFile(dir/L"runtime"/L"enabled.json",std::string("{\"enabled\":true,\"opaque\":")+std::string(80,'[')+"0"+std::string(80,']')+"}");};RuntimeOwner::run(c);check(!c->enabled,"deep-second-read-enabled-recovery");});
 run("runtime-config-read-off-not-promoted-by-later-missing",[](const auto& dir){auto c=runtimeSetup(dir,R"({"enabled":false})");RuntimeOwner::runtimeState.afterReadExists=[&]{const auto file=dir/L"runtime"/L"enabled.json";if(fp::exists(file)){fp::create_directories(dir/L"runtime"/L"work");fp::rename(file,dir/L"runtime"/L"work"/L"retained-off.json");}};RuntimeOwner::run(c);check(!c->enabled,"post-read-exists-promoted-off-to-built-in-on");});

// The complete runtime run/readJson are extracted unchanged below. Only the
// external owner/event queue, status/log ports and data roots are controlled.
namespace RuntimeOwner {
using json=J;
std::string W2U(const std::wstring& value){return utf8(value);}
struct Pending {};
struct Control {std::mutex mx;std::condition_variable cv;bool stop=true;std::deque<Pending> pending;std::atomic<bool> enabled{true},ownsRunning{true},active{false};};
struct RuntimeState {fp::path base;std::function<void()> storageReady,afterReadExists;bool locationFault=false,publishFault=false;unsigned published=0,runOneCalls=0;J last;};
RuntimeState runtimeState;
namespace fspath {
using fp::path;
bool exists(const std::wstring& file,std::error_code& ec){if(runtimeState.afterReadExists)runtimeState.afterReadExists();return fp::exists(file,ec);}
}
std::wstring root(){return (runtimeState.base/L"legacy").wstring();}
std::wstring runtimeRoot(){if(runtimeState.locationFault)throw std::runtime_error("fixture-location-unavailable");return (runtimeState.base/L"runtime").wstring();}
void log(const std::shared_ptr<Control>&,const char* event,const J&){if(std::string_view(event)=="storage-ready"&&runtimeState.storageReady)runtimeState.storageReady();}
void publish(const std::shared_ptr<Control>&,const J& value){++runtimeState.published;runtimeState.last=value;if(runtimeState.publishFault)throw std::runtime_error("fixture-evidence-unavailable");}
void runOne(const std::shared_ptr<Control>&,const Pending&,const J&){++runtimeState.runOneCalls;throw std::runtime_error("unexpected-real-owner-event");}
@@RUNTIME@@
}
void runtimeFile(const fp::path& file,const std::string& bytes){fp::create_directories(file.parent_path());std::ofstream output(file,std::ios::binary|std::ios::trunc);output<<bytes;need(bool(output),"runtime-fixture-write");}
std::shared_ptr<RuntimeOwner::Control> runtimeSetup(const fp::path& dir,const std::string& bytes,bool absent=false){
 RuntimeOwner::runtimeState={};RuntimeOwner::runtimeState.base=dir;
 ymcc::steamOriginalStorage::prepare(dir/L"legacy",dir/L"runtime");
 if(!absent)runtimeFile(dir/L"runtime"/L"enabled.json",bytes);
 return std::make_shared<RuntimeOwner::Control>();
}


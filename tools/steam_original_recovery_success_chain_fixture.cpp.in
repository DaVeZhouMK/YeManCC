 for(const auto& name:{operation,eventKey}){auto value=readJson(fixture.data/L"consumed"/utf16(name+".json"));value["schema"]="ymcc.steam-original-recovery-consumption.v1";atomicJson(fixture.data/L"consumed"/utf16(name+".json"),value);}
 const auto disabled=fixture.data/L"disabled"/utf16(key+".json");atomicJson(disabled,{{"reason","recovery-cleanup-not-confirmed"},{"consumed",true},{"noAutomaticRetry",true}});
 J driver={{"status","failed"},{"reason","loaded-client-ui-compatibility-contract"},{"openProcessAttempted",true},{"writes",J::array()},{"sourceEntries",J::array()},{"publisherCalls",0},{"entryEverExposed",false},{"armAttempted",false},{"controlOutcomeUnknown",false},{"managementCallUnresolved",false},{"trialDllMayRemainLoaded",false},{"entryMayRemainPatched",false},{"pathMemoryReleased",true},{"packetMemoryReleased",true}};
 J proof={{"engineRevision","dual-route-original-recovery-20261023-r7"},{"lifeKey",key},{"trigger",{{"kind","startup"},{"id",oldId}}},{"status","refused"},{"consumed",true},{"reason","recovery-cleanup-not-confirmed"},{"recoveryRoute","semi-static"},{"before",{{"gameId",std::to_string(scope.gameId)},{"gamePid",scope.roles[1].pid},{"originalPrimaryMatched",true}}},{"driverResult",driver}};
 const auto root=fixture.data/L"audited-prepublication-transfer";atomicJson(root/utf16(key+".source.json"),proof);
 J audit={{"schema","ymcc.steam-original-audited-prepublication-transfer.v1"},{"authorizedBy","explicit-operator-no-write-audit-20261023"},{"targetRoute","legacy-dynamic"},{"life",identity},{"sourceEngineRevision","dual-route-original-recovery-20261023-r7"},{"sourceNativeSha256","66d147da3511e33c0c349244cd81c158d7547489ce1a082865a8711cbe5e260e"},{"sourceEventId",oldId},{"disabledSha256",fileHash(disabled.wstring())},{"operationSha256",fileHash((fixture.data/L"consumed"/utf16(operation+".json")).wstring())},{"eventSha256",fileHash((fixture.data/L"consumed"/utf16(eventKey+".json")).wstring())},{"sourceSummarySha256",fileHash((root/utf16(key+".source.json")).wstring())}};
 atomicJson(root/utf16(key+".json"),audit);fixture.priorLedger=2;e["recoveryRoute"]="legacy-dynamic";return e;
}
int main(int argc,char** argv){if(argc!=2&&argc!=3)return 64;const std::string selection=argc==3?argv[2]:"all";if(selection!="all"&&selection!="config-storm"&&selection!="runtime-config"&&selection!="negative-startup"&&selection!="negative-pins")return 64;const auto root=fp::path(argv[1]);fp::create_directories(root);

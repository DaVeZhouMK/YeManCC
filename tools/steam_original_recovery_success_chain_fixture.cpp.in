J nativeState(const Scope& scope,const Snapshot& s){return {{"flags",s.flags},{"running",s.flags==8196},{"gameId",std::to_string(scope.gameId)},{"gamePid",scope.roles[1].pid},{"birth",std::to_string(scope.roles[1].born)},{"primary",s.target.primary},{"originalPrimaryMatched",s.target.primary==scope.roles[1].pid}};}

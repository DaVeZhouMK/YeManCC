J eventFor(const fp::path& dir,const std::string& kind,const std::string& id="first"){
 J e;const std::array<const char*,4> names{"steam","game","ymcc","cef"};
 for(std::size_t i=0;i<4;++i)e[names[i]]={{"pid",4000u+static_cast<DWORD>(i)},{"birthFileTime",std::to_string(134370000000000001ULL+i)},{"session",1},{"path","D:\\owned-fixture\\"+std::string(names[i])+".exe"}};
 e["target"]=e["game"];e["target"]["gameId"]="10260559608980439040";e["target"]["appid"]=2388972698u;
 e["dataRoot"]=utf8((dir/L"data").wstring());e["evidenceRoot"]=utf8((dir/L"evidence").wstring());e["logRoot"]=utf8((dir/L"logs").wstring());e["account64"]="76561198000000001";e["recoveryAllowed"]=true;
 e["trigger"]={{"kind",kind},{"generation",kind=="wake"?"7":"0"},{"id",id},{"rulesEpoch","1"}};
 if(kind=="wake")e["trigger"]["powerEventFileTime"]=std::to_string(fixture.wake?fixture.wake:fixture.utc);
 return e;
}
void reset(const fp::path& dir){fixture=Fixture{};fixture.data=dir/L"data";fixture.wake=fixture.utc;embedded::sha256=digest(embedded::image,sizeof embedded::image);}
J invoke(const J& event){auto result=handle(event,{},[]{return fixture.current;},[]{return fixture.observed;},0);fixture.lastReceipt=result;check(!gActive.load(),"engine-active-leaked");check(!gEmit&&!gCurrent&&!gObservationCurrent&&!gOriginalSteam&&!gCleanupMode,"per-job-ports-leaked");return result;}
J baseline(J event){event["trigger"]["kind"]="startup";event["trigger"]["id"]="healthy-reference";fixture.flags=8196;auto r=invoke(event);check(r.at("status")=="healthy"&&r.at("referenceCaptured")==true,"healthy-reference-not-captured");check(ledgerCount()==0&&fixture.queries==0&&fixture.drivers==0,"healthy-capture-consumed-or-published");return r;}
void expectSuccess(const J& r,const J& event){
 check(r.at("status")=="recovered-native"&&r.at("nativeRecovered")==true,"initial-success-path-refused");
 check(r.at("consumed")==true&&ledgerCount()==2,"single-event-durable-keys-not-retained");
 check(fixture.queries==1&&fixture.queryEnds==1&&fixture.source==1&&fixture.drivers==1,"success-not-single-publication");
 check(r.at("after").at("flags")==8196&&r.at("after").at("primary")==event.at("game").at("pid"),"original-native-readback-not-restored");
 check(fixture.request.at("gameId")==event.at("target").at("gameId")&&fixture.request.at("processes").at("game")==event.at("game"),"publisher-identity-replaced");
 check(fixture.request.at("healthyProof").at("healthyFlags")==8196&&fixture.request.at("healthyProof").at("pinNonce").get<std::string>().size()==36,"healthy-proof-not-forwarded");
 check(r.at("spawnedHelperProcesses")==0&&r.at("repairAccepted")==false&&r.at("uiVerified")==false&&r.at("inputVerified")==false,"fixture-was-misreported-as-field-acceptance");
 check(fixture.order.back()=="query-end","query-resources-not-released");
}
J createHistoricalNoWriteAudit(J e){
 e["recoveryRoute"]="semi-static";baseline(e);fixture.flags=4;
 const auto scope=openScope(e);const auto identity=life(scope);const auto key=textHash(identity.dump());

struct QueryActor {
 QueryActor(U64,const std::wstring&,RecoveryRoute=RecoveryRoute::SemiStatic,std::string={}){requireCurrent();++fixture.queries;fixture.order.push_back("query");need(ledgerCount()==fixture.priorLedger,"source-acquisition-spent-publication-budget");}
 ~QueryActor(){++fixture.queryEnds;fixture.order.push_back("query-end");}

    test("event-wake-before-ready-enters-both-routes",[]{auto c=reset(false);eventOwner(c);g_powerLifecycle=PowerLifecycle::Resuming;steamOriginalRecoveryWake(7);check(c->deferredWake==7,"deferred-wake-lost");check(c->pending.empty(),"wake-queued-before-ready");g_powerLifecycle=PowerLifecycle::Ready;steamOriginalRecoveryPowerReady(7);check(c->pending.size()==1,"ready-did-not-queue-wake");check(c->pending.front().kind==Trigger::Wake,"wrong-ready-event");drainOne(c);check(engineCalls==2,"event-did-not-reach-dual-engine");check(requests[0]["recoveryRoute"]=="legacy-dynamic","legacy-event-route-lost");check(requests[0]["recoveryAllowed"]==true,"legacy-event-not-mutation-eligible");check(requests[1]["recoveryRoute"]=="semi-static","static-event-route-lost");check(c->deferredWake==0,"admitted-deferred-wake-not-cleared");});
    test("event-ready-before-wake-queues-immediately",[]{auto c=reset(false);eventOwner(c);steamOriginalRecoveryPowerReady(7);check(c->pending.empty(),"ready-fabricated-wake");steamOriginalRecoveryWake(7);check(c->pending.size()==1,"ready-wake-not-queued");drainOne(c);check(engineCalls==2,"ready-first-did-not-reach-dual-engine");});
    test("event-duplicate-ready-coalesces",[]{auto c=reset(false);eventOwner(c);g_powerLifecycle=PowerLifecycle::Resuming;steamOriginalRecoveryWake(7);g_powerLifecycle=PowerLifecycle::Ready;for(int i=0;i<20;i++)steamOriginalRecoveryPowerReady(7);check(c->pending.size()==1,"duplicate-ready-expanded-queue");check(c->sequence==1,"duplicate-ready-issued-new-sequence");check(eventSignals==1,"duplicate-ready-signalled-new-observation");drainOne(c);check(engineCalls==2,"coalesced-ready-lost-routes");});
    test("event-repeated-wake-cannot-refund-route-budget",[]{auto c=reset(false);eventOwner(c);steamOriginalRecoveryWake(7);drainOne(c);check(engineCalls==2,"first-event-not-dispatched");steamOriginalRecoveryWake(7);drainOne(c);check(engineCalls==2,"same-event-refunded-engine-budget");check(c->deferredWake==0,"consumed-event-remained-deferred");});
    test("event-wrong-ready-generation-does-not-release-wake",[]{auto c=reset(false);eventOwner(c);g_powerLifecycle=PowerLifecycle::Resuming;steamOriginalRecoveryWake(7);g_powerLifecycle=PowerLifecycle::Ready;steamOriginalRecoveryPowerReady(8);check(c->pending.empty(),"other-generation-released-wake");check(c->deferredWake==7,"other-generation-erased-wake");steamOriginalRecoveryPowerReady(7);drainOne(c);check(engineCalls==2,"correct-generation-did-not-release-wake");});
    test("event-stale-wake-does-not-replace-new-generation",[]{auto c=reset(false);eventOwner(c);c->latestPower=8;c->deferredWake=8;steamOriginalRecoveryWake(7);check(c->pending.empty(),"stale-wake-queued");check(c->latestPower==8&&c->deferredWake==8,"stale-wake-replaced-generation");steamOriginalRecoverySuspend(7);check(c->pending.empty(),"stale-suspend-queued");});
    test("event-stop-clears-pending-and-prevents-reentry",[]{auto c=reset(false);eventOwner(c);steamOriginalRecoveryWake(7);check(c->pending.size()==1,"prestop-event-not-queued");steamOriginalRecoveryRequestStop();check(c->stop&&c->pending.empty(),"stop-did-not-clear-queue");steamOriginalRecoveryWake(7);steamOriginalRecoveryPowerReady(7);check(c->pending.empty(),"stopped-owner-queued-work");check(engineCalls==0,"stopped-owner-entered-engine");});
    test("event-binding-ready-retries-deferred-identity",[]{auto c=reset(false);eventOwner(c);targetAvailable=false;steamOriginalRecoveryWake(7);drainOne(c);check(engineCalls==0,"missing-target-entered-engine");check(c->deferredWake==7,"missing-target-erased-deferred-wake");targetAvailable=true;steamOriginalRecoveryBindingReady();check(c->pending.size()==2,"binding-event-did-not-requeue-wake-and-observation");check(c->pending.front().kind==Trigger::Wake,"binding-event-replaced-wake-with-observation");drainOne(c);check(engineCalls==2,"binding-ready-did-not-reach-dual-engine");});
    test("event-static-rejection-preserves-legacy-dispatch",[]{auto c=reset(false);eventOwner(c);privateAvailable=false;steamOriginalRecoveryWake(7);drainOne(c);check(engineCalls==1,"event-static-rejection-blocked-legacy");check(requests[0]["recoveryRoute"]=="legacy-dynamic","event-legacy-not-selected");check(privateReads==1,"event-static-qualification-was-skipped");});
    test("event-no-admission-does-not-fabricate-recovery",[]{auto c=reset(false);eventOwner(c);SleepRecoveryAuto::state.wakeAdmission["status"]="rejected";steamOriginalRecoveryWake(7);drainOne(c);check(engineCalls==0,"event-fabricated-resume-proof");});
    test("event-licensed-type0-never-enters-either-engine",[]{auto c=reset(false);eventOwner(c);liveGame.pid=60616;liveGame.processCreated=134372020151686628ULL;liveGame.path=LR"(D:\Game\Steam\steamapps\common\Among Us\Among Us.exe)";g_gameValveTarget.game=liveGame;SteamGameLink::live.gameId="945360";SteamGameLink::live.binding.appid=945360;steamOriginalRecoveryWake(7);drainOne(c);check(engineCalls==0,"event-licensed-entered-engine");check(privateReads==0,"event-licensed-entered-private-read");check(!c->bindingQualified&&!c->ownsRunning,"event-licensed-became-bound");const auto rows=c->snapshot["dualRoutes"];check(rows.size()==2,"event-licensed-route-summary-missing");for(const auto& row:rows)check(row["reason"]=="non-type2-gameid"&&row["engineDispatched"]==false,"event-licensed-not-explicitly-excluded");});

    test("producer-arm-preserves-wake-before-ready",[]{auto c=reset(false);eventOwner(c);closeEpisodeCalls=armProducerCalls=0;g_powerLifecycle=PowerLifecycle::Resuming;sleepRecoveryAutoArm(7);check(closeEpisodeCalls==1&&armProducerCalls==1&&producerGeneration==7,"formal-arm-producer-not-invoked");check(c->deferredWake==7&&c->pending.empty(),"formal-arm-lost-wake-notification");g_powerLifecycle=PowerLifecycle::Ready;steamOriginalRecoveryPowerReady(7);drainOne(c);check(engineCalls==2,"formal-arm-did-not-reach-both-routes");});
    test("producer-suspend-capture-queues-reference-only",[]{auto c=reset(false);eventOwner(c);captureProducerCalls=captureReadyCalls=0;sleepRecoveryAutoCaptureSuspend(7);check(captureProducerCalls==1&&captureReadyCalls==1&&producerGeneration==7,"formal-capture-producer-not-invoked");check(c->pending.size()==1&&c->pending.front().kind==Trigger::SuspendCapture,"formal-capture-not-queued");drainOne(c);check(engineCalls==2,"formal-capture-did-not-reach-both-routes");for(const auto& req:requests)check(req["recoveryAllowed"]==false,"capture-granted-recovery");});
    test("producer-commit-ready-releases-deferred-wake",[]{auto c=reset(false);eventOwner(c);gateOpenCalls=postResumeMessages=0;g_resumeReadyGeneration=7;g_powerLifecycle=PowerLifecycle::Resuming;sleepRecoveryAutoArm(7);check(commitPowerResume(7,"fixture-native-commit"),"formal-ready-commit-rejected");check(g_powerLifecycle==PowerLifecycle::Ready,"formal-ready-did-not-commit");check(c->pending.size()==1,"formal-ready-commit-lost-wake");check(gateOpenCalls==1&&postResumeMessages==1,"formal-ready-other-effects-lost");drainOne(c);check(engineCalls==2,"formal-ready-did-not-reach-both-routes");});
    test("producer-already-ready-branch-releases-deferred-wake",[]{auto c=reset(false);eventOwner(c);g_powerLifecycle=PowerLifecycle::Resuming;steamOriginalRecoveryWake(7);g_powerLifecycle=PowerLifecycle::Ready;check(commitPowerResume(7,"fixture-idempotent-ready"),"already-ready-commit-rejected");check(c->pending.size()==1,"already-ready-dropped-deferred-wake");drainOne(c);check(engineCalls==2,"already-ready-did-not-reach-both-routes");});
    test("producer-invalid-ready-generation-does-not-release",[]{auto c=reset(false);eventOwner(c);g_powerLifecycle=PowerLifecycle::Resuming;steamOriginalRecoveryWake(7);g_resumeReadyGeneration=8;check(!commitPowerResume(7,"fixture-unready-generation"),"unready-generation-committed");check(!commitPowerResume(8,"fixture-stale-generation"),"noncurrent-generation-committed");check(c->pending.empty()&&g_powerLifecycle==PowerLifecycle::Resuming,"invalid-ready-released-wake");g_resumeReadyGeneration=7;});
    unsigned failed=0;for(const auto& value:cases)if(!value["passed"].get<bool>())++failed;
    std::cout<<json({{"tests",cases.size()},{"checks",checks},{"failed",failed},{"passed",failed==0},{"cases",cases}}).dump()<<'\n';return failed?1:0;

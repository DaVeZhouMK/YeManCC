using Control=SteamOriginalRecovery::Control;using Pending=SteamOriginalRecovery::Pending;using Trigger=ymcc::steamOriginal::Trigger;
std::shared_ptr<Control> reset(bool kernel){
    now=1000000000000ULL;fixtureGeneration=7;tick=100000;operationAllowed=true;targetAvailable=true;privateAvailable=true;sceneSession=1;
    g_sleepRecoveryAutoEnabled=true;g_exitRequested=false;g_sleepRecoveryAutoConfigEpoch=5;g_gameRulesEpoch=9;g_powerLifecycle=PowerLifecycle::Ready;
    registryCandidate=0;registryPid=30224;registryReadable=true;registryReads=registryPidReads=engineRejectedAccountPorts=0;
    privateRequireCandidate=false;privateOriginalAccount=privateObservedAccount=456;privateAccountInputs.clear();
    liveGame={};SleepSteamRecovery::live={};SteamGameLink::live={};g_gameValveTarget={};g_gameValveTarget.game=liveGame;
    targetReads=engineCalls=privateReads=strictProofReads=0;requests.clear();engineGuards.clear();publishedStates.clear();saved.clear();onPrivateRead={};onEngineEnter={};onTracking={};engineReply={};
    SleepRecoveryAuto::state={};SleepRecoveryAuto::kernelWake={};SleepRecoveryAuto::kernelSleepEntry={};
    const auto boundary=now-10000000,event=now-5000000;
    SleepRecoveryAuto::state.wakeAdmission={{"status","admitted"},{"source",kernel?"kernel-power-507-reason-1":"pbt-resume-suspend-s3"},
        {"kernelWakeConfirmed",kernel},{"proofFresh",true},{"proofFollowedPreparedBoundary",false},
        {"boundaryGeneration",7},{"proofObservedGeneration",7},{"boundaryFileTime",std::to_string(boundary)},
        {"eventFileTime",kernel?json(std::to_string(event)):json(nullptr)},{"pbtObservedFileTime",std::to_string(event)},{"modernStandby",false}};
    if(kernel){SleepRecoveryAuto::kernelWake.eventFileTime=event;SleepRecoveryAuto::kernelWake.boundaryFileTime=boundary;}
    auto c=std::make_shared<Control>();c->startupPending=false;c->latestPower=7;return c;
}
const json config={{"enabled",true},{"targetMode","generic"}};
void run(const std::shared_ptr<Control>& c,U64 seq=1,U64 gen=7){SteamOriginalRecovery::runOne(c,{Trigger::Wake,gen,seq},config);}
std::vector<json> cases;unsigned checks=0;
void check(bool value,const char* reason){++checks;if(!value)throw std::runtime_error(reason);}
void test(const char* name,const std::function<void()>& body){const auto before=checks;try{body();cases.push_back({{"name",name},{"passed",true},{"checks",checks-before}});}catch(const std::exception& e){cases.push_back({{"name",name},{"passed",false},{"reason",e.what()},{"checks",checks-before}});}}

using Route=ymcc::steamOriginal::RecoveryRoute;
void route(const std::shared_ptr<Control>& c,Route r,U64 seq=1){SteamOriginalRecovery::runRoute(c,{Trigger::Wake,7,seq},config,r,true);}
json result(const char* status,bool consumed=false){return {{"status",status},{"consumed",consumed},{"reason",std::string("port-")+status},{"after",{{"running",true}}}};}
void routesChecked(const std::shared_ptr<Control>& c){const auto rows=c->snapshot.at("dualRoutes");check(rows.size()==2,"route-summary-missing");check(rows[0]["route"]=="legacy-dynamic","legacy-order-changed");check(rows[1]["route"]=="semi-static","static-order-changed");}
void eventOwner(const std::shared_ptr<Control>& c){SteamOriginalRecovery::callbackControl=c;c->enabled=true;eventSignals=0;c->observationEvent=std::shared_ptr<void>(reinterpret_cast<void*>(1),[](void*){});}
void drainOne(const std::shared_ptr<Control>& c){check(!c->pending.empty(),"event-not-queued");const auto e=c->pending.front();c->pending.pop_front();SteamOriginalRecovery::runOne(c,e,config);}
int main(){
    test("s3-ready-no-kernel",[]{auto c=reset(false);check(!SteamOriginalRecovery::wakeProof(7,5).eventFileTime,"static-proof-was-fabricated");const auto p=SteamOriginalRecovery::legacyWakeProof(7,5);check(p.valid(7,5,now,tick),"legacy-pbt-proof-refused");run(c);check(engineCalls==2,"s3-routes-not-dispatched");check(privateReads==1,"static-ui-typed-gate-missing");check(requests[0]["recoveryRoute"]=="legacy-dynamic","legacy-route-not-selected");check(requests[1]["recoveryRoute"]=="semi-static","static-s3-route-not-dispatched");check(requests[1]["recoveryAllowed"]==true,"static-s3-mutation-was-suppressed");check(engineGuards[1]["current"]==true,"static-s3-current-refused");check(engineGuards[0]["current"]==true,"legacy-current-refused");check(requests[0]["target"]["pid"]==65048,"game-changed");check(requests[0]["target"]["birth"]=="134371944693218729","game-birth-changed");check(requests[0]["steam"]["pid"]==63648,"steam-changed");check(requests[0]["target"]["gameId"]=="10260559608980439040","full-gameid-changed");check(requests[0]["account64"]=="76561197960266184","active-account-changed");check(c->snapshot["nativeRunning"].is_null(),"running-fabricated");routesChecked(c);});
    test("s3-static-runs-independently-without-kernel",[]{auto c=reset(false);route(c,Route::SemiStatic);check(engineCalls==1,"static-s3-route-not-dispatched");check(requests[0]["recoveryRoute"]=="semi-static","static-route-not-selected");check(engineGuards[0]["current"]==true,"static-s3-current-refused");check(!SteamOriginalRecovery::wakeProof(7,5).eventFileTime,"kernel-proof-fabricated");});
    test("legacy-account-unavailable-static-still-runs",[]{auto c=reset(true);SleepSteamRecovery::live.account=0;run(c);check(engineCalls==1,"active-account-gate-suppressed-static");check(requests[0]["recoveryRoute"]=="semi-static","static-route-not-selected");});
    test("s3-legacy-does-not-read-ui-gate",[]{auto c=reset(false);privateAvailable=false;route(c,Route::LegacyDynamic);check(engineCalls==1,"legacy-ui-gated");check(privateReads==0,"legacy-used-ui-typed-gate");check(strictProofReads==0,"legacy-read-strict-kernel-proof");});
    test("no-admission-both-routes-refuse",[]{auto c=reset(false);SleepRecoveryAuto::state.wakeAdmission["status"]="rejected";run(c);check(engineCalls==0,"unadmitted-wake-dispatched");});
    test("no-admission-object-both-routes-refuse",[]{auto c=reset(false);SleepRecoveryAuto::state.wakeAdmission=nullptr;run(c);check(engineCalls==0,"missing-admission-dispatched");});
    test("modern-standby-only-pbt-both-routes-refuse",[]{auto c=reset(false);SleepRecoveryAuto::state.wakeAdmission["modernStandby"]=true;run(c);check(engineCalls==0,"modern-standby-pbt-dispatched");});
    test("shared-s3-ticket-expiry-both-routes-refuse",[]{auto c=reset(false);now+=60000ULL*10000;tick+=60000;run(c);check(engineCalls==0,"expired-s3-ticket-dispatched");});
    test("verified-account-precedes-registry-candidate",[]{reset(false);registryCandidate=89250578;check(SteamOriginalRecovery::accountCandidate(456)==456,"verified-account-overridden");check(registryReads==0,"verified-account-read-registry");});
    test("account-candidate-helper-zero-and-registry-failure",[]{reset(false);check(SteamOriginalRecovery::accountCandidate(0)==0,"zero-candidate-fabricated");registryCandidate=89250578;registryReadable=false;check(SteamOriginalRecovery::accountCandidate(0)==0,"failed-registry-read-used");});
    test("stale-registry-pid-valid-candidate-legacy-dispatches",[]{
        auto c=reset(false);SleepSteamRecovery::live.account=0;registryCandidate=89250578;
        route(c,Route::LegacyDynamic);
        check(engineCalls==1,"candidate-legacy-not-dispatched");
        check(privateReads==0,"legacy-candidate-used-ui-gate");
        check(SleepSteamRecovery::live.account==0,"untrusted-candidate-promoted-to-verified-session");
        check(registryPid==30224&&SleepSteamRecovery::live.pid==63648,"stale-registry-scene-changed");
        check(registryPidReads==0&&registryReads>0,"candidate-helper-used-stale-pid");
        check(requests[0]["account64"]==std::to_string(76561197960265728ULL+89250578),"candidate-account-not-forwarded");
        check(requests[0]["target"]["pid"]==65048&&requests[0]["target"]["gameId"]=="10260559608980439040","candidate-changed-original-game");
        check(engineGuards[0]["current"]==true,"candidate-original-scope-refused");
        check(c->snapshot["nativeRunning"].is_null()&&!c->ownsRunning,"candidate-alone-claimed-running");
        check(!c->snapshot["lastResult"].value("consumed",false),"candidate-alone-claimed-consumption");
        check(!saved.at(L"fixture-evidence\\last-event.json").contains("account64"),"private-candidate-leaked-to-public-event");
    });
    test("candidate-static-independently-uses-ui-identity-port",[]{
        auto c=reset(false);SleepSteamRecovery::live.account=0;registryCandidate=89250578;
        privateRequireCandidate=true;privateOriginalAccount=privateObservedAccount=89250578;
        route(c,Route::SemiStatic);
        check(engineCalls==1,"candidate-static-not-dispatched");
        check(privateReads==1&&privateAccountInputs[0]==89250578,"candidate-not-passed-to-static-ui-gate");
        check(requests[0]["recoveryRoute"]=="semi-static","candidate-static-route-changed");
        check(requests[0]["account64"]==std::to_string(76561197960265728ULL+89250578),"static-original-account-port-not-used");
        check(c->snapshot["nativeRunning"].is_null(),"static-candidate-alone-claimed-running");
    });
    test("candidate-static-still-rejects-ui-port-unavailable",[]{auto c=reset(false);SleepSteamRecovery::live.account=0;registryCandidate=89250578;privateAvailable=false;run(c);check(engineCalls==1,"candidate-static-gate-suppressed-legacy");check(requests[0]["recoveryRoute"]=="legacy-dynamic","candidate-legacy-route-changed");check(privateReads==1,"static-candidate-skipped-ui-gate");});
    test("wrong-candidate-engine-port-rejects-no-consumption",[]{
        auto c=reset(false);SleepSteamRecovery::live.account=0;registryCandidate=89250579;
        privateRequireCandidate=true;privateOriginalAccount=89250578;privateObservedAccount=0;
        // This injected refusal is the engine boundary contract, not a native
        // CUser/pins/IPC validator. No native publisher executes in this test.
        engineReply=[](const json& req){
            if(req["account64"]==std::to_string(76561197960265728ULL+89250579)){
                ++engineRejectedAccountPorts;
                return json{{"status","unqualified"},{"reason","fixture-original-native-account-contract-refused"},{"consumed",false}};
            }
            check(req["account64"]==std::to_string(76561197960265728ULL+89250578),"retry-candidate-not-forwarded");
            return json{{"status","unqualified"},{"reason","fixture-no-native-validation-executed"},{"consumed",false}};
        };
        run(c);
        check(engineCalls==1&&engineRejectedAccountPorts==1,"wrong-candidate-engine-port-not-rejected");
        check(privateReads==1,"wrong-candidate-static-skipped-ui-gate");
        check(!c->snapshot["lastResult"].value("consumed",false),"wrong-candidate-consumed-publication-budget");
        check(!c->ownsRunning&&c->snapshot["nativeRunning"].is_null(),"wrong-candidate-claimed-running");
        const auto count=engineCalls;registryCandidate=89250578;run(c,2);
        check(engineCalls==count+1,"wrong-candidate-refunded-legacy-dispatch-or-blocked-independent-static");
        check(requests.back()["recoveryRoute"]=="semi-static","legacy-dispatch-budget-refunded");
        check(engineRejectedAccountPorts==1&&!saved.at(L"fixture-evidence\\last-semi-static-summary.json").value("consumed",false),"retry-candidate-claimed-native-validation-or-consumption");
    });
    test("candidate-change-revokes-final-ownership",[]{
        auto c=reset(false);SleepSteamRecovery::live.account=0;registryCandidate=89250578;
        privateRequireCandidate=true;privateOriginalAccount=privateObservedAccount=89250578;
        onEngineEnter=[]{if(requests.back()["recoveryRoute"]=="semi-static")registryCandidate=89250579;};
        // Synthetic success receipt tests only runOne's ownership bookkeeping.
        engineReply=[](const json& req){return req["recoveryRoute"]=="legacy-dynamic"?result("recovered-native",true):result("unqualified");};
        run(c);
        check(engineCalls==2,"candidate-dual-dispatch-missing");
        check(!c->ownsRunning,"changed-candidate-resurrected-ownership");
        check(c->snapshot["currentBindingValid"]==false&&c->snapshot["nativeRunning"].is_null(),"changed-candidate-marked-current");
        check(c->snapshot["lastResultHistorical"]==true,"changed-candidate-not-historical");
        check(c->snapshot["lastResult"]["status"]=="recovered-native","candidate-change-erased-historical-first-receipt");
    });
    test("stable-candidate-final-check-retains-controlled-success",[]{auto c=reset(false);SleepSteamRecovery::live.account=0;registryCandidate=89250578;privateRequireCandidate=true;privateOriginalAccount=privateObservedAccount=89250578;engineReply=[](const json& req){return req["recoveryRoute"]=="legacy-dynamic"?result("recovered-native",true):result("unqualified");};run(c);check(engineCalls==2,"candidate-dual-dispatch-missing");check(c->ownsRunning,"stable-candidate-final-check-rejected");check(requests[1]["recoveryAllowed"]==false,"candidate-terminal-permitted-second-publisher");check(SleepSteamRecovery::live.account==0,"candidate-promoted-to-session-account");});
    test("zero-session-and-registry-and-native-account-refuse",[]{auto c=reset(false);SleepSteamRecovery::live.account=0;registryCandidate=0;privateRequireCandidate=true;privateAvailable=false;privateObservedAccount=0;run(c);check(engineCalls==0,"zero-accounts-dispatched");check(!c->ownsRunning&&c->snapshot["nativeRunning"].is_null(),"zero-accounts-claimed-running");});
    test("kernel-proof-and-static-dispatch",[]{auto c=reset(true);check(SteamOriginalRecovery::wakeProof(7,5).valid(7,5,now),"static-proof-refused");route(c,Route::SemiStatic);check(engineCalls==1,"static-engine-not-dispatched");check(requests[0]["recoveryRoute"]=="semi-static","static-route-not-selected");check(engineGuards[0]["current"]==true,"static-current-refused");check(privateReads==1,"static-ui-typed-gate-missing");});
    test("legacy-rejected-static-independently-runs",[]{auto c=reset(true);SleepRecoveryAuto::state.armed=0;check(!SteamOriginalRecovery::legacyWakeProof(7,5).eventFileTime,"legacy-proof-not-rejected");run(c);check(engineCalls==1,"static-engine-not-dispatched");check(requests[0]["recoveryRoute"]=="semi-static","static-route-not-selected");check(requests[0]["recoveryAllowed"]==true,"static-mutation-was-suppressed");check(engineGuards[0]["current"]==true,"static-current-refused");routesChecked(c);});
    test("legacy-engine-rejection-static-independently-runs",[]{auto c=reset(true);run(c);check(engineCalls==2,"both-routes-not-dispatched");check(requests[0]["recoveryRoute"]=="legacy-dynamic","legacy-order-changed");check(requests[1]["recoveryRoute"]=="semi-static","static-order-changed");check(requests[1]["recoveryAllowed"]==true,"legacy-rejection-suppressed-static");check(requests[0]["trigger"]["id"]==requests[1]["trigger"]["id"],"shared-event-budget-was-split");check(requests[0]["target"]==requests[1]["target"],"route-target-changed");});
    test("static-rejected-legacy-budget-remains",[]{auto c=reset(false);privateAvailable=false;route(c,Route::SemiStatic);check(engineCalls==0,"invalid-static-dispatched");route(c,Route::LegacyDynamic);check(engineCalls==1,"static-rejection-consumed-legacy-budget");check(engineGuards[0]["current"]==true,"legacy-current-refused");});
    test("static-ui-gate-rejected-legacy-still-runs",[]{auto c=reset(true);privateAvailable=false;run(c);check(engineCalls==1,"static-ui-gate-suppressed-legacy");check(requests[0]["recoveryRoute"]=="legacy-dynamic","legacy-route-not-selected");});
    test("legacy-success-static-only-observes",[]{auto c=reset(true);engineReply=[](const json& req){return req["recoveryRoute"]=="legacy-dynamic"?result("recovered-native",true):result("unqualified");};run(c);check(engineCalls==2,"static-observation-missing");check(requests[1]["recoveryAllowed"]==false,"static-can-double-publish");check(c->snapshot["lastResult"]["status"]=="recovered-native","legacy-success-erased");check(saved.at(L"fixture-evidence\\last-recovery-summary.json")["status"]=="recovered-native","durable-first-success-erased");check(c->ownsRunning,"legacy-success-owner-erased");routesChecked(c);});
    test("first-success-preserved-when-static-healthy",[]{auto c=reset(true);engineReply=[](const json& req){return req["recoveryRoute"]=="legacy-dynamic"?result("recovered-native",true):result("healthy");};run(c);check(engineCalls==2,"static-observation-missing");check(requests[1]["recoveryAllowed"]==false,"static-can-double-publish");check(c->snapshot["recoveryRoute"]=="legacy-dynamic","first-success-route-overwritten");check(c->snapshot["lastResult"]["status"]=="recovered-native","first-success-overwritten");});
    test("first-healthy-success-preserved",[]{auto c=reset(true);engineReply=[](const json&){return result("healthy");};run(c);check(engineCalls==2,"static-observation-missing");check(requests[1]["recoveryAllowed"]==false,"healthy-result-allows-second-publisher");check(c->snapshot["recoveryRoute"]=="legacy-dynamic","first-healthy-route-overwritten");});
    test("first-success-becomes-historical-if-static-guard-loses-game",[]{auto c=reset(true);onEngineEnter=[]{if(requests.back()["recoveryRoute"]=="semi-static"){++liveGame.pid;g_gameValveTarget.game=liveGame;}};engineReply=[](const json& req){return req["recoveryRoute"]=="legacy-dynamic"?result("recovered-native",true):result("unqualified");};run(c);check(engineCalls==2,"static-observation-missing");check(engineGuards[1]["current"]==false,"changed-game-authorized");check(!c->ownsRunning,"stale-first-success-owns-running");check(c->snapshot["currentBindingValid"]==false,"stale-first-success-binding-current");check(c->snapshot["nativeRunning"].is_null(),"stale-first-success-faked-running");check(c->snapshot["lastResultHistorical"]==true,"stale-first-success-not-historical");});
    test("first-success-becomes-historical-if-static-guard-loses-epoch",[]{auto c=reset(true);onEngineEnter=[]{if(requests.back()["recoveryRoute"]=="semi-static")++g_sleepRecoveryAutoConfigEpoch;};engineReply=[](const json& req){return req["recoveryRoute"]=="legacy-dynamic"?result("recovered-native",true):result("unqualified");};run(c);check(engineCalls==2,"static-observation-missing");check(engineGuards[1]["current"]==false,"changed-epoch-authorized");check(!c->ownsRunning,"stale-first-success-owns-running");check(c->snapshot["nativeRunning"].is_null(),"stale-first-success-faked-running");});
    test("same-pid-different-full-gameid-cannot-resurrect",[]{
        auto c=reset(true);
        engineReply=[](const json& req){
            if(req["recoveryRoute"]=="legacy-dynamic"){
                SteamGameLink::live.gameId="10260559613275406336";
                ++SteamGameLink::live.binding.appid;
                return result("recovered-native",true);
            }
            return result("unqualified");
        };
        run(c);
        check(engineCalls==1,"migrated-gameid-was-dispatched");
        check(liveGame.pid==65048&&liveGame.processCreated==134371944693218729ULL,"pid-identity-was-changed-by-fixture");
        check(c->boundGameId=="10260559613275406336","production-binding-did-not-migrate");
        check(!c->ownsRunning,"migrated-gameid-resurrected-ownership");
        check(c->snapshot["target"]["gameId"]=="10260559608980439040","first-success-original-gameid-overwritten");
        check(c->snapshot["currentBindingValid"]==false,"migrated-gameid-marked-current");
        check(c->snapshot["nativeRunning"].is_null(),"migrated-gameid-faked-running");
        check(c->snapshot["lastResultHistorical"]==true,"migrated-gameid-not-historical");
        check(c->snapshot["lastResult"]["status"]=="recovered-native","historical-first-success-erased");
    });
    for(const auto& changed:std::vector<std::string>{"binding-qualified","bound-appid","control-stop","account","steam-birth","rules","off","power-ready"}){
        test(("final-success-refuses-"+changed).c_str(),[changed]{
            auto c=reset(true);
            onEngineEnter=[c,changed]{
                if(requests.back()["recoveryRoute"]!="semi-static")return;
                if(changed=="binding-qualified"){std::lock_guard<std::mutex> lock(c->mx);c->bindingQualified=false;}
                else if(changed=="bound-appid"){std::lock_guard<std::mutex> lock(c->mx);++c->boundAppId;}
                else if(changed=="control-stop"){std::lock_guard<std::mutex> lock(c->mx);c->stop=true;}
                else if(changed=="account")++SleepSteamRecovery::live.account;
                else if(changed=="steam-birth")++SleepSteamRecovery::live.created;
                else if(changed=="rules")++g_gameRulesEpoch;
                else if(changed=="off")g_sleepRecoveryAutoEnabled=false;
                else if(changed=="power-ready")g_powerLifecycle=PowerLifecycle::Resuming;
            };
            engineReply=[](const json& req){return req["recoveryRoute"]=="legacy-dynamic"?result("recovered-native",true):result("unqualified");};
            run(c);
            check(engineCalls==2,"static-observation-missing");
            check(!c->ownsRunning,"final-invalid-scope-resurrected-ownership");
            check(c->snapshot["currentBindingValid"]==false,"final-invalid-scope-marked-current");
            check(c->snapshot["nativeRunning"].is_null(),"final-invalid-scope-faked-running");
            check(c->snapshot["lastResultHistorical"]==true,"final-invalid-scope-not-historical");
            check(c->snapshot["lastResult"]["status"]=="recovered-native","historical-first-success-erased");
        });
    }
    test("legacy-consumed-ambiguous-static-only-observes",[]{auto c=reset(true);engineReply=[](const json& req){return req["recoveryRoute"]=="legacy-dynamic"?result("unqualified",true):result("unqualified");};run(c);check(engineCalls==2,"static-observation-missing");check(requests[1]["recoveryAllowed"]==false,"ambiguous-consume-allows-double-publish");check(c->snapshot["nativeRunning"].is_null(),"ambiguous-result-faked-running");});
    test("same-wake-never-refunds",[]{auto c=reset(true);run(c);const auto count=engineCalls;check(count==2,"initial-dual-dispatch-missing");run(c,2);c->admission.invalidate();c->legacyAdmission.invalidate();++g_gameRulesEpoch;run(c,3);check(engineCalls==count,"wake-budget-refunded");});
    test("independent-route-admission",[]{auto c=reset(true);route(c,Route::LegacyDynamic);check(engineCalls==1,"legacy-dispatch-missing");route(c,Route::SemiStatic);check(engineCalls==2,"legacy-admission-consumed-static");route(c,Route::LegacyDynamic,2);route(c,Route::SemiStatic,2);check(engineCalls==2,"route-replay-consumed-twice");});
    for(const auto r:{Route::LegacyDynamic,Route::SemiStatic}){
        const std::string prefix=ymcc::steamOriginal::routeName(r);
        auto named=[&](const char* suffix,const std::function<void()>& body){test((prefix+suffix).c_str(),body);};
        named("-off-refuses",[=]{auto c=reset(true);g_sleepRecoveryAutoEnabled=false;route(c,r);check(engineCalls==0,"off-dispatched");});
        named("-stale-config-epoch-refuses",[=]{auto c=reset(true);g_sleepRecoveryAutoConfigEpoch=6;route(c,r);check(engineCalls==0,"stale-epoch-dispatched");});
        named("-stale-generation-refuses",[=]{auto c=reset(true);c->latestPower=8;route(c,r);check(engineCalls==0,"stale-generation-dispatched");});
        named("-not-ready-refuses",[=]{auto c=reset(true);g_powerLifecycle=PowerLifecycle::Resuming;route(c,r);check(engineCalls==0,"not-ready-dispatched");});
        named("-game-changes-before-admission",[=]{auto c=reset(true);onTracking=[]{++liveGame.processCreated;};route(c,r);check(engineCalls==0,"changed-game-dispatched");});
        named("-steam-changes-before-admission",[=]{auto c=reset(true);onTracking=[]{++SleepSteamRecovery::live.created;};route(c,r);check(engineCalls==0,"changed-steam-dispatched");});
        named("-game-at-engine-boundary",[=]{auto c=reset(true);onEngineEnter=[]{++liveGame.pid;g_gameValveTarget.game=liveGame;};route(c,r);check(engineCalls==1,"engine-boundary-missing");check(engineGuards[0]["current"]==false,"second-game-authorized");check(engineGuards[0]["observation"]==false,"second-game-observed");});
        named("-steam-at-engine-boundary",[=]{auto c=reset(true);onEngineEnter=[]{++SleepSteamRecovery::live.created;};route(c,r);check(engineCalls==1,"engine-boundary-missing");check(engineGuards[0]["current"]==false,"changed-steam-authorized");check(engineGuards[0]["observation"]==false,"changed-steam-observed");});
        named("-epoch-at-engine-boundary",[=]{auto c=reset(true);onEngineEnter=[]{++g_sleepRecoveryAutoConfigEpoch;};route(c,r);check(engineCalls==1,"engine-boundary-missing");check(engineGuards[0]["current"]==false,"changed-epoch-authorized");check(engineGuards[0]["observation"]==false,"changed-epoch-observed");check(!c->ownsRunning,"stale-running-owner");check(c->snapshot["nativeRunning"].is_null(),"running-fabricated");});
        named("-rules-at-engine-boundary",[=]{auto c=reset(true);onEngineEnter=[]{++g_gameRulesEpoch;};route(c,r);check(engineCalls==1,"engine-boundary-missing");check(engineGuards[0]["current"]==false,"changed-rules-authorized");check(engineGuards[0]["observation"]==false,"changed-rules-observed");});
        named("-off-at-engine-boundary",[=]{auto c=reset(true);onEngineEnter=[]{g_sleepRecoveryAutoEnabled=false;};route(c,r);check(engineCalls==1,"engine-boundary-missing");check(engineGuards[0]["current"]==false,"off-authorized");});
        named("-cancelled-dispatch-never-refunds",[=]{auto c=reset(true);onEngineEnter=[]{g_sleepRecoveryAutoEnabled=false;};route(c,r);const auto count=engineCalls;check(count==1,"first-dispatch-missing");g_sleepRecoveryAutoEnabled=true;onEngineEnter={};route(c,r,2);c->admission.invalidate();c->legacyAdmission.invalidate();route(c,r,3);check(engineCalls==count,"cancelled-budget-refunded");});
    }
    test("game-changes-during-private-read",[]{auto c=reset(true);onPrivateRead=[]{++liveGame.processCreated;};route(c,Route::SemiStatic);check(engineCalls==0,"changed-game-dispatched");});
    test("steam-changes-during-private-read",[]{auto c=reset(true);onPrivateRead=[]{++SleepSteamRecovery::live.created;};route(c,Route::SemiStatic);check(engineCalls==0,"changed-steam-dispatched");});
    test("actual-wake-proof-refuses-unconfirmed",[]{reset(true);SleepRecoveryAuto::state.wakeAdmission["kernelWakeConfirmed"]=false;check(!SteamOriginalRecovery::wakeProof(7,5).eventFileTime,"unconfirmed-static-witness-accepted");});
    test("actual-wake-proof-refuses-null-event-time",[]{reset(true);SleepRecoveryAuto::state.wakeAdmission["eventFileTime"]=nullptr;check(!SteamOriginalRecovery::wakeProof(7,5).eventFileTime,"null-static-event-time-accepted");});
    test("actual-wake-proof-refuses-expired-witness",[]{reset(true);now+=60000ULL*10000;check(!SteamOriginalRecovery::wakeProof(7,5).eventFileTime,"expired-static-witness-accepted");});
    test("legacy-proof-refuses-missing-pbt-timestamp",[]{reset(false);SleepRecoveryAuto::state.wakeAdmission.erase("pbtObservedFileTime");check(!SteamOriginalRecovery::legacyWakeProof(7,5).eventFileTime,"missing-pbt-time-accepted");});
    test("legacy-proof-refuses-expired-timestamp",[]{reset(false);now+=60000ULL*10000;check(!SteamOriginalRecovery::legacyWakeProof(7,5).eventFileTime,"expired-pbt-time-accepted");});
    test("legacy-proof-refuses-expired-armed-tick",[]{reset(false);tick+=60000;check(!SteamOriginalRecovery::legacyWakeProof(7,5).eventFileTime,"expired-pbt-arm-accepted");});
    test("legacy-proof-refuses-modern-standby-pbt",[]{reset(false);SleepRecoveryAuto::state.wakeAdmission["modernStandby"]=true;check(!SteamOriginalRecovery::legacyWakeProof(7,5).eventFileTime,"modern-standby-pbt-accepted");});
    test("legacy-proof-refuses-operation-denied",[]{reset(false);operationAllowed=false;check(!SteamOriginalRecovery::legacyWakeProof(7,5).eventFileTime,"operation-denied-accepted");});
    test("legacy-proof-refuses-new-sleep-entry",[]{reset(false);SleepRecoveryAuto::kernelSleepEntry.eventFileTime=now;check(!SteamOriginalRecovery::legacyWakeProof(7,5).eventFileTime,"new-sleep-entry-accepted");});
    test("legacy-proof-invalidates-at-boundary",[]{auto c=reset(false);onEngineEnter=[]{SleepRecoveryAuto::state.wakeAdmission["pbtObservedFileTime"]=std::to_string(now-4000000);};route(c,Route::LegacyDynamic);check(engineCalls==1,"legacy-engine-not-dispatched");check(engineGuards[0]["current"]==false,"changed-pbt-proof-authorized");check(engineGuards[0]["observation"]==false,"changed-pbt-proof-observed");});
    test("legacy-proof-retry-cannot-refresh-budget",[]{auto c=reset(false);run(c);check(engineCalls==2,"s3-routes-not-dispatched");now+=60000ULL*10000;tick+=60000;run(c,2);check(engineCalls==2,"expired-wake-retried");check(!SteamOriginalRecovery::legacyWakeProof(7,5).eventFileTime,"pbt-proof-refreshed");});
    test("legacy-proof-refuses-unadmitted",[]{reset(false);SleepRecoveryAuto::state.wakeAdmission["status"]="rejected";check(!SteamOriginalRecovery::legacyWakeProof(7,5).eventFileTime,"unadmitted-pbt-accepted");});
    test("legacy-proof-refuses-future-or-wrong-generation",[]{reset(false);check(!SteamOriginalRecovery::legacyWakeProof(8,5).eventFileTime,"wrong-generation-accepted");SleepRecoveryAuto::state.wakeAdmission["pbtObservedFileTime"]=std::to_string(now+1);check(!SteamOriginalRecovery::legacyWakeProof(7,5).eventFileTime,"future-pbt-time-accepted");});

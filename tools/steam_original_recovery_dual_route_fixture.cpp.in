struct KernelSleepEntry {ULONGLONG configEpoch=5,generation=7,eventFileTime=0;} kernelSleepEntry;
bool wakeOperationAllows(ULONGLONG g,ULONGLONG e){return operationAllowed&&g==fixtureGeneration&&e==g_sleepRecoveryAutoConfigEpoch.load();}
bool wakeOperationAllowedLocked(ULONGLONG g,ULONGLONG e){return wakeOperationAllows(g,e);}
}
namespace SleepSteamRecovery {
struct Session {DWORD pid=63648;ULONGLONG created=12341234;std::wstring root=L"D:\\steam";DWORD account=456;} live;
Session session(){return live;}
json liveRequest(Session& requestedSession,const json&,const std::function<bool()>& guard,ymcc::steamrecordidentity::Read* read){
    ++privateReads;privateAccountInputs.push_back(requestedSession.account);if(onPrivateRead)onPrivateRead();
    read->available=privateAvailable&&(!privateRequireCandidate||requestedSession.account==privateOriginalAccount)&&guard();
    read->account64=76561197960265728ULL+privateOriginalAccount;
    read->gameId64=10260559608980439040ULL;read->appid=static_cast<DWORD>(read->gameId64>>32);
    return {{"ok",true},{"mutated",false},{"observedAccount",privateObservedAccount}};
}
}

constexpr DWORD MAXDWORD=UINT32_MAX;
using HKEY=std::uintptr_t;
constexpr HKEY HKEY_CURRENT_USER=0x80000001ULL;
// Registry observations are inputs, never account/native qualification.
DWORD registryCandidate=0,registryPid=30224;
bool registryReadable=true,privateRequireCandidate=false;
DWORD privateOriginalAccount=456,privateObservedAccount=456;
unsigned registryReads=0,registryPidReads=0,engineRejectedAccountPorts=0;
std::vector<DWORD> privateAccountInputs;
bool sofRegDWORD(HKEY root,const wchar_t* sub,const wchar_t* name,DWORD* out){
    ++registryReads;
    if(root!=HKEY_CURRENT_USER||std::wstring(sub)!=L"Software\\Valve\\Steam\\ActiveProcess"||!registryReadable)return false;
    if(std::wstring(name)==L"ActiveUser"){*out=registryCandidate;return true;}
    if(std::wstring(name)==L"pid"){++registryPidReads;*out=registryPid;return true;}
    return false;
}

// Current-owner and event-handle ports: no Win32 signals or live worker.
std::shared_ptr<Control> callbackControl;
std::shared_ptr<Control> current(){return callbackControl;}
std::wstring root(){return L"fixture-evidence";}
std::wstring runtimeRoot(){return L"fixture-runtime";}
void publish(const std::shared_ptr<Control>& c,json value,bool=true){c->snapshot.update(value);publishedStates.push_back(value);}
void saveJson(const std::wstring& path,const json& value){saved[path]=value;}
void log(const std::shared_ptr<Control>&,const char*,const json&){}
@@HELPERS@@
// Count call sites, then invoke the exact extracted strict-proof body.
static ymcc::steamOriginal::WakeProof countedStrictWakeProof(unsigned long long g,unsigned long long e){++strictProofReads;return wakeProof(g,e);}
#define wakeProof countedStrictWakeProof
@@RUN_ONE@@
#undef wakeProof
}
static json steamOriginalRecoveryEngineHandle(const json& request,const std::function<bool()>& current,const std::function<void(const json&)>&,const std::function<bool()>& observation,std::uintptr_t){
    ++engineCalls;requests.push_back(request);if(onEngineEnter)onEngineEnter();
    const bool valid=current(),observed=observation();engineGuards.push_back({{"current",valid},{"observation",observed}});
    if(engineReply)return engineReply(request);
    // The engine is a boundary port here: never claim a repair/native Running.
    return {{"status","unqualified"},{"reason","fixture-engine-boundary"}};
}
@@EVENT_ENTRYPOINTS@@
// Power, UI message and hardware side effects are counters; the producer and
// commit bodies below are the exact formal consumers, not reimplemented code.
unsigned closeEpisodeCalls=0,armProducerCalls=0,captureProducerCalls=0,captureReadyCalls=0,gateOpenCalls=0,postResumeMessages=0;
U64 producerGeneration=0;
namespace SleepSteamRecovery {void closeSuspendEpisode(){++closeEpisodeCalls;}void captureSuspend(U64 g){++captureProducerCalls;producerGeneration=g;}}
namespace SleepRecoveryAuto {void arm(U64 g){++armProducerCalls;producerGeneration=g;}void captureReady(U64 g){++captureReadyCalls;producerGeneration=g;}}
std::atomic<U64> g_resumeReadyGeneration{7},g_lastPowerResumeCommitTick{0};
std::atomic<bool> g_inputReady{true};
bool sgShouldKeepInputDuringStandby(){return false;}
void openHardwareWriteGate(){++gateOpenCalls;}
void traceLog(const char*,...){}
constexpr std::uintptr_t g_hwnd=1;constexpr unsigned WM_POWER_RESUME_COMMIT=0x8000;
bool PostMessageW(std::uintptr_t,unsigned,std::uintptr_t,std::intptr_t){++postResumeMessages;return true;}

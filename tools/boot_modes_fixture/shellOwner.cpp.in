static unsigned powerOpens=0,powerCloses=0;
static HANDLE WINAPI trackedPowerEvent(LPSECURITY_ATTRIBUTES a,BOOL manual,BOOL initial,LPCWSTR name){auto h=::CreateEventW(a,manual,initial,name);if(h){std::lock_guard lock(powerHandlesMx);powerHandles.insert(h);++powerOpens;}return h;}
static BOOL WINAPI trackedPowerClose(HANDLE h){const auto ok=::CloseHandle(h);if(ok){std::lock_guard lock(powerHandlesMx);if(powerHandles.erase(h))++powerCloses;}return ok;}

static std::wstring U2W(const std::string& text){return {text.begin(),text.end()};}
static std::string W2U(const std::wstring& text){return {text.begin(),text.end()};}
static std::string ascii_lower(std::string value){for(auto& c:value)c=static_cast<char>(::tolower(static_cast<unsigned char>(c)));return value;}
static bool sameFinalPath(const std::wstring& a,const std::wstring& b){return a==b;}

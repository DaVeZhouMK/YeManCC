static json fixtureDocument;
static std::mutex settingsMx;
static const std::wstring YM_SETTINGS_FILE=L"owned-memory/settings.json",kTdpDaemonExe=L"not-a-real-helper.exe";
struct SettingsFileGuard{std::lock_guard<std::mutex> lock{settingsMx};};
static unsigned settingsReads=0;
static std::string ymSettingsReadRaw(const std::wstring&){++settingsReads;return fixtureDocument.dump();}
[[maybe_unused]] static json ymSettingsSectionReadCachedUnlocked(const char* section,const char*,const std::initializer_list<const char*>* fields,bool* primaryRead){
 ++settingsReads;*primaryRead=!fixtureDocument.is_null();json selected=json::object();
 if(fixtureDocument.contains(section)&&fixtureDocument.at(section).is_object())for(const auto* field:*fields)
  if(fixtureDocument.at(section).contains(field))selected[field]=fixtureDocument.at(section).at(field);
 return selected;
}
static std::atomic<bool> g_exitRequested{false},g_tdpDaemonStopSent{false},g_poolCancel{false};
static std::atomic<unsigned long long> g_powerGeneration{4};
static std::atomic<unsigned> g_tdpObservationFailures{0};

static std::atomic<PowerLifecycle> g_powerLifecycle{PowerLifecycle::Ready};
static std::atomic<bool> g_hardwareWriteGate{true};
static std::atomic<unsigned> g_hardwareWriteInFlight{0};
static std::atomic<ULONGLONG> g_sgLatestSleepEntryFileTime{0};
static std::atomic<uint64_t> g_sharedPowerPublicationRevision{0},g_sharedPowerSuspendSerial{0};
static struct{bool isolated=false;}g_aiFanMockSession;

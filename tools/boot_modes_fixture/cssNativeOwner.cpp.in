 if(change=="mode")document["extensions"]["bootModes"]["revision"]=4;
 if(change=="result")document["extensions"]["bootModesStartupResult"]={{"schema",1},{"revision",99}};
 if(change=="observed")document["input"]["startupObservedBoot"]="replacement-boot";
 if(change=="ack")document["input"]["hostAcknowledgedRevision"]=17;
 if(change=="unrelated")document["extensions"]["peer"]=true;
}
struct ObservedChild {HANDLE handle=nullptr;DWORD pid=0;ULONGLONG birth=0;std::string stage;bool assigned=false,groupAssigned=false;~ObservedChild(){if(handle)CloseHandle(handle);}};
static std::vector<std::unique_ptr<ObservedChild>> children;
static void fixtureChild(HANDLE handle,const char* stage,bool groupAssigned){
 auto item=std::make_unique<ObservedChild>();need(DuplicateHandle(GetCurrentProcess(),handle,GetCurrentProcess(),&item->handle,SYNCHRONIZE|PROCESS_QUERY_LIMITED_INFORMATION,FALSE,0),"Owned child observation handle unavailable");item->pid=GetProcessId(handle);FILETIME born{},exit{},kernel{},user{};need(GetProcessTimes(handle,&born,&exit,&kernel,&user)!=FALSE,"Owned helper birth unavailable");item->birth=(ULONGLONG(born.dwHighDateTime)<<32)|born.dwLowDateTime;item->stage=stage;item->groupAssigned=groupAssigned;BOOL assigned=FALSE;IsProcessInJob(handle,nullptr,&assigned);item->assigned=assigned!=FALSE;children.push_back(std::move(item));
 if(selectedStage==stage)mutate();
}
struct OwnedProcess {HANDLE handle=nullptr;~OwnedProcess(){if(handle){TerminateProcess(handle,0);WaitForSingleObject(handle,2000);CloseHandle(handle);}}};
static std::wstring self(){wchar_t buffer[32768]{};GetModuleFileNameW(nullptr,buffer,32768);return buffer;}
static HANDLE launchOwned(const std::wstring& exe){auto command=L"\""+exe+L"\" --owned-idle";STARTUPINFOW startup{sizeof(startup)};PROCESS_INFORMATION child{};need(CreateProcessW(exe.c_str(),command.data(),nullptr,nullptr,FALSE,CREATE_NO_WINDOW,nullptr,nullptr,&startup,&child)!=FALSE,"Owned inert process launch failed");CloseHandle(child.hThread);return child.hProcess;}
static bool live(HANDLE handle){return handle&&WaitForSingleObject(handle,0)==WAIT_TIMEOUT;}
static void reset(const json& defaults,const json& wire){
 document=defaults;document["input"]=wire.at("expectedBootContext").at("input");document["extensions"]=wire.at("expectedBootContext").at("extensions");ownerReads=0;contentions=0;changed=false;selectedStage.clear();change="current";onContention=nullptr;children.clear();std::lock_guard lock(effectsMx);effects.clear();atChange=0;
}
static json childRows(){json result=json::array();for(const auto& child:children)result.push_back({{"pid",child->pid},{"birth",std::to_string(child->birth)},{"stage",child->stage},{"assignedToAJob",child->assigned},{"groupAssignmentObserved",child->groupAssigned},{"signaled",WaitForSingleObject(child->handle,2000)==WAIT_OBJECT_0}});return result;}
static void expireAndRelease(uint64_t token){
 {SettingsFileGuard held;document["input"]["revision"]=999;}
 if(token){auto result=g_steamCssUse.release(token);need(!result.error&&!result.remaining,"Stale request cleanup was not confirmed");}
 std::lock_guard lock(g_steamCssUse.mutex_);need(!g_steamCssUse.token_&&!g_steamCssUse.ensure_&&!g_steamCssUse.helper_,"Stale native CSS use retained bounded helper or token");
}

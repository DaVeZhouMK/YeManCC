}
static std::string ymSettingsReadRaw(const std::wstring& file){++ownerState->reads;return ownerRaw(file);}
[[maybe_unused]] static json ymSettingsReadUnlocked(){
    ++ownerState->fallbackReads;
    for(const auto* file:{&YM_SETTINGS_FILE,&YM_SETTINGS_BACKUP_FILE}){
        try{const auto value=ymcc::settingsBaseline::parseDocument(ymSettingsReadRaw(*file));if(ymcc::settingsBaseline::supported(value))return value;}catch(...){}
    }return json::object();
}
static void ipc_on(const char* name,std::function<json(const json&)> fn){ownerNeed(std::string(name)=="steam.startup.set","only actual selected handler");ownerHandlers[name]=std::move(fn);}
static void appendNativeLifecycleLog(const char* name,const json& value){ownerNeed(std::string(name)=="steam-startup-service"&&value.is_object(),"unexpected memory log");++ownerState->logs;}
static struct {void notifyRequestChanged(){}} g_steamCssUse;
namespace ymcc::earlystart {
static json read(){++ownerState->serviceReads;ownerPause("service");return {{"known",true},{"installed",true},{"automatic",true},{"running",true},{"fixture","memory-service"}};}
static json repair(){++ownerState->serviceRepairs;ownerPause("service");return {{"known",true},{"installed",true},{"automatic",true},{"running",true},{"fixture","memory-service"}};}
}
// The code behind these terminals stays byte-identical. Only API leaves for
// owned files and the isolated mutex are bound here, never an owner model.
#define CreateMutexW ownerCreateMutex
#define WaitForSingleObject ownerWait
#define CloseHandle ownerClose
#define CreateFileW ownerCreateFile

// This branch compiles ORIGINAL Startup/IPC/owner/guard source from the declared
// generated include. It never includes WindowsPorts or a Steam/service launcher.
struct OwnerHandle {
    HANDLE value=nullptr;
    explicit OwnerHandle(HANDLE h=nullptr):value(h){}
    ~OwnerHandle(){if(value&&value!=INVALID_HANDLE_VALUE)::CloseHandle(value);}
    OwnerHandle(const OwnerHandle&)=delete;OwnerHandle& operator=(const OwnerHandle&)=delete;
};
static void ownerNeed(bool value,const char* why){if(!value)throw std::runtime_error(why);}
static std::wstring ownerRoot,ownerSuiteToken,POWER_CONTROL_DIR,YM_SETTINGS_FILE,YM_SETTINGS_BACKUP_FILE;

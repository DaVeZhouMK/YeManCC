static void ownerChange(const std::string& change){
    const auto original=ymcc::settingsBaseline::parseDocument(ownerRaw(YM_SETTINGS_FILE));
    if(change=="corrupt"){ownerWrite(YM_SETTINGS_FILE,"{bad-owned-main");return;}
    auto next=original;ownerNeed(next.is_object(),"peer requires strict settings");
    if(change=="revision")next["input"]["revision"]=8;
    else if(change=="input-intent")next["input"]["diagnostics"]["inputLoggingEnabled"]=true;
    else if(change=="mode"){next["extensions"]["bootModes"]["revision"]=4;if(next["extensions"]["bootModes"].contains("preparation"))next["extensions"]["bootModes"]["global"]["background"]["ui"]["theme"]="red-black";}
    else if(change=="claim"||change=="claim-rebased"||change=="claim-current"){
        if(change!="claim-current")next["extensions"]["bootModesClaimWriteId"]="peer-steam-claim";
        if(change!="claim"){next["extensions"]["bootModes"]["revision"]=4;next["extensions"]["bootModes"]["global"]["background"]["ui"]["theme"]="red-black";}
    }
    else if(change=="result")next["extensions"]["bootModesStartupResult"]={{"schema",1},{"revision",99}};
    else if(change=="observed")next["input"]["startupObservedBoot"]="new-owned-boot";
    else if(change=="unsupported")next["schemaVersion"]=99;
    else if(change=="preparation-selection"){next["extensions"]["bootModes"]["revision"]=4;next["extensions"]["bootModes"]["boot"]=next["extensions"]["bootModes"]["boot"]=="global"?"xbox":"global";}
    else if(change=="preparation-new-request"){next["extensions"]["bootModes"]["revision"]=4;next["extensions"]["bootModes"]["preparation"]["revision"]=4;}
    else if(change=="preparation-disabled")next["extensions"]["bootModes"]["bootEnabled"]=false;
    else if(change=="preparation-current")next["extensions"]["bootModes"]["current"]=next["extensions"]["bootModes"]["current"]=="global"?"xbox":"global";
    else if(change=="preparation-state")next["extensions"]["bootModes"]["preparation"]["status"]="prepared";
    else if(change=="preparation-rollback")next["extensions"]["bootModes"]["revision"]=2;
    else if(change=="ack")next["input"]["hostAcknowledgedRevision"]=7;
    else if(change=="unrelated")next["extensions"]["peer"]={{"keep",true}};
    else ownerNeed(change=="none","unknown selected mutation");
    ownerWrite(YM_SETTINGS_FILE,next.dump());
}
struct OwnerOutcome {bool ok=false;json reply;std::string error;};
static OwnerOutcome ownerInvoke(const json& args){
    OwnerOutcome result;try{result.reply=ownerHandlers.at("steam.startup.set")(args);result.ok=result.reply.value("ok",false);}
    catch(const std::exception& error){result.error=error.what();}return result;
}
static std::wstring ownerEventName(const char* suffix){
    return L"Local\\YMCC-SteamStartupOwner-"+ownerSuiteToken+L"-"+std::to_wstring(ownerState->row.at("index").get<unsigned>())+L"-"+std::wstring(suffix,suffix+std::strlen(suffix));
}
struct OwnerChild {
    OwnerHandle ready,release,job,process,thread;bool assigned=false,joined=false,zero=false,forced=false;
    DWORD exitCode=STILL_ACTIVE;
    explicit OwnerChild(const char* operation){
      try{
        ready.value=::CreateEventW(nullptr,TRUE,FALSE,ownerEventName("ready").c_str());ownerNeed(ready.value&&GetLastError()!=ERROR_ALREADY_EXISTS,"fresh peer ready event");
        release.value=::CreateEventW(nullptr,TRUE,FALSE,ownerEventName("release").c_str());ownerNeed(release.value&&GetLastError()!=ERROR_ALREADY_EXISTS,"fresh peer release event");
        job.value=::CreateJobObjectW(nullptr,nullptr);ownerNeed(job.value!=nullptr,"owned peer Job");
        JOBOBJECT_EXTENDED_LIMIT_INFORMATION limits{};limits.BasicLimitInformation.LimitFlags=JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE;
        ownerNeed(::SetInformationJobObject(job.value,JobObjectExtendedLimitInformation,&limits,sizeof(limits))!=FALSE,"peer Job kill policy");
        const auto image=fixtureImage();const std::wstring op(operation,operation+std::strlen(operation));
        std::wstring command=L"\""+image+L"\" --startup-owner-lock-child \""+ownerState->root.wstring()+L"\" "+ownerSuiteToken+L" "+op;
        STARTUPINFOW startup{};startup.cb=sizeof(startup);startup.dwFlags=STARTF_USESHOWWINDOW;startup.wShowWindow=SW_HIDE;PROCESS_INFORMATION created{};
        ownerNeed(::CreateProcessW(image.c_str(),command.data(),nullptr,nullptr,FALSE,CREATE_SUSPENDED|CREATE_NO_WINDOW,nullptr,ownerState->root.c_str(),&startup,&created)!=FALSE,"exact hidden owned peer");
        process.value=created.hProcess;thread.value=created.hThread;
        if(!::AssignProcessToJobObject(job.value,process.value))throw std::runtime_error("peer Job assignment refused");
        assigned=true;ownerNeed(::ResumeThread(thread.value)!=static_cast<DWORD>(-1),"peer resume after Job assignment");
      }catch(...){const auto error=std::current_exception();collectOwned(false);std::rethrow_exception(error);}
    }
    ~OwnerChild(){if(process.value&&(!joined||!zero))collectOwned(false);}
    void collectOwned(bool requireNatural){
        if(!process.value)return;
        const auto deadline=GetTickCount64()+1800;
        const auto remaining=[&]()->DWORD{const auto now=GetTickCount64();return now<deadline?static_cast<DWORD>(deadline-now):0;};
        if(release.value)::SetEvent(release.value);
        if(!joined)joined=::WaitForSingleObject(process.value,1200)==WAIT_OBJECT_0;
        if(!joined){
            forced=true;
            if(assigned&&job.value)::TerminateJobObject(job.value,124);
            else ::TerminateProcess(process.value,125); // Exact suspended child owned by this constructor.
            joined=::WaitForSingleObject(process.value,remaining())==WAIT_OBJECT_0;
        }
        if(joined&&!::GetExitCodeProcess(process.value,&exitCode))joined=false;
        if(job.value){
            do{
                JOBOBJECT_BASIC_ACCOUNTING_INFORMATION account{};
                if(!::QueryInformationJobObject(job.value,JobObjectBasicAccountingInformation,&account,sizeof(account),nullptr))break;
                zero=account.ActiveProcesses==0;
                if(zero||!remaining())break;
                if(joined&&!forced&&remaining()<=250){forced=true;::TerminateJobObject(job.value,124);}
                ::Sleep(2);
            }while(remaining());
        }
        if(requireNatural)ownerNeed(assigned&&joined&&zero&&!forced&&exitCode==0,"natural peer exit and assigned Job zero before close");
    }
    void finish(){collectOwned(true);}
};
static void ownerInitPaths(const ownerfs::path& root,const json& row){
    ownerState=std::make_unique<OwnerState>(root,row);ownerPath(root);ownerfs::create_directory(ownerState->profile);
    const auto pc=root/L"PowerControl";ownerfs::create_directory(pc);POWER_CONTROL_DIR=pc.wstring();
    YM_SETTINGS_FILE=(pc/L"yeman-settings.json").wstring();YM_SETTINGS_BACKUP_FILE=YM_SETTINGS_FILE+L".bak";
}
static int ownerChildMain(const ownerfs::path& root,const std::wstring& token,const std::wstring& operation){
    wchar_t temp[MAX_PATH]{};const auto tempSize=::GetTempPathW(MAX_PATH,temp);
    ownerNeed(tempSize>0&&tempSize<MAX_PATH&&root.is_absolute()&&ownerBelow(temp,root)&&
        root.parent_path().filename().wstring().rfind(L"ymcc-steam-startup-owner-",0)==0,"owned temporary peer root");
    ownerRoot=root.parent_path().wstring();ownerSuiteToken=token;ownerPath(root);
    const auto authority=json::parse(ownerRaw(root/L"peer-authority.json"));
    ownerNeed(authority.at("kind")=="ymcc-steam-startup-owner-peer.v1"&&authority.at("token")==std::string(token.begin(),token.end())&&authority.at("image")==ownerfs::path(fixtureImage()).generic_string(),"peer authority tuple");
    ownerNeed(operation==L"commit-hold"||operation==L"probe-commit","exact owned peer operation");
    ownerInitPaths(root,authority.at("row"));
    OwnerHandle ready(::OpenEventW(EVENT_MODIFY_STATE,FALSE,ownerEventName("ready").c_str()));
    OwnerHandle release(::OpenEventW(SYNCHRONIZE,FALSE,ownerEventName("release").c_str()));
    ownerNeed(ready.value&&release.value,"owned peer events");
    if(operation==L"probe-commit"){
        OwnerHandle mutex(::OpenMutexW(SYNCHRONIZE|MUTEX_MODIFY_STATE,FALSE,(L"Local\\YMCC-SteamStartupOwner-"+token).c_str()));
        ownerNeed(mutex.value!=nullptr,"peer opens exact isolated mutex");const auto probe=::WaitForSingleObject(mutex.value,0);
        if(probe==WAIT_OBJECT_0||probe==WAIT_ABANDONED)::ReleaseMutex(mutex.value);
        ownerWrite(root/L"peer-probe.json",json{{"blocked",probe==WAIT_TIMEOUT}}.dump());::SetEvent(ready.value);
        {SettingsFileGuard guard;ownerChange("mode");ownerWrite(root/L"peer-committed","yes");}
    }else{
        SettingsFileGuard guard;ownerChange(authority.at("row").at("change").get<std::string>());
        ::SetEvent(ready.value);ownerNeed(::WaitForSingleObject(release.value,1500)==WAIT_OBJECT_0,"peer held lock release");
    }
    for(const auto handle:ownerSettingsMutexHandles)::CloseHandle(handle);ownerSettingsMutexHandles.clear();return 0;
}
static json ownerCase(const ownerfs::path& suite,const json& row){
    const auto root=suite/std::to_wstring(row.at("index").get<unsigned>());ownerfs::create_directory(root);ownerInitPaths(root,row);
    const auto scenario=row.at("scenario").get<std::string>(),change=row.at("change").get<std::string>();
    const auto mode=row.at("mode").get<std::string>();const bool enabled=row.at("enabled").get<bool>();
    g_exitRequested=false;g_aiFanMockSession.isolated=false;
    json document={{"schemaVersion",1},{"input",{{"revision",7},{"startupObservedBoot","owned-boot"},{"outputTarget",{{"persona","elite"}}},{"diagnostics",{{"inputLoggingEnabled",false}}}}},
        {"extensions",{{"bootModes",{{"schema",1},{"revision",3},{"current",mode},{"boot",mode}}},{"bootModesAppliedBoot","owned-boot"}}}};
    if(scenario=="preparation"||scenario=="preparation-lock-wait"){
        auto& modeDocument=document["extensions"]["bootModes"];modeDocument["bootEnabled"]=true;
        modeDocument["preparation"]={{"schema",1},{"mode",mode},{"enabled",true},{"revision",3},{"observedBoot","owned-boot"},{"status","preparing"},{"steps",{{"steam",{{"state","waiting"}}}}}};
    }
    if(change=="claim"||change=="claim-rebased"||change=="claim-current")document["extensions"]["bootModesClaimWriteId"]="original-steam-claim";
    if(scenario=="route"&&change.rfind("disabled-",0)==0)document["extensions"]["bootModes"]["bootEnabled"]=false;
    if(scenario=="route"&&change.rfind("unconfigured-",0)==0)document["extensions"]["bootModes"].erase("boot");
    ownerWrite(YM_SETTINGS_FILE,document.dump());ownerWrite(YM_SETTINGS_BACKUP_FILE,document.dump());
    const auto early=ownerState->profile/L".earlystart";const std::string custom="owned unrelated advanced command\r\n";ownerWrite(early,custom);
    ownerWrite(root/L"peer-authority.json",json{{"kind","ymcc-steam-startup-owner-peer.v1"},{"token",std::string(ownerSuiteToken.begin(),ownerSuiteToken.end())},{"image",ownerfs::path(fixtureImage()).generic_string()},{"row",row}}.dump());
    json args={{"enabled",enabled},{"repairCommand",true},{"origin","boot-mode"},{"bootContext",{{"input",document.at("input")},{"extensions",document.at("extensions")}}}};
    if(scenario=="stale-dispatch")ownerChange(change);
    if((scenario=="current"||scenario=="preparation")&&change!="none")ownerChange(change);
    if(scenario=="ordinary"){args.erase("bootContext");if(change=="absent-origin")args.erase("origin");else args["origin"]=change;}
    if(scenario=="custom-refused")args["repairCommand"]=false;
    if(scenario=="invalid"){
        if(change=="origin-invalid")args["origin"]="bad";
        if(change=="origin-type")args["origin"]=true;
        if(change=="context-without-origin")args.erase("origin");
        if(change=="ordinary-context")args["origin"]="ordinary";
        if(change=="boot-origin-without-context")args.erase("bootContext");
        if(change=="context-null")args["bootContext"]=nullptr;
        if(change=="context-extra-key")args["bootContext"]["unknown"]=true;
        if(change=="context-input-revision")args["bootContext"]["input"]["revision"]=-1;
        if(change=="context-mode-schema")args["bootContext"]["extensions"]["bootModes"]["schema"]=2;
        if(change=="enabled-type")args["enabled"]="true";
        if(change=="repair-type")args["repairCommand"]="true";
        if(change=="unknown-argument")args["unknown"]=true;
        if(change=="isolated")g_aiFanMockSession.isolated=true;
    }
    if(scenario=="exit"&&change=="before")g_exitRequested=true;
    const auto backupBefore=ownerRaw(YM_SETTINGS_BACKUP_FILE);OwnerOutcome outcome;
    std::unique_ptr<OwnerChild> peer;std::thread local,handler;std::atomic<bool> localBlocked{false},localDone{false};std::string localError,error;
    try{
        const bool async=scenario=="lock-wait"||scenario=="preparation-lock-wait"||scenario=="atomic-write"||scenario=="service-late"||(scenario=="exit"&&change=="after-write");
        if(async){
            handler=std::thread([&]{outcome=ownerInvoke(args);});
            ownerNeed(::WaitForSingleObject(ownerState->entered.value,1800)==WAIT_OBJECT_0,"selected production phase reached");
            if(scenario=="lock-wait"||scenario=="preparation-lock-wait"){
                peer=std::make_unique<OwnerChild>("commit-hold");
                ownerNeed(::WaitForSingleObject(peer->ready.value,1500)==WAIT_OBJECT_0,"cross-process new settings committed while holding mutex");
                ::SetEvent(ownerState->release.value);
                ownerNeed(::WaitForSingleObject(ownerState->probed.value,1500)==WAIT_OBJECT_0,"actual final lock contention observed");
                peer->finish();
            }else if(scenario=="atomic-write"){
                if(change=="local"){
                    local=std::thread([&]{try{
                        const bool acquired=g_settingsFileMtx.try_lock();if(acquired)g_settingsFileMtx.unlock();localBlocked=!acquired;
                        ::SetEvent(ownerState->probed.value);
                        {SettingsFileGuard guard;ownerChange("mode");ownerWrite(root/L"peer-committed","yes");}localDone=true;
                    }catch(const std::exception& ex){localError=ex.what();::SetEvent(ownerState->probed.value);}});
                    ownerNeed(::WaitForSingleObject(ownerState->probed.value,1000)==WAIT_OBJECT_0&&localBlocked.load(),"real nonrecursive local mutex blocks settings commit");
                }else{
                    peer=std::make_unique<OwnerChild>("probe-commit");
                    ownerNeed(::WaitForSingleObject(peer->ready.value,1500)==WAIT_OBJECT_0,"cross-process settings writer probed");
                    ownerNeed(json::parse(ownerRaw(root/L"peer-probe.json")).at("blocked")==true,"actual named mutex blocks settings commit");
                }
                ownerNeed(!ownerfs::exists(root/L"peer-committed"),"new settings cannot commit during actual Startup mutation");
                ::SetEvent(ownerState->release.value);
            }else if(scenario=="service-late"){
                if(change=="exit")g_exitRequested=true;
                else {SettingsFileGuard guard;ownerChange("mode");}
                ::SetEvent(ownerState->release.value);
            }else {g_exitRequested=true;::SetEvent(ownerState->release.value);}
            handler.join();if(local.joinable())local.join();if(peer&&!peer->joined)peer->finish();
            ownerNeed(localError.empty(),"local settings writer failed");if(scenario=="atomic-write"&&change=="local")ownerNeed(localDone.load(),"local writer completion");
        }else outcome=ownerInvoke(args);
        const bool accepted=scenario=="current"||scenario=="ordinary"||scenario=="atomic-write"||
            (scenario=="route"&&(change=="disabled-current"||change=="unconfigured-current"))||
            ((scenario=="preparation"||scenario=="preparation-lock-wait")&&(change=="mode"||change=="unrelated"||change=="ack"||change=="claim-current"));
        const bool routeOrClaim=scenario=="route"||change=="claim"||change=="claim-rebased"||change=="claim-current";
        if(scenario!="atomic-write")ownerNeed(outcome.ok==accepted,"actual IPC acceptance differs from selected boundary");
        if(routeOrClaim&&!accepted)ownerNeed(outcome.error=="BOOT_STEAM_STARTUP_REQUEST_EXPIRED"&&ownerState->logs==0&&ownerState->serviceReads+ownerState->serviceRepairs==0,"rejected route or claim never reaches service");
        if(scenario=="ordinary"||scenario=="invalid"||(scenario=="exit"&&change=="before"))ownerNeed(ownerState->reads==0&&ownerState->fallbackReads==0,"ordinary/invalid request must not read settings");
        ownerNeed(ownerState->fallbackReads==0,"boot write must never read fallback backup/defaults");
        ownerNeed(ownerRaw(YM_SETTINGS_BACKUP_FILE)==backupBefore,"handler preserved settings backup bytes");
        ownerNeed(ownerDefaultProfileCalls==0,"default user profile must never be queried");
        const bool fileAccepted=accepted||scenario=="service-late"||(scenario=="exit"&&change=="after-write");
        unsigned backups=0;for(const auto& entry:ownerfs::directory_iterator(ownerState->profile)){
            const auto name=entry.path().filename().wstring();
            if(name.rfind(L".earlystart.ymcc-before-",0)==0){++backups;ownerNeed(ownerRaw(entry.path())==custom,"actual Startup backup preserves exact custom bytes");}
            ownerNeed(name.rfind(L".earlystart.ymcc-",0)!=0||name.rfind(L".earlystart.ymcc-before-",0)==0,"no temporary Startup file leak");
        }
        if(fileAccepted){
            ownerNeed(backups==1,"one original custom command backup");
            // Compare using the actual Startup command, without querying defaults.
            const ymcc::steamlaunch::Startup inspect(POWER_CONTROL_DIR,fixtureImage(),fixtureProfile());
            if(enabled){std::wstring value;ownerNeed(inspect.read(value)&&value==inspect.command+L"\r\n","exact original Startup command");}
            else ownerNeed(!ownerfs::exists(early),"disabled startup removes only owned earlystart");
        }else ownerNeed(ownerRaw(early)==custom&&backups==0&&ownerState->mutations==0,"rejected request preserved file and backups");
        if(scenario=="current"||scenario=="ordinary"||((scenario=="preparation"||scenario=="preparation-lock-wait")&&accepted))ownerNeed(ownerState->logs==1&&ownerState->serviceReads+ownerState->serviceRepairs==1,"current request has one memory service completion/log");
        if(scenario=="stale-dispatch"||scenario=="lock-wait"||scenario=="invalid"||scenario=="custom-refused"||scenario=="exit")
            ownerNeed(ownerState->logs==0&&ownerState->serviceReads+ownerState->serviceRepairs==0,"rejected/exit request has no late service/log");
        if(scenario=="service-late")ownerNeed(!outcome.ok&&ownerState->logs==0&&ownerState->serviceReads+ownerState->serviceRepairs==1,"late service completion cannot publish old success");
        if(scenario=="lock-wait"||scenario=="preparation-lock-wait")ownerNeed(ownerState->contended.load(),"actual named mutex contention evidence");
    }catch(const std::exception& ex){error=ex.what();::SetEvent(ownerState->release.value);if(peer)::SetEvent(peer->release.value);if(handler.joinable())handler.join();if(local.joinable())local.join();if(peer&&!peer->joined){try{peer->finish();}catch(const std::exception& finish){error+=";peer cleanup:"+std::string(finish.what());}}}
    g_exitRequested=false;g_aiFanMockSession.isolated=false;
    return {{"selection",row},{"status",error.empty()?"PASS":"FAIL"},{"error",error},{"handlerOk",outcome.ok},{"handlerError",outcome.error},
        {"settingsReads",ownerState->reads.load()},{"fallbackReads",ownerState->fallbackReads.load()},{"startupMutationPorts",ownerState->mutations.load()},
        {"serviceReads",ownerState->serviceReads.load()},{"serviceRepairs",ownerState->serviceRepairs.load()},{"logs",ownerState->logs.load()},
        {"defaultProfileQueries",ownerDefaultProfileCalls},{"crossProcess",peer!=nullptr},{"peerAssigned",peer?peer->assigned:false},
        {"peerNaturalExit",peer?peer->joined&&!peer->forced&&peer->exitCode==0:false},{"peerJoined",peer?peer->joined:false},
        {"peerExitCode",peer?json(peer->exitCode):json(nullptr)},{"peerJobZeroBeforeClose",peer?peer->zero:false},{"peerForced",peer?peer->forced:false},
        {"runtimeRoot",root.generic_string()},{"realSteamActions",0},{"installedSettingsWrites",0}};
}
int wmain(int argc,wchar_t** argv){
    try{
        if(argc==5&&std::wstring(argv[1])==L"--startup-owner-lock-child"){
            const auto code=ownerChildMain(argv[2],argv[3],argv[4]);return code;
        }
        if((argc!=3&&argc!=5)||std::wstring(argv[1])!=L"--startup-owner-only")return 2;
        wchar_t temp[MAX_PATH]{};const auto tempSize=::GetTempPathW(MAX_PATH,temp);ownerNeed(tempSize>0&&tempSize<MAX_PATH,"temporary root");
        const ownerfs::path root=ownerfs::absolute(argv[2]).lexically_normal();
        ownerNeed(ownerBelow(temp,root)&&root.filename().wstring().rfind(L"ymcc-steam-startup-owner-",0)==0&&
            ownerLower(root.wstring())!=ownerLower(ownerfs::path(temp).wstring())&&!ownerfs::exists(root),"fresh owned temporary run root required");
        ownerNeed(!ownerBelow(root,ownerfs::path(root.wstring()+L"-sibling"))&&!ownerBelow(root,root.parent_path()),"owned path sibling and parent remain rejected");
        const auto allSelection=startupOwnerSelection();auto selection=allSelection;
        if(argc==5){
            const auto requested=std::wstring(argv[4]);
            ownerNeed(std::wstring(argv[3])==L"--case-index"&&!requested.empty()&&requested.size()<=9&&
                requested.find_first_not_of(L"0123456789")==std::wstring::npos,"exact positive case index required");
            const auto index=std::stoul(requested);selection=json::array();
            for(const auto& row:allSelection)if(row.at("index").get<unsigned>()==index)selection.push_back(row);
            ownerNeed(selection.size()==1,"unknown or empty startup owner selection");
        }
        ownerRoot=root.wstring();ownerNeed(ownerfs::create_directory(root),"exclusive owned run directory");ownerPath(root);
        ownerSuiteToken=std::to_wstring(GetCurrentProcessId())+L"-"+std::to_wstring(GetTickCount64());
        registerStartupOwnerHandler();json results=json::array();bool okay=true;
        for(const auto& row:selection){auto result=ownerCase(root,row);okay=result.at("status")=="PASS";results.push_back(std::move(result));if(!okay)break;}
        for(const auto handle:ownerSettingsMutexHandles)::CloseHandle(handle);ownerSettingsMutexHandles.clear();
        const json report={{"suite","Steam native launch / explicit startup owner only"},{"status",okay?"PASS":"FAIL"},
            {"selected",selection},{"results",results},{"executed",results.size()},{"availableCases",allSelection.size()},
            {"wholeOwnerSuite",argc==3},{"pathSiblingAndParentRejected",true},{"defaultCasesExecuted",0},{"realSteamActions",0},{"installedSettingsWrites",0},{"bootIdentityQueries",0}};
        ownerWrite(root/L"result.json",report.dump(2));std::cout<<report.dump(2)<<std::endl;return okay?0:23;
    }catch(const std::exception& error){std::cerr<<"FAIL startup-owner-only "<<error.what()<<std::endl;return 23;}
}
#else
#error Explicit YMCC_STEAM_STARTUP_OWNER_SOURCE preparation required
#endif

struct OwnerState {
    ownerfs::path root,profile;json row;
    std::atomic<unsigned> reads{0},fallbackReads{0},waits{0},serviceReads{0},serviceRepairs{0},logs{0},mutations{0};
    std::atomic<bool> armed{true},contended{false};
    OwnerHandle entered{::CreateEventW(nullptr,TRUE,FALSE,nullptr)},release{::CreateEventW(nullptr,TRUE,FALSE,nullptr)},probed{::CreateEventW(nullptr,TRUE,FALSE,nullptr)};
    explicit OwnerState(ownerfs::path p,json r):root(std::move(p)),profile(root/L"profile"),row(std::move(r)){
        ownerNeed(entered.value&&release.value&&probed.value,"owner event creation");
    }
};
static std::unique_ptr<OwnerState> ownerState;
static unsigned ownerDefaultProfileCalls=0;
static std::wstring ownerLower(std::wstring value){for(auto& c:value)c=std::towlower(c);return value;}
static bool ownerBelow(const ownerfs::path& base,const ownerfs::path& value){
    const auto normalized=[](const ownerfs::path& input){
        const auto absolute=ownerfs::absolute(input).lexically_normal();auto text=ownerLower(absolute.wstring());
        const auto rootSize=absolute.root_path().wstring().size();
        while(text.size()>rootSize&&(text.back()==L'\\'||text.back()==L'/'))text.pop_back();return text;
    };
    const auto a=normalized(base),b=normalized(value);
    return b==a||(b.size()>a.size()&&b.compare(0,a.size(),a)==0&&
        ((a.back()==L'\\'||a.back()==L'/')||(b[a.size()]==L'\\'||b[a.size()]==L'/')));
}
static void ownerPath(const ownerfs::path& path){
    ownerNeed(path.is_absolute()&&ownerBelow(ownerRoot,path),"foreign fixture path");
    auto cursor=path.lexically_normal();
    for(;;){
        const auto attr=::GetFileAttributesW(cursor.c_str());
        ownerNeed(attr==INVALID_FILE_ATTRIBUTES||!(attr&FILE_ATTRIBUTE_REPARSE_POINT),"fixture reparse path");
        if(ownerLower(cursor.wstring())==ownerLower(ownerfs::path(ownerRoot).wstring()))break;
        const auto parent=cursor.parent_path();ownerNeed(parent!=cursor&&ownerBelow(ownerRoot,parent),"fixture path parent");cursor=parent;
    }
}
static std::string ownerRaw(const ownerfs::path& file){
    ownerPath(file);std::ifstream input(file,std::ios::binary);
    ownerNeed(static_cast<bool>(input),"owned file read failed");
    std::string value((std::istreambuf_iterator<char>(input)),{});
    ownerNeed(value.size()<=1024u*1024u,"owned file size");return value;
}
static void ownerWrite(const ownerfs::path& file,const std::string& value){
    ownerPath(file);const auto temporary=ownerfs::path(file.wstring()+L".fixture-tmp-"+std::to_wstring(GetCurrentThreadId()));
    ownerPath(temporary);OwnerHandle handle(::CreateFileW(temporary.c_str(),GENERIC_WRITE,0,nullptr,CREATE_NEW,FILE_ATTRIBUTE_NORMAL,nullptr));
    ownerNeed(handle.value!=INVALID_HANDLE_VALUE,"owned atomic write open");DWORD wrote=0;
    ownerNeed(value.size()<=1024u*1024u&&::WriteFile(handle.value,value.data(),static_cast<DWORD>(value.size()),&wrote,nullptr)&&wrote==value.size()&&::FlushFileBuffers(handle.value),"owned atomic write");
    ::CloseHandle(handle.value);handle.value=nullptr;
    ownerNeed(::MoveFileExW(temporary.c_str(),file.c_str(),MOVEFILE_REPLACE_EXISTING|MOVEFILE_WRITE_THROUGH),"owned atomic replace");
}
static void ownerPause(const char* point){
    const auto scenario=ownerState->row.at("scenario").get<std::string>();
    const auto change=ownerState->row.at("change").get<std::string>();
    const bool selected=((scenario=="lock-wait"||scenario=="preparation-lock-wait")&&std::string(point)=="before-final-wait")||
        (scenario=="atomic-write"&&std::string(point)=="startup-mutation")||
        (scenario=="service-late"&&std::string(point)=="service")||
        (scenario=="exit"&&change=="after-write"&&std::string(point)=="startup-written");
    if(!selected||!ownerState->armed.exchange(false))return;
    ownerNeed(::SetEvent(ownerState->entered.value)!=FALSE,"signal owner pause");
    ownerNeed(::WaitForSingleObject(ownerState->release.value,1500)==WAIT_OBJECT_0,"owner pause deadline");
}
static HANDLE ownerCreateMutex(LPSECURITY_ATTRIBUTES sa,BOOL initial,LPCWSTR name){
    ownerNeed(!sa&&!initial&&name&&std::wstring(name)==L"Local\\YeManCC-UnifiedSettings","unexpected production mutex terminal");
    const auto isolated=L"Local\\YMCC-SteamStartupOwner-"+ownerSuiteToken;
    HANDLE value=::CreateMutexW(nullptr,FALSE,isolated.c_str());if(value)ownerSettingsMutexHandles.push_back(value);return value;
}
static BOOL ownerClose(HANDLE value){
    const auto found=std::find(ownerSettingsMutexHandles.begin(),ownerSettingsMutexHandles.end(),value);
    if(found!=ownerSettingsMutexHandles.end())ownerSettingsMutexHandles.erase(found);
    return ::CloseHandle(value);
}
static DWORD ownerWait(HANDLE value,DWORD timeout){
    const auto ordinal=++ownerState->waits;
    if((ownerState->row.at("scenario")=="lock-wait"||ownerState->row.at("scenario")=="preparation-lock-wait")&&ordinal==2){
        ownerPause("before-final-wait");
        ownerNeed(::WaitForSingleObject(value,0)==WAIT_TIMEOUT,"actual named mutex must be contended");
        ownerState->contended=true;::SetEvent(ownerState->probed.value);
    }
    return ::WaitForSingleObject(value,timeout);
}
static HANDLE ownerCreateFile(LPCWSTR name,DWORD access,DWORD share,LPSECURITY_ATTRIBUTES sa,DWORD disposition,DWORD flags,HANDLE model){
    ownerNeed(name&&!sa&&!model,"unexpected Startup file terminal");ownerPath(name);
    if(access&GENERIC_WRITE){++ownerState->mutations;ownerPause("startup-mutation");}
    return ::CreateFileW(name,access,share,sa,disposition,flags,model);
}
static DWORD ownerAttributes(LPCWSTR name){ownerPath(name);return ::GetFileAttributesW(name);}
static BOOL ownerAttributesEx(LPCWSTR name,GET_FILEEX_INFO_LEVELS level,LPVOID data){ownerPath(name);return ::GetFileAttributesExW(name,level,data);}
static BOOL ownerCopy(LPCWSTR from,LPCWSTR to,BOOL fail){
    ownerPath(from);ownerPath(to);ownerNeed(fail!=FALSE,"backup must not replace");++ownerState->mutations;ownerPause("startup-mutation");return ::CopyFileW(from,to,fail);
}
static BOOL ownerDelete(LPCWSTR name){
    ownerPath(name);++ownerState->mutations;ownerPause("startup-mutation");const auto ok=::DeleteFileW(name);
    if(ok&&ownerfs::path(name).filename()==L".earlystart")ownerPause("startup-written");return ok;
}
static BOOL ownerMove(LPCWSTR from,LPCWSTR to,DWORD flags){
    ownerPath(from);ownerPath(to);const auto ok=::MoveFileExW(from,to,flags);
    if(ok&&ownerfs::path(to).filename()==L".earlystart")ownerPause("startup-written");return ok;
}
static std::wstring fixtureProfile(){ownerPath(ownerState->profile);return ownerState->profile.wstring();}
static std::wstring fixtureImage(){std::vector<wchar_t> bytes(32768);const auto size=::GetModuleFileNameW(nullptr,bytes.data(),static_cast<DWORD>(bytes.size()));ownerNeed(size&&size<bytes.size(),"fixture image path");return {bytes.data(),size};}

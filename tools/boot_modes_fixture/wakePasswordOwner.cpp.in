#define NOMINMAX
#include <windows.h>
#include <objbase.h>
#include <atomic>
#include <chrono>
#include <fstream>
#include <functional>
#include <future>
#include <iostream>
#include <map>
#include <memory>
#include <mutex>
#include <string>
#include <thread>
#include <type_traits>
#include <vector>
#include "settings_baseline.h"
#include "boot_mode_preferences.h"
#include "sleep_wake_password.h"
#include "sleep_power_revocation.h"
using json=nlohmann::json;
using namespace ymcc::sleep_wake_password;
static json document,powerResult;
static std::mutex settingsMx;
static const std::wstring YM_SETTINGS_FILE=L"owned-memory/wake-password-settings.json";
struct SettingsFileGuard {std::lock_guard<std::mutex> lock{settingsMx};};
static std::atomic<unsigned> settingsReads{0};
static unsigned preferenceWrites=0;
static bool preferenceFailure=false,fixtureEnable=true;
static bool failureOnlySelected=false;
static std::string failureFault;
static std::vector<std::string> failureTrace;
static std::function<void()> unusedOwnerRead;
static std::string stage,change;
static bool changed=false;
static std::vector<std::string> effects;
static std::size_t atChange=0;
static ymcc::sleeppower::SharedPowerV1 fixturePower;
static ymcc::sleeppower::RevocationMirrors fixtureRevocations;
static std::string powerStage,powerChange;
static int __cdecl readFixturePower(ymcc::sleeppower::SharedPowerV1* out,std::uint32_t size){
 if(!out||size!=sizeof(fixturePower))return 0;*out=fixturePower;return 1;
}
static bool captureSharedPowerLifecycle(ymcc::sleeppower::SharedPowerV1& out){return ymcc::sleeppower::capturePower(&readFixturePower,out);}
static bool sharedPowerLifecycleCurrent(const ymcc::sleeppower::SharedPowerV1& power){return ymcc::sleeppower::powerCurrent(&readFixturePower,power);}
static auto observeSharedPowerRevocation(const ymcc::sleeppower::SharedPowerV1& power){return fixtureRevocations.observe(&readFixturePower,power);}
static void mutate(){
 if(changed)return;SettingsFileGuard held;changed=true;atChange=effects.size();
 if(change=="revision")document["input"]["revision"]=8;
 if(change=="hash")document["input"]["diagnostics"]["inputLoggingEnabled"]=!document["input"]["diagnostics"]["inputLoggingEnabled"].get<bool>();
 if(change=="mode")document["extensions"]["bootModes"]["revision"]=4;
 if(change=="result")document["extensions"]["bootModesStartupResult"]={{"schema",1},{"revision",99}};
 if(change=="observed")document["input"]["startupObservedBoot"]="replacement-boot";
 if(change=="ack")document["input"]["hostAcknowledgedRevision"]=17;
 if(change=="unrelated")document["extensions"]["peer"]=true;
}
static void boundary(const std::string& name){
 if(failureOnlySelected&&(name.rfind("read",0)==0||name.rfind("write",0)==0||name=="query"||name=="activate"))failureTrace.push_back(name);
 if(stage==name)mutate();
 if(powerStage!=name)return;
 atChange=effects.size();
 if(powerChange=="generation")++fixturePower.generation;
 else if(powerChange=="notification")++fixturePower.observedNotificationSequence;
 else if(powerChange=="pending")fixturePower.flags|=ymcc::sleeppower::kNotificationPending;
 else if(powerChange=="publication")++fixturePower.publicationRevision;
 else if(powerChange=="revocation")fixtureRevocations.revoke();
}
static std::string ymSettingsReadRaw(const std::wstring& path){if(path!=YM_SETTINGS_FILE)throw std::runtime_error("Unexpected settings path");++settingsReads;return document.dump();}
static std::atomic<unsigned> contentionCount{0};
static std::function<void()> onContention;
struct ObservedOwnerLock {
 std::unique_lock<std::mutex> lock;
 explicit ObservedOwnerLock(std::mutex& mutex):lock(mutex,std::defer_lock){if(!lock.try_lock()){++contentionCount;if(onContention)onContention();lock.lock();}}
};
// ORIGINAL_OWNER
static bool ymSettingsWriteSection(const char* name,const json& patch,const std::function<bool(json&,json&)>& prepare,const std::function<bool()>& commitCurrent={}){
 if(std::string(name)!="sleep")throw std::runtime_error("Unexpected settings section");
 boundary("save-prepare");bool saved=false;
 {SettingsFileGuard held;auto next=document;auto section=next.value("sleep",json::object());section.update(patch);if(prepare(section,next)&&!preferenceFailure){boundary("save-commit");if(!commitCurrent||commitCurrent()){next["sleep"]=section;document=next;++preferenceWrites;effects.push_back("preference-write");saved=true;}}}
 boundary("save-return");return saved;
}
struct CachePreference {std::atomic<bool> value{false};void store(bool on,std::memory_order order){value.store(on,order);effects.push_back("preference-cache");}bool load()const{return value.load();}};
static CachePreference g_wakePasswordPreference;
struct HardwareWriteLease {explicit HardwareWriteLease(const char*){boundary("lease");}};
// ORIGINAL_CHECK_AND_GUID
// ORIGINAL_FAKE_POWER_API
namespace ymcc::sleep_wake_password {
// INSTRUMENTED_FAKE_POWER_API
static_assert(std::is_constructible_v<FixturePowerApi,const std::function<bool()>&>);
}
static std::map<std::string,std::function<json(const json&)>> handlers;
static void ipc_on(const std::string& name,std::function<json(const json&)> callback){handlers[name]=std::move(callback);}
#define WindowsPowerApi FixturePowerApi
// ORIGINAL_REGISTRATION
#undef WindowsPowerApi
static json legacyControls(){
// ORIGINAL_LEGACY_CONTROLS
 return cases;
}
static void reset(const json& defaults,const json& wire,bool enable){
 document=defaults;document["input"]=wire.at("expectedBootContext").at("input");document["extensions"]=wire.at("expectedBootContext").at("extensions");
 fixtureEnable=enable;document["sleep"]["wakePasswordEnabled"]=!enable;g_wakePasswordPreference.value.store(!enable);
 effects.clear();failureTrace.clear();atChange=0;powerResult=nullptr;changed=false;settingsReads=preferenceWrites=0;preferenceFailure=false;unusedOwnerRead=nullptr;contentionCount=0;onContention=nullptr;
 fixturePower={};fixturePower.generation=41;fixturePower.observedNotificationSequence=8;fixturePower.flags=ymcc::sleeppower::kKnown|ymcc::sleeppower::kHardwareAllowed;
 powerStage.clear();powerChange.clear();
}
static json runOne(const json& request){return handlers.at("power.wakePassword.set")(request);}
// ORIGINAL_REGISTRY_CASES
// ORIGINAL_FAILURE_CASES
int main(int argc,char** argv){
 json rows=json::array(),controls=json::array();
 try{
  check(argc==5,"defaults, wire, selection, raw required");json defaults,wire;std::ifstream(argv[1])>>defaults;std::ifstream(argv[2])>>wire;const bool before=std::string(argv[3])=="before",mutexOnly=std::string(argv[3])=="mutex";
  registerWakePassword();
#if defined(YMCC_WAKE_PASSWORD_REGISTRY_CASES)
  if(std::string(argv[3])=="registry"||std::string(argv[3])=="registry-control"){
   runRegistryCases(defaults,wire,std::string(argv[3])=="registry-control",argv[4],rows,controls);
   std::cout<<json{{"status","PASS"},{"rows",rows},{"controls",controls}}.dump()<<'\n';return 0;
  }
#endif
#if defined(YMCC_WAKE_PASSWORD_FAILURE_CASES)
  if(std::string(argv[3])=="failures"||std::string(argv[3])=="failure-negative"){
   failureOnlySelected=true;runFailureCases(defaults,wire,std::string(argv[3])=="failure-negative",argv[4],rows,controls);
   std::cout<<json{{"status","PASS"},{"rows",rows},{"controls",controls}}.dump()<<'\n';return 0;
  }
#endif
  const std::vector<std::string> stages={"dispatch","mutex","lease","read1","read2","write1","write2","read3","read4","query","activate","read5","read6","save-prepare","save-return"};
  const std::vector<std::string> kinds={"revision","hash","mode","result","observed","ack","unrelated","current"};
  std::ofstream raw(argv[4],std::ios::app);
  for(const auto& entry:wire.at("modes"))for(const bool enable:{true,false})for(const auto& nextStage:stages)for(const auto& kind:kinds){
   if(mutexOnly&&nextStage!="mutex")continue;
   if(before&&(entry.at("mode")!="global"||!enable||nextStage!="read1"||kind!="hash"))continue;
   reset(defaults,entry,enable);stage=nextStage;change=kind;const bool allowed=kind=="ack"||kind=="unrelated"||kind=="current";
   json request=entry.at("request");request["enabled"]=enable;if(before)request["bootContext"]=entry.at("expectedBootContext");
   json result;std::string error;
   auto invoke=[&]{try{if(stage=="dispatch")mutate();result=runOne(request);}catch(const std::exception& e){error=e.what();}};
   if(stage=="mutex"){
    std::unique_lock<std::mutex> held(transactionMutex);std::promise<void> entered;auto ready=entered.get_future();onContention=[&]{entered.set_value();};
    std::thread worker(invoke);const bool reached=ready.wait_for(std::chrono::seconds(1))==std::future_status::ready;
    if(reached)mutate();held.unlock();worker.join();onContention=nullptr;check(reached&&contentionCount==1,"Actual native mutex contention was not observed");
   }else invoke();
   const std::vector<std::string> late(effects.begin()+static_cast<std::ptrdiff_t>(atChange),effects.end());
   json row={{"mode",entry.at("mode")},{"enabled",enable},{"stage",stage},{"contentionCount",contentionCount.load()},{"workerJoined",stage=="mutex"},{"kind",kind},{"allowed",allowed},{"changed",changed},{"error",error},{"reply",result},{"lateEffects",late},{"power",powerResult},{"settingsReads",settingsReads.load()},{"preferenceWrites",preferenceWrites},{"cached",g_wakePasswordPreference.load()}};
   raw<<row.dump()<<'\n';raw.flush();rows.push_back(row);check(changed,"Selected wake-password boundary not reached");
   if(allowed){check(error.empty()&&result.value("ok",false)&&result.value("preferenceSaved",false),"Current wake-password request failed");check(g_wakePasswordPreference.load()==enable,"Current wake-password preference cache mismatch");}
   else{check(late.empty(),"expired wake-password request reached later effect");check(error=="BOOT_WAKE_PASSWORD_REQUEST_EXPIRED","Expired wake-password reply not refused");}
  }
  if(!before&&!mutexOnly){
   stage.clear();change="current";const auto ownerBefore=settingsReads.load();const auto original=legacyControls();check(settingsReads.load()==ownerBefore,"Ordinary algorithm gained owner reads");controls.push_back({{"name","original-ordinary-algorithm"},{"cases",original}});
   for(const bool enable:{true,false}){reset(defaults,wire.at("modes").at(0),enable);auto request=wire.at("ordinary");request["enabled"]=enable;const auto result=runOne(request);check(result.value("ok",false)&&settingsReads==0,"Ordinary native call gained owner reads");controls.push_back({{"name",enable?"ordinary-on":"ordinary-off"},{"ownerReads",0}});}
   reset(defaults,wire.at("modes").at(0),true);auto request=wire.at("modes").at(0).at("request");request["bootContext"]={{"input",json::object()}};bool refused=false;try{runOne(request);}catch(...){refused=true;}check(refused&&effects.empty(),"Invalid context reached native write");controls.push_back({{"name","invalid-context-no-effect"}});
   reset(defaults,wire.at("modes").at(0),true);request=wire.at("modes").at(0).at("request");request["origin"]="ordinary";refused=false;try{runOne(request);}catch(...){refused=true;}check(refused&&effects.empty(),"Invalid origin reached native write");controls.push_back({{"name","ordinary-context-refused"}});
   reset(defaults,wire.at("modes").at(0),true);preferenceFailure=true;const auto failed=runOne(wire.at("modes").at(0).at("request"));check(failed.value("ok",false)&&!failed.value("preferenceSaved",true)&&!g_wakePasswordPreference.load(),"Failed preference save published remembered state");controls.push_back({{"name","scoped-save-failure-no-cache"}});
  }
  json publicRows=json::array();
  if(!before&&!mutexOnly){
   stage.clear();
   const auto& mode=wire.at("modes").at(0);
   for(const auto& cut:std::vector<std::pair<std::string,std::string>>{{"dispatch","generation"},{"dispatch","notification"},{"dispatch","pending"},{"lease","notification"},{"write1","generation"},{"write1","revocation"},{"write1","publication"},{"activate","notification"},{"save-prepare","pending"},{"save-commit","generation"}}){
    reset(defaults,mode,true);powerStage=cut.first;powerChange=cut.second;auto request=mode.at("request");
    if(powerStage=="dispatch")boundary("dispatch");
    std::string error;json reply;
    try{reply=runOne(request);}catch(const std::exception& e){error=e.what();}
    const auto late=std::vector<std::string>(effects.begin()+static_cast<std::ptrdiff_t>(atChange),effects.end());
    json row={{"stage",powerStage},{"change",powerChange},{"error",error},{"late",late},{"preferenceWrites",preferenceWrites},{"indices",powerResult}};
    publicRows.push_back(row);raw<<row.dump()<<'\n';
    if(powerChange=="publication")check(error.empty()&&reply.value("ok",false)&&preferenceWrites==1,"Healthy publication cancelled password request");
    else{
     check(error=="WAKE_PASSWORD_POWER_ADMISSION_EXPIRED"&&late.empty()&&preferenceWrites==0,"Expired public admission reached a later effect");
     if(powerStage=="write1")check(powerResult.at("ac")==1&&powerResult.at("dc")==0&&powerResult.at("writes")==1,"Completed AC write was unexpectedly undone or followed by DC");
    }
   }
   for(const bool partial:{false,true}){
    reset(defaults,mode,true);auto request=wire.at("ordinary");request.erase("expectedPowerNotificationSequence");if(!partial)request.erase("expectedPowerGeneration");
    std::string error;try{runOne(request);}catch(const std::exception& e){error=e.what();}
    check(error=="WAKE_PASSWORD_INVALID_POWER_ADMISSION"&&effects.empty(),"Missing public token reached native action");
    json row={{"stage","dispatch"},{"change",partial?"partial":"missing"},{"error",error},{"late",effects}};publicRows.push_back(row);raw<<row.dump()<<'\n';
   }
  }
  std::cout<<json{{"status","PASS"},{"rows",rows},{"controls",controls},{"publicRows",publicRows}}.dump()<<'\n';return 0;
 }catch(const std::exception& e){std::cout<<json{{"status","FAIL"},{"error",e.what()},{"rows",rows},{"controls",controls}}.dump()<<'\n';return 1;}
}

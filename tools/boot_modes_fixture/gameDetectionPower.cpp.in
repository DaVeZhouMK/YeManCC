
static void requireGamePower(bool ok,const char* message){if(!ok)throw std::runtime_error(message);}
static void resetGamePower(){ports::s=ports::State{};ports::s.candidate.pid=7;ports::s.candidate.processCreated=700;ports::s.candidate.path=L"C:\\Games\\bluey.exe";ports::s.candidate.name=L"bluey";ports::s.candidate.whitelisted=true;ports::s.candidate.whitelistRule=L"bluey";ports::s.process=ports::s.candidate;g_gameValveTarget={};g_gameValveGeneration=500;g_gameValveTarget.generation=500;g_gameValveTarget.identityGeneration=500;g_gameValveTarget.discoveryState=NativeGameDiscoveryState::Complete;g_gameValvePublishedGeneration=0;g_gameValveObservation.store(nullptr);g_hardwareWriteGate.store(true);focusRemembered=0;}
static void revokeGamePower(const std::string& kind){if(kind=="publication-only"){g_sharedPowerPublicationRevision.fetch_add(1);return;}if(kind=="same-fact"){g_sharedPowerRevocations.revoke();return;}const auto receipt=g_sleepPowerDispatch.window(PBT_APMQUERYSUSPEND,::GetTickCount64());requireGamePower(!hardwareWriteAllowed(),"query-suspend did not revoke original public owner");g_sleepPowerDispatch.complete(receipt,::GetTickCount64());requireGamePower(hardwareWriteAllowed(),"same generation Ready not restored by original Dispatch");}
int main(int argc,char** argv){json rows=json::array();try{registerDetection();const std::vector<std::string> names={"zero-sequence","current","deny-start","stale-generation","stale-sequence","scan-auto","scan-preferred","rules-failure","same-fact","publication-only","legacy-current","malformed","repeat-unavailable"};std::string selection=argc>2?argv[2]:"power:all";requireGamePower(selection.rfind("power:",0)==0,"invalid original native group");selection=selection.substr(6);for(const auto& name:names){if(selection!="all"&&selection!=name)continue;resetGamePower();ymcc::sleeppower::SharedPowerV1 captured;requireGamePower(captureSharedPowerLifecycle(captured),"initial capture unavailable");json args={{"automatic",true},{"expectedPowerGeneration",captured.generation},{"expectedPowerNotificationSequence",captured.observedNotificationSequence}};bool deny=false;
 if(name=="zero-sequence")requireGamePower(captured.observedNotificationSequence==0,"zero sequence needs original first native case");
 if(name=="deny-start"){g_hardwareWriteGate.store(false);deny=true;}
 if(name=="stale-generation"){args["expectedPowerGeneration"]=captured.generation+1;deny=true;}
 if(name=="stale-sequence"){args["expectedPowerNotificationSequence"]=captured.observedNotificationSequence+1;deny=true;}
 if(name=="legacy-current")args=json::object();
 if(name=="scan-preferred"){args["pid"]=7;args["automatic"]=false;}
 if(name=="rules-failure"){ports::s.rulesError=1;ports::s.point=ports::Point::Rules;ports::s.hook=[&]{revokeGamePower("query");};deny=true;}
 if(name=="scan-auto"||name=="scan-preferred"||name=="same-fact"||name=="publication-only"){ports::s.point=ports::Point::Scan;ports::s.hook=[&]{revokeGamePower(name);};deny=name!="publication-only";}
 const auto before=g_gameValveTarget.generation;bool rejected=false;json reply;
 if(name=="repeat-unavailable"){ports::s.rulesError=1;const auto first=commands.at("game.detect")(args);const auto firstGeneration=g_gameValveTarget.generation;const auto second=commands.at("game.detect")(args);requireGamePower(first.value("observationState",std::string{})=="unavailable"&&second.value("observationState",std::string{})=="unavailable"&&g_gameValveTarget.generation==firstGeneration&&ports::s.publications==1,"unchanged unavailable rules advanced original target generation");}
 else if(name=="malformed"){for(const auto& bad:std::vector<json>{nullptr,true,"1",-1,.5,9007199254740992ULL}){auto invalid=args;invalid["expectedPowerNotificationSequence"]=bad;bool caught=false;try{commands.at("game.detect")(invalid);}catch(const std::exception&){caught=true;}requireGamePower(caught,"malformed power selector reached native game action");}auto missing=json{{"expectedPowerNotificationSequence",0}};try{commands.at("game.detect")(missing);}catch(const std::exception&){rejected=true;}requireGamePower(rejected&&ports::s.scans==0&&g_gameValveTarget.generation==before,"malformed power admission mutated valve");}
 else{try{reply=commands.at("game.detect")(args);}catch(const std::exception&){rejected=true;}if(deny){requireGamePower(rejected,"revoked public game request accepted");requireGamePower(g_gameValveTarget.generation==before&&ports::s.publications==0&&focusRemembered==0,"revoked public game request mutated target");}else{requireGamePower(!rejected&&reply.value("pid",0u)==7,"current public game request rejected");requireGamePower(g_gameValveTarget.generation>before&&ports::s.publications==1&&focusRemembered==1,"current game request missing original publication");}}
 requireGamePower(powerHandles.empty()&&powerOpens==powerCloses,"public game registration handle remained live");rows.push_back({{"name",name},{"rejected",rejected},{"scans",ports::s.scans},{"publications",ports::s.publications},{"focusRemembered",focusRemembered},{"powerEventsOpened",powerOpens},{"powerEventsClosed",powerCloses},{"handlesAtReturn",powerHandles.size()}});if(argc>3){std::ofstream log(argv[3],std::ios::app);log<<rows.back().dump()<<'\n';}}
 requireGamePower(!rows.empty(),"unknown native game power selection");std::cout<<json{{"status","PASS"},{"rows",rows},{"actualHandler",true},{"actualValve",true},{"actualSharedRevocation",true},{"realGameOrPowerActions",0}}.dump();return 0;}catch(const std::exception& e){if(rows.empty()){std::string selection=argc>2?argv[2]:"power:all";rows.push_back({{"name",selection.substr(6)}});}std::cout<<json{{"status","FAIL"},{"rows",rows},{"error",e.what()}}.dump();return 1;}}

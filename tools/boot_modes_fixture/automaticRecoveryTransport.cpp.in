using Json=nlohmann::json;
inline constexpr const char *kScript="ownedFixture",*kLightGamepadScript="ownedFixture",*kUiModeScript="ownedFixture";
struct SteamProcessLease {
 bool bound=false;
 bool bind(const steamsession::Session& expected){return bound=expected.pid==501&&expected.created==502&&expected.root==L"owned-steam"&&expected.account==42;}
 bool current()const{return bound;}
};
static std::vector<Endpoint> listeners(const std::wstring&,DWORD expected){listenersource::checkpoint();need(expected==501,"bound session pid was dropped");return {{601,8000,L"127.0.0.1"}};}
static bool stillOwned(const std::wstring&,const Endpoint&,DWORD expected){return expected==501;}
// ORIGINAL_TRANSPORT
}
static json steamLiveRequest(DWORD account,json request,const std::function<bool()>& admit={},const std::function<bool()>& current={},ymcc::steamcommand::Disposition* disposition=nullptr){
 const auto proof=request.at("sleepSessionProcess");
 ymcc::steamsession::Session expected;expected.account=account;expected.pid=proof.at("pid").get<DWORD>();expected.created=std::stoull(proof.at("created").get<std::string>());const auto root=proof.at("root").get<std::string>();expected.root.assign(root.begin(),root.end());
 request["account"]=account;
 const auto run=sourceMutation?ymcc::steamlive::runLeaky:ymcc::steamlive::run;
 return run(expected.root,request,admit,0,current,&expected,disposition,ymcc::steamlive::ModeTransportWait::Immediate,nullptr);
}
static std::string W2U(const std::wstring& text){return std::string(text.begin(),text.end());}
static bool focusQueryProcessIdentity(DWORD pid,std::wstring* path,ULONGLONG* created){if(path)*path=L"owned-game.exe";if(created)*created=5678;return pid==1234;}
static void sgRecordFact(const char*,const json&){}
namespace SleepSteamRecovery {
using namespace ymcc::sleeprecovery;
using ymcc::sleeprecovery::decimal;
static bool unsignedDecimal(const std::string& value,std::uint64_t& out){unsigned long long n=0;const bool ok=decimal(value,n);out=n;return ok;}

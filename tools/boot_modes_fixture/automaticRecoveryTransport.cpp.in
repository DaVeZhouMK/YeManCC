using json=nlohmann::json;
enum class PowerLifecycle{Ready,Resuming,Suspending,Suspended};
static std::atomic<bool> g_exitRequested{false},g_sleepRecoveryAutoEnabled{true};
static std::atomic<unsigned long long> g_powerGeneration{7},g_sleepRecoveryAutoConfigEpoch{5};
static std::atomic<PowerLifecycle> g_powerLifecycle{PowerLifecycle::Ready};
// ORIGINAL_NATIVE_POWER
static bool sleepSteamWakeOperationAllows(unsigned long long generation,unsigned long long epoch){return sleepSteamRecoveryAllows(generation,epoch)&&g_powerLifecycle==PowerLifecycle::Ready;}
static bool sourceMutation=false;
static std::string cancellation,position;
static std::atomic<unsigned> sends{0},opens{0},closes{0},doubleCloses{0},watchdogsJoined{0};
static bool blockReceive=false;
static unsigned long long cancellationAt=0;
static void need(bool ok,const char* message){if(!ok)throw std::runtime_error(message);}
static void cancelScope(){
 cancellationAt=GetTickCount64();
 if(cancellation=="off"){g_sleepRecoveryAutoEnabled=false;++g_sleepRecoveryAutoConfigEpoch;}
 else if(cancellation=="power-generation")g_powerGeneration=8;
 else if(cancellation=="suspend")g_powerLifecycle=PowerLifecycle::Suspended;
 else if(cancellation=="exit")g_exitRequested=true;
}
namespace Ports {
struct State{std::string kind;bool closed=false,bodyRead=false;};
static std::mutex mx;
static std::condition_variable cv;
static std::map<HINTERNET,std::shared_ptr<State>> handles;
static std::uintptr_t next=16;
static HINTERNET create(const char* kind){std::lock_guard<std::mutex> lock(mx);auto h=reinterpret_cast<HINTERNET>(next+=16);handles[h]=std::make_shared<State>(State{kind});++opens;return h;}
static BOOL close(HINTERNET h){std::lock_guard<std::mutex> lock(mx);const auto it=handles.find(h);if(it==handles.end()){++doubleCloses;return FALSE;}it->second->closed=true;handles.erase(it);++closes;cv.notify_all();return TRUE;}
static unsigned remaining(){std::lock_guard<std::mutex> lock(mx);return static_cast<unsigned>(handles.size());}
static HINTERNET open(LPCWSTR,DWORD,LPCWSTR,LPCWSTR,DWORD){return create("session");}
static HINTERNET connect(HINTERNET,LPCWSTR host,INTERNET_PORT port,DWORD){need(std::wstring(host)==L"127.0.0.1"&&port==8000,"unexpected endpoint");return create("connection");}
static HINTERNET request(HINTERNET,LPCWSTR,LPCWSTR name,LPCWSTR,LPCWSTR,LPCWSTR*,DWORD){return create(std::wstring(name)==L"/json/list"?"targets":"upgrade");}
static BOOL option(HINTERNET,DWORD,LPVOID,DWORD){return TRUE;}
static BOOL timeouts(HINTERNET,int,int,int,int){return TRUE;}
static BOOL sendRequest(HINTERNET,LPCWSTR,DWORD,LPVOID,DWORD,DWORD,DWORD_PTR){return TRUE;}
static BOOL response(HINTERNET,LPVOID){return TRUE;}
static BOOL headers(HINTERNET h,DWORD,LPCWSTR,LPVOID value,LPDWORD,LPDWORD){std::lock_guard<std::mutex> lock(mx);*static_cast<DWORD*>(value)=handles.at(h)->kind=="targets"?200:101;return TRUE;}
static BOOL read(HINTERNET h,LPVOID buffer,DWORD size,LPDWORD count){
 std::lock_guard<std::mutex> lock(mx);auto& s=*handles.at(h);if(s.bodyRead){*count=0;return TRUE;}s.bodyRead=true;
 const std::string data=R"([{"type":"page","title":"SharedJSContext","url":"https://steamloopback.host/","webSocketDebuggerUrl":"ws://127.0.0.1:8000/devtools/page/fixture"}])";
 need(data.size()<=size,"target buffer too small");std::memcpy(buffer,data.data(),data.size());*count=static_cast<DWORD>(data.size());return TRUE;
}
static HINTERNET upgrade(HINTERNET,DWORD_PTR){auto h=create("socket");if(position=="pre-send")cancelScope();return h;}
static DWORD socketSend(HINTERNET,WINHTTP_WEB_SOCKET_BUFFER_TYPE,PVOID,DWORD){++sends;return NO_ERROR;}
static DWORD queryCloseStatus(HINTERNET,USHORT*,PVOID,DWORD,DWORD*){need(false,"unexpected websocket close frame");return ERROR_INVALID_FUNCTION;}
static DWORD socketReceive(HINTERNET h,PVOID buffer,DWORD size,LPDWORD count,WINHTTP_WEB_SOCKET_BUFFER_TYPE* kind){
 if(position=="after-send"||blockReceive)cancelScope();
 if(blockReceive){std::unique_lock<std::mutex> lock(mx);auto state=handles.at(h);cv.wait(lock,[&]{return state->closed;});return ERROR_WINHTTP_OPERATION_CANCELLED;}
 const auto data=json{{"id",1},{"result",{{"result",{{"value",{{"ok",true},{"runtimeAccepted",true},{"mutated",true},{"actionAcknowledged",true},{"reason","owned-response"}}}}}}}}.dump();
 need(data.size()<=size,"response buffer too small");std::memcpy(buffer,data.data(),data.size());*count=static_cast<DWORD>(data.size());*kind=WINHTTP_WEB_SOCKET_UTF8_MESSAGE_BUFFER_TYPE;return NO_ERROR;
}
}
struct WatchdogWitness {
 HANDLE handle=nullptr;
 void bind(std::thread& thread){need(DuplicateHandle(GetCurrentProcess(),reinterpret_cast<HANDLE>(thread.native_handle()),GetCurrentProcess(),&handle,SYNCHRONIZE,FALSE,0)!=0,"watchdog handle duplicate failed");}
 ~WatchdogWitness(){if(handle){if(WaitForSingleObject(handle,0)==WAIT_OBJECT_0)++watchdogsJoined;CloseHandle(handle);}}
};
#define WinHttpCloseHandle Ports::close
#define WinHttpOpen Ports::open
#define WinHttpConnect Ports::connect
#define WinHttpOpenRequest Ports::request
#define WinHttpSetOption Ports::option
#define WinHttpSetTimeouts Ports::timeouts
#define WinHttpSendRequest Ports::sendRequest
#define WinHttpReceiveResponse Ports::response
#define WinHttpQueryHeaders Ports::headers
#define WinHttpReadData Ports::read
#define WinHttpWebSocketCompleteUpgrade Ports::upgrade
#define WinHttpWebSocketSend Ports::socketSend
#define WinHttpWebSocketReceive Ports::socketReceive
#define WinHttpWebSocketQueryCloseStatus Ports::queryCloseStatus

// ORIGINAL_FOREGROUND
struct Captured {unsigned long long generation=7;Game game{1234,5678,L"owned-game.exe"};Session client;json targetSelection=json::object();};
static Captured capture;
static Captured capturedFor(unsigned long long){return capture;}
static Session session(){return capture.client;}
static bool sameGame(const Game& game){return game.pid==1234&&game.created==5678;}
static bool sameSession(const Session& value){return value.pid==501&&value.created==502;}
static bool gameNotPaused(const Game&){return true;}
static bool sameClientEvidence(const json& a,const json& b){return a==b;}
static bool nativePrimaryAllowsOriginal(const Session&,const Game&,std::uint32_t,bool){return true;}
static Foreground foreground(const Game&,const Session&){return {nullptr,1234,5678,"original-game"};}
static bool sameForeground(const Foreground&,const Game&,const Session&){return true;}
static bool allowedForeground(const Foreground&){return true;}
static json returnOriginalPidWindow(const Captured&,unsigned long long,const json&,const Foreground&,const std::function<bool()>&,const std::function<bool()>&){need(false,"unexpected OS return fallback");return {};}
static json inspect(unsigned long long gen,const char* = nullptr){return {{"generation",gen},{"game",{{"pid",1234},{"created","5678"}}},{"steamClient",{{"pid",501},{"created","502"}}},{"tracker",{{"appid",123}}},{"steamRecovery",{{"repairable",true}}},{"steamInputRecovery",{{"repairable",true}}}};}
// ORIGINAL_NATIVE_CALLERS
}
static void reset(){
 need(Ports::remaining()==0,"prior handles not returned");g_exitRequested=false;g_sleepRecoveryAutoEnabled=true;g_powerGeneration=7;g_sleepRecoveryAutoConfigEpoch=5;g_powerLifecycle=PowerLifecycle::Ready;
 sends=opens=closes=doubleCloses=watchdogsJoined=0;position.clear();cancellation.clear();blockReceive=false;cancellationAt=0;
 SleepSteamRecovery::capture={};auto& client=SleepSteamRecovery::capture.client;client.account=42;client.pid=501;client.created=502;client.root=L"owned-steam";
}
static json invoke(const std::string& op){const auto input=SleepSteamRecovery::inspect(7);const auto current=[]{return sleepSteamRecoveryAllows(7,5)&&g_powerLifecycle==PowerLifecycle::Ready;};return op=="sleep.reconcile"?SleepSteamRecovery::reconcile(input,7,5,current):SleepSteamRecovery::resumeInputContext(input,7,5,current);}
static json observation(const std::string& mode,const std::string& op,const json& reply){return {{"mode",mode},{"operation",op},{"position",position},{"cancel",cancellation},{"reply",reply},{"sends",sends.load()},{"opened",opens.load()},{"closed",closes.load()},{"handlesRemaining",Ports::remaining()},{"doubleCloses",doubleCloses.load()},{"watchdogsJoined",watchdogsJoined.load()}};}
int main(int argc,char** argv){json rows=json::array(),controls=json::array();
 try{
  need(argc==4,"wire selection raw required");json wire;std::ifstream(argv[1])>>wire;sourceMutation=std::string(argv[2])=="transport-negative";std::ofstream raw(argv[3],std::ios::app);
  ymcc::steamcommand::Coordinator coordinator;ymcc::steamcommand::Provider provider(coordinator);need(bool(provider),"test command provider was not installed");
  for(const auto& mode:wire.at("modes"))for(const auto& op:{"sleep.reconcile","sleep.input-resume"})for(const auto& at:{"pre-send","after-send"})for(const auto& kind:{"off","power-generation","suspend","exit"}){
   if(sourceMutation&&(mode.at("mode")!="global"||std::string(op)!="sleep.reconcile"||std::string(at)!="after-send"||std::string(kind)!="off"))continue;
   reset();position=at;cancellation=kind;const auto reply=invoke(op);const auto row=observation(mode.at("mode"),op,reply);raw<<row.dump()<<'\n';raw.flush();rows.push_back(row);
   need(Ports::remaining()==0,"actual transport retained owned socket handle");need(opens==closes&&doubleCloses==0&&watchdogsJoined==1,"transport handles/watchdog were not exactly returned");need(!reply.value("accepted",true),"retired native operation reported accepted");need(sends==(std::string(at)=="pre-send"?0u:1u),"unexpected actual message dispatch count");need(reply.value("mutated",true)==(std::string(at)=="after-send"),"dispatched uncertainty was lost or fabricated");
  }
  if(!sourceMutation){
   for(const auto& mode:wire.at("modes"))for(const auto& op:{"sleep.reconcile","sleep.input-resume"}){reset();const auto reply=invoke(op);need(reply.value("accepted",false)&&sends==1&&Ports::remaining()==0&&watchdogsJoined==1,"current native operation did not complete");controls.push_back(observation(mode.at("mode"),op,reply));}
   reset();blockReceive=true;cancellation="off";const auto started=GetTickCount64();const auto reply=invoke("sleep.reconcile");const auto elapsed=GetTickCount64()-started;auto row=observation("global","sleep.reconcile",reply);row["name"]="actual-default-16s-blocking-receive-deadline";row["elapsedMs"]=elapsed;controls.push_back(row);raw<<json{{"control",row}}.dump()<<'\n';raw.flush();
   need(elapsed>=15000&&elapsed<17500,"default real socket watchdog deadline was not observed");need(!reply.value("accepted",true)&&reply.value("mutated",false)&&sends==1&&Ports::remaining()==0&&watchdogsJoined==1,"default deadline did not return uncertain sent operation and owned resources");
  }
  std::cout<<json{{"status","PASS"},{"rows",rows},{"controls",controls}}.dump()<<'\n';return 0;
 }catch(const std::exception& error){const auto beforeCleanup=Ports::remaining();{std::lock_guard<std::mutex> lock(Ports::mx);Ports::handles.clear();}std::cout<<json{{"status","FAIL"},{"error",error.what()},{"rows",rows},{"controls",controls},{"testPortHandlesBeforeFailureCleanup",beforeCleanup},{"testPortHandlesAfterFailureCleanup",Ports::remaining()}}.dump()<<'\n';return 1;}
}

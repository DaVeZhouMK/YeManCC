static void configureFailure(const std::string& name) {
 failureFault=name;
}
static void checkFailureBaseline(const std::string& name,bool enabled,const json& reply) {
 const DWORD initial=enabled?0:1,desired=enabled?1:0;
 if(name=="activation") {
  check(reply.value("ok",false)&&reply.value("preferenceSaved",false)&&preferenceWrites==1&&g_wakePasswordPreference.load()==enabled,"Activation refusal must preserve confirmed saved preference");
  check(powerResult.at("ac")==desired&&powerResult.at("dc")==desired&&!reply.value("reactivated",true)&&reply.at("reactivationError")==ERROR_ACCESS_DENIED,"Activation failure receipt was not separate from stored state");
 }else {
  check(!reply.value("ok",true)&&!reply.value("preferenceSaved",true)&&preferenceWrites==0&&g_wakePasswordPreference.load()!=enabled,"Failed transaction published preference/cache success");
  if(name=="rollback-ac")check(!reply.value("rollbackOk",true)&&powerResult.at("ac")==desired&&powerResult.at("dc")==initial,"Partial rollback failure was hidden");
  else {
   check(powerResult.at("ac")==initial&&powerResult.at("dc")==initial,"Failed transaction did not retain/restore original indices");
   if(name=="rollback-dc"||name=="rollback-readback")check(!reply.value("rollbackOk",true),"Failed rollback receipt was promoted to success");
   else check(reply.value("rollbackOk",false),"Confirmed unchanged/rolled-back transaction lost its receipt");
  }
  if(name=="initial-ac-read"||name=="initial-dc-read"||name=="rollback-readback")check(!reply.value("known",true),"Failed snapshot was labelled known");
 }
}
static void runFailureCases(const json& defaults,const json& wire,bool negative,const char* rawFile,json& rows,json& controls) {
 const std::vector<std::string> faults={"initial-ac-read","initial-dc-read","write-ac","write-dc","rollback-ac","rollback-dc","stored-readback","final-readback","activation","rollback-readback"};
 const std::vector<std::string> kinds={"revision","hash","mode","result","observed","ack","unrelated","current"};
 std::ofstream raw(rawFile,std::ios::app);
 for(const auto& mode:wire.at("modes"))for(const bool enabled:{true,false})for(const auto& fault:faults){
  if(negative&&(mode.at("mode")!="global"||!enabled||fault!="write-dc"))continue;
  reset(defaults,mode,enabled);configureFailure(fault);stage.clear();change="current";auto request=mode.at("request");request["enabled"]=enabled;const auto baseline=runOne(request);const auto boundaries=failureTrace;
  checkFailureBaseline(fault,enabled,baseline);check(!boundaries.empty(),"Failure trace was empty");
  json control={{"mode",mode.at("mode")},{"enabled",enabled},{"fault",fault},{"baselineReply",baseline},{"boundaries",boundaries},{"power",powerResult},{"preferenceWrites",preferenceWrites},{"cached",g_wakePasswordPreference.load()}};raw<<json{{"type","baseline-control"},{"value",control}}.dump()<<'\n';raw.flush();controls.push_back(control);
  for(const auto& boundaryName:boundaries)for(const auto& kind:kinds){
   if(negative&&(boundaryName!="read3"||kind!="hash"))continue;
   reset(defaults,mode,enabled);configureFailure(fault);stage=boundaryName;change=kind;const bool allowed=kind=="ack"||kind=="unrelated"||kind=="current";json reply;std::string error;
   try{reply=runOne(request);}catch(const std::exception& e){error=e.what();}
   const std::vector<std::string> late(effects.begin()+static_cast<std::ptrdiff_t>(atChange),effects.end());
   json row={{"mode",mode.at("mode")},{"enabled",enabled},{"fault",fault},{"stage",boundaryName},{"kind",kind},{"allowed",allowed},{"changed",changed},{"error",error},{"reply",reply},{"power",powerResult},{"lateEffects",late},{"trace",failureTrace},{"preferenceWrites",preferenceWrites},{"cached",g_wakePasswordPreference.load()}};raw<<json{{"type","boundary-row"},{"value",row}}.dump()<<'\n';raw.flush();rows.push_back(row);check(changed,"Selected failure/rollback boundary not reached");
   if(allowed){check(error.empty(),"Current failure path threw unexpectedly");checkFailureBaseline(fault,enabled,reply);check(reply==baseline,"Allowed ACK/unrelated control changed failure receipt");}
   else {check(late.empty(),"expired wake-password failure path reached later API or preference effect");check(error=="BOOT_WAKE_PASSWORD_REQUEST_EXPIRED","Expired failure-path request was not refused");check(preferenceWrites==0&&g_wakePasswordPreference.load()!=enabled,"Expired failure path changed durable preference/cache");}
  }
 }
}

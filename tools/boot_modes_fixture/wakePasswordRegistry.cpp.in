#include <powrprof.h>
static LONG WINAPI fixtureRegOpen(HKEY,LPCWSTR,DWORD,REGSAM,PHKEY);
static LONG WINAPI fixtureRegCreate(HKEY,LPCWSTR,DWORD,LPWSTR,DWORD,REGSAM,const LPSECURITY_ATTRIBUTES,PHKEY,LPDWORD);
static LONG WINAPI fixtureRegQuery(HKEY,LPCWSTR,LPDWORD,LPDWORD,LPBYTE,LPDWORD);
static LONG WINAPI fixtureRegSet(HKEY,LPCWSTR,DWORD,DWORD,const BYTE*,DWORD);
static LONG WINAPI fixtureRegClose(HKEY);
static DWORD WINAPI fixturePowerReadAc(HKEY,const GUID*,const GUID*,const GUID*,LPDWORD);
static DWORD WINAPI fixturePowerReadDc(HKEY,const GUID*,const GUID*,const GUID*,LPDWORD);
static DWORD WINAPI fixturePowerGet(HKEY,GUID**);
static DWORD WINAPI fixturePowerSet(HKEY,const GUID*);
static HLOCAL WINAPI fixtureLocalFree(HLOCAL);
#define RegOpenKeyExW fixtureRegOpen
#define RegCreateKeyExW fixtureRegCreate
#define RegQueryValueExW fixtureRegQuery
#define RegSetValueExW fixtureRegSet
#define RegCloseKey fixtureRegClose
#define PowerReadACValueIndex fixturePowerReadAc
#define PowerReadDCValueIndex fixturePowerReadDc
#define PowerGetActiveScheme fixturePowerGet
#define PowerSetActiveScheme fixturePowerSet
#define LocalFree fixtureLocalFree
#include "sleep_wake_password.h"
#undef RegOpenKeyExW
#undef RegCreateKeyExW
#undef RegQueryValueExW
#undef RegSetValueExW
#undef RegCloseKey
#undef PowerReadACValueIndex
#undef PowerReadDCValueIndex
#undef PowerGetActiveScheme
#undef PowerSetActiveScheme
#undef LocalFree
// REGISTRY_DECLARATIONS_END
struct RegistryBank {
 DWORD ac=0,dc=0;bool setting=false;unsigned sets=0,created=0,activations=0,next=0;
 std::map<HKEY,bool> keys;std::map<HLOCAL,bool> allocations;
} registryBank;
static void registryCall(const std::string& name){effects.push_back(name);if(name=="registry-create")boundary(name);}
static HKEY registryKey(bool scheme){const auto h=reinterpret_cast<HKEY>(static_cast<uintptr_t>(0x10000+(++registryBank.next)));registryBank.keys[h]=scheme;return h;}
static LONG WINAPI fixtureRegOpen(HKEY parent,LPCWSTR path,DWORD,REGSAM,PHKEY out){
 LONG error=ERROR_SUCCESS;
 if(parent==HKEY_LOCAL_MACHINE){check(std::wstring(path)==SchemeKey,"Registry adapter escaped fixed scheme");*out=registryKey(true);}
 else {check(registryBank.keys.count(parent)&&registryBank.keys.at(parent)&&std::wstring(path)==SettingKey,"Registry adapter escaped fixed setting");if(registryBank.setting)*out=registryKey(false);else error=ERROR_FILE_NOT_FOUND;}
 registryCall("registry-open");return error;
}
static LONG WINAPI fixtureRegCreate(HKEY parent,LPCWSTR path,DWORD,LPWSTR,DWORD,REGSAM,const LPSECURITY_ATTRIBUTES,PHKEY out,LPDWORD){
 check(registryBank.keys.count(parent)&&registryBank.keys.at(parent)&&std::wstring(path)==SettingKey,"Registry create escaped owned fake setting");registryBank.setting=true;++registryBank.created;*out=registryKey(false);registryCall("registry-create");return ERROR_SUCCESS;
}
static LONG WINAPI fixtureRegQuery(HKEY key,LPCWSTR name,LPDWORD,LPDWORD type,LPBYTE bytes,LPDWORD size){
 check(registryBank.keys.count(key)&&!registryBank.keys.at(key)&&*size==sizeof(DWORD),"Invalid fake registry query");const std::wstring n=name;check(n==L"ACSettingIndex"||n==L"DCSettingIndex","Unexpected index query");*type=REG_DWORD;*size=sizeof(DWORD);*reinterpret_cast<DWORD*>(bytes)=n==L"ACSettingIndex"?registryBank.ac:registryBank.dc;registryCall("registry-query");return ERROR_SUCCESS;
}
static LONG WINAPI fixtureRegSet(HKEY key,LPCWSTR name,DWORD,DWORD type,const BYTE* bytes,DWORD size){
 check(registryBank.keys.count(key)&&!registryBank.keys.at(key)&&type==REG_DWORD&&size==sizeof(DWORD),"Invalid fake registry write");const DWORD value=*reinterpret_cast<const DWORD*>(bytes);const std::wstring n=name;check((n==L"ACSettingIndex"||n==L"DCSettingIndex")&&value<=1,"Unexpected index write");if(n==L"ACSettingIndex")registryBank.ac=value;else registryBank.dc=value;++registryBank.sets;registryCall("registry-set");return ERROR_SUCCESS;
}
static LONG WINAPI fixtureRegClose(HKEY key){check(registryBank.keys.erase(key)==1,"Registry adapter closed an unowned key");return ERROR_SUCCESS;}
static DWORD WINAPI fixturePowerReadAc(HKEY,const GUID* scheme,const GUID* sub,const GUID* setting,LPDWORD value){check(IsEqualGUID(*scheme,Scheme)&&IsEqualGUID(*sub,Subgroup)&&IsEqualGUID(*setting,Setting),"Fallback escaped fixed power indices");*value=registryBank.ac;registryCall("power-read-ac");return ERROR_SUCCESS;}
static DWORD WINAPI fixturePowerReadDc(HKEY,const GUID* scheme,const GUID* sub,const GUID* setting,LPDWORD value){check(IsEqualGUID(*scheme,Scheme)&&IsEqualGUID(*sub,Subgroup)&&IsEqualGUID(*setting,Setting),"Fallback escaped fixed power indices");*value=registryBank.dc;registryCall("power-read-dc");return ERROR_SUCCESS;}
static DWORD WINAPI fixturePowerGet(HKEY,GUID** value){*value=new GUID(Scheme);registryBank.allocations[reinterpret_cast<HLOCAL>(*value)]=true;registryCall("power-active-query");return ERROR_SUCCESS;}
static DWORD WINAPI fixturePowerSet(HKEY,const GUID* scheme){check(IsEqualGUID(*scheme,Scheme),"Activated another scheme");++registryBank.activations;registryCall("power-activate");return ERROR_SUCCESS;}
static HLOCAL WINAPI fixtureLocalFree(HLOCAL value){check(registryBank.allocations.erase(value)==1,"Freed unowned fake active GUID");delete reinterpret_cast<GUID*>(value);return nullptr;}
static json registryState(){return {{"ac",registryBank.ac},{"dc",registryBank.dc},{"sets",registryBank.sets},{"created",registryBank.created},{"activeKeys",registryBank.keys.size()},{"activeAllocations",registryBank.allocations.size()}};}
static void resetRegistry(bool enabled){check(registryBank.keys.empty()&&registryBank.allocations.empty(),"Prior registry resources remained");registryBank=RegistryBank{};registryBank.ac=registryBank.dc=enabled?0:1;}
static void runRegistryCases(const json& defaults,const json& wire,bool control,const char* rawFile,json& rows,json& controls){
 const std::vector<std::string> kinds={"revision","hash","mode","result","observed","ack","unrelated","current"};std::ofstream raw(rawFile,std::ios::app);
 for(const auto& mode:wire.at("modes"))for(const bool enabled:{true,false})for(const auto& kind:kinds){
  if(control&&(mode.at("mode")!="global"||!enabled||kind!="hash"))continue;
  reset(defaults,mode,enabled);resetRegistry(enabled);stage="registry-create";change=kind;const bool allowed=kind=="ack"||kind=="unrelated"||kind=="current";auto request=mode.at("request");request["enabled"]=enabled;json reply;std::string error;try{reply=runOne(request);}catch(const std::exception& e){error=e.what();}
  const std::vector<std::string> late(effects.begin()+static_cast<std::ptrdiff_t>(atChange),effects.end());json row={{"mode",mode.at("mode")},{"enabled",enabled},{"kind",kind},{"allowed",allowed},{"changed",changed},{"error",error},{"reply",reply},{"lateEffects",late},{"registry",registryState()},{"preferenceWrites",preferenceWrites},{"cached",g_wakePasswordPreference.load()}};raw<<row.dump()<<'\n';raw.flush();rows.push_back(row);check(changed,"Registry create boundary was not observed");check(registryBank.keys.empty()&&registryBank.allocations.empty(),"Actual Windows adapter retained a key/allocation");
  if(allowed){check(error.empty()&&reply.value("ok",false)&&reply.value("preferenceSaved",false)&&registryBank.ac==DWORD(enabled)&&registryBank.dc==DWORD(enabled)&&g_wakePasswordPreference.load()==enabled,"Current adapter request failed");}
  else{check(late.empty(),"expired registry adapter reached later system call");check(error=="BOOT_WAKE_PASSWORD_REQUEST_EXPIRED"&&registryBank.sets==0&&preferenceWrites==0&&g_wakePasswordPreference.load()!=enabled,"Expired adapter write/preference was not refused");}
 }
 if(!control){reset(defaults,wire.at("modes").at(0),true);resetRegistry(true);stage.clear();change="current";auto request=wire.at("ordinary");request["enabled"]=true;const auto reply=runOne(request);check(reply.value("ok",false)&&settingsReads==0&&registryBank.keys.empty()&&registryBank.allocations.empty(),"Ordinary adapter gained owner reads or retained resources");controls.push_back({{"name","ordinary-adapter-no-owner-reads"},{"ownerReads",settingsReads.load()},{"registry",registryState()}});}
}

}
static uint64_t fixtureBegin(const json& mode,bool scoped=true){auto request=scoped?mode["beginRequest"]:json::object();return std::stoull(handlers.at("steamAppearance.beginUse")(request).at("token").get<std::string>());}
static void ensure(uint64_t token,const json& mode,bool scoped=true){auto request=scoped?mode["ensureRequest"]:json::object();request["token"]=std::to_string(token);need(handlers.at("steamAppearance.ensureUse")(request).value("ok",false),"Actual ensure failed");}
static std::shared_ptr<Fence> park(uint64_t token){auto f=arm(token);SetEvent(g_steamCssUse.wake_);f->wait();ResetEvent(g_steamCssUse.wake_);return f;}
static bool commit(const std::string& writer,const json& before,json next){
 next["input"]["revision"]=before["input"]["revision"].get<int>()+1;
 if(writer=="document")return ymSettingsWriteDocument(next.dump(),nullptr,&before);
 if(writer=="section")return ymSettingsWriteSection("input",next["input"]);
 if(writer=="section-prepare")return ymSettingsWriteSection("ui",before["ui"],std::function<bool(json&,json&)>{[&](json&,json& all){all["input"]=next["input"];return true;}});
 if(writer=="patch")return ymSettingsPatchSection("input",{{"revision",next["input"]["revision"]}});
 if(writer=="input-cas")return ymSettingsSetInputBooleanCas("msiShieldEnabled",true);
 if(writer=="bounded-recovery"){need(sgWriteFileAtomic(YM_SETTINGS_FILE,std::string(4*1024*1024+1,'!')),"Oversize setup failed");return ymSettingsWriteDocument(next.dump(),nullptr,&before);}
 throw std::runtime_error("Unknown writer");
}

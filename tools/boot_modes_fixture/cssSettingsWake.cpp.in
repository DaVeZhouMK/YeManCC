struct Fence {
 uint64_t generation;HANDLE entered=CreateEventW(nullptr,TRUE,FALSE,nullptr),release=CreateEventW(nullptr,TRUE,FALSE,nullptr);
 explicit Fence(uint64_t g):generation(g){need(entered&&release,"Worker fence creation failed");}
 ~Fence(){CloseHandle(entered);CloseHandle(release);}
 void wait(){need(WaitForSingleObject(entered,1000)==WAIT_OBJECT_0,"Actual worker wait boundary not reached");}
 void resume(){SetEvent(release);}
};
static std::mutex fenceMx,observationMx;
static std::shared_ptr<Fence> pendingFence;
static json waits=json::array(),signals=json::array();
static std::atomic<bool> pauseNotification{false};
static HANDLE signalEntered=nullptr,signalRelease=nullptr,wakeContended=nullptr;
static void fixtureWakeContention(){if(pauseNotification&&wakeContended)SetEvent(wakeContended);}
static std::shared_ptr<Fence> arm(uint64_t generation){auto f=std::make_shared<Fence>(generation);std::lock_guard lock(fenceMx);need(!pendingFence,"Overlapping worker fence");pendingFence=f;return f;}
static void fixtureBeforeWait(uint64_t g,DWORD timeout){
 std::shared_ptr<Fence> f;{std::lock_guard lock(fenceMx);if(pendingFence&&pendingFence->generation==g){f=std::move(pendingFence);}}
 if(f){SetEvent(f->entered);WaitForSingleObject(f->release,2000);}
 {std::lock_guard lock(observationMx);waits.push_back({{"generation",g},{"timeout",timeout},{"boundary","before-real-wait"}});}
}
static void fixtureAfterWait(uint64_t g,DWORD result){std::lock_guard lock(observationMx);waits.push_back({{"generation",g},{"result",result},{"boundary","after-real-wait"}});}
static BOOL fixtureSettingsSignal(HANDLE event){
 bool local=false,named=false;std::thread witness([&]{local=g_settingsFileMtx.try_lock();HANDLE mutex=CreateMutexW(nullptr,FALSE,fixtureSettingsMutexName().c_str());if(mutex){const auto r=WaitForSingleObject(mutex,0);named=r==WAIT_OBJECT_0||r==WAIT_ABANDONED;if(named)ReleaseMutex(mutex);CloseHandle(mutex);}if(local)g_settingsFileMtx.unlock();});witness.join();
 if(pauseNotification){SetEvent(signalEntered);WaitForSingleObject(signalRelease,2000);}
 const auto signaled=SetEvent(event);const auto error=signaled?0:GetLastError();std::lock_guard lock(observationMx);signals.push_back({{"localLockReleased",local},{"namedLockReleased",named},{"signaled",signaled!=FALSE},{"error",error}});return signaled;
}
struct Child {HANDLE h=nullptr;DWORD pid=0;ULONGLONG birth=0;~Child(){if(h)CloseHandle(h);}};
static std::vector<std::unique_ptr<Child>> children;
static void fixtureChild(HANDLE h,const char* stage,bool){if(std::string(stage)!="resumed")return;auto c=std::make_unique<Child>();need(DuplicateHandle(GetCurrentProcess(),h,GetCurrentProcess(),&c->h,SYNCHRONIZE|PROCESS_QUERY_LIMITED_INFORMATION,FALSE,0),"Child observation unavailable");c->pid=GetProcessId(h);FILETIME b{},e{},k{},u{};need(GetProcessTimes(h,&b,&e,&k,&u)!=FALSE,"Child birth unavailable");c->birth=(ULONGLONG(b.dwHighDateTime)<<32)|b.dwLowDateTime;children.push_back(std::move(c));}
static json childRows(bool stopped){json rows=json::array();for(const auto& c:children){const bool signaled=WaitForSingleObject(c->h,stopped?1000:0)==WAIT_OBJECT_0;rows.push_back({{"pid",c->pid},{"birth",std::to_string(c->birth)},{"signaled",signaled}});if(stopped)need(signaled,"Owned helper survived stale lease");}return rows;}
static HANDLE releasedEvent=nullptr;
static bool live(HANDLE h){return h&&WaitForSingleObject(h,0)==WAIT_TIMEOUT;}
struct OwnedProcess {HANDLE h=nullptr;~OwnedProcess(){if(h){TerminateProcess(h,0);WaitForSingleObject(h,2000);CloseHandle(h);}}};

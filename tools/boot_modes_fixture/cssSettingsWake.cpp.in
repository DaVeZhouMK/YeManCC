static size_t signalCount(){std::lock_guard lock(observationMx);return signals.size();}
static uint64_t currentToken(){std::lock_guard lock(g_steamCssUse.mutex_);return g_steamCssUse.token_;}
static void setup(const json& defaults,const json& mode){
 need(!currentToken(),"Prior lease still active");children.clear();ResetEvent(releasedEvent);auto doc=defaults;doc["input"]=mode["expectedBootContext"]["input"];doc["extensions"]=mode["expectedBootContext"]["extensions"];

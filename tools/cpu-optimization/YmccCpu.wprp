<?xml version="1.0" encoding="utf-8"?>
<WindowsPerformanceRecorder Version="1.0" Author="YMCC CPU optimization">
  <Profiles>
    <SystemCollector Id="YmccCpuCollector" Name="YMCC CPU stack collector">
      <BufferSize Value="256" />
      <Buffers Value="256" />
    </SystemCollector>
    <SystemProvider Id="YmccCpuProvider">
      <Keywords>
        <Keyword Value="CpuConfig" />
        <Keyword Value="ProcessThread" />
        <Keyword Value="Loader" />
        <Keyword Value="SampledProfile" />
      </Keywords>
      <Stacks>
        <Stack Value="SampledProfile" />
      </Stacks>
    </SystemProvider>
    <Profile Id="YmccCpu.Verbose.Memory" Name="YmccCpu" Description="CPU execution stacks only; 64 MiB requested ring; scheduling capture retained separately" LoggingMode="Memory" DetailLevel="Verbose">
      <Collectors>
        <SystemCollectorId Value="YmccCpuCollector">
          <SystemProviderId Value="YmccCpuProvider" />
        </SystemCollectorId>
      </Collectors>
    </Profile>
    <Profile Id="YmccCpu.Verbose.File" Name="YmccCpu" Description="Bounded CPU execution stacks in file mode; no per-CPU ring overwrites" LoggingMode="File" DetailLevel="Verbose">
      <Collectors>
        <SystemCollectorId Value="YmccCpuCollector">
          <SystemProviderId Value="YmccCpuProvider" />
        </SystemCollectorId>
      </Collectors>
    </Profile>
  </Profiles>
</WindowsPerformanceRecorder>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <UseAppHost>false</UseAppHost>
    <Deterministic>true</Deterministic>
    <NuGetAudit>false</NuGetAudit>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <RestoreSources></RestoreSources>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../../InputHost/CanonicalFrameFingerprintMemo.cs" Link="CanonicalFrameFingerprintMemo.cs" />
    <Compile Include="$(EvidenceRoot)/GeneratedCanonical.cs" Link="GeneratedCanonical.cs" />
    <Compile Include="$(EvidenceRoot)/GeneratedFaultMemo.cs" Link="GeneratedFaultMemo.cs" />
  </ItemGroup>
</Project>

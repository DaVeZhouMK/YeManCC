static std::uint64_t onAfterOffWake(){
    // OFF suspend uses the actual production arm. The retired wake's lack of
    // pending work is a declared input; no wake execution/retirement is emulated.
    inputHostArmWakePhysicalHold("system-suspend");clockNow+=60000;
    g_realStickTest.virtualTargetEnabled=true;configuredPersona="steamdeck";
    return g_virtualStartProtection.admit(configuredPersona,clockNow).requestId;
}
int main(int argc,char**argv){
    if(argc!=2)return 2;json results=json::array(),failures=json::array();
    auto check=[&](const std::string& name,bool ok){results.push_back({{"name",name},{"passed",ok}});if(!ok)failures.push_back(name);};
    reset();const auto request=onAfterOffWake();const auto before=g_virtualStartProtection.view(clockNow);
    check("gpd-off-suspend-arms-existing-hold",g_wakeHoldPhysicalUnhide&&request!=0);
    const bool gate=originalBusQueues();
    check("gpd-idle-wake-first-on-reaches-original-bus-gate",gate&&!g_wakeHoldPhysicalUnhide);
    const auto after=g_virtualStartProtection.view(clockNow);
    check("original-request-period-persona-and-fallback-retained",after.requestId==request&&after.persona==before.persona&&after.remainingMs==before.remainingMs&&after.phase=="pending"&&after.fallbackAttempts==before.fallbackAttempts);
    const auto logCount=lifecycleLogs.size();(void)originalBusQueues();
    check("retirement-is-once-with-no-target-or-device-effect",lifecycleLogs.size()==logCount&&!g_inputHostProcess&&g_inputHostEpoch==0&&g_realStickTest.virtualTargetEnabled&&configuredPersona=="steamdeck");
    std::vector<std::pair<std::string,std::function<void()>>> refused={
      {"unresolved-machine",[]{g_machineIdentity.resolved=false;}},{"unknown-gpd-profile",[]{profileKnown=false;}},
      {"host-epoch",[]{g_inputHostEpoch=1;}},{"host-process",[]{g_inputHostProcess=reinterpret_cast<HANDLE>(1);}},
      {"host-primary-thread",[]{g_inputHostPrimaryThread=reinterpret_cast<HANDLE>(1);}},
      {"host-server-pipe",[]{g_inputHostServerPipe=reinterpret_cast<HANDLE>(1);}},
      {"pipe-unreturned",[]{pipeReturned=false;}},{"hello",[]{g_inputHostHello=true;}},
      {"prepared",[]{g_inputHostPrepared=true;}},{"prepare-may-have-arrived",[]{g_inputHostPrepareMayHaveReachedHost=true;}},
      {"neutralized",[]{g_inputHostNeutralized=true;}},{"active-host",[]{g_inputHostActive=true;}},
      {"active-visibility",[]{g_hidHideVisibilityJournal.active=true;}},{"quarantine",[]{g_inputHostReleaseQuarantined=true;}},
      {"sd-debt",[]{g_msiSteamDeckReleaseDebt.pending=true;}},{"ps-debt",[]{g_psEndpointOwnership.pending=true;}},
      {"history-unknown",[]{historyReturned=false;}},{"current-proof-pending",[]{currentProofPending=true;}},
      {"blocked",[]{g_inputHostStartBlocked=true;}},{"transport-fault",[]{g_inputHostTransportFault=true;}},
      {"fault-held",[]{g_inputHostFaultHoldsStart=true;}},{"intent-writer",[]{g_inputHostVirtualIntentWriters=true;}},
      {"non-ready-power",[]{g_powerLifecycle=PowerLifecycle::Suspended;}},{"power-revoked",[]{g_inputHostPowerAdmissionRevoked=true;}},
      {"exit-fence",[]{exitFence=true;}},{"exit-request",[]{g_exitRequested=true;}},{"capture-stop",[]{g_inputCaptureStop=true;}},
      {"external-priority",[]{g_externalPriorityVirtualSuspended=true;}},{"recorder",[]{g_shortcutRecordingActive=true;}},
      {"physical-release-window",[]{physicalRelease=true;}},{"wake-request",[]{g_wakeRescanRequested=true;}},
      {"queued-lifecycle",[]{g_inputHostLifecycleWorkRequested=true;}},{"lifecycle-inflight",[]{g_inputHostLifecycleWorkInFlight=true;}},
      {"switch-return",[]{g_inputHostSwitchExecutionReturnPending=true;}},{"switch-recovery",[]{g_inputHostSwitchRecoveryPending=true;}},
      {"recovery",[]{g_inputHostRecoveryPending=true;}},{"tuple-heal",[]{g_inputHostTupleHealPending=true;}},
      {"native-cycle-pending",[]{g_msiNativeForegroundCyclePending=true;}},{"physical-duty",[]{g_physicalReleaseWindowDutyActive=true;}},
      {"native-owner-active",[]{g_msiNativeForegroundLease.active=true;}},{"native-process",[]{g_msiNativeForegroundLease.cycleProcess=reinterpret_cast<HANDLE>(1);}},
      {"native-writer",[]{g_msiNativeForegroundLease.nativeRefreshWriter=std::make_shared<int>(1);}},
      {"native-visibility",[]{g_msiNativeForegroundLease.nativeVisibilitySession=std::make_shared<int>(1);}},
      {"native-posthide",[]{g_msiNativeForegroundLease.postHideCycle=true;}},{"native-cold",[]{g_msiNativeForegroundLease.coldReturnCycle=true;}},
      {"native-restore",[]{g_msiNativeForegroundLease.restorePending=true;}},
      {"native-deferred",[]{g_msiNativeForegroundLease.deferredVirtualWork.push_back("unreturned");}},
      {"posthide-owner",[]{g_postHideCycleOwned=true;}},{"cold-owner",[]{g_coldReturnCycleOwned=true;}},
      {"native-power-hold",[]{g_msiNativeForegroundPowerHold=true;}},{"unknown-public-power",[]{sharedKnown=false;}},
      {"retired-public-power",[]{publicCurrent=false;}},{"other-public-generation",[]{sharedGeneration=powerNow+1;}},
      {"expired-player",[]{clockNow+=30000;}},{"configured-off",[]{configuredPersona="disabled";g_realStickTest.virtualTargetEnabled=false;}}
    };
    for(const auto& [name,alter]:refused){reset();(void)onAfterOffWake();alter();check("hold-retained-"+name,!inputHostRetireUnownedRogWakeHoldForStart()&&g_wakeHoldPhysicalUnhide);}
    // Reuse every original common refusal for ROG; GPD-only facts stay excluded.
    for(const auto& [name,alter]:refused){
        if(name=="native-owner-active")break;if(name=="unknown-gpd-profile")continue;
        reset();(void)onAfterOffWake();g_machineIdentity.family=Family::Rog;alter();
        check("rog-common-hold-retained-"+name,!inputHostRetireUnownedRogWakeHoldForStart()&&g_wakeHoldPhysicalUnhide);
    }
    for(unsigned change=0;change<3;++change){
        reset();(void)onAfterOffWake();afterFirstPowerCheck=[change]{if(change==0)publicCurrent=false;else if(change==1)++powerNow;else g_powerLifecycle=PowerLifecycle::Suspended;};
        check("mid-admission-power-change-retains-hold-"+std::to_string(change),!inputHostRetireUnownedRogWakeHoldForStart()&&g_wakeHoldPhysicalUnhide);
    }
    for(const auto family:{Family::Msi,Family::OneX,Family::Aya,Family::Unknown}){reset();(void)onAfterOffWake();g_machineIdentity.family=family;check("other-family-unchanged-"+std::to_string(static_cast<int>(family)),!inputHostRetireUnownedRogWakeHoldForStart()&&g_wakeHoldPhysicalUnhide);}
    reset();(void)onAfterOffWake();g_machineIdentity.family=Family::Rog;sharedKnown=false;
    check("original-rog-admission-unchanged",inputHostRetireUnownedRogWakeHoldForStart()&&!g_wakeHoldPhysicalUnhide);
    auto& owner=g_msiNativeForegroundLease;
    const auto liveWriter=[&]{
        reset();(void)onAfterOffWake();g_msiNativeForegroundCyclePending=true;
        owner.active=true;owner.cycleProcess=reinterpret_cast<HANDLE>(1);
    };
    liveWriter();
    check("live-native-writer-keeps-hold-and-existing-queue-authority",originalBusQueues()&&g_wakeHoldPhysicalUnhide&&busQueueCalls==1&&lifecycleLogs.size()==1);
    const auto settledHandoff=[&]{
        reset();const auto ticket=onAfterOffWake();
        owner.active=true;owner.virtualHandoffHeld=true;owner.virtualHandoffRequest=ticket;
        owner.cycleAccepted=true;owner.retiredNativeWriterAttempt="original-writer";
        return ticket;
    };
    const auto heldTicket=settledHandoff();
    const auto deadline=clockNow+g_virtualStartProtection.view(clockNow).remainingMs;
    const bool queued=originalBusQueues();
    ymcc::inputHost::queuedPlayerStart::Work work;
    const bool bound=queued&&ymcc::inputHost::queuedPlayerStart::decode(busQueue.front(),work)&&work.bound;
    const auto queuedWire=queued?busQueue.front():std::string{};
    const bool duplicate=originalBusQueues();
    check("settled-native-handoff-queues-original-first-on-without-clearing-hold",
        bound&&!duplicate&&busQueueCalls==1&&busQueue.size()==1&&busDiscoveryDirty==1&&!busThrottled&&
        work.request==heldTicket&&work.deadline==deadline&&work.power==powerNow&&work.persona==configuredPersona&&work.reason=="initial-target-admission"&&
        g_wakeHoldPhysicalUnhide&&owner.active&&owner.virtualHandoffHeld&&
        !g_inputHostProcess&&!g_inputHostEpoch&&owner.retiredNativeWriterAttempt=="original-writer"&&
        owner.deferredVirtualWork.empty()&&lifecycleLogs.size()==1&&lifecycleLogs[0].value("nativeWriterWaitMayQueue",false)&&
        lifecycleLogs[0].value("wakeHoldPreserved",false)&&g_virtualStartProtection.view(clockNow).requestId==heldTicket);
    const std::vector<std::pair<std::string,std::function<void()>>> settledRefusals{
        {"not-held",[&]{owner.virtualHandoffHeld=false;}},{"other-request",[&]{++owner.virtualHandoffRequest;}},
        {"other-suspend",[&]{++owner.suspendSerial;}},{"expired",[]{clockNow+=30000;}},
        {"unknown-retirement",[&]{owner.retiredNativeWriterAttempt.clear();}},
        {"no-success",[&]{owner.cycleAccepted=false;}},{"failed-writer",[&]{owner.helperExitCode=6;}},
        {"unreturned-handle",[&]{owner.cycleProcess=reinterpret_cast<HANDLE>(1);}},
        {"unreturned-writer",[&]{owner.nativeRefreshWriter=std::make_shared<int>(1);}},
        {"still-returning",[&]{owner.restorePending=true;}},{"configuration-returned",[&]{owner.configurationReturned=true;}},
        {"stale-power",[]{publicCurrent=false;}},{"unknown-power",[]{sharedKnown=false;}}
    };
    for(const auto& [name,alter]:settledRefusals){(void)settledHandoff();alter();
        check("settled-native-handoff-refuses-"+name,!originalBusQueues()&&!busQueueCalls&&g_wakeHoldPhysicalUnhide);}
    liveWriter();busSourceAdmitted=false;
    check("current-handoff-does-not-bypass-physical-source-admission",
        !originalBusQueues()&&busQueue.empty()&&!busQueueCalls&&!busDiscoveryDirty&&g_wakeHoldPhysicalUnhide&&g_hidHideStartDeferredLogged);
    liveWriter();g_inputHostLifecycleWorkInFlight=true;
    check("current-handoff-does-not-bypass-serial-owner",
        !originalBusQueues()&&busQueue.empty()&&!busQueueCalls&&g_wakeHoldPhysicalUnhide);
    liveWriter();g_hidHideLastStartAttemptTick=clockNow;
    check("current-handoff-does-not-bypass-bus-attempt-throttle",
        !originalBusQueues()&&busQueue.empty()&&!busQueueCalls&&g_wakeHoldPhysicalUnhide&&
        busThrottled==1);
    for(bool native:{false,true}){
        reset();(void)onAfterOffWake();std::atomic<bool> locked=false,release=false;
        std::thread holder([&]{if(native)g_msiNativeForegroundMx.lock();else g_inputHostMx.lock();locked=true;while(!release)Sleep(1);if(native)g_msiNativeForegroundMx.unlock();else g_inputHostMx.unlock();});
        while(!locked)Sleep(1);const bool retired=inputHostRetireUnownedRogWakeHoldForStart();release=true;holder.join();
        check(native?"native-lock-contention-keeps-hold":"host-lock-contention-keeps-hold",!retired&&g_wakeHoldPhysicalUnhide);
    }
    reset();configuredPersona="elite";g_realStickTest.virtualTargetEnabled=true;g_powerGeneration=powerNow;
    const auto elite=g_virtualStartProtection.admit(configuredPersona,clockNow);
    const auto beforeQuarantine=g_virtualStartProtection.view(clockNow);
    const auto eliteWire=ymcc::inputHost::queuedPlayerStart::bind("initial-target-admission");
    ymcc::inputHost::queuedPlayerStart::Work eliteWork;
    const bool eliteBound=ymcc::inputHost::queuedPlayerStart::decode(eliteWire,eliteWork)&&eliteWork.bound;
    check("win5-elite-enablement-binds-original-ticket-and-deadline",elite.accepted&&eliteBound&&eliteWork.request==elite.requestId&&
        eliteWork.persona=="elite"&&eliteWork.power==powerNow&&eliteWork.deadline==clockNow+30000);
    g_inputHostReleaseQuarantined=true;g_inputHostStartBlocked=true;historyReturned=false;
    const auto startRan=runStartQuarantineExcerpt(eliteWork.request);
    const auto candidate=g_virtualStartProtection.view(clockNow);
    check("win5-elite-unreturned-old-target-refuses-before-next-start-stage",!startRan&&!nextStartStageCalls&&
        g_inputHostReleaseQuarantined&&g_inputHostStartBlocked&&!historyReturned&&switchAudit=="release-quarantine"&&quarantineDiagnostics==1&&
        lifecycleLogs.size()==1&&lifecycleLogs[0].value("event","")=="input-host-start-blocked"&&lifecycleLogs[0].value("reason","")=="release-quarantine");
    check("win5-elite-start-refusal-emits-same-ticket-failure-candidate",candidate.locked&&candidate.requestId==elite.requestId&&
        candidate.phase=="verifying"&&candidate.candidateOutcome=="failure"&&candidate.verificationRemainingMs==10000&&
        candidate.remainingMs==beforeQuarantine.remainingMs&&candidate.fallbackAttempts==0&&g_inputHostSwitchVerificationPending==elite.requestId&&
        startProtectionAction=="verification-pending"&&startProtectionOrigin=="start-terminal-failure"&&!recoveryOffers);
    clockNow+=9999;
    const auto rejectedEarly=g_virtualStartProtection.finishVerification(elite.requestId,"failure",clockNow);
    const auto rejectedNewOn=g_virtualStartProtection.admit("elite",clockNow);
    check("win5-elite-candidate-neither-finalizes-early-nor-renews-admission",!rejectedEarly&&!rejectedNewOn.accepted&&
        g_virtualStartProtection.view(clockNow).remainingMs==20001&&g_virtualStartProtection.view(clockNow).verificationRemainingMs==1);
    ++clockNow;
    const bool wrongFinal=g_virtualStartProtection.finishVerification(elite.requestId+1,"success",clockNow);
    const bool final=g_virtualStartProtection.finishVerification(elite.requestId,"failure",clockNow);
    const bool repeatedFinal=g_virtualStartProtection.finishVerification(elite.requestId,"failure",clockNow);
    const auto terminal=g_virtualStartProtection.view(clockNow);
    check("win5-elite-protection-finalizes-once-but-cannot-return-old-target",!wrongFinal&&final&&!repeatedFinal&&
        terminal.requestId==elite.requestId&&terminal.phase=="failure"&&!terminal.locked&&g_inputHostReleaseQuarantined&&!nextStartStageCalls);
    // Represent confirmed return as an input; this leaf does not perform the return or create a Host.
    g_inputHostReleaseQuarantined=false;g_inputHostStartBlocked=false;historyReturned=true;
    const auto fresh=g_virtualStartProtection.admit("elite",clockNow);
    const bool proceeded=runStartQuarantineExcerpt(fresh.requestId);
    check("win5-elite-confirmed-return-allows-one-next-stage-not-ready",fresh.accepted&&fresh.requestId!=elite.requestId&&proceeded&&
        nextStartStageCalls==1&&g_virtualStartProtection.view(clockNow).phase=="pending"&&quarantineDiagnostics==1&&!g_inputHostProcess);
    std::ofstream(argv[1])<<json({{"passed",failures.empty()},{"checks",results.size()},{"failures",failures},{"results",results},
      {"busDispatch",{{"wire",queuedWire},{"request",work.request},{"deadline",work.deadline},{"power",work.power},{"persona",work.persona},{"reason",work.reason}}},
      {"scope","actual BUS admission through ticket binding and the source-exact Start quarantine and candidate excerpts; no queued worker, full Start, real return or device IO"}}).dump(2);
    std::cout<<"checks="<<results.size()<<" failures="<<failures.size()<<"\n";return failures.empty()?0:1;
}

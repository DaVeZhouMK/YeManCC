static void reset(){
    g_virtualStartProtection.~VirtualStartProtection();new(&g_virtualStartProtection)ymcc::VirtualStartProtection;
    g_machineIdentity={true,Family::Gpd};g_realStickTest={true,false};configuredPersona="disabled";
    clockNow=1000;powerNow=sharedGeneration=4;g_inputHostEpoch=0;g_inputHostRunId.clear();
    g_inputHostProcess=g_inputHostPrimaryThread=g_inputHostServerPipe=nullptr;
    g_inputHostHello=g_inputHostPrepared=g_inputHostPrepareMayHaveReachedHost=g_inputHostNeutralized=g_inputHostActive=false;
    g_inputHostStartBlocked=g_inputHostTransportFault=g_inputHostFaultHoldsStart=false;
    g_inputReady=sharedKnown=pipeReturned=historyReturned=profileKnown=publicCurrent=true;currentProofPending=false;
    g_hidHideVisibilityJournal.active=false;g_msiSteamDeckReleaseDebt.pending=g_psEndpointOwnership.pending=false;
    g_powerLifecycle=PowerLifecycle::Ready;exitFence=physicalRelease=false;g_msiNativeForegroundLease=NativeOwner{};
    for(auto* p:{&g_wakeHoldPhysicalUnhide,&g_inputHostReleaseQuarantined,&g_msiDinputReturnOwed,&g_inputHostVirtualIntentWriters,
      &g_inputHostPowerAdmissionRevoked,&g_exitRequested,&g_inputCaptureStop,&g_externalPriorityVirtualSuspended,
      &g_shortcutRecordingActive,&g_wakeRescanRequested,&g_inputHostLifecycleWorkRequested,&g_inputHostLifecycleWorkInFlight,
      &g_inputHostSwitchExecutionReturnPending,&g_inputHostSwitchRecoveryPending,&g_inputHostRecoveryPending,
      &g_inputHostTupleHealPending,&g_msiNativeForegroundCyclePending,&g_physicalReleaseWindowDutyActive,
      &g_postHideCycleOwned,&g_coldReturnCycleOwned,&g_msiNativeForegroundPowerHold})p->store(false);
    lifecycleLogs.clear();powerChecks=0;afterFirstPowerCheck={};
    busSourceAdmitted=true;g_hidHideStartDeferredLogged=false;
    g_hidHideLastStartAttemptTick=g_hidHideStartDeferredSinceTick=0;
    busQueueCalls=busDiscoveryDirty=busThrottled=0;busQueue.clear();
}


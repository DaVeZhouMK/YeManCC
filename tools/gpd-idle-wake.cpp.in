class InputHostMutex {
    std::mutex value_;std::atomic<DWORD> owner_{0};
public:
    void lock(){value_.lock();owner_=GetCurrentThreadId();}
    bool try_lock(){if(!value_.try_lock())return false;owner_=GetCurrentThreadId();return true;}
    void unlock(){owner_=0;value_.unlock();}
    bool ownedByCurrentThread()const{return owner_==GetCurrentThreadId();}
};

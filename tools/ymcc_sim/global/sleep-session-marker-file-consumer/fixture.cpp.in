#include <atomic>
#include <cctype>
#include <iostream>
#include <mutex>
#include <sstream>
#include <stdexcept>
#include "json.hpp"
using json = nlohmann::json;
namespace fspath = std::filesystem;
static fspath::path caseDataDir;
static unsigned long memoryPid = 100;
static unsigned long long memoryTick = 100;
static bool g_fanPriorRunUnclean = false;
static std::string g_fanCurrentRunToken;
static std::string g_fanPriorRunToken;
static std::atomic<bool> g_sgCleanupDone{false};
static std::mutex g_sgOpMtx;
static std::atomic<bool> g_sgInSuspend{false};
static std::wstring SG_SLEEP_LEASE_DIR, SG_MANUAL_DIR;
static int cancelCalls = 0;
static std::vector<json> lifecycleLogs, businessFacts;
static std::wstring yemancc_data_dir() { return caseDataDir.wstring(); }
static unsigned long GetCurrentProcessId() { return memoryPid; }
static unsigned long long GetTickCount64() { return memoryTick; }
static void appendNativeLifecycleLog(const char* kind, json data) { lifecycleLogs.push_back({{"kind",kind},{"data",data}}); }
static void sgRecordFact(const char* kind, const json& data = json::object()) { businessFacts.push_back({{"kind",kind},{"data",data}}); }
struct SgSleepTarget { bool markerOwned=false; unsigned long long powerGeneration=0; };
struct SgResumeResult { int count=0; };
static bool sgReadSleepTarget(SgSleepTarget&) { return false; }
static bool sgResumeSleepTargetUnlocked(unsigned long long, bool) { throw std::runtime_error("unexpected memory target resume"); }
static SgResumeResult sgResumeTrackedAllUnlocked() { businessFacts.push_back({{"kind","memory-empty-resume"}}); return {}; }
static void sgCancelWakeGameRecoveryUnlocked(const char* reason) { ++cancelCalls; businessFacts.push_back({{"kind","memory-wake-cancel"},{"reason",reason}}); }
// EXACT_CURRENT_FULL_DEFINITIONS
static void need(bool condition, const char* text) { if(!condition)throw std::runtime_error(text); }
static fspath::path marker() { return fspath::path(sessionMarkerPath()); }
static std::string readBytes(const fspath::path& file) { std::ifstream input(file,std::ios::binary);need(bool(input),"fixture read failed");std::ostringstream stream;stream<<input.rdbuf();need(!input.bad(),"fixture read bad");return stream.str(); }
static void seed(const std::string& bytes) { std::ofstream out(marker(),std::ios::binary|std::ios::trunc);need(bool(out),"fixture seed open failed");out<<bytes;out.flush();need(bool(out),"fixture seed write failed"); }
static int logCount(const char* kind) { int n=0;for(const auto& row:lifecycleLogs)if(row.at("kind")==kind)++n;return n; }
static json snapshot() {
 const auto file=marker();const bool exists=fspath::exists(file),regular=exists&&fspath::is_regular_file(file),directory=exists&&fspath::is_directory(file);
 return {{"markerType",regular?"file":directory?"directory":"missing"},{"markerBytes",regular?readBytes(file):""},{"currentToken",g_fanCurrentRunToken},{"priorUnclean",g_fanPriorRunUnclean},{"priorToken",g_fanPriorRunToken},{"abnormalLogs",logCount("session-abnormal-termination")},{"cleanLogs",logCount("session-clean-exit")},{"writeFailureLogs",logCount("session-clean-exit-failed")},{"cleanupDone",g_sgCleanupDone.load()},{"cancelCalls",cancelCalls}};
}
static fspath::path heldMarker() { return caseDataDir/"held-unclean.marker"; }
static void blockMarker() { need(fspath::is_regular_file(marker()),"block requires actual existing file");fspath::rename(marker(),heldMarker());need(fspath::create_directory(marker()),"block directory not created");need(fspath::is_directory(marker()),"actual directory refusal absent"); }
static void unblockMarker() { need(fspath::is_directory(marker()),"unblock requires owned directory");need(fspath::remove(marker()),"owned refusal directory not removed");fspath::rename(heldMarker(),marker()); }
static json run(const std::string& action) {
 if(action=="prior-unclean")seed("88@12");
 else if(action=="prior-clean")seed("88@12,clean");
 else if(action=="prior-whitespace")seed(" \r\n 88@12 \t\r\n");
 else if(action=="prior-empty")seed("");
 else if(action=="prior-damaged")seed("broken@@marker");
 if(action=="boot-refused-retry") { need(fspath::create_directory(marker()),"owned boot refusal directory not created");sessionMarkerCheckAtBoot();const auto initial=snapshot();need(fspath::remove(marker()),"owned boot refusal directory not removed");memoryTick=200;sessionMarkerCheckAtBoot();return {{"initial",initial},{"final",snapshot()}}; }
 sessionMarkerCheckAtBoot();
 if(action=="clean"||action=="clean-twice"||action=="missing-before-clean") { if(action=="missing-before-clean")need(fspath::remove(marker()),"owned marker missing removal failed");memoryTick=200;sessionMarkerMarkClean();if(action=="clean-twice"){memoryTick=300;sessionMarkerMarkClean();}return {{"final",snapshot()}}; }
 if(action=="clean-refused"||action=="clean-refused-retry") { blockMarker();memoryTick=200;sessionMarkerMarkClean();const auto refused=snapshot();unblockMarker();if(action=="clean-refused-retry"){memoryTick=300;sessionMarkerMarkClean();}return {{"afterRefusal",refused},{"final",snapshot()}}; }
 if(action=="cleanup") { memoryTick=200;const bool returned=sgCleanupBeforeExit(false);return {{"returned",returned},{"final",snapshot()}}; }
 if(action=="cleanup-refused"||action=="cleanup-refused-retry") { blockMarker();memoryTick=200;const bool first=sgCleanupBeforeExit(false);const auto refused=snapshot();unblockMarker();if(action=="cleanup-refused-retry"){memoryTick=300;const bool second=sgCleanupBeforeExit(false);return {{"firstReturned",first},{"secondReturned",second},{"afterRefusal",refused},{"final",snapshot()}};}return {{"returned",first},{"afterRefusal",refused},{"final",snapshot()}}; }
 need(action=="fresh"||action=="restart"||action.rfind("prior-",0)==0,"unknown scenario action");return {{"final",snapshot()}};
}
int main(int argc,char** argv) {
 try { need(argc==2,"one owned config argument required");const auto configFile=fspath::path(argv[1]);need(YmccPauseBoundary::inside(configFile),"config outside owned root");const json config=json::parse(readBytes(configFile));caseDataDir=fspath::path(config.at("dataDir").get<std::string>());need(YmccPauseBoundary::inside(caseDataDir)&&fspath::is_directory(caseDataDir)&&!fspath::is_symlink(fspath::symlink_status(caseDataDir)),"data directory not owned");memoryPid=config.at("pid").get<unsigned long>();memoryTick=config.at("tick").get<unsigned long long>();SG_SLEEP_LEASE_DIR=(caseDataDir/"owned-empty-sleep-leases").wstring();SG_MANUAL_DIR=(caseDataDir/"owned-empty-manual-leases").wstring();const json actual=run(config.at("action").get<std::string>()),expected=config.at("expected");const bool passed=actual==expected;std::cout<<json({{"case",config.at("case")},{"label",config.at("label")},{"expected",expected},{"actual",actual},{"passed",passed},{"lifecycleLogs",lifecycleLogs},{"businessFacts",businessFacts}}).dump()<<std::endl;return passed?0:23;
 } catch(const std::exception& error) { std::cerr<<json({{"harnessError",error.what()}}).dump()<<std::endl;return 2; }
}
 struct entry{fspath::path value;bool regular=true;bool is_regular_file()const{if(typeQueryErrors.count(value.wstring())){op("memory-file-type-error",{{"path",narrow(value.wstring())}});throw std::system_error(std::make_error_code(std::errc::permission_denied));}return regular;}fspath::path path()const{return value;}};
 struct directory_range{std::wstring directory;std::vector<entry> values;struct iterator{directory_range* owner;size_t index;entry& operator*()const{return owner->values[index];}bool operator!=(const iterator& other)const{return index!=other.index;}iterator& operator++(){++index;if(index==1&&iteratorIncrementErrors.count(owner->directory)){op("memory-directory-increment-error",{{"path",narrow(owner->directory)}});throw std::system_error(std::make_error_code(std::errc::io_error));}return *this;}};iterator begin(){return{this,0};}iterator end(){return{this,values.size()};}};
 bool exists(const std::wstring& p){if(existsErrors.count(p))throw std::system_error(std::make_error_code(std::errc::permission_denied));return files.count(p)||directories.count(p);}bool exists(const std::wstring& p,std::error_code& ec){if(existsErrors.count(p)){ec=std::make_error_code(std::errc::permission_denied);op("memory-exists-error",{{"path",narrow(p)},{"value",existsErrorValue}});return existsErrorValue;}ec.clear();return exists(p);}bool exists(const path& p){return exists(p.wstring());}

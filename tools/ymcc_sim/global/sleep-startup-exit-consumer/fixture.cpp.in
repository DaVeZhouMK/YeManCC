static std::vector<json> workerJoinReceipts;
static void collectStartup(){std::lock_guard<std::mutex> op(g_sgOpMtx);sgCollectStartupResumeScopeUnlocked();}
static void publishPower(ULONGLONG generation,ULONGLONG revision,bool admitted=true){
 Power power;power.generation=generation;power.suspendSerial=generation;power.publicationRevision=revision;
 power.observedNotificationSequence=revision;power.flags=Shared::kKnown|(admitted?Shared::kHardwareAllowed:Shared::kNotificationPending);
 memoryPower=power;sgOfferStartupResume(power);
}
static size_t startupFacts(const char* kind){return std::count_if(operations.begin(),operations.end(),[&](const auto& fact){return fact.value("kind",std::string{})==kind;});}
static bool runStartupWork(bool* duplicateHeld=nullptr){
 if(!g_startupResumeDelivery.runnable())return false;
 bool took=false;
 std::thread worker([&]{SgWorkItem item;std::optional<Power> power;if(!sgWaitForWork(item,power)||!power)return;took=true;
  if(duplicateHeld){sgRequestStartupResume();sgOfferStartupResume(*power);*duplicateHeld=!g_startupResumeDelivery.runnable();}
  sgServiceStartupResume(*power);
 });worker.join();workerJoinReceipts.push_back({{"waitDelivered",took},{"joined",!worker.joinable()}});return took&&!worker.joinable();
}

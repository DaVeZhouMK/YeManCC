namespace ymcc::sleepLegacyResume {
struct Paths {std::wstring dir;DWORD pid;};
static Paths paths(const std::wstring& dir,DWORD pid){return {dir,pid};}
enum class Result { None,Cleaned,Pending };
struct ResumeLease {
 Result result=Result::Pending;ULONGLONG completedBirth=0;
 template<class Current> bool current(const Current& check)const{return result==Result::None&&check();}
};
}
namespace ymcc::sleepStartupResume {
using Records=std::optional<std::string>;
using Inventory=std::map<DWORD,Records>;
enum class Match { Matching,Changed };
static Records readRecordVersions(const sleepLegacyResume::Paths& p){const auto it=files.find(key(p.dir,p.pid));return it==files.end()?Records{}:it->second;}
static Match compareRecordVersions(const Records& old,const Records& now){return old==now?Match::Matching:Match::Changed;}
static bool collect(const std::wstring& dir,Inventory& out,DWORD self){
 try {for(auto& entry:fspath::directory_iterator(dir)){const auto pid=sleepRecoveryRecords::pidForName(entry.path().filename().wstring());if(pid&&pid!=self)out.emplace(pid,readRecordVersions({dir,pid}));}return true;}
 catch(...){return false;}
}
static bool settled(const std::wstring& dir,const Inventory& scope){for(const auto& [pid,original]:scope){if(original&&original==readRecordVersions({dir,pid}))return false;}return true;}
}
template<class Current> static ymcc::sleepLegacyResume::ResumeLease sgAcquireResumeFiles(
 const std::wstring& dir,DWORD pid,const Current& current,ULONGLONG=0,
 const std::function<bool(const ymcc::sleepLegacyResume::Paths&)>& local={}){
 const auto& peer=dir==SG_MANUAL_DIR?SG_SLEEP_LEASE_DIR:SG_MANUAL_DIR;
 if(!current()||existsErrors.count(dir)||existsErrors.count(peer)||files.count(key(peer,pid))||(local&&!local({dir,pid})))return {};
 return {ymcc::sleepLegacyResume::Result::None,0};
}
template<class Current> static ymcc::sleepLegacyResume::ResumeLease sgAcquirePauseFiles(
 const std::wstring& dir,DWORD pid,const Current& current){return sgAcquireResumeFiles(dir,pid,current);}

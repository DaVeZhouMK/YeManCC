DWORD GetCurrentProcessId(){return 42;}
bool ProcessIdToSessionId(DWORD pid,DWORD* out){if(pid==42){*out=1;return currentSessionKnown;}auto i=procs.find(pid);if(i==procs.end()||(!i->second.alive&&!i->second.allowOpenExited)){memoryLastError=ERROR_INVALID_PARAMETER;return false;}*out=i->second.session;return true;}
bool focusQueryProcessIdentity(DWORD pid,void*,ULONGLONG* created){++identityCalls;const auto i=procs.find(pid);bool available=identityCalls<=int(identityAvailability.size())?identityAvailability[identityCalls-1]:true;const bool reachable=i!=procs.end()&&(i->second.alive||i->second.allowOpenExited)&&available;const bool known=reachable&&i->second.queryKnown;bool ok=known||(reachable&&i->second.queryReturnsZero);if(ok)*created=known?i->second.birth:0;memoryLastError=ok?0:i==procs.end()||!i->second.alive?ERROR_INVALID_PARAMETER:ERROR_ACCESS_DENIED;op("memory-identity-query",{{"pid",pid},{"call",identityCalls},{"ok",ok},{"created",*created}});return ok;}
HANDLE OpenProcess(DWORD access,bool,DWORD pid){++openCalls;auto i=procs.find(pid);if(i==procs.end()||(!i->second.alive&&!(access==PROCESS_QUERY_LIMITED_INFORMATION&&i->second.allowOpenExited))||((access&PROCESS_SUSPEND_RESUME)&&!i->second.allowResume)){memoryLastError=i==procs.end()||(!i->second.alive&&!i->second.allowOpenExited)?ERROR_INVALID_PARAMETER:ERROR_ACCESS_DENIED;op("memory-process-open-denied",{{"pid",pid},{"access",access},{"live",i!=procs.end()&&i->second.alive}});return 0;}if(birthRaceOnOpen){i->second.birth+=4444;i->second.depth=1;birthRaceOnOpen=false;op("memory-pid-reused",{{"pid",pid},{"newBirth",i->second.birth}});}memoryLastError=0;const HANDLE h=nextHandle++;handles[h]={pid,access,i->second.birth};op("memory-process-open",{{"pid",pid},{"handle",h},{"birth",i->second.birth},{"access",access}});return h;}
ULONGLONG nativeProcessCreatedFromHandle(HANDLE h){const auto i=handles.find(h);const auto value=i!=handles.end()&&(i->second.access&PROCESS_QUERY_LIMITED_INFORMATION)&&procs[i->second.pid].queryKnown?i->second.birth:0;op("memory-opened-birth",{{"handle",h},{"birth",value}});return value;}
bool CloseHandle(HANDLE h){if(readHandles.count(h)){op("memory-file-close",{{"handle",h}});return readHandles.erase(h)>0;}op("memory-process-close",{{"handle",h}});return handles.erase(h)>0;}
constexpr DWORD GENERIC_READ=0x80000000,FILE_SHARE_READ=1,FILE_SHARE_WRITE=2,FILE_SHARE_DELETE=4,OPEN_EXISTING=3,FILE_ATTRIBUTE_NORMAL=128;constexpr HANDLE INVALID_HANDLE_VALUE=static_cast<HANDLE>(-1);
HANDLE CreateFileW(const wchar_t* raw,DWORD access,DWORD share,void*,DWORD disposition,DWORD flags,void*){const std::wstring p(raw);const bool ok=files.count(p)&&!readDenied.count(p)&&access==GENERIC_READ&&share==(FILE_SHARE_READ|FILE_SHARE_WRITE|FILE_SHARE_DELETE)&&disposition==OPEN_EXISTING&&flags==FILE_ATTRIBUTE_NORMAL;op("memory-file-open",{{"path",narrow(p)},{"ok",ok},{"access",access}});if(!ok)return INVALID_HANDLE_VALUE;const HANDLE h=nextFileHandle++;readHandles[h]={p,files[p],0};return h;}
bool ReadFile(HANDLE h,void* buffer,DWORD capacity,DWORD* count,void*){*count=0;auto i=readHandles.find(h);if(i==readHandles.end())return false;auto& f=i->second;if(readFailsPartway.count(f.path)&&f.offset){op("memory-file-read",{{"path",narrow(f.path)},{"ok",false}});return false;}size_t size=std::min<size_t>(capacity,f.bytes.size()-f.offset);if(readFailsPartway.count(f.path))size=std::min<size_t>(size,7);std::copy_n(f.bytes.data()+f.offset,size,static_cast<char*>(buffer));f.offset+=size;*count=static_cast<DWORD>(size);op("memory-file-read",{{"path",narrow(f.path)},{"ok",true},{"bytes",*count}});return true;}
bool GetExitCodeProcess(HANDLE h,DWORD* code){auto i=handles.find(h);if(i==handles.end()||!(i->second.access&PROCESS_QUERY_LIMITED_INFORMATION)||!procs.count(i->second.pid)){op("memory-exit-query",{{"handle",h},{"ok",false}});return false;}*code=procs[i->second.pid].alive?STILL_ACTIVE:0;op("memory-exit-query",{{"handle",h},{"pid",i->second.pid},{"exitCode",*code},{"ok",true}});return true;}
LONG countedNtResume(HANDLE h){++ntAttempts;auto hi=handles.find(h);if(hi==handles.end())return -1;auto& p=procs[hi->second.pid];json receipt={{"pid",hi->second.pid},{"birth",hi->second.birth},{"access",hi->second.access},{"depthBefore",p.depth}};if(p.nativeFail||!p.alive||p.depth<=0){receipt["success"]=false;resumeReceipts.push_back(receipt);op("memory-nt-resume",receipt);return -1;}--p.depth;++ntSuccesses;receipt["success"]=true;resumeReceipts.push_back(receipt);op("memory-nt-resume",receipt);return 0;}

json listFor(DWORD pid=100){return json::array({{{"pid",pid},{"processCreated",std::to_string(procs[pid].birth)}}});}
int resume(bool list,const std::wstring& dir=SG_SLEEP_LEASE_DIR){return list?sgResumeGameByPids(listFor(),dir).at("resumed").get<int>():sgResumeMarkedDirectoryUnlocked(dir,false).count;}
void routeCase(const char* label,bool list,bool expectMarker,int expectResume,int expectedAttempts=-1){json api=json::object();const int resumed=list?(api=sgResumeGameByPids(listFor(),SG_SLEEP_LEASE_DIR)).at("resumed").get<int>():sgResumeMarkedDirectoryUnlocked(SG_SLEEP_LEASE_DIR,false).count;const bool marker=files.count(key(SG_SLEEP_LEASE_DIR));bool exactOnly=true;for(const auto& r:resumeReceipts)exactOnly=exactOnly&&r.at("birth")==1234;json expected={{"markerRetained",expectMarker},{"resumed",expectResume},{"onlyAdmittedBirthResumed",true},{"ntAttempts",expectedAttempts}},actual={{"markerRetained",marker},{"resumed",resumed},{"ntAttempts",ntAttempts},{"ntSuccesses",ntSuccesses},{"currentBirth",procs[100].birth},{"remainingDepth",procs[100].depth},{"onlyAdmittedBirthResumed",exactOnly}};bool feedback=true;if(list){const auto failed=api.at("failedPids"),stale=api.at("stalePids");const bool failedTarget=std::find(failed.begin(),failed.end(),json(100))!=failed.end(),staleTarget=std::find(stale.begin(),stale.end(),json(100))!=stale.end(),needFailed=expectMarker&&expectResume==0,needStale=!expectMarker&&expectResume==0;expected["retryableFailureReported"]=needFailed;expected["staleReported"]=needStale;actual["retryableFailureReported"]=failedTarget;actual["staleReported"]=staleTarget;actual["apiResult"]=api;feedback=failedTarget==needFailed&&staleTarget==needStale;}const bool ok=marker==expectMarker&&resumed==expectResume&&exactOnly&&feedback&&(expectedAttempts<0||ntAttempts==expectedAttempts);record(label,expected,actual,ok);}

void reset(){readDenied.clear();readFailsPartway.clear();existsErrors.clear();iteratorErrors.clear();existsErrorValue=false;readHandles.clear();nextFileHandle=200000;files.clear();directories.clear();nonRegular.clear();procs.clear();procs[100]={};procs[101]={5678,1,true,true,true,false,2};handles.clear();nextHandle=10000;operations.clear();resumeReceipts.clear();ntAttempts=ntSuccesses=openCalls=identityCalls=focusCalls=memoryWaits=0;birthRaceOnOpen=false;currentSessionKnown=true;identityAvailability.clear();fnNtResume=countedNtResume;memoryLastError=0;g_sgSleepTarget={};g_manualPausedPid=0;}

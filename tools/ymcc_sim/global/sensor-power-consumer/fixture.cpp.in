static void check(const char* name,bool ok){checks.push_back({{"name",name},{"passed",ok},{"scenario",fixtureScenario}});}
static size_t countLog(const char* event){std::lock_guard<std::mutex> l(fixtureLogMx);return std::count_if(fixtureLogs.begin(),fixtureLogs.end(),[&](const auto& o){return o.value("event","")==event;});}
static json lastLog(const char* event){std::lock_guard<std::mutex> l(fixtureLogMx);for(auto i=fixtureLogs.rbegin();i!=fixtureLogs.rend();++i)if(i->value("event","")==event)return *i;return json::object();}
static bool waitLog(const char* e,size_t n){const auto start=GetTickCount64();while(GetTickCount64()-start<2000){if(countLog(e)>=n)return true;Sleep(1);}return false;}
static void powerCases(){
 // ORIGINAL_POWER_CASES_BEGIN
 fixtureOwnerGate=CreateEventW(nullptr,TRUE,FALSE,nullptr);g_sensorThreadWake=CreateEventW(nullptr,FALSE,FALSE,nullptr);g_sensorThreadMailbox.open();
 g_sensorThread=CreateThread(nullptr,0,inputCaptureSensorThreadProc,nullptr,0,nullptr);
 const auto started=GetTickCount64();suspendResumeSubscriptionCallback(nullptr,PBT_APMSUSPEND,nullptr);
 check("OS callback revokes admission before GUI exists",g_inputCaptureSensorsSuspended&&g_sensorPowerPausePending&&g_sensorSuspendCallbackActive);
 check("OS callback does not wait for sensor STA",GetTickCount64()-started<1000&&countLog("gyro-power-early-pause-completed")==0);
 check("OS callback does not change sleep generation or game lifecycle",currentPowerGeneration()==7&&g_powerLifecycle==PowerLifecycle::Ready);
 inputCaptureResumeSensorsForPower(true);
 check("stale Ready state cannot reopen an OS suspend callback",g_inputCaptureSensorsSuspended&&countLog("gyro-power-command-queued")==0);
 SetEvent(fixtureOwnerGate);check("actual STA completes early pause",waitLog("gyro-power-early-pause-completed",1));
 check("both readers and subscriptions stop on STA",lastLog("gyro-power-early-pause-completed").value("subscriptionsStopped",false));
 check("retained WinRT objects release requested cadence",g_gyroSensor.interval==0&&g_accelSensor.interval==0&&bool(g_gyroSensor)&&bool(g_accelSensor));
 check("stopped sensor binding rejects old provider generations",g_inputCaptureSink->activeBindingGeneration==0);
 g_idleSessionDisplayState=0;g_powerLifecycle=PowerLifecycle::Resuming;
 suspendResumeSubscriptionCallback(nullptr,PBT_APMRESUMEAUTOMATIC,nullptr);
 check("generic OS resume clears callback fence without handheld force",!g_sensorSuspendCallbackActive);
 inputCaptureResumeSensorsForPower();
 check("automatic resume while display OFF stays paused",g_inputCaptureSensorsSuspended&&countLog("gyro-power-command-queued")==0);
 const auto keep=fixtureKeepalive.load(),poll=fixturePolls.load();
 for(int i=0;i<3;++i){SetEvent(g_sensorThreadWake);Sleep(15);}
 check("OFF wakeups execute no sensor poll or high magnitude keepalive",fixtureKeepalive==keep&&fixturePolls==poll);
 inputCaptureSessionDisplayPowerChanged(2);check("DIM does not resume a paused sensor",g_inputCaptureSensorsSuspended);
 inputCaptureSessionDisplayPowerChanged(1);check("DIM to ON resumes through real helper",waitLog("gyro-power-command-completed",1));
 check("same retained objects resubscribe at configured interval",g_gyroSensor.interval==100&&g_accelSensor.interval==100&&g_gyroReadingChangedSubscribed&&g_accelReadingChangedSubscribed);
 check("sensor resume does not request a cold object rebind",fixtureColdStarts==0);
 check("resume receipt does not claim physical sleep verification",lastLog("gyro-power-command-completed").value("physicalSleepVerified",true)==false);
 g_powerLifecycle=PowerLifecycle::Ready;
 const auto queued=countLog("gyro-power-command-queued"),completed=countLog("gyro-power-command-completed");
 inputCaptureSessionDisplayPowerChanged(0);
 check("display OFF immediately revokes binding",g_inputCaptureSink->activeBindingGeneration==0&&g_inputCaptureSensorsSuspended);
 check("display OFF executes before any kernel event or generation change",g_powerLifecycle==PowerLifecycle::Ready&&currentPowerGeneration()==7);
 check("display OFF cancels wake retries",!g_sensorWakePollActive);
 inputCaptureSessionDisplayPowerChanged(0);
 check("repeated OFF queues exactly one stop",countLog("gyro-power-command-queued")==queued+1);
 check("display OFF has actual completion evidence",waitLog("gyro-power-command-completed",completed+1)&&lastLog("gyro-power-command-completed").value("subscriptionsStopped",false));
 auto ticket=g_sensorThreadMailbox.submit(SensorThreadRequest::Resubscribe);SetEvent(g_sensorThreadWake);
 check("old queued resubscribe is consumed without reopening while OFF",g_sensorThreadMailbox.wait(ticket,std::chrono::milliseconds(2000))==ymcc::sensors::ThreadMailbox::Result::Completed&&!g_gyroReadingChangedSubscribed&&!g_msiSensorApiProvider.running());
 inputCaptureSessionDisplayPowerChanged(9);check("invalid display state is ignored",g_idleSessionDisplayState==0);
 g_idleSessionDisplayState=-1;g_idleLegacyMonitorState=0;check("legacy OFF fallback blocks sensors",!inputCaptureSensorPowerMayRun());
 g_idleSessionDisplayState=1;check("session display state takes precedence over legacy OFF",inputCaptureSensorPowerMayRun());
 inputCaptureResumeSensorsForPower();check("valid ON restores reader",waitLog("gyro-power-command-completed",completed+2));
 g_gyroSensor.failRevoke=true;g_msiSensorApiProvider.blockStop=true;
 inputCaptureSessionDisplayPowerChanged(0);check("failed revoke and stuck provider do not report fully stopped",waitLog("gyro-power-command-completed",completed+3)&&!lastLog("gyro-power-command-completed").value("subscriptionsStopped",true)&&countLog("gyro-power-unsubscribe-failed")>0);
 inputCaptureSessionDisplayPowerChanged(1);
 check("resume with an unretired reader retains paused admission",waitLog("gyro-power-command-completed",completed+4)&&g_inputCaptureSensorsSuspended&&countLog("gyro-power-resubscribe-deferred")>0);
 g_gyroSensor.failRevoke=false;g_msiSensorApiProvider.blockStop=false;
 inputCaptureSessionDisplayPowerChanged(1);check("later valid resume can retry an unsuccessful revoke",waitLog("gyro-power-command-completed",completed+5)&&g_gyroReadingChangedSubscribed);
 auto shutdown=g_sensorThreadMailbox.submit(SensorThreadRequest::Shutdown);SetEvent(g_sensorThreadWake);
 check("actual STA shuts down normally",WaitForSingleObject(g_sensorThread,3000)==WAIT_OBJECT_0);
 CloseHandle(g_sensorThread);CloseHandle(g_sensorThreadWake);CloseHandle(fixtureOwnerGate);g_sensorThread=nullptr;g_sensorThreadWake=nullptr;
 inputCaptureSuspendSensorsForPower();check("missing owner reports rejection and retains paused admission",g_inputCaptureSensorsSuspended&&countLog("gyro-power-command-rejected")>0);
 // ORIGINAL_POWER_CASES_END
}

static size_t countPhase(const char* phase){std::lock_guard<std::mutex> lock(fixtureLogMx);
 return std::count_if(fixtureLogs.begin(),fixtureLogs.end(),[&](const auto& o){return o.value("event","")=="gyro-virtual-link-wake"&&o.value("phase","")==phase;});}
static json lastPhase(const char* phase){std::lock_guard<std::mutex> lock(fixtureLogMx);
 for(auto i=fixtureLogs.rbegin();i!=fixtureLogs.rend();++i)if(i->value("event","")=="gyro-virtual-link-wake"&&i->value("phase","")==phase)return *i;return json::object();}
static bool waitPhase(const char* phase,size_t n){const auto start=GetTickCount64();
 while(GetTickCount64()-start<2000){if(countPhase(phase)>=n)return true;Sleep(1);}return false;}
static json fixtureInput(unsigned revision=1){return {{"outputTarget",{{"revision",revision},{"gyroEnabled",true}}},
 {"gyroMotion",{{"enabled",true},{"outputMode","virtual-stick"},{"motionMode","on"}}}};}
static void clearFixtureLogs(){std::lock_guard<std::mutex> lock(fixtureLogMx);fixtureLogs.clear();}
static void resetBusy(){g_gyroJudgeState=GyroJudgeState::Idle;g_sensorWakePollActive=false;g_gyroCalibRequested=false;
 g_gyroCalibStageAtomic=GyroCalibStage::None;fixtureSelectionWork=false;g_windowsSourceProbeBusy=false;
 std::atomic_store(&g_windowsDefaultSelectedRoute,std::shared_ptr<int>{});std::atomic_store(&g_windowsPrivateConsumerProjection,std::shared_ptr<int>{});}
static void cachePair(UINT64 receipt,UINT64 sequence=431){const auto sink=g_inputCaptureSink;std::lock_guard<std::mutex> lock(sink->mx);
 sink->gyroOk=sink->accelOk=true;sink->gyroBindingGeneration=sink->accelBindingGeneration=sink->activeBindingGeneration.load();
 sink->gyroReceiptTick=sink->accelReceiptTick=receipt;sink->gyroSequence=sink->accelSequence=sequence;
 sink->gyroTimestamp100ns=sink->accelTimestamp100ns=sequence*10000;}
static void prepareVirtual(bool enabled=true){
 g_virtualGyroWake.configure(json{{"fixture-reset",true}},false);g_virtualGyroWake.cancelPending();
 fixtureClock=100000;fixtureHostEpoch=41;fixturePowerGeneration=7;fixtureGameOverrideActive=false;
 g_inputHostFaultHoldsStart=false;g_inputHostPowerAdmissionRevoked=false;g_inputHostRecoveryIntentReset=false;fixtureHostExitFence=false;
 g_inputHostActive=true;g_inputHostRequestedPersonaMatchesBound=true;fixtureDuringRevoke={};
 g_powerLifecycle=PowerLifecycle::Ready;g_idleSessionDisplayState=1;g_idleLegacyMonitorState=1;
 g_inputCaptureSensorsSuspended=false;g_sensorPowerPausePending=false;g_sensorSuspendCallbackActive=false;
 g_inputReady=true;g_exitRequested=false;g_externalPriorityVirtualSuspended=false;g_sleepRecoveryOutputWanted=true;g_inputCaptureReady=true;
 g_machineIdentity.family=YmccFamily::Rog;g_machineIdentity.resolved=true;resetBusy();g_gyroJudgeTaskEnabled=false;
 g_sensorThreadMailbox.close();g_sensorThreadMailbox.open();g_windowsSensorDeviceChange.reset();g_sensorUnsubscribeRetained=false;
 g_inputCaptureSensorGeneration+=10;g_inputCaptureSink=std::make_shared<FixtureSink>();g_inputCaptureSink->SetBindingGeneration(g_inputCaptureSensorGeneration);
 g_gyroSensor.reset();g_accelSensor.reset();g_gyroReadingChangedSubscribed=g_accelReadingChangedSubscribed=true;
 g_gyroReadingChangedToken=g_accelReadingChangedToken=1;
 g_msiSensorApiProvider.alive=g_hcWindowsSensorApiProvider.alive=false;g_msiSensorApiProvider.blockStop=g_hcWindowsSensorApiProvider.blockStop=false;
 g_sensorMeta={"winrt","winrt",true,true};fixtureColdStarts=0;clearFixtureLogs();cachePair(fixtureSensorTick()-1000);
 // The effective enable boolean and game owner admission are explicit memory
 // inputs; the production Configure function and context construction execute.
 inputCaptureConfigureVirtualGyroWake(fixtureInput(),enabled);
}
static bool beginVirtualCase(const char* name,const std::string& selected){if(!selected.empty()&&selected!=name)return false;
 fixtureScenario=name;executedScenarios.push_back(name);return true;}
static bool noResubscribe(){return g_gyroSensor.subscriptions==0&&g_accelSensor.subscriptions==0&&fixtureColdStarts==0;}
static void virtualCases(const std::string& selected){
 if(beginVirtualCase("disabled",selected)){
  prepareVirtual(false);inputCaptureNoteVirtualGyroReady(inputHostEpochToken(),g_virtualGyroWake.configuration());fixtureClock=100750;inputCaptureVirtualGyroWakeStep();
  check("virtual link OFF rejects the ready notification",countPhase("queued")==0);
  check("virtual link OFF leaves no deadline",g_virtualGyroWake.waitMs(fixtureSensorTick(),INFINITE)==INFINITE);
  check("virtual link OFF never resubscribes",noResubscribe());
 }
 if(beginVirtualCase("healthy",selected)){
  prepareVirtual();const auto generation=g_inputCaptureSensorGeneration;inputCaptureNoteVirtualGyroReady(inputHostEpochToken(),g_virtualGyroWake.configuration());inputCaptureNoteVirtualGyroReady(inputHostEpochToken(),g_virtualGyroWake.configuration());
  fixtureClock=100749;inputCaptureVirtualGyroWakeStep();check("virtual link waits the full 750ms and deduplicates ready",countPhase("queued")==1&&noResubscribe()&&g_virtualGyroWake.waitMs(fixtureSensorTick(),INFINITE)==1);
  fixtureClock=100750;cachePair(fixtureSensorTick()-250,2);inputCaptureVirtualGyroWakeStep();
  check("virtual link healthy pair never resubscribes",noResubscribe()&&g_inputCaptureSensorGeneration==generation&&countPhase("already-streaming")==1);
  check("virtual link healthy result keeps game consumption unproven",!lastPhase("already-streaming").value("gameConsumptionProven",true));
  inputCaptureNoteVirtualGyroReady(inputHostEpochToken(),g_virtualGyroWake.configuration());fixtureClock=110000;inputCaptureVirtualGyroWakeStep();
  check("virtual link healthy result has no repeating deadline",countPhase("queued")==1&&g_virtualGyroWake.waitMs(fixtureSensorTick(),INFINITE)==INFINITE&&noResubscribe());
 }
 if(beginVirtualCase("reconfigured",selected)){
  prepareVirtual();inputCaptureNoteVirtualGyroReady(inputHostEpochToken(),g_virtualGyroWake.configuration());inputCaptureConfigureVirtualGyroWake(fixtureInput(2),true);
  fixtureClock=100750;inputCaptureVirtualGyroWakeStep();
  check("virtual link reconfiguration invalidates the pending old configuration",noResubscribe()&&g_virtualGyroWake.waitMs(fixtureSensorTick(),INFINITE)==INFINITE);
  inputCaptureNoteVirtualGyroReady(inputHostEpochToken(),g_virtualGyroWake.configuration());check("virtual link new configuration gets its own settle window",g_virtualGyroWake.waitMs(fixtureSensorTick(),INFINITE)==750);
  inputCaptureConfigureVirtualGyroWake(fixtureInput(2),false);fixtureClock=101500;inputCaptureVirtualGyroWakeStep();
  check("virtual link OFF invalidates a previously queued ON",noResubscribe()&&g_virtualGyroWake.waitMs(fixtureSensorTick(),INFINITE)==INFINITE);
 }
 if(beginVirtualCase("old-ack-configuration",selected)){
  prepareVirtual();const auto frameConfig=g_virtualGyroWake.configuration();inputCaptureConfigureVirtualGyroWake(fixtureInput(2),true);
  inputCaptureNoteVirtualGyroReady(inputHostEpochToken(),frameConfig);
  check("virtual link rejects an ACK captured under the old configuration",countPhase("queued")==0&&g_virtualGyroWake.waitMs(fixtureSensorTick(),INFINITE)==INFINITE);
  check("virtual link rejected old ACK does not consume current readiness",g_virtualGyroWake.needsReady(inputHostEpochToken(),currentPowerGeneration()));
  inputCaptureNoteVirtualGyroReady(inputHostEpochToken(),g_virtualGyroWake.configuration());
  check("virtual link current-configuration ACK gets one fresh deadline",countPhase("queued")==1&&g_virtualGyroWake.waitMs(fixtureSensorTick(),INFINITE)==750);
 }
 if(beginVirtualCase("expired-ready",selected)){
  prepareVirtual();inputCaptureNoteVirtualGyroReady(inputHostEpochToken(),g_virtualGyroWake.configuration());fixtureClock=105001;inputCaptureVirtualGyroWakeStep();
  check("virtual link drops a ready ticket after its original five-second lifetime",noResubscribe()&&g_virtualGyroWake.waitMs(fixtureSensorTick(),INFINITE)==INFINITE);
  inputCaptureNoteVirtualGyroReady(inputHostEpochToken(),g_virtualGyroWake.configuration());
  check("virtual link expired ticket does not loop on the same Host and configuration",countPhase("queued")==1&&noResubscribe());
 }
 if(beginVirtualCase("verification-expiry",selected)){
  prepareVirtual();inputCaptureNoteVirtualGyroReady(inputHostEpochToken(),g_virtualGyroWake.configuration());fixtureClock=100750;
  const auto original=g_virtualGyroWake.take(fixtureSensorTick(),inputHostEpochToken(),currentPowerGeneration());
  check("virtual link ticket lifetime starts at the accepted ready time",original&&original->expires==105000);
  if(original&&g_virtualGyroWake.commit(*original,inputHostEpochToken(),currentPowerGeneration(),fixtureSensorTick(),[]{return inputCaptureVirtualGyroHostMayWake();})){

struct FixtureSink{
 std::atomic<UINT64> activeBindingGeneration{10};std::mutex mx;
 UINT64 gyroHighMotionEpisode=0,accelMotionEpisode=0;
 bool gyroOk=false,accelOk=false;
 UINT64 gyroBindingGeneration=0,accelBindingGeneration=0,gyroReceiptTick=0,accelReceiptTick=0;
 UINT64 gyroSequence=0,accelSequence=0,gyroTimestamp100ns=0,accelTimestamp100ns=0;
 void ResetSamples(){std::lock_guard<std::mutex> lock(mx);gyroOk=accelOk=false;
  gyroBindingGeneration=accelBindingGeneration=gyroReceiptTick=accelReceiptTick=0;
  gyroSequence=accelSequence=gyroTimestamp100ns=accelTimestamp100ns=0;}
 void SetBindingGeneration(UINT64 g){activeBindingGeneration.store(g);}
 void OnGyro(int,UINT64 g){std::lock_guard<std::mutex> lock(mx);if(g!=activeBindingGeneration.load()||!g)return;
  gyroOk=true;gyroBindingGeneration=g;gyroReceiptTick=fixtureSensorTick();gyroTimestamp100ns=++gyroSequence*10000;}
 void OnAccel(int,UINT64 g){std::lock_guard<std::mutex> lock(mx);if(g!=activeBindingGeneration.load()||!g)return;
  accelOk=true;accelBindingGeneration=g;accelReceiptTick=fixtureSensorTick();accelTimestamp100ns=++accelSequence*10000;}
};
static auto g_inputCaptureSink=std::make_shared<FixtureSink>();
static std::function<void()> fixtureDuringRevoke;
struct FixtureSensor{
 bool present=true,failRevoke=false;UINT32 interval=100;
 std::atomic<unsigned> subscriptions{0},revocations{0},releases{0};
 void reset(){present=true;failRevoke=false;interval=100;subscriptions=revocations=releases=0;}
 explicit operator bool()const{return present;}
 FixtureSensor& operator=(std::nullptr_t){present=false;++releases;return *this;}
 UINT32 MinimumReportInterval()const{return 10;}
 void ReportInterval(UINT32 v){interval=v;}
 void ReadingChanged(int){if(failRevoke)throw std::runtime_error("fixture revoke failure");++revocations;auto action=std::move(fixtureDuringRevoke);if(action)action();}
 template<class F>int ReadingChanged(F){return static_cast<int>(++subscriptions)+1;}
};

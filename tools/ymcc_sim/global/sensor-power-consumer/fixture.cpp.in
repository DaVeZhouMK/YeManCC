static void prepareOriginalPowerCases(){
 prepareVirtual(false);fixtureClock=0;fixturePowerGeneration=7;g_machineIdentity.family=YmccFamily::Other;
 g_sensorWakePollActive=true;g_gyroJudgeTaskEnabled=true;g_msiSensorApiProvider.alive=g_hcWindowsSensorApiProvider.alive=true;
 g_sensorMeta={"sensorapi","sensorapi",true,true};clearFixtureLogs();fixtureScenario="power";
}
int main(int argc,char** argv){
 const bool powerOnly=argc==2&&std::string(argv[1])=="--power-only";
 const bool caseOnly=argc==3&&std::string(argv[1])=="--case";
 if(argc!=1&&!powerOnly&&!caseOnly){fprintf(stderr,"Unsupported sensor-power selection\n");return 2;}
 try{
  if(!powerOnly)virtualCases(caseOnly?argv[2]:"");
  if(caseOnly&&executedScenarios.empty())throw std::runtime_error("Unknown or empty virtual link case selection");
  if(!caseOnly){prepareOriginalPowerCases();executedScenarios.push_back("power");powerCases();}
 }catch(const std::exception& error){check(error.what(),false);}
 const bool ok=!checks.empty()&&std::all_of(checks.begin(),checks.end(),[](const auto& c){return c.value("passed",false);});
 json result={{"ok",ok},{"cases",checks},{"executedScenarios",executedScenarios},{"logs",fixtureAllLogs},{"hardwareIo",false},{"normalYmccStarted",false}};
 printf("%s\n",result.dump().c_str());return ok?0:1;
}

 cases.emplace_back("cold-start-cannot-bypass-provider-debt",[]{Scope owner;const auto state=owner.blocked(g_msiSensorApiProvider);g_gyroSensor.present=g_accelSensor.present=false;inputCaptureStartWinRtSensorsImpl();check(g_inputCaptureSensorsSuspended&&winrtDiscoveryAttempts==0&&!g_msiSensorApiProvider.stopped(),"actual cold Start cannot probe new WinRT objects before old provider return");::SetEvent(state->release);until([&]{return !g_msiSensorApiProvider.running();});g_inputCaptureSensorsSuspended=false;inputCaptureStartWinRtSensorsImpl();check(g_msiSensorApiProvider.stopped()&&winrtDiscoveryAttempts==2,"fresh actual cold Start first returns old provider then reaches inert WinRT discovery");});
 if(argc>2){::CoUninitialize();return 2;}const std::string selection=argc==2?argv[1]:"";const bool suffix=selection.starts_with("from:");const auto name=suffix?selection.substr(5):selection;if(argc==2&&std::none_of(cases.begin(),cases.end(),[&](const auto& c){return c.first==name;})){::CoUninitialize();return 2;}json selected=json::array(),failures=json::array();bool reached=false;for(const auto& c:cases){if(c.first==name)reached=true;if(argc==2&&!(suffix?reached:c.first==name))continue;selected.push_back(c.first);try{c.second();}catch(const std::exception& error){failures.push_back({{"case",c.first},{"message",error.what()}});break;}}::CoUninitialize();std::cout<<json({{"cases",selected},{"assertions",assertions},{"failures",failures},{"actualResourcesReturned",resourcesReturned},{"physicalDeviceIo",false},{"originalProviderFullHeader",true}}).dump()<<std::endl;return failures.empty()?0:1;}

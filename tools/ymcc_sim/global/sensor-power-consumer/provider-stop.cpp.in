struct NativeHandle{HANDLE value;bool thread,closed=false;DWORD id=0;};
static std::mutex traceMx;
static std::vector<NativeHandle> handles;
static std::atomic<bool> failThreadClose{false},failEventClose{false},failThreadWait{false};
static std::atomic<DWORD> heldWaitCaller{0};
static HANDLE waitEntered=nullptr,waitRelease=nullptr;
static unsigned cancellationCalls=0,unexpectedDiscoveries=0;
static std::vector<HRESULT> cancelResults;
static bool ownedThread(HANDLE h){std::lock_guard<std::mutex> lock(traceMx);for(auto it=handles.rbegin();it!=handles.rend();++it)if(it->value==h&&!it->closed)return it->thread;return false;}
static HANDLE providerEvent(LPSECURITY_ATTRIBUTES a,BOOL manual,BOOL initial,LPCWSTR n){const auto h=::CreateEventW(a,manual,initial,n);if(h){std::lock_guard<std::mutex> lock(traceMx);handles.push_back({h,false,false,0});}return h;}
static HANDLE providerThread(LPSECURITY_ATTRIBUTES a,SIZE_T size,LPTHREAD_START_ROUTINE entry,LPVOID p,DWORD flags,LPDWORD id){const auto h=::CreateThread(a,size,entry,p,flags,id);if(h){std::lock_guard<std::mutex> lock(traceMx);handles.push_back({h,true,false,id?*id:0});}return h;}
static BOOL providerClose(HANDLE h){std::lock_guard<std::mutex> lock(traceMx);for(auto it=handles.rbegin();it!=handles.rend();++it)if(it->value==h&&!it->closed){if((it->thread&&failThreadClose)||(!it->thread&&failEventClose)){SetLastError(ERROR_ACCESS_DENIED);return FALSE;}const auto ok=::CloseHandle(h);if(ok)it->closed=true;return ok;}return ::CloseHandle(h);}
static DWORD providerWait(HANDLE h,DWORD budget){if(ownedThread(h)){if(failThreadWait){SetLastError(ERROR_INVALID_HANDLE);return WAIT_FAILED;}if(budget&&heldWaitCaller==GetCurrentThreadId()){::SetEvent(waitEntered);::WaitForSingleObject(waitRelease,2500);}}return ::WaitForSingleObject(h,budget);}
static HRESULT providerCancel(DWORD id,ULONG timeout){++cancellationCalls;const auto hr=::CoCancelCall(id,timeout);cancelResults.push_back(hr);return hr;}
static HRESULT noDeviceDiscovery(REFCLSID,LPUNKNOWN,DWORD,REFIID,LPVOID* output){++unexpectedDiscoveries;if(output)*output=nullptr;return E_UNEXPECTED;}
#define CreateEventW providerEvent
#define CreateThread providerThread
#define CloseHandle providerClose
#define WaitForSingleObject providerWait
#define CoCancelCall providerCancel
#define CoCreateInstance noDeviceDiscovery

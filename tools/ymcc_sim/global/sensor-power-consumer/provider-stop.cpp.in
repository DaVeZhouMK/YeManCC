static int __cdecl readSharedSystemPower(ymcc::sleeppower::SharedPowerV1* output,uint32_t bytes){
 if(!output||bytes<sizeof(*output)||g_exitRequested.load())return 0;
 ymcc::sleeppower::SharedPowerV1 power;power.generation=1;power.publicationRevision=1;
 power.phase=static_cast<uint32_t>(g_powerLifecycle.load());power.observedNotificationSequence=g_sleepPowerDispatch.observedSequence();
 power.flags=ymcc::sleeppower::kKnown|(power.phase==0?ymcc::sleeppower::kHardwareAllowed:0u)|
  (g_sleepPowerDispatch.pendingSuspend()?ymcc::sleeppower::kNotificationPending:0u);*output=power;return 1;
}

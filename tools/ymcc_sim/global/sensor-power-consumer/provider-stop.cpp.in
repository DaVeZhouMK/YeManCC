static unsigned assertions=0,resourcesReturned=0;
static void check(bool ok,const char* why){++assertions;if(!ok)throw std::runtime_error(why);}
static void until(const std::function<bool()>& done){const auto end=GetTickCount64()+2500;while(!done()){if(GetTickCount64()>=end)throw std::runtime_error("actual provider deadline");Sleep(1);}}
static unsigned openHandles(){std::lock_guard<std::mutex> lock(traceMx);unsigned n=0;for(const auto& h:handles)if(!h.closed)++n;return n;}
static HANDLE latestThread(){std::lock_guard<std::mutex> lock(traceMx);for(auto it=handles.rbegin();it!=handles.rend();++it)if(it->thread&&!it->closed)return it->value;return nullptr;}
struct Scope{
 std::vector<std::shared_ptr<Shared>> sdk;
 Scope(){check(g_msiSensorApiProvider.stopped()&&g_hcWindowsSensorApiProvider.stopped(),"prior original provider owners returned");handles.clear();winrtDiscoveryAttempts=0;cancelResults.clear();cancellationCalls=0;unexpectedDiscoveries=0;failThreadClose=false;failEventClose=false;failThreadWait=false;heldWaitCaller=0;throwDiagnostic=false;logs.clear();g_powerLifecycle=PowerLifecycle::Ready;g_idleSessionDisplayState=1;g_idleLegacyMonitorState=1;g_sensorSuspendCallbackActive=false;g_inputCaptureSensorsSuspended=false;g_sensorWakePollActive=false;g_sensorUnsubscribeRetained=false;g_gyroReadingChangedSubscribed=false;g_accelReadingChangedSubscribed=false;g_gyroSensor=WinRtPort{};g_accelSensor=WinRtPort{};g_sensorMeta={};g_sensorThreadMailbox.close();g_sensorThreadMailbox.open();waitEntered=::CreateEventW(nullptr,TRUE,FALSE,nullptr);waitRelease=::CreateEventW(nullptr,TRUE,FALSE,nullptr);g_sensorActivePower.store(ymcc::inputHost::sharedPower::Scope::create(&readSharedSystemPower,g_sharedPowerRevocations,true,ymcc::inputHost::sharedPower::Use::Lifecycle));}
 std::shared_ptr<Shared> blocked(Provider& provider,UINT64 generation=11){auto state=std::make_shared<Shared>();state->block=true;sdk.push_back(state);check(provider.start(options(state,generation)),"complete original Provider.start accepted SDK interface transport");check(::WaitForSingleObject(state->readEntered,2500)==WAIT_OBJECT_0,"actual original MTA reaches blocked SDK GetData");return state;}
 ~Scope(){g_sensorActivePower.store({});failThreadClose=false;failEventClose=false;failThreadWait=false;heldWaitCaller=0;throwDiagnostic=false;::SetEvent(waitRelease);for(const auto& state:sdk)::SetEvent(state->release);const bool retired=g_msiSensorApiProvider.stop(2500)&&g_hcWindowsSensorApiProvider.stop(2500)&&g_msiSensorApiProvider.stopped()&&g_hcWindowsSensorApiProvider.stopped();bool com=true;for(const auto& s:sdk)com&=s->managers==0&&s->sensors==0&&s->reports==0&&s->writes==0&&s->permissions==0&&s->createdThread==s->destroyedThread;sdk.clear();const bool gates=::CloseHandle(waitEntered)&&::CloseHandle(waitRelease);waitEntered=waitRelease=nullptr;if(retired&&com&&gates&&openHandles()==0&&unexpectedDiscoveries==0)++resourcesReturned;else std::terminate();}
};
struct StopAttempt{std::thread worker;std::atomic<bool> result{true};explicit StopAttempt(Provider& provider){worker=std::thread([this,&provider]{const auto com=::CoInitializeEx(nullptr,COINIT_MULTITHREADED);heldWaitCaller=GetCurrentThreadId();result=provider.stop(20);heldWaitCaller=0;if(SUCCEEDED(com))::CoUninitialize();});check(::WaitForSingleObject(waitEntered,2500)==WAIT_OBJECT_0,"actual stop holds original lifecycle mutex at thread wait");}void finish(){::SetEvent(waitRelease);if(worker.joinable())worker.join();}~StopAttempt(){finish();}};

int main(int argc,char** argv){const auto com=::CoInitializeEx(nullptr,COINIT_APARTMENTTHREADED);if(FAILED(com))return 2;std::vector<std::pair<std::string,std::function<void()>>> cases;
 cases.emplace_back("busy-provider-is-not-retired",[]{Scope owner;const auto state=owner.blocked(g_msiSensorApiProvider);StopAttempt stopping(g_msiSensorApiProvider);check(!g_msiSensorApiProvider.running()&&!g_msiSensorApiProvider.stopped(),"busy actual provider query is unknown rather than stopped");readyResume();const bool rejected=g_inputCaptureSensorsSuspended&&g_gyroSensor.subscriptions==0&&g_accelSensor.subscriptions==0;stopping.finish();check(rejected,"busy provider lifecycle is not permission to resubscribe");::SetEvent(state->release);until([&]{return !g_msiSensorApiProvider.running();});readyResume();check(g_msiSensorApiProvider.stopped()&&g_gyroSensor.subscriptions==1&&g_accelSensor.subscriptions==1,"fresh consumer Resume first returns exact old provider resources");check(state->samples==0&&state->createdThread!=GetCurrentThreadId()&&state->createdThread==state->destroyedThread,"late cancelled SDK reading cannot publish and COM returns on original MTA");});
 cases.emplace_back("partial-stop-event-keeps-owner-debt",[]{Scope owner;const auto state=owner.blocked(g_msiSensorApiProvider);check(!g_msiSensorApiProvider.stop(0),"blocked provider stop remains pending");const auto thread=latestThread();::SetEvent(state->release);check(::WaitForSingleObject(thread,2500)==WAIT_OBJECT_0,"actual provider thread returned before stop-event close fault");failEventClose=true;check(!g_msiSensorApiProvider.stop(0)&&!g_msiSensorApiProvider.stopped()&&!g_msiSensorApiProvider.running(),"partial close retains stop event and State after thread close");readyResume();check(g_inputCaptureSensorsSuspended&&g_gyroSensor.subscriptions==0,"returned thread with retained stop event is not resource return");failEventClose=false;readyResume();check(g_msiSensorApiProvider.stopped()&&g_gyroSensor.subscriptions==1,"later original stop closes exact pending event before resubscribe");});
 cases.emplace_back("failed-thread-close-keeps-owner-debt",[]{Scope owner;const auto state=owner.blocked(g_msiSensorApiProvider);check(!g_msiSensorApiProvider.stop(0),"first stop retained blocked owner");const auto thread=latestThread();::SetEvent(state->release);check(::WaitForSingleObject(thread,2500)==WAIT_OBJECT_0,"actual thread terminal before close fault");failThreadClose=true;check(!g_msiSensorApiProvider.stop(0)&&openHandles()==2,"failed CloseHandle retains exact thread and event");readyResume();check(g_inputCaptureSensorsSuspended&&g_gyroSensor.subscriptions==0,"unclosed provider thread cannot authorize WinRT subscriptions");failThreadClose=false;readyResume();check(g_msiSensorApiProvider.stopped()&&openHandles()==0&&g_gyroSensor.subscriptions==1,"actual original close path returns both resources");});
 cases.emplace_back("unknown-provider-wait-keeps-ownership",[]{Scope owner;const auto state=owner.blocked(g_msiSensorApiProvider);failThreadWait=true;check(!g_msiSensorApiProvider.stop(0)&&!g_msiSensorApiProvider.running()&&!g_msiSensorApiProvider.stopped(),"unknown wait is not stopped or owner return");readyResume();check(g_inputCaptureSensorsSuspended&&g_gyroSensor.subscriptions==0&&openHandles()==2,"consumer preserves provider debt under unknown wait");failThreadWait=false;::SetEvent(state->release);until([&]{return !g_msiSensorApiProvider.running();});readyResume();check(g_msiSensorApiProvider.stopped()&&g_gyroSensor.subscriptions==1,"fresh actual return allows same objects after unknown observation");});
 cases.emplace_back("blocked-stop-is-bounded-and-no-stack",[]{Scope owner;const auto state=owner.blocked(g_msiSensorApiProvider);const auto before=GetTickCount64();check(!g_msiSensorApiProvider.stop(20)&&GetTickCount64()-before<1000,"original Provider.stop keeps bounded wait");auto fresh=std::make_shared<Shared>();check(!g_msiSensorApiProvider.start(options(fresh,22))&&fresh->managers==0,"same Provider cannot stack worker while old GetData blocked");readyResume();check(g_inputCaptureSensorsSuspended&&g_gyroSensor.subscriptions==0&&cancellationCalls>=1,"consumer defers until actual MTA returns after cancellation request");::SetEvent(state->release);until([&]{return !g_msiSensorApiProvider.running();});readyResume();check(g_msiSensorApiProvider.stopped()&&state->samples==0,"actual late GetData remains cancelled while resources drain");});
 cases.emplace_back("hc-provider-slot-uses-same-strict-return",[]{Scope owner;const auto state=owner.blocked(g_hcWindowsSensorApiProvider,33);StopAttempt stopping(g_hcWindowsSensorApiProvider);readyResume();const bool paused=g_inputCaptureSensorsSuspended&&g_accelSensor.subscriptions==0;stopping.finish();check(paused,"second actual provider slot cannot be mistaken stopped while locked");::SetEvent(state->release);until([&]{return !g_hcWindowsSensorApiProvider.running();});readyResume();check(g_hcWindowsSensorApiProvider.stopped()&&g_hcWindowsSensorApiGeneration==0&&g_accelSensor.subscriptions==1,"original HC stop helper retires actual slot and generation");});
 cases.emplace_back("power-suspend-does-not-start-new-subscriptions",[]{Scope owner;const auto state=owner.blocked(g_msiSensorApiProvider);g_powerLifecycle=PowerLifecycle::Suspended;readyResume();check(g_gyroSensor.subscriptions==0&&g_msiSensorApiProvider.running(),"original power predicate refuses Resume before provider work");g_powerLifecycle=PowerLifecycle::Ready;check(!g_msiSensorApiProvider.stop(0),"old provider cancellation still pending");::SetEvent(state->release);until([&]{return !g_msiSensorApiProvider.running();});readyResume();check(g_msiSensorApiProvider.stopped()&&g_gyroSensor.subscriptions==1,"new admitted consumer request returns old provider first");});
 cases.emplace_back("full-stop-keeps-provider-debt-separate",[]{Scope owner;const auto state=owner.blocked(g_msiSensorApiProvider);inputCaptureStopWinRtSensorsImpl();check(!g_sensorUnsubscribeRetained&&!g_gyroSensor&&!g_accelSensor&&!g_msiSensorApiProvider.stopped(),"original full Stop retires apartment objects but retains separate provider debt");::SetEvent(state->release);until([&]{return !g_msiSensorApiProvider.running();});check(g_msiSensorApiProvider.stop(0)&&g_msiSensorApiProvider.stopped()&&openHandles()==0,"only actual provider return discharges its remaining debt");});
 cases.emplace_back("stop-diagnostic-cannot-skip-independent-retirement",[]{Scope owner;const auto msi=owner.blocked(g_msiSensorApiProvider);const auto hc=owner.blocked(g_hcWindowsSensorApiProvider,33);g_gyroReadingChangedSubscribed=g_accelReadingChangedSubscribed=true;throwDiagnostic=true;bool escaped=false;try{inputCaptureStopWinRtSensorsImpl();}catch(...){escaped=true;}throwDiagnostic=false;check(!escaped&&!g_gyroReadingChangedSubscribed&&!g_accelReadingChangedSubscribed&&g_gyroSensor.revocations==1&&g_accelSensor.revocations==1,"failed stop diagnostics cannot skip independent WinRT token retirement");check(!g_msiSensorApiProvider.stopped()&&!g_hcWindowsSensorApiProvider.stopped()&&cancellationCalls>=2,"both actual Provider owners remain owed after bounded cancellation");::SetEvent(msi->release);::SetEvent(hc->release);until([&]{return !g_msiSensorApiProvider.running()&&!g_hcWindowsSensorApiProvider.running();});check(g_msiSensorApiProvider.stop(0)&&g_hcWindowsSensorApiProvider.stop(0)&&msi->samples==0&&hc->samples==0,"late SDK work cannot resurrect either cancelled provider");});

static void appendNativeLifecycleLog(const char* event,const json& data){
 const std::string name=event;
 if(name=="gyro-power-sta-recovery"&&data.value("phase","")=="command-retry-issued"&&injectNewResumeAtRetry.exchange(false))submitNewResume();
 if(name=="gyro-power-sta-recovery"){++recoveryLogCalls;if(g_sensorThreadMx.try_lock()){++recoveryLogsUnlocked;g_sensorThreadMx.unlock();}if(throwRecoveryLog)throw std::runtime_error("recovery diagnostics failed");}
 if(name=="gyro-power-command-queued"){
  if constexpr(hasRepair){if(g_sensorThreadMx.try_lock()){++loggerUnlocked;g_sensorThreadMx.unlock();}}
  {std::lock_guard<std::mutex> lock(logMx);queued.push_back(data);}
  if(throwQueuedLog.exchange(false))throw std::runtime_error("queued log failure");
 }else if(name=="gyro-power-command-completed"){if(throwCompletedLog.exchange(false))throw std::runtime_error("completed log failed");std::lock_guard<std::mutex> lock(logMx);completed.push_back(data);}
 else if(name=="gyro-power-command-rejected"){std::lock_guard<std::mutex> lock(logMx);fixtureRejectedReceipts.push_back(data);}
 else if(name=="gyro-power-early-pause-completed"&&throwEarlyLog.exchange(false))throw std::runtime_error("early pause log failed");
 else if(name=="input-capture-sensor-owner-rejected"&&throwOwnerLog.exchange(false))throw std::runtime_error("owner rejection log failed");
}

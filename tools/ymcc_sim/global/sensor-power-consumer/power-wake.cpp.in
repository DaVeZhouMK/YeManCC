template<class F>static bool postReason(F post,SensorThreadRequest request,unsigned long long predecessor,const ymcc::sensors::ThreadMailbox::Scope* scope,const char** reason){
 (void)reason;
 if constexpr(std::is_invocable_r_v<bool,F,SensorThreadRequest,unsigned long long,const ymcc::sensors::ThreadMailbox::Scope*,const char**,std::shared_ptr<ymcc::inputHost::sharedPower::Scope>>)return post(request,predecessor,scope,reason,{});
 else if constexpr(std::is_invocable_r_v<bool,F,SensorThreadRequest,unsigned long long,const ymcc::sensors::ThreadMailbox::Scope*,const char**>)return post(request,predecessor,scope,reason);
 else return post(request,predecessor,scope);
}

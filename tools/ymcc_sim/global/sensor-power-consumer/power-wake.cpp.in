static std::function<void()> afterRecoveryRequestClear; // Window thread only.
template<class T> struct FixtureRecoveryRequestCell {
 std::atomic<T> cell;
 T load(std::memory_order order=std::memory_order_seq_cst) const noexcept{return cell.load(order);}
 void store(T value,std::memory_order order=std::memory_order_seq_cst) noexcept{cell.store(std::move(value),order);}
 bool compare_exchange_strong(T& expected,T desired,std::memory_order order){
  const bool clearing=!desired;
  const bool replaced=cell.compare_exchange_strong(expected,std::move(desired),order);
  if(replaced&&clearing){auto next=std::exchange(afterRecoveryRequestClear,{});if(next)next();}
  return replaced;
 }
};

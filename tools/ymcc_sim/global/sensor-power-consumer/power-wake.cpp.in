// Explicit Reader port: same coherent public fields, no invented sensor permission.
static int __cdecl readSharedSystemPower(ymcc::sleeppower::SharedPowerV1* output,std::uint32_t bytes)noexcept{
 using namespace ymcc::sleeppower;
 if(!output||bytes<sizeof(SharedPowerV1))return 0;*output={};
 for(unsigned attempt=0;attempt!=3;++attempt){
  if(!fixturePublicKnown.load()||g_exitRequested.load())return 0;
  SharedPowerV1 value;value.generation=fixturePower.load();value.phase=static_cast<std::uint32_t>(g_powerLifecycle.load());
  value.suspendSerial=fixturePublicSuspendSerial.load();value.publicationRevision=fixturePublicPublication.load();
  value.observedNotificationSequence=g_sleepPowerDispatch.observedSequence();
  const auto flags=fixturePublicFlags.load();const bool pending=g_sleepPowerDispatch.pendingSuspend();
  value.flags=flags|(pending?kNotificationPending:0u);
  if(value.generation!=fixturePower.load()||value.phase!=static_cast<std::uint32_t>(g_powerLifecycle.load())||
     value.suspendSerial!=fixturePublicSuspendSerial.load()||value.publicationRevision!=fixturePublicPublication.load()||
     value.observedNotificationSequence!=g_sleepPowerDispatch.observedSequence()||flags!=fixturePublicFlags.load()||
     pending!=g_sleepPowerDispatch.pendingSuspend())continue;
  if(!fixturePublicKnown.load()||g_exitRequested.load()||!value.generation)return 0;*output=value;return 1;
 }
 return 0;
}
static void fixtureCompletePublicNotification(ULONG type){
 const auto receipt=g_sleepPowerDispatch.window(type,GetTickCount64());g_sleepPowerDispatch.complete(receipt,GetTickCount64());
 for(unsigned i=0;i<4&&g_sleepPowerDispatch.hasPending();++i){
  const auto pending=g_sleepPowerDispatch.pendingReplay();
  if(!pending)throw std::runtime_error("active delivery crossed sensor notification setup");
  const auto delivered=g_sleepPowerDispatch.forwarded(pending.sequence,pending.type,GetTickCount64());
  if(!delivered)throw std::runtime_error("retained sensor notification cannot be delivered");
  g_sleepPowerDispatch.complete(delivered,GetTickCount64());
 }
 if(g_sleepPowerDispatch.hasPending()||g_sleepPowerDispatch.pendingSuspend())throw std::runtime_error("unfinished sensor notification setup");
}
static auto fixtureSensorPublicScope(){
 return ymcc::inputHost::sharedPower::Scope::create(&readSharedSystemPower,g_sharedPowerRevocations,true,ymcc::inputHost::sharedPower::Use::Lifecycle);
}
template<class Scope>static void fixtureAttachPublicPower(Scope& scope){
 if constexpr(requires{scope.publicPower;})scope.publicPower=fixtureSensorPublicScope();
}
static void fixtureResetPublicPower(){
 g_sharedPowerRevocations.revoke();g_sensorActivePower.store({});
 fixturePublicKnown=true;fixturePublicSuspendSerial=1;fixturePublicPublication=1;
 fixturePublicFlags=ymcc::sleeppower::kKnown|ymcc::sleeppower::kHardwareAllowed;
 // Existing cases represent an already initialized capture; late-init cases clear it.
 g_sensorActivePower.store(fixtureSensorPublicScope());
 g_inputCaptureSink->gyroCallbacks=0;g_inputCaptureSink->accelCallbacks=0;
}

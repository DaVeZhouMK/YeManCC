struct WorkerScope{
 WorkerScope(){
  rejectMailboxAtReset=false;coldStartDeferred=false;coldStartPowerCut=false;holdNextPumpReturn=false;commandPumpEntered=CreateEventW(nullptr,TRUE,FALSE,nullptr);commandPumpRelease=CreateEventW(nullptr,TRUE,FALSE,nullptr);useActualResubscribe=false;retainActualRevoke=false;injectNewResumeAtRetry=false;g_gyroSensor={};g_accelSensor={};recoveryLogCalls=0;recoveryLogsUnlocked=0;throwRecoveryLog=false;holdFailurePost=false;failNextThreadCreate=false;failurePostEntered=CreateEventW(nullptr,TRUE,FALSE,nullptr);failurePostRelease=CreateEventW(nullptr,TRUE,FALSE,nullptr);resetRecovery();g_captureGeneration=7;fixturePower=100;failRecoveryPost=false;clearDebt();g_inputCaptureStop=false;g_sensorUnsubscribeRetained=false;g_gyroReadingChangedSubscribed=false;g_accelReadingChangedSubscribed=false;g_msiSensorApiProvider.setDebt(false);g_hcWindowsSensorApiProvider.setDebt(false);throwCompletedLog=false;throwCommandLog=false;throwCreateLog=false;throwEarlyLog=false;throwOwnerLog=false;throwSelectionClose=false;failThreadClose=false;threadsCreated=0;firstPump=true;failCom=false;failPump=false;failThreadWait=false;throwQueuedLog=false;throwResume=false;failedSignals=0;signalAttempts=0;resumeCalls=0;subscribed=0;stopCalls=0;comInitializations=0;comReturns=0;staMessages=0;pumpCalls=0;loggerUnlocked=0;staThreadId=0;arms=0;independentProjection=0;g_exitRequested=false;g_inputCaptureReady=true;g_sensorSuspendCallbackActive=false;g_sensorPowerPausePending=false;g_inputCaptureSensorsSuspended=true;g_powerLifecycle=PowerLifecycle::Ready;g_idleSessionDisplayState=1;g_idleLegacyMonitorState=1;g_sleepPowerRedeliveryArmed=false;g_sharedPowerProjectionPending=false;{std::lock_guard<std::mutex> lock(logMx);queued.clear();completed.clear();fixtureRejectedReceipts.clear();}pumpEntered=CreateEventW(nullptr,TRUE,FALSE,nullptr);pumpRelease=CreateEventW(nullptr,TRUE,FALSE,nullptr);
  fixtureResetPublicPower();
 }
 ~WorkerScope(){

  const auto serial=ownerSerial();const auto originalThread=g_sensorThread;
  ++fixturePublicSuspendSerial;g_sharedPowerRevocations.revoke();
  bool interleaved=false;
  afterRecoveryRequestClear=[&]{
   failRecoveryPost=true;failPump=true;actualSetEvent(g_sensorThreadWake);
   interleaved=::WaitForSingleObject(originalThread,1500)==WAIT_OBJECT_0&&!failRecoveryPost&&ownerSerial()==serial;
  };
  SendMessageW(g_hwnd,kSharedPowerStateMessage,0,0);

static HRESULT fixtureCoInitialize(LPVOID p,DWORD flags){
 if(failCom.exchange(false)){::SetEvent(pumpEntered);::WaitForSingleObject(pumpRelease,3000);return E_FAIL;}
 const auto hr=::CoInitializeEx(p,flags);
 if(SUCCEEDED(hr)){
  APTTYPE type{};APTTYPEQUALIFIER qualifier{};if(FAILED(CoGetApartmentType(&type,&qualifier))||(type!=APTTYPE_STA&&type!=APTTYPE_MAINSTA))return E_FAIL;
  ++comInitializations;staThreadId=GetCurrentThreadId();
  WNDCLASSW wc{};wc.lpfnWndProc=staProc;wc.hInstance=GetModuleHandleW(nullptr);wc.lpszClassName=L"YmccSensorStaFixture";RegisterClassW(&wc);
  staWindow=CreateWindowExW(0,wc.lpszClassName,L"",0,0,0,0,0,HWND_MESSAGE,nullptr,wc.hInstance,nullptr);
 }
 return hr;
}
static void fixtureCoUninitialize(){const auto window=staWindow.exchange(nullptr);if(window)DestroyWindow(window);++comReturns;::CoUninitialize();}
static DWORD fixtureMsgWait(DWORD count,const HANDLE* handles,DWORD timeout,DWORD mask,DWORD flags){
 ++pumpCalls;
 if(firstPump.exchange(false)){MSG msg{};PeekMessageW(&msg,nullptr,0,0,PM_NOREMOVE);::SetEvent(pumpEntered);if(::WaitForSingleObject(pumpRelease,3000)!=WAIT_OBJECT_0){SetLastError(ERROR_TIMEOUT);return WAIT_FAILED;}}
 if(failPump.exchange(false)){SetLastError(ERROR_INVALID_HANDLE);return WAIT_FAILED;}
 const auto result=::MsgWaitForMultipleObjectsEx(count,handles,timeout,mask,flags);
 if(holdNextPumpReturn.exchange(false)){::SetEvent(commandPumpEntered);::WaitForSingleObject(commandPumpRelease,2500);}
 return result;
}
static BOOL fixtureSetEvent(HANDLE event){
 if(event==g_sensorThreadWake){++signalAttempts;int count=failedSignals.load();while(count>0){if(failedSignals.compare_exchange_weak(count,count-1)){SetLastError(ERROR_NOT_READY);return FALSE;}}}
 return ::SetEvent(event);
}
static DWORD fixtureWait(HANDLE handle,DWORD budget){if(handle==g_sensorThread&&failThreadWait){SetLastError(ERROR_INVALID_HANDLE);return WAIT_FAILED;}return ::WaitForSingleObject(handle,budget);}
static UINT_PTR fixtureSetTimer(HWND h,UINT_PTR id,UINT delay,TIMERPROC proc){++arms;return ::SetTimer(h,id,delay,proc);}
static BOOL actualSetEvent(HANDLE event){return ::SetEvent(event);}
static BOOL fixturePost(HWND h,UINT m,WPARAM w,LPARAM l){if(m==kSharedPowerStateMessage&&failRecoveryPost.exchange(false)){SetLastError(ERROR_NOT_READY);return FALSE;}const auto result=::PostMessageW(h,m,w,l);if(m==kSharedPowerStateMessage&&holdFailurePost.exchange(false)){::SetEvent(failurePostEntered);::WaitForSingleObject(failurePostRelease,2500);}return result;}
#define PostMessageW fixturePost
static HANDLE actualReturnedThread(){return ::CreateThread(nullptr,0,[](LPVOID)->DWORD{return 0;},nullptr,0,nullptr);}
static HANDLE fixtureCreateThread(LPSECURITY_ATTRIBUTES a,SIZE_T size,LPTHREAD_START_ROUTINE proc,LPVOID param,DWORD flags,LPDWORD id){if(failNextThreadCreate.exchange(false)){SetLastError(ERROR_NOT_ENOUGH_MEMORY);return nullptr;}const auto result=::CreateThread(a,size,proc,param,flags,id);if(result)++threadsCreated;return result;}
static BOOL fixtureCloseHandle(HANDLE h){if(h==g_sensorThread&&failThreadClose){SetLastError(ERROR_ACCESS_DENIED);return FALSE;}return ::CloseHandle(h);}

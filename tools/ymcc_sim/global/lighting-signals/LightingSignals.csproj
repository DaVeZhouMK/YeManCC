<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0-windows</TargetFramework><UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems><StartupObject Condition="'$(StartupObject)' == ''">LightingSignalsHarness</StartupObject>
    <AssemblyName>LightingSignalsHarness</AssemblyName>
    <LightingProgramSource Condition="'$(LightingProgramSource)' == ''">$(MSBuildThisFileDirectory)..\..\..\..\FanLab\LightSetter\Program.cs</LightingProgramSource>
    <LightingConsumerSource Condition="'$(LightingConsumerSource)' == ''">$(MSBuildThisFileDirectory)..\..\..\..\FanLab\LightSetter\DeviceCoreConsumer.cs</LightingConsumerSource>
    <FixturePinSource Condition="'$(FixturePinSource)' == ''">$(MSBuildThisFileDirectory)..\..\..\..\FanLab\LightSetter\LightingAssemblyPins.cs</FixturePinSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Harness.cs" />
    <Compile Include="$(LightingProgramSource)" Link="ProductProgram.cs" />
    <Compile Include="$(LightingConsumerSource)" Link="ProductConsumer.cs" />
    <Compile Include="$(FixturePinSource)" Link="LightingAssemblyPins.cs" />
    <Compile Include="../../../../FanLab/LightSetter/OneXQueuedLighting.cs" Link="OneXQueuedLighting.cs" />
    <Compile Include="../../../../FanLab/LightSetter/OneXLightingSession.cs" Link="OneXLightingSession.cs" />
    <Compile Include="../../../../FanLab/RuntimeDependencyContract.cs" Link="RuntimeDependencyContract.cs" />
    <Compile Include="../../../../FanLab/DeviceCoreSharedDependencies.cs" Link="DeviceCoreSharedDependencies.cs" />
    <Compile Include="../../../../native/ProcessEfficiency.cs" Link="ProcessEfficiency.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../../../capabilities/HcDeviceCapabilityCatalog.cs" Link="Capabilities/HcDeviceCapabilityCatalog.cs" />
    <Compile Include="../../../../capabilities/HcDeviceCapabilityCatalog.generated.cs" Link="Capabilities/HcDeviceCapabilityCatalog.generated.cs" />
    <Compile Include="../../../../capabilities/HcLightingCapabilityCatalog.cs" Link="Capabilities/HcLightingCapabilityCatalog.cs" />
    <Compile Include="../../../../capabilities/HcLightingCapabilityCatalog.generated.cs" Link="Capabilities/HcLightingCapabilityCatalog.generated.cs" />
  </ItemGroup>
</Project>


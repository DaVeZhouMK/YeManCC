    private sealed class Session
    {
        private readonly Tuple _tuple = new("steamdeck");
        private HMController? _controller;
        private bool _steamDeckReleasePending, _idleCtsReleasePending;
        private Phase _phase = Phase.Active;
        private IdleGuard.Captured? _idleCtsRelease;
        private string _sdkDisposeFailure = "";
        private readonly MsiSteamDeckReleaseFence1726? _msiSteamDeckReleaseFence1726 = null;
        internal readonly IdleRuntime IdleRuntime = new();
        internal Session(HMController controller) => _controller = controller;
        internal HMController? Controller => _controller;
        internal bool Pending => _steamDeckReleasePending || _idleCtsReleasePending;
        internal string PhaseName => _phase.ToString();
        internal bool Stop(out string detail) => TryStopSteamDeckIdleForRelease(out detail);
        internal bool Complete(out string detail) => TryCompleteIdleCtsRelease(out detail);
        internal bool Prepare(out string detail)
        {
            @@PREPARE_GUARDS@@
            detail = "fake-prepare-allowed"; return true;
        }
        internal bool Release(out string detail)
        {
            @@RELEASE_FAILURE_GUARD@@
            if (!TryCompleteIdleCtsRelease(out detail) || !TryStopSteamDeckIdleForRelease(out detail)) return false;
            if (_controller is null) { detail = "already-released"; return true; }
            var controller = _controller;
            if (!Guard.TryStopAgainstRuntime(controller, new Runtime(), out detail)) return false;
            if (!IdleGuard.TryCaptureAgainstRuntime(controller, IdleRuntime, out var captured, out detail) || captured is null) return false;
            try
            {
                controller.Dispose(); captured.MarkControllerDisposeReturned(); _idleCtsRelease = captured;
                _idleCtsReleasePending = true; _controller = null;
            }
            catch (Exception ex)
            {
                _idleCtsRelease = captured; _idleCtsReleasePending = true;
                return RetainSdkDisposeFailure(new List<string> { "controller-dispose:" + ex.GetType().Name }, null, out detail);
            }
            return TryCompleteIdleCtsRelease(out detail);
        }
        private VirtualEndpointObservation ObserveVirtualEndpoint(string persona, bool requireInstanceIds) => default;
        private void CompleteMsiNonSdReleaseDiagnostic(bool completed) { }
        @@ACTUAL_IDLE_WRAPPER@@
        @@ACTUAL_COMPLETE_RECEIPT@@
        @@ACTUAL_RETAIN_FAILURE@@
    }
    private sealed class Runtime : Guard.IRuntime
    {
        internal int Budget = 500, Cancels, Joins, LastJoin;
        internal bool ReadStateThrows;
        internal ThreadState? ReportedState;
        public Type ControllerType => typeof(HMController);
        public Type CancellationSourceType => typeof(CancellationTokenSource);
        public Type ReaderType => typeof(Thread);
        public bool IsPinnedCore(Type type) => true;
        public int ReadJoinBudgetMilliseconds(Type type) => Budget;
        public bool IsCurrentReader(object reader) => ReferenceEquals(reader, Thread.CurrentThread);
        public ThreadState ReadThreadState(object reader) => ReadStateThrows ? throw new Exception("state read") : ReportedState ?? ((Thread)reader).ThreadState;
        public bool TryEnterCancellationLock(object gate, int ms) { Check(ms <= 500); return Monitor.TryEnter(gate, ms); }
        public void ExitCancellationLock(object gate) => Monitor.Exit(gate);
        public void Cancel(object source) { Cancels++; ((CancellationTokenSource)source).Cancel(); }
        public bool Join(object reader, int ms) { Joins++; LastJoin = ms; Check(ms <= 500); return ((Thread)reader).Join(ms); }
    }
    private sealed class IdleRuntime : IdleGuard.IRuntime
    {
        internal int Budget = 500, Stops, LastStop;
        internal bool Identity = true, ClockIdentity = true, StopThrows, TerminationThrows;
        public Type ControllerType => typeof(HMController);
        public Type ClockInterfaceType => typeof(IDeviceClock);
        public Type ReaderType => typeof(Thread);
        public bool IsPinnedCore(Type type) => Identity;
        public bool IsPinnedClock(Type type) => ClockIdentity && type == typeof(DeviceClock<StreamTick>);
        public int ReadJoinBudgetMilliseconds(Type type) => Budget;
        public bool IsCurrentReader(object reader) => ReferenceEquals(reader, Thread.CurrentThread);
        public ThreadState ReadThreadState(object reader) => ((Thread)reader).ThreadState;
        public bool HasTerminated(object reader) => TerminationThrows ? throw new Exception("termination proof") : ((Thread)reader).Join(0);
        public object ReadClockThread(object clock) => ((IDeviceClock)clock).Thread;
        public void StopClock(object clock, int ms)
        {
            Stops++; LastStop = ms; Check(ms <= 500);
            if (StopThrows) throw new Exception("injected-stop");
            ((IDeviceClock)clock).Stop(ms);
        }
    }
    // The sole extracted-consumer binding substitution: fake controller metadata
    // uses the actual helper's reviewed IRuntime seam. Helpers remain unmodified.
    private static class BclClockAdmission
    {
        internal static readonly IdleRuntime Runtime = new();
        internal static bool TryStopInputClock(HMController controller, out string detail) =>
            IdleGuard.TryStopInputClockAgainstRuntime(controller, Runtime, out detail);
    }
    private sealed class OutputWorker : IDisposable
    {
        internal readonly CancellationTokenSource Cts = new();
        internal readonly ManualResetEventSlim Gate = new(), Entered = new();
        internal readonly HMController Controller;
        internal readonly Thread Thread;
        internal OutputWorker(bool blocked = false, nint view = 1)
        {
            HMController? c = null;
            Thread = new Thread(() => c!.RunOutput()) { IsBackground = true, Name = "host-sdk-stop200-owned-output" };
            c = Controller = new HMController(Cts, Thread, view, poll: () => { Entered.Set(); if (blocked) Gate.Wait(); else Cts.Token.WaitHandle.WaitOne(); });
            Thread.Start(); Check(Entered.Wait(2000), "fixture output startup");
        }
        public void Dispose()
        {
            Gate.Set(); if (!Controller.OutputClosed) try { Cts.Cancel(); } catch (ObjectDisposedException) { }
            Check(Thread.Join(2000), "fixture output leaked"); Cts.Dispose(); Gate.Dispose(); Entered.Dispose();
        }
    }
    private static HMController IdleController(DeviceClock<StreamTick>? clock = null, byte[]? prior = null)
    {
        prior ??= new byte[64]; if (prior.Length == 64) BinaryPrimitives.WriteUInt32LittleEndian(prior.AsSpan(4), 123);
        return new HMController(new(), clock: clock, prior: prior);
    }
    private static readonly List<object> Rows = new(), Observations = new();
    private static int Failures;
    private static void Check(bool ok, string message = "assertion failed") { if (!ok) throw new Exception(message); }
    private static void Test(string name, Action body)
    {
        World.Reset(); _screenPadOwnsReport = false; _screenPadPacketCounter = 0;
        try { body(); Rows.Add(new { name, pass = true }); }
        catch (Exception ex) { Failures++; Rows.Add(new { name, pass = false, error = ex.ToString() }); }
    }

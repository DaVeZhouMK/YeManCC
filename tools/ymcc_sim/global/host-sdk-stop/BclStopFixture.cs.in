    internal sealed class FakeContext
    {
        internal void OnControllerDisposing(HMController controller)
        {
            World.ContextCalls++;
            if (controller.Reader?.IsAlive == true || controller.Idle?.IsAlive == true) World.UnsafeFakeUnmaps++;
            if (World.ThrowContextDispose) throw new InvalidOperationException("injected-context-dispose-failure");
            World.AfterContextDispose?.Invoke();
        }
    }

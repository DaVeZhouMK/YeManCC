    internal interface IDeviceClock { void Stop(int joinMs); Thread Thread { get; } }
    internal readonly struct StreamTick { }
    internal sealed partial class DeviceClock<TTick>
    {
        private readonly Thread _thread;
        private readonly object _lifetime = new();
        private readonly AutoResetEvent _wake = new(false);
        private readonly nint _timer = 0;
        private volatile bool _stop;
        private bool _closed;
        internal readonly ManualResetEventSlim Entered = new();
        internal readonly ManualResetEventSlim ExternalGate = new();
        internal bool WakeClosed => _wake.SafeWaitHandle.IsClosed;
        internal bool Closed => _closed;
        public Thread Thread => _thread;
        internal DeviceClock(bool blocked = false, bool start = true, Action? onWorker = null)
        {
            _thread = new Thread(() =>
            {
                Entered.Set();
                try { onWorker?.Invoke(); if (blocked) ExternalGate.Wait(); else while (!_stop) _wake.WaitOne(); }
                finally { Close(); }
            }) { IsBackground = true, Name = "host-sdk-stop200-owned-clock" };
            if (start) { _thread.Start(); if (!Entered.Wait(2000)) throw new Exception("fixture clock startup"); }
        }
        internal void Finish()
        {
            ExternalGate.Set();
            if ((_thread.ThreadState & ThreadState.Unstarted) != 0) Stop(0);
            else { Stop(500); if (!_thread.Join(2000)) throw new Exception("fixture clock leaked"); }
            Entered.Dispose(); ExternalGate.Dispose();
        }
        @@EXACT_CLOCK_STOP@@
    }
    internal sealed partial class DeviceClock<TTick> : IDeviceClock { }

        {
            var a = Assembly.GetExecutingAssembly(); Check(!a.GetReferencedAssemblies().Any(n => n.Name == "HIDMaestro.Core"));
            Check(a.GetTypes().SelectMany(t => t.GetMethods(BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.Instance | BindingFlags.Static)).All(m => (m.Attributes & MethodAttributes.PinvokeImpl) == 0));
        });
        Console.WriteLine(JsonSerializer.Serialize(new { schemaVersion = 2, generation = "2.0.0-current", passed = Rows.Count - Failures, failed = Failures, cases = Rows, observations = Observations,
            realBclThreads = true, realSdkLoaded = false, realSdkControllerConstructed = false, deviceDriverOrRealMappingAccess = false, exactSdkDisposeBody = true,
            rawOwnershipAdmissionSeam = "only extracted call target uses actual helper IRuntime; production admission separately rejects fake metadata" }));
        return Failures == 0 ? 0 : 1;
    }
}
HANDLE CreateFileW(const wchar_t* path,DWORD,DWORD,void*,DWORD,DWORD flags,void*){++createCalls;lastCreateFlags=flags;const std::wstring p(path);op("memory-create",{{"path",narrow(p)},{"flags",flags},{"fail",failCreate}});if(failCreate||files.count(p))return INVALID_HANDLE_VALUE;files[p]={};const HANDLE h=nextFileHandle++;fileHandles[h]={p};return h;}
bool WriteFile(HANDLE h,const void* data,DWORD length,DWORD* written,void*){++writeCalls;*written=failWrite?0:shortWrite&&length?length-1:length;op("memory-write",{{"bytesRequested",length},{"bytesWritten",*written},{"ok",!failWrite}});if(!fileHandles.count(h))return false;files[fileHandles[h].path].append(static_cast<const char*>(data),*written);return !failWrite;}
bool FlushFileBuffers(HANDLE){++flushCalls;op("memory-flush",{{"ok",!failFlush}});return !failFlush;}
bool CloseHandle(HANDLE h){if(h<10000){op("memory-process-close",{{"handle",h}});return true;}++closeCalls;fileHandles.erase(h);op("memory-file-close",{{"ok",!failClose}});return !failClose;}
bool DeleteFileW(const wchar_t* path){const std::wstring p(path);op("memory-delete",{{"path",narrow(p)}});return files.erase(p)>0;}
bool MoveFileExW(const wchar_t* from,const wchar_t* to,DWORD flags){++moveCalls;lastMoveFlags=flags;const std::wstring a(from),b(to);op("memory-move",{{"from",narrow(a)},{"to",narrow(b)},{"flags",flags},{"ok",!failMoves}});if(failMoves||!files.count(a))return false;files[b]=files[a];files.erase(a);if(dieOnMarkerCommit&&b==markerKey(SG_SLEEP_LEASE_DIR))processAlive=false;return true;}
bool ReplaceFileW(const wchar_t* target,const wchar_t* replacement,void*,DWORD flags,void*,DWORD){++replaceCalls;lastReplaceFlags=flags;const std::wstring a(replacement),b(target);op("memory-replace",{{"flags",flags},{"ok",!failReplace}});if(failReplace||!files.count(a))return false;files[b]=files[a];files.erase(a);return true;}
void Sleep(DWORD ms){++memorySleeps;op("memory-wait",{{"ms",ms}});}
static ULONGLONG sgMarkerCreated(const std::wstring&,DWORD);static unsigned long long sgMarkerGeneration(const std::wstring&,DWORD);static bool sgMarkerIsSuspended(const std::wstring&,DWORD);
LONG countedNativeSuspend(HANDLE h){++ntCalls;json receipt={{"pid",h},{"created",sgMarkerCreated(SG_SLEEP_LEASE_DIR,h)},{"generation",sgMarkerGeneration(SG_SLEEP_LEASE_DIR,h)},{"suspendedState",sgMarkerIsSuspended(SG_SLEEP_LEASE_DIR,h)}};nativeReceipts.push_back(receipt);op("memory-native-suspend",receipt);return 0;}

std::wstring markerKey(const std::wstring& dir,DWORD pid=100){return dir+L"\\"+std::to_wstring(pid)+L".txt";}
std::string narrow(const std::wstring& p){return std::string(p.begin(),p.end());}
void op(const char* kind,json details=json::object()){details["kind"]=kind;operations.push_back(std::move(details));}
std::string sgReadFile(const std::wstring& p){auto i=files.find(p);return i==files.end()?std::string{}:i->second;}

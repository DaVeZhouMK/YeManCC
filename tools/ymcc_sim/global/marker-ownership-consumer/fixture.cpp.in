 reset();{const bool manual=sgWriteProcessMarker(SG_MANUAL_DIR,100,"suspended",7),sleep=sgWriteProcessMarker(SG_SLEEP_LEASE_DIR,100,"suspended",0);const auto a=sgReadFile(markerKey(SG_MANUAL_DIR)),b=sgReadFile(markerKey(SG_SLEEP_LEASE_DIR));record("manual-token-and-generation-format",{{"manualRunToken","42@9001"},{"sleepHasManualFields",false},{"zeroGenerationOmitted",true}},{{"manual",a},{"sleep",b}},manual&&sleep&&a.find("|pauseRun=42@9001|pauseSerial=11")!=std::string::npos&&a.find("|generation=7")!=std::string::npos&&b.find("|pauseRun=")==std::string::npos&&b.find("|generation=")==std::string::npos);}

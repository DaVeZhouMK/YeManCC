bool sgReadSleepTarget(SgSleepTarget& target){target=g_sgSleepTarget;return target.captured;}
void sgClearSleepTargetIfMatches(const SgSleepTarget& target){if(g_sgSleepTarget.pid==target.pid&&g_sgSleepTarget.processCreated==target.processCreated&&g_sgSleepTarget.powerGeneration==target.powerGeneration)g_sgSleepTarget={};}
void sgWriteFile(const std::wstring& path,const std::string& value){files[path]=value;op("memory-capture-metadata",{{"path",narrow(path)}});}
bool sgHasMarkerFiles(const std::wstring& dir){for(const auto& item:files)if(item.first.rfind(dir+L"\\",0)==0)return true;return false;}
SgResumeResult sgResumeMarkedDirectoryUnlocked(const std::wstring&,bool){++staleRecoveryCalls;return {};}
// EXACT_COMBINATION_FUNCTIONS
int groups=0,failedGroups=0;
void record(const char* label,json expected,json actual,bool passed){++groups;if(!passed)++failedGroups;std::cout<<json({{"case",label},{"passed",passed},{"expected",expected},{"actual",actual},{"trace",operations}}).dump()<<std::endl;}
void reset(){files.clear();directories.clear();fileHandles.clear();operations.clear();nativeReceipts.clear();queryModes.clear();nextFileHandle=10000;queryCalls=ntCalls=processOpenCalls=staleRecoveryCalls=writeCalls=flushCalls=moveCalls=replaceCalls=closeCalls=memorySleeps=createCalls=0;processAlive=true;openedBirthRace=failCreate=failWrite=shortWrite=failFlush=failClose=failMoves=failReplace=failDirCreate=hideDirAfterCreate=dieOnMarkerCommit=false;currentSession=targetSession=1;lastCreateFlags=lastMoveFlags=lastReplaceFlags=0;g_sgSleepTarget={};g_sgPauseResume=g_sgRepairEligible=true;g_powerLifecycle=PowerLifecycle::Suspending;g_sgManualPauseSerial=11;}
void seed(const std::wstring& dir,ULONGLONG birth=1234,unsigned long long gen=7){directories.insert(dir);files[markerKey(dir)]="pid=100|created="+std::to_string(birth)+"|epoch=1.25|state=suspended|generation="+std::to_string(gen);}
void pauseCase(const char* label,int expectedNt=-1,int expectedFrozen=-1,unsigned long long generation=7,bool twice=false){auto result=sgPauseSleepTarget(generation);if(twice)result=sgPauseSleepTarget(generation);const auto birth=sgMarkerCreated(SG_SLEEP_LEASE_DIR,100),gen=sgMarkerGeneration(SG_SLEEP_LEASE_DIR,100);const bool owner=nativeValveValidateOwnedSuspendedTarget(SG_SLEEP_LEASE_DIR,100,processBirth);bool everyNativeBound=true;for(const auto& receipt:nativeReceipts)everyNativeBound=everyNativeBound&&receipt.at("created")==processBirth&&receipt.at("generation")==7&&receipt.at("suspendedState")==true;const bool frozenBound=!result.frozen||!processAlive||(owner&&birth==processBirth&&gen==generation);const bool exactExpected=(expectedNt<0||ntCalls==expectedNt)&&(expectedFrozen<0||result.frozen==bool(expectedFrozen));json actual={{"frozen",result.frozen},{"publishedMarkerOwned",g_sgSleepTarget.markerOwned},{"ntCalls",ntCalls},{"processOpenCalls",processOpenCalls},{"markerCreated",birth},{"markerGeneration",gen},{"ownerAccepted",owner},{"everyNativeHadExactLease",everyNativeBound},{"frozenHasExactLease",frozenBound},{"queryCalls",queryCalls},{"processAlive",processAlive},{"markerText",sgReadFile(markerKey(SG_SLEEP_LEASE_DIR))},{"nativeReceipts",nativeReceipts},{"staleRecoveryCalls",staleRecoveryCalls}};record(label,{{"everyNativeHadExactLease",true},{"frozenHasExactLease",true},{"expectedNt",expectedNt},{"expectedFrozen",expectedFrozen}},actual,everyNativeBound&&frozenBound&&exactExpected);}
void atomicFailureCase(const char* label){const std::wstring p=L"memory\\atomic.txt";files[p]="old-data";const bool result=sgWriteFileAtomic(p,"new-data");record(label,{{"returned",false},{"oldFinalPreserved",true}},{{"returned",result},{"final",sgReadFile(p)},{"ntCalls",ntCalls},{"flushCalls",flushCalls},{"moveCalls",moveCalls},{"replaceCalls",replaceCalls}},!result&&sgReadFile(p)=="old-data"&&ntCalls==0);}

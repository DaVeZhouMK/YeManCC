#include "common_hid_runtime_cases.inc"
int main(int argc,char** argv)try {
    [[maybe_unused]] const auto originalBackgroundCapture=&backgroundControllerUiCapture;
    if(argc!=2||(std::string_view(argv[1])!="--inspect-only"&&std::string_view(argv[1])!="--observation-only"&&std::string_view(argv[1])!="--business-only"&&std::string_view(argv[1])!="--inspection-early"&&std::string_view(argv[1])!="--inspection-early-business"&&std::string_view(argv[1])!="--off-fse"&&std::string_view(argv[1])!="--source-binding"))throw std::runtime_error("explicit runtime projection required");
    g_inputCaptureGamepadSnapshot.inputSource="xinput";
    g_inputCaptureGamepadSnapshot.readContextStable=true;
    g_inputCaptureGamepadSnapshot.readPowerGeneration=1;
    g_inputCaptureGamepadSnapshot.readTopologyGeneration=2;
    g_inputCaptureGamepadSnapshot.readIdentityGeneration=3;
    g_axisCalibrationXinputKeys[0]=std::make_shared<const std::string>("\\\\?\\usb#actual-selected-source");
    using namespace ymcc::input::identityRefresh;
    g_xinputFeedbackIdentity[0].observe({true,true,false,false,L"actual-selected-source",Kind::Physical,3,3,1,1});
    runtimeBusinessOnly=std::string_view(argv[1])=="--business-only"||std::string_view(argv[1])=="--inspection-early-business";
    commonRuntimeCases(std::string_view(argv[1])=="--source-binding"?"source-binding":std::string_view(argv[1])=="--off-fse"?"off-fse":std::string_view(argv[1]).starts_with("--inspection-early")?"inspection-early":std::string_view(argv[1])=="--observation-only"?"observation-only":"inspect-only");
    if(!runtimeBusinessOnly)check(newDiagnosticAttempts>0&&!newDiagnosticWithoutScope&&!ymcc::inputHost::diagnostics::Scope::active(),"both new diagnostic sites use real deferred Scope and restore TLS after exceptions");
    std::cout<<json{{"checks",checks},{"cases",runtimeProjectionCases},{"projection","common-hid-runtime"},
        {"originalCanonicalId","controller.unified-standard-input"},{"physicalInput",false},
        {"actualInspect",true},{"actualCaptureReadLane",true},{"legacy211Executed",false},
        {"businessTrace",runtimeBusinessTrace},{"newDiagnosticAttempts",newDiagnosticAttempts},{"newDiagnosticWithoutScope",newDiagnosticWithoutScope},
        {"rawInputLeafCalls",fakeOs.rawCalls},{"hidLeafCalls",fakeOs.hidCalls},{"cfgLeafCalls",fakeOs.cfgCalls}}.dump()<<'\n';
    return 0;
}catch(const std::exception& e){std::cerr<<"FAIL "<<e.what()<<'\n';return 1;}

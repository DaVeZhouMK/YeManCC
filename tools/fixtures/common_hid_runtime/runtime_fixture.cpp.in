static void appendNativeLifecycleLog(const char* event,const json& j){
    if(std::string_view(event)=="gamepad-common-hid-inspection"||std::string_view(event)=="gamepad-common-hid-observation") {
        ++newDiagnosticAttempts;if(!ymcc::inputHost::diagnostics::Scope::active())++newDiagnosticWithoutScope;
    }
    if(throwDiagnosticEvent==event){++diagnosticThrowAttempts;SetLastError(4321);throw std::runtime_error("injected diagnostic failure");}
    logs.push_back({{"event",event},{"data",j}});
}

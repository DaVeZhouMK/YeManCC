int checks=0,cases=0;void check(bool ok,const char*what){++checks;if(!ok)throw std::runtime_error(what);}
struct Outcome{bool accepted;int excludes,white,custom,stamp;NativeDetectedGame game;unsigned long long gen=0;};
Outcome run(bool after,const Scenario&input,const NativeGameValveSnapshot&target){s=input;g_gameValveTarget=target;g_gameRulesEpoch=5;excludesReads=whiteReads=customReads=stamps=identityReads=0;Outcome o;o.accepted=after?afterRead(&o.game,&o.gen):beforeRead(&o.game,&o.gen);o.excludes=excludesReads;o.white=whiteReads;o.custom=customReads;o.stamp=stamps;return o;}
void compare(const Scenario&input,const NativeGameValveSnapshot&target){++cases;auto b=run(false,input,target),n=run(true,input,target);check(n.accepted==b.accepted,"old/new admission differs");check(n.stamp==b.stamp&&n.stamp==1,"fresh disk stamp lost");check(n.white==b.white&&n.white==1,"fresh whitelist lost");check(n.excludes<=b.excludes&&n.custom<=b.custom,"extra unused file reads");if(b.accepted)check(n.gen==b.gen&&n.game.pid==b.game.pid&&n.game.processCreated==b.game.processCreated&&n.game.path==b.game.path,"returned identity differs");}
int main(){try{Scenario p;NativeGameValveSnapshot t;compare(p,t);auto old=run(false,p,t),now=run(true,p,t);check(old.excludes==1&&old.custom==1&&now.excludes==0&&now.custom==0,"healthy whitelist unused file elision missing");
p.white.clear();p.excluded.push_back(L"wuxia");compare(p,t);check(!run(true,p,t).accepted,"removed whitelist must honor blacklist");
p=Scenario{};p.white.clear();p.ws=499;compare(p,t);check(!run(true,p,t).accepted,"removed whitelist must enforce low memory gate");
p=Scenario{};p.path=L"D:\\other\\other.exe";compare(p,t);check(!run(true,p,t).accepted,"whitelisted old path cannot authorize changed path");
p=Scenario{};p.born=501;compare(p,t);check(!run(true,p,t).accepted,"reused pid must fail");
p=Scenario{};p.refreshEpoch=true;compare(p,t);check(!run(true,p,t).accepted,"rule epoch changed must fail");
p=Scenario{};t.game.customConfigured=true;compare(p,t);check(run(true,p,t).custom==1,"custom binding needs fresh custom file");p.custom.clear();compare(p,t);check(!run(true,p,t).accepted,"removed custom binding must fail");
p=Scenario{};t=NativeGameValveSnapshot{};t.game.path.clear();compare(p,t);check(run(true,p,t).excludes==1,"empty saved path cannot skip blacklist lookup");
std::mt19937 rng(203314);for(int i=0;i<12000;++i){Scenario x;NativeGameValveSnapshot y;auto b=[&]{return (rng()&1)!=0;};x.sessionOk=b();x.sameSession=b();x.identityOk=b();x.memoryOk=b();x.openOk=b();x.monitorExcluded=b();x.refreshEpoch=(rng()%7)==0;x.ws=rng()%1000;y.game.whitelisted=b();y.game.customConfigured=b();if(b())x.white.clear();if(b())x.white={L"wux*"};if(b())x.excluded.push_back(L"wuxia");if(b())x.custom.clear();if((rng()%8)==0)x.path=L"D:\\changed\\other.exe";if((rng()%8)==0)x.path=L"D:\\otherfolder\\wuxia.exe";if((rng()%9)==0)y.game.path.clear();if((rng()%8)==0)y.game.pid=0;if((rng()%8)==0)y.game.processCreated=0;if((rng()%8)==0)x.born=501;if((rng()%8)==0)y.generation=0;if((rng()%8)==0)y.rulesEpoch=4;compare(x,y);}
std::cout<<"{\"passed\":true,\"checks\":"<<checks<<",\"differentialCases\":"<<cases<<",\"healthyOldRuleLoadCalls\":3,\"healthyNewRuleLoadCalls\":1,\"realWindowsOrSteamActions\":0}";return 0;}catch(const std::exception&e){std::cerr<<e.what();return 1;}}

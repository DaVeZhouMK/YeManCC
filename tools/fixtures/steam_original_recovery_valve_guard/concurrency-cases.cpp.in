using DWORD=std::uint32_t;using ULONGLONG=unsigned long long;using SIZE_T=std::size_t;using HANDLE=void*;
constexpr bool FALSE=false;constexpr DWORD PROCESS_QUERY_LIMITED_INFORMATION=1,PROCESS_VM_READ=2;
constexpr SIZE_T SG_MIN_WS=500;

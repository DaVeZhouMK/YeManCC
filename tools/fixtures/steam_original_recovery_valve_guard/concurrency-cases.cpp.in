struct PROCESS_MEMORY_COUNTERS{DWORD cb=0;SIZE_T WorkingSetSize=0;};using PROCESS_MEMORY_COUNTERS_EX=PROCESS_MEMORY_COUNTERS;
namespace ports {
enum class Point{None,Rules,FirstIdentity,FinalIdentity};
struct State {
 unsigned steps=0,identities=0,ruleReads=0,hooks=0,publications=0,scans=0;
 bool identityOk=true,sessionsOk=true,sameSession=true,memoryOk=true,openOk=true,excluded=false;
 SIZE_T memory=900;double now=100;
 NativeDetectedGame process,candidate;
 std::vector<std::wstring> white{L"bluey"},black{L"explorer"},custom{L"bluey"};
 Point point=Point::None;std::function<void()> hook;
};
State s;
void step(){if(++s.steps>256)throw std::runtime_error("I/O port budget exceeded");}
void hit(Point point){step();if(s.point==point&&s.hook){s.point=Point::None;auto fn=std::move(s.hook);s.hook={};++s.hooks;fn();}}
}
std::mutex g_gameRulesMx,g_rememberedGameTargetMx;
std::atomic<unsigned long long> g_gameRulesEpoch{5};
int g_rememberedGameTarget=0;unsigned long long g_rememberedGameDeadline=0;
void focusLosslessReturnInvalidate(){ports::step();}
double sgNowEpoch(){ports::step();return ++ports::s.now;}
DWORD GetCurrentProcessId(){ports::step();return 1;}
bool ProcessIdToSessionId(DWORD pid,DWORD*out){ports::step();*out=(pid==1||ports::s.sameSession)?1:2;return ports::s.sessionsOk;}
bool focusQueryProcessIdentity(DWORD,std::wstring*path,ULONGLONG*born){
 ++ports::s.identities;*path=ports::s.process.path;*born=ports::s.process.processCreated;
 ports::hit(ports::s.identities==1?ports::Point::FirstIdentity:ports::Point::FinalIdentity);
 return ports::s.identityOk;
}
HANDLE OpenProcess(DWORD,bool,DWORD){ports::step();return ports::s.openOk?reinterpret_cast<void*>(1):nullptr;}
void CloseHandle(HANDLE){ports::step();}
bool GetProcessMemoryInfo(HANDLE,PROCESS_MEMORY_COUNTERS*p,std::size_t){ports::step();p->WorkingSetSize=ports::s.memory;return ports::s.memoryOk;}
void nativeRefreshGameRulesEpochFromDiskLocked(){++ports::s.ruleReads;ports::hit(ports::Point::Rules);}
std::vector<std::wstring> sgExcludes(){ports::step();return ports::s.black;}
std::vector<std::wstring> sgGameWhitelist(){ports::step();return ports::s.white;}
std::vector<std::wstring> nativeConfiguredGameExes(){ports::step();return ports::s.custom;}
bool nativeMonitorExcluded(const std::wstring&){ports::step();return ports::s.excluded;}
bool nativeIsConfiguredGameExe(const std::wstring& name,const std::vector<std::wstring>& list){ports::step();return std::find(list.begin(),list.end(),name)!=list.end();}
enum class NativeOnePidResult{Ok,NameUnavailable,Missing};
NativeOnePidResult nativeScanGameOnePid(DWORD,const std::wstring&,const std::vector<std::wstring>&,const std::vector<std::wstring>&,const std::vector<std::wstring>&,NativeDetectedGame*out){ports::step();++ports::s.scans;*out=ports::s.candidate;return out->pid?NativeOnePidResult::Ok:NativeOnePidResult::Missing;}
NativeDetectedGame nativeScanGame(DWORD,const std::vector<std::wstring>&,const std::vector<std::wstring>&,const std::vector<std::wstring>&){ports::step();++ports::s.scans;return ports::s.candidate;}
bool nativeScanGameConfiguredBest(const std::vector<std::wstring>&,const std::vector<std::wstring>&,const std::vector<std::wstring>&,NativeDetectedGame*){ports::step();++ports::s.scans;return false;}
std::wstring nativeProcessWindowTitle(DWORD){ports::step();return L"Bluey";}

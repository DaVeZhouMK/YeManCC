struct View{NativeDetectedGame game;unsigned long long generation=0,identity=0,rules=0;double selected=0,last=0;};
template<class T> View viewOf(const T&t){View v{t.game,t.generation,0,t.rulesEpoch,t.selectedAtEpoch,t.lastSeenEpoch};if constexpr(requires{t.identityGeneration;})v.identity=t.identityGeneration;return v;}
#define ADAPTER(TYPE,NS) struct TYPE{ \
 static void reset(){NS::g_gameValveTarget={};NS::g_gameValveGeneration=0;} \
 static View view(){return viewOf(NS::g_gameValveTarget);} \
 static void commit(const NativeDetectedGame&g,unsigned long long e=5){std::lock_guard lock(NS::g_gameValveMx);NS::nativeValveCommitLocked(g,e);} \
 static void touch(){std::lock_guard lock(NS::g_gameValveMx);NS::nativeValveTouchLocked();} \
 static void clear(){std::lock_guard lock(NS::g_gameValveMx);NS::nativeValveClearLocked();} \
 static void acquire(){NS::nativeValveAcquire();} \
 static bool read(NativeDetectedGame*g,unsigned long long*n){return NS::nativeValveReadCurrentTarget(g,n);} \
 static auto& raw(){return NS::g_gameValveTarget;} \
};
ADAPTER(Old,frozen)
ADAPTER(New,production)
#undef ADAPTER
unsigned checks=0,cases=0,maxPortSteps=0;
void check(bool okay,const std::string& why){++checks;if(!okay)throw std::runtime_error(why);}
NativeDetectedGame original(){NativeDetectedGame g;g.pid=10340;g.name=L"bluey";g.title=L"Bluey";g.path=L"D:\\Game\\Bluey.exe";g.processCreated=134372069314736092ULL;g.workingSet=900;g.whitelisted=true;g.customConfigured=true;g.whitelistRule=L"bluey";return g;}
template<class A> void reset(){ports::s={};g_gameRulesEpoch=5;ports::s.process=original();ports::s.candidate=original();A::reset();A::commit(original());}
struct Result{bool accepted=false;View begin,end;unsigned long long output=999;NativeDetectedGame game;unsigned hooks=0;};
template<class A> Result round(ports::Point point,std::function<void()> hook,bool expected,const char*name){
 Result r;r.begin=A::view();ports::s.point=point;ports::s.hook=std::move(hook);r.game.pid=999;
 r.accepted=A::read(&r.game,&r.output);r.end=A::view();r.hooks=ports::s.hooks;
 maxPortSteps=std::max(maxPortSteps,ports::s.steps);++cases;check(r.accepted==expected,name);
 if(point!=ports::Point::None)check(r.hooks==1,std::string(name)+": interleaving not executed once");
 if(expected){check(r.output==r.begin.generation,std::string(name)+": output lost snapshot publication generation");check(r.game.pid==r.begin.game.pid&&r.game.processCreated==r.begin.game.processCreated&&r.game.path==r.begin.game.path,std::string(name)+": output identity changed");}
 else check(r.output==999&&r.game.pid==999,std::string(name)+": failed reader published output");
 return r;
}
void readers(){
 reset<Old>();round<Old>(ports::Point::None,{},true,"frozen stable original");
 reset<New>();round<New>(ports::Point::None,{},true,"production stable original");
 for(auto point:{ports::Point::Rules,ports::Point::FirstIdentity,ports::Point::FinalIdentity}){
  reset<Old>();auto b=round<Old>(point,[]{Old::touch();},false,"frozen same identity heartbeat falsely refuses");
  check(b.begin.game.pid==b.end.game.pid&&b.begin.game.processCreated==b.end.game.processCreated&&b.begin.game.path==b.end.game.path&&b.begin.rules==b.end.rules&&b.end.generation>b.begin.generation,"frozen reproduction changed identity/rules");
  reset<New>();auto n=round<New>(point,[]{New::touch();},true,"production same identity heartbeat remains current");check(n.end.generation>n.begin.generation&&n.end.identity==n.begin.identity,"touch lease/publication semantics");
 }
 reset<Old>();round<Old>(ports::Point::FinalIdentity,[]{Old::acquire();},false,"frozen real Acquire heartbeat falsely refuses");check(ports::s.publications==1&&ports::s.scans==0,"frozen retained Acquire branch not executed");
 reset<New>();round<New>(ports::Point::FinalIdentity,[]{New::acquire();},true,"production real Acquire heartbeat remains current");check(ports::s.publications==1&&ports::s.scans==0,"production retained Acquire branch not executed");
 reset<Old>();round<Old>(ports::Point::Rules,[]{Old::commit(original());},false,"frozen same selection commit falsely refuses");
 reset<New>();round<New>(ports::Point::Rules,[]{New::commit(original());},true,"same selection commit preserves lease");
 const std::vector<std::pair<const char*,std::function<void(NativeDetectedGame&)>>> changes={
 {"pid",[](auto&g){++g.pid;}},{"birth",[](auto&g){++g.processCreated;}},{"path",[](auto&g){g.path=L"D:\\Other\\Bluey.exe";}},
 {"custom",[](auto&g){g.customConfigured=false;}},{"whitelisted",[](auto&g){g.whitelisted=false;}},{"whitelist-rule",[](auto&g){g.whitelistRule=L"blue*";}}};
 for(const auto&[name,change]:changes){
  reset<New>();auto changed=original();change(changed);auto lease=New::view().identity;New::commit(changed);check(New::view().identity>lease,std::string("commit must advance lease: ")+name);
  reset<New>();round<New>(ports::Point::FinalIdentity,[changed]{New::commit(changed);},false,name);
  reset<New>();round<New>(ports::Point::FinalIdentity,[changed]{New::commit(changed);New::commit(original());},false,(std::string("ABA ")+name).c_str());
 }
 reset<New>();round<New>(ports::Point::Rules,[]{New::clear();},false,"clear revokes");
 reset<New>();round<New>(ports::Point::Rules,[]{New::clear();New::commit(original());},false,"clear then same target ABA revokes");
 reset<New>();round<New>(ports::Point::FinalIdentity,[]{++g_gameRulesEpoch;},false,"late global rule epoch revokes");
 reset<New>();round<New>(ports::Point::Rules,[]{++g_gameRulesEpoch;},false,"disk rule epoch revokes");
 reset<New>();round<New>(ports::Point::FinalIdentity,[]{New::commit(original(),6);},false,"late snapshot rules revoke");
 reset<New>();auto lease=New::view().identity;New::commit(original(),6);check(New::view().identity>lease,"rule selection commit advances identity lease");
 reset<New>();round<New>(ports::Point::FinalIdentity,[]{New::commit(original(),6);New::commit(original(),5);},false,"rules ABA revokes");
 // Defense checks alter one final snapshot field without a commit; these test
 // the independent full-identity/rule comparisons, not realistic writers.
 reset<New>();round<New>(ports::Point::FinalIdentity,[]{++New::raw().game.pid;},false,"final pid defense");
 reset<New>();round<New>(ports::Point::FinalIdentity,[]{++New::raw().game.processCreated;},false,"final birth defense");
 reset<New>();round<New>(ports::Point::FinalIdentity,[]{New::raw().game.path=L"D:\\Other\\Bluey.exe";},false,"final path defense");
 reset<New>();round<New>(ports::Point::FinalIdentity,[]{++New::raw().rulesEpoch;},false,"final rules defense");
 reset<New>();New::raw().identityGeneration=0;round<New>(ports::Point::None,{},false,"zero identity lease refuses");
 reset<New>();New::raw().generation=0;round<New>(ports::Point::None,{},false,"zero publication refuses");
 reset<New>();ports::s.process.processCreated++;round<New>(ports::Point::None,{},false,"OS birth mismatch refuses");
 reset<New>();ports::s.process.path=L"D:\\Other\\Bluey.exe";round<New>(ports::Point::None,{},false,"OS path mismatch refuses");
 reset<New>();ports::s.sameSession=false;round<New>(ports::Point::None,{},false,"foreign session refuses");
 reset<New>();ports::s.identityOk=false;round<New>(ports::Point::None,{},false,"identity I/O failure refuses");
 reset<New>();ports::s.white.clear();ports::s.black.push_back(L"bluey");round<New>(ports::Point::None,{},false,"removed whitelist honors exclusions");
 reset<New>();ports::s.white.clear();ports::s.memory=499;round<New>(ports::Point::None,{},false,"removed whitelist enforces memory gate");
 reset<New>();ports::s.custom.clear();round<New>(ports::Point::None,{},false,"removed custom admission refuses");
}
void writers(){
 reset<New>();auto b=New::view();New::touch();auto n=New::view();check(n.generation>b.generation&&n.identity==b.identity&&n.last>b.last&&n.selected==b.selected,"touch only advances heartbeat publication");
 reset<New>();b=New::view();auto same=original();same.title=L"new title";same.workingSet=1000;New::commit(same);n=New::view();check(n.generation>b.generation&&n.identity==b.identity&&n.selected==b.selected,"display/memory refresh preserves lease");
 reset<New>();b=New::view();same=original();same.path=L"d:\\game\\bluey.exe";New::commit(same);check(New::view().identity==b.identity,"path case alone preserves lease");
 reset<New>();New::raw().identityGeneration=0;New::commit(original());check(New::view().identity>0,"initial zero lease is repaired by commit");
 reset<New>();b=New::view();New::clear();n=New::view();check(n.generation>b.generation&&n.identity> b.identity&&!n.game.pid,"clear always advances lease and publication");auto previous=n.identity;auto publication=n.generation;New::clear();check(New::view().identity==previous&&New::view().generation>publication,"repeated no-game heartbeat preserves identity lease and advances publication");
}
json wireSamples=json::array();
void responses(){
 reset<New>();production::NativeGameValveSnapshot observation;
 const auto selected=production::nativeValveAcquire(0,0,&observation);
 check(selected.pid==observation.game.pid&&selected.processCreated==observation.game.processCreated,"response captures the elected process instance");
 check(observation.generation==New::view().generation&&observation.identityGeneration==New::view().identity&&observation.generation>0,"response carries the same lock-captured observation and identity lease");
 auto payload=production::nativeGameTargetJson(observation);wireSamples.push_back(payload);
 check(payload["valid"]==true&&payload["pid"]==selected.pid&&payload["processCreated"]==std::to_string(selected.processCreated),"valid wire payload retains elected identity");
 check(payload["generation"]==observation.generation&&payload["identityGeneration"]==observation.identityGeneration,"valid wire payload carries both generations");
 New::clear();observation=New::raw();payload=production::nativeGameTargetJson(observation);wireSamples.push_back(payload);
 check(payload["valid"]==false&&payload["pid"]==0&&payload["processCreated"]=="0","no-game wire payload is an explicit invalid tombstone");
 check(payload["generation"]==observation.generation&&payload["identityGeneration"]==observation.identityGeneration,"invalid wire payload retains ordered generations");
}
int main(){try{readers();writers();responses();std::cout<<"{\"passed\":true,\"checks\":"<<checks<<",\"wireSamples\":"<<wireSamples.dump()<<",\"readerCases\":"<<cases<<",\"maxPortSteps\":"<<maxPortSteps<<",\"portStepBudget\":256,\"frozenHeartbeatFalseRejectionReproduced\":true,\"productionHeartbeatAccepted\":true,\"actualAcquireRetainedBranchExecuted\":true,\"targetAndClearABARejected\":true,\"realWindowsOrSteamActions\":0}";return 0;}catch(const std::exception&e){std::cerr<<e.what()<<'\n';return 1;}}

struct LoopState{
 HANDLE ownedCleanup=nullptr,controller=nullptr,parked=nullptr,wake=nullptr,stopController=nullptr;
 std::atomic<bool> injectHelperWaitFailure{false};std::atomic<unsigned> forcedWaitFailures{0};
 bool windowPresent=false,firstTimeout=false,joined=false;unsigned configuredCloseFailures=0,steps=0;
 std::atomic<unsigned> ownerWaits{0},messageWaits{0},peeks{0},dispatches{0},readyCalls{0},closeAttempts{0},closeFailures{0},closeSuccesses{0};
 std::atomic<bool> capturePermit{false},steamPermit{false},messagePending{false},controllerDone{false};
 std::atomic<bool> parkedRetained{true},readyResetAfterRejected{true},completionBeforeClose{false},closeWithoutPermits{false};
 std::atomic<bool> controllerGateFailed{false};bool budgetCaught=false,returned=false,salvaged=false;

static WPARAM executeNormalLoop(){
#define waitForCleanupOrMessages observedLoopWait
#define IsWindow fixtureIsWindow
#define SendMessageW fixtureSend
#define CloseHandle fixtureClose
#define PeekMessageW fixturePeek

@UI_ENSURE_EXIT_OWNER@
#undef DispatchMessageW
#undef TranslateMessage
#undef PeekMessageW
#undef CloseHandle
#undef waitForCleanupOrMessages
static DWORD WINAPI privateCleanup(LPVOID){return 0;}
static json runLoopCase(bool window,bool capture,bool steam,unsigned failedClose,bool firstTimeout){
 LoopState state;loop=&state;state.windowPresent=window;state.configuredCloseFailures=failedClose;state.firstTimeout=firstTimeout;
 state.steamPermit=steam;g_captureExitReleased=capture;g_exitCleanupCompleted=false;g_exitRequested=true;g_exitReadyPosted=true;
 g_exitLastWaitingStage=nullptr;g_hwnd=window?reinterpret_cast<HWND>(std::uintptr_t{1}):nullptr;
 const unsigned before=failures;std::thread controller;std::string error;WPARAM returnedCode=0;
 try{
  for(HANDLE* h:{&state.parked,&state.wake,&state.stopController}){*h=::CreateEventW(nullptr,FALSE,FALSE,nullptr);if(!*h)throw std::runtime_error("owned loop event creation");}
  state.ownedCleanup=::CreateThread(nullptr,0,privateCleanup,nullptr,0,nullptr);
  if(!state.ownedCleanup||!::DuplicateHandle(::GetCurrentProcess(),state.ownedCleanup,::GetCurrentProcess(),&state.controller,0,FALSE,DUPLICATE_SAME_ACCESS))throw std::runtime_error("owned cleanup duplication");
  g_exitCleanupThread=state.ownedCleanup;
  state.joined=::WaitForSingleObject(state.controller,5000)==WAIT_OBJECT_0;
  if(!state.joined)throw std::runtime_error("owned cleanup thread join");
  controller=std::thread([&]{
   HANDLE handles[]={state.stopController,state.parked};
   for(;;){
    const auto observed=::WaitForMultipleObjects(2,handles,FALSE,5000);
    if(observed==WAIT_OBJECT_0)break;
    if(observed!=WAIT_OBJECT_0+1){state.controllerGateFailed=true;::SetEvent(state.wake);break;}
    if(++state.steps>8){state.controllerGateFailed=true;::SetEvent(state.wake);break;}
    // The production loop has parked on its private message event, while this
    // independent thread holds the only wake. Permit changes require dispatch.
    state.messagePending=true;::SetEvent(state.wake);
   }
   state.controllerDone=true;
  });
  try{returnedCode=executeNormalLoop();state.returned=true;}catch(const std::exception& e){error=e.what();}
 }catch(const std::exception& e){error=e.what();}
 if(state.stopController)::SetEvent(state.stopController);
 if(controller.joinable())controller.join();
 check(state.joined,"real cleanup thread positively joined before READY decisions");
 check(!state.budgetCaught,"signalled rejected READY cannot repeatedly wake without message-only parking");
 check(state.messageWaits>0&&state.steps>0,"pending gate or failed close reaches an owned blocking message wait");
 check(state.dispatches>0,"message-only wake falls through actual Peek and dispatch");
 check(state.parkedRetained&&!state.completionBeforeClose,"checked Close must precede complete and preserve owner on failure");
 check(!state.closeWithoutPermits,"lost window requires both capture and Steam permit before Close");
 check(state.closeFailures==failedClose,"configured valid-handle Close failure actually executed");
 check(state.closeSuccesses==1&&state.ownedCleanup==nullptr&&g_exitCleanupThread==nullptr,"production path positively closes cleanup handle exactly once");
 check(state.returned&&g_exitCleanupCompleted&&returnedCode==47,"actual main exit completes only after checked retirement");
 check(!window||state.readyResetAfterRejected,"rejected READY clears posted marker while retaining owner");
 check(!state.controllerGateFailed&&state.controllerDone,"fixture message controller positively joined");
 // Failure cleanup never discards an unverified handle. Its result remains a
 // failed contract, including the old Close-failure lost-owner reproduction.
 if(state.ownedCleanup&&state.joined){state.salvaged=true;if(::CloseHandle(state.ownedCleanup))state.ownedCleanup=nullptr;}
 unsigned remaining=unsigned(state.ownedCleanup!=nullptr);
 for(HANDLE* h:{&state.controller,&state.parked,&state.wake,&state.stopController})if(*h){if(::CloseHandle(*h))*h=nullptr;else ++remaining;}
 check(remaining==0,"all private loop kernel handles explicitly closed after join");
 json row={{"windowPresent",window},{"initialCapturePermit",capture},{"initialSteamPermit",steam},{"injectedCloseFailures",failedClose},
  {"firstMessageWaitTimeout",firstTimeout},{"fixturePass",failures==before},{"immediateWakeBudgetCaught",state.budgetCaught},
  {"ownerWaits",state.ownerWaits.load()},{"messageOnlyWaits",state.messageWaits.load()},{"peekCalls",state.peeks.load()},
  {"dispatches",state.dispatches.load()},{"readyCalls",state.readyCalls.load()},{"closeAttempts",state.closeAttempts.load()},
  {"closeFailures",state.closeFailures.load()},{"productionCloseSuccesses",state.closeSuccesses.load()},
  {"ownerRetainedAtMessagePark",state.parkedRetained.load()},{"completeBeforeClose",state.completionBeforeClose.load()},
  {"closeWithoutBothPermits",state.closeWithoutPermits.load()},{"ownedCleanupThreadJoined",state.joined},
  {"controllerJoined",state.controllerDone.load()},{"ownedHandlesRemaining",remaining},{"controllerSalvagedProductHandle",state.salvaged},
  {"processExitUsedAsCleanup",false},{"actualMainLoopAndReadyExecuted",true},{"memoryMessageAdapter",true},{"trace",state.trace},{"error",error}};
 g_exitCleanupThread=nullptr;loop=nullptr;return row;
}
static json runHelperWaitFailure(){
 LoopState state;loop=&state;state.injectHelperWaitFailure=true;state.steamPermit=true;state.windowPresent=false;
 g_captureExitReleased=true;g_exitCleanupCompleted=false;g_exitRequested=true;g_exitReadyPosted=false;g_hwnd=nullptr;
 const unsigned before=failures;std::thread controller;std::string error;
 try{
  for(HANDLE* h:{&state.parked,&state.wake,&state.stopController}){*h=::CreateEventW(nullptr,FALSE,FALSE,nullptr);if(!*h)throw std::runtime_error("helper observer event creation");}
  state.ownedCleanup=::CreateThread(nullptr,0,privateCleanup,nullptr,0,nullptr);
  if(!state.ownedCleanup||!::DuplicateHandle(::GetCurrentProcess(),state.ownedCleanup,::GetCurrentProcess(),&state.controller,0,FALSE,DUPLICATE_SAME_ACCESS))throw std::runtime_error("helper owner creation");
  g_exitCleanupThread=state.ownedCleanup;state.joined=::WaitForSingleObject(state.controller,5000)==WAIT_OBJECT_0;
  if(!state.joined)throw std::runtime_error("helper owner join failed");
  controller=std::thread([&]{
   HANDLE handles[]={state.stopController,state.parked};
   const auto value=::WaitForMultipleObjects(2,handles,FALSE,5000);
   if(value==WAIT_OBJECT_0+1){
    // A fixed helper reaches this owned blocking event, then can recover on
    // the next real signalled wait. The current helper never reaches it.
    ++state.steps;state.injectHelperWaitFailure=false;state.messagePending=true;::SetEvent(state.wake);
   }else if(value!=WAIT_OBJECT_0){state.controllerGateFailed=true;::SetEvent(state.wake);}
   state.controllerDone=true;
  });
  try{inputCaptureEnsureExitOwner(47);state.returned=true;}catch(const std::exception& e){error=e.what();}
 }catch(const std::exception& e){error=e.what();}
 if(state.stopController)::SetEvent(state.stopController);if(controller.joinable())controller.join();
 const bool retainedAfterFailure=state.ownedCleanup&&g_exitCleanupThread==state.ownedCleanup&&!g_exitCleanupCompleted;
 check(state.forcedWaitFailures>0,"actual EnsureExitOwner consumed injected WAIT_FAILED on a valid owned handle");
 check(!state.budgetCaught,"EnsureExitOwner WAIT_FAILED cannot repeatedly wake without message-only parking");
 check(state.messageWaits>0,"EnsureExitOwner WAIT_FAILED enters message-only blocking wait");
 check(state.returned&&g_exitCleanupCompleted&&state.closeSuccesses==1,"helper retries successfully only after message wait and checked Close");
 check(state.joined&&state.controllerDone&&!state.controllerGateFailed,"helper observer and cleanup threads positively joined");
 if(state.ownedCleanup&&state.joined){state.salvaged=true;if(::CloseHandle(state.ownedCleanup))state.ownedCleanup=nullptr;}
 unsigned remaining=unsigned(state.ownedCleanup!=nullptr);
 for(HANDLE* h:{&state.controller,&state.parked,&state.wake,&state.stopController})if(*h){if(::CloseHandle(*h))*h=nullptr;else ++remaining;}
 check(remaining==0,"helper failure observer explicitly closes all owned handles after joins");
 json row={{"case","EnsureExitOwner-WAIT_FAILED"},{"fixturePass",failures==before},{"actualEnsureExitOwnerExecuted",true},
  {"validOwnedHandleFailureInjection",true},{"forcedWaitFailures",state.forcedWaitFailures.load()},
  {"immediateWakeBudgetCaught",state.budgetCaught},{"messageOnlyWaits",state.messageWaits.load()},
  {"ownerRetainedAfterFailedWait",retainedAfterFailure},{"controllerSalvagedProductHandle",state.salvaged},
  {"ownedCleanupThreadJoined",state.joined},{"controllerJoined",state.controllerDone.load()},
  {"ownedHandlesRemaining",remaining},{"processExitUsedAsCleanup",false},{"error",error}};
 g_exitCleanupThread=nullptr;loop=nullptr;return row;
}
int main(int argc,char**){json cases=json::array();
 if(argc>1){cases.push_back(runHelperWaitFailure());std::cout<<json({{"pass",failures==0},{"checks",checks},{"failures",failures},{"cases",cases}}).dump()<<'\n';return failures?1:0;}
 for(const auto window:{true,false}){
  cases.push_back(runLoopCase(window,false,true,0,false));
  cases.push_back(runLoopCase(window,true,false,0,false));
  cases.push_back(runLoopCase(window,true,true,1,false));
 }
 cases.push_back(runLoopCase(true,false,true,1,false));
 cases.push_back(runLoopCase(true,false,true,0,true));
 cases.push_back(runLoopCase(false,false,false,1,false));
 std::cout<<json({{"pass",failures==0},{"checks",checks},{"failures",failures},{"cases",cases},
 {"wholeLifecycleAcceptance",false},{"realWindowOrHardwareOrSleep",false},{"processExitUsedAsCleanup",false}}).dump()<<'\n';return failures?1:0;}

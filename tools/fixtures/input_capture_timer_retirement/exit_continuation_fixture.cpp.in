static LRESULT fixtureSend(HWND h,UINT msg,WPARAM w,LPARAM l){++loop->readyCalls;return executeReady(h,msg,w,l);}
namespace ymcc::exitLifecycle {
static DWORD observedLoopWait(HANDLE handle){
 if(handle){
  if(++loop->ownerWaits>8){loop->budgetCaught=true;throw std::runtime_error("bounded immediate-handle wake observer caught spin");}
  if(handle!=loop->ownedCleanup)throw std::runtime_error("loop wait lost owned cleanup handle");
  if(loop->injectHelperWaitFailure){
   if(::WaitForSingleObject(loop->controller,0)!=WAIT_OBJECT_0)throw std::runtime_error("failure injection requires positively signalled real owner");
   ++loop->forcedWaitFailures;::SetLastError(ERROR_GEN_FAILURE);return WAIT_FAILED;
  }
  // The signalled wait uses the actual production header against our owned
  // real thread object. No fabricated signalled WAIT_RESULT is admitted.
  const DWORD result=waitForCleanupOrMessages(handle);
  if(result!=WAIT_OBJECT_0)throw std::runtime_error("fixture cleanup thread must already be signalled");
  return result;
 }
 ++loop->messageWaits;
 const bool retained=loop->ownedCleanup&&g_exitCleanupThread==loop->ownedCleanup&&!g_exitCleanupCompleted;
 if(!retained)loop->parkedRetained=false;
 if(loop->windowPresent&&g_exitReadyPosted.load())loop->readyResetAfterRejected=false;
 loop->trace.push_back({{"action","message-only-park"},{"ownerRetained",retained},{"ownerWaits",loop->ownerWaits.load()},
  {"closeFailures",loop->closeFailures.load()},{"capturePermit",inputCaptureExitOwnershipReleased()},{"steamPermit",steamOriginalRecoveryStopped()}});
 ::SetEvent(loop->parked);
 // Memory message adapter: a controller must wake this private kernel event.
 // No Sleep, real window, hardware, service or Game Bar operation is involved.
 if(::WaitForSingleObject(loop->wake,5000)!=WAIT_OBJECT_0)throw std::runtime_error("private message wake failed");
 if(loop->firstTimeout&&loop->messageWaits==1)return WAIT_TIMEOUT;
 return WAIT_OBJECT_0;
}
}
static BOOL fixturePeek(MSG* message,HWND,UINT,UINT,UINT){
 ++loop->peeks;if(!loop->messagePending.exchange(false))return FALSE;
 message->message=kFixturePermit;message->wParam=0;message->lParam=0;return TRUE;
}
static BOOL fixtureTranslate(const MSG*){return TRUE;}
static LRESULT fixtureDispatch(const MSG* message){
 if(message->message!=kFixturePermit)throw std::runtime_error("unexpected memory message");
 ++loop->dispatches;
 if(!inputCaptureExitOwnershipReleased())g_captureExitReleased=true;
 else if(!steamOriginalRecoveryStopped())loop->steamPermit=true;
 loop->trace.push_back({{"action","Peek-dispatch"},{"dispatches",loop->dispatches.load()}});
 return 0;
}

static json replay(bool held,bool childHeld){
 auto owner=std::make_unique<KernelCase>();KernelCase& state=*owner;current=&state;
 const auto before=failures;resetCaptureFixture();g_inputCaptureThread=nullptr;g_inputCaptureStop=false;
 postQuitCalls=sealCalls=coUninitCalls=0;quitProbe=sealProbe=uninitProbe=WAIT_FAILED;
 finalReturned=false;gateHeldProven=false;childPolls=ownerPauseCount=cleanupCreated=cleanupClosed=cleanupJoinProofs=0;
 holdMemoryChild=childHeld;memoryClock=100;g_exitRequested=true;
 bool returned=false,finalDone=false;std::string error;std::thread controller;
 bool retainedLogged=false;unsigned actualOwnerStops=0;
#if FIXTURE_TYPED_EXIT
 g_exitCleanupThread=nullptr;g_exitCleanupCompleted=false;g_exitCleanupWorkerFailureReported=false;
#endif
 {
  CleanupGuard cleanup{state,owner};
  try{
   for(OwnedHandle* event:{&state.ready,&state.release,&state.completed}){event->value=::CreateEventW(nullptr,TRUE,FALSE,nullptr);requireSetup(event->value!=nullptr,"owned event creation");}
   state.product.value=::CreateThread(nullptr,0,ownedWorker,&state,0,nullptr);requireSetup(state.product.value!=nullptr,"owned worker creation");
   state.workerCreated=true;state.originalProduct=state.product.value;g_inputCaptureThread=state.product.value;
   requireSetup(::DuplicateHandle(::GetCurrentProcess(),state.product.value,::GetCurrentProcess(),&state.controller.value,0,FALSE,DUPLICATE_SAME_ACCESS)!=FALSE,"owned controller duplication");
   state.controllerDuplicatedBeforeStop=true;requireSetup(realWait(state.ready.value,kReadyWaitMs).result==WAIT_OBJECT_0,"owned worker ready");
   if(!held){state.releaseAndJoin();requireSetup(state.joined,"precompleted worker joined");}
#if FIXTURE_TYPED_EXIT
   ownerPaused=::CreateEventW(nullptr,FALSE,FALSE,nullptr);ownerResume=::CreateEventW(nullptr,FALSE,FALSE,nullptr);
   requireSetup(ownerPaused&&ownerResume,"owner observation events created");
   if(held||childHeld)controller=std::thread([&]{
    const unsigned pauses=unsigned(held)+unsigned(childHeld);
    for(unsigned i=0;i<pauses;++i){
     if(::WaitForSingleObject(ownerPaused,10000)!=WAIT_OBJECT_0){::SetEvent(state.release.value);::SetEvent(ownerResume);return;}
     const bool barrier=!finalReturned.load()&&sealCalls==0&&coUninitCalls==0&&!g_captureExitReleased.load();
     if(barrier)gateHeldProven=true;
     if(held&&i==0){if(state.host!=0)gateHeldProven=false;::SetEvent(state.release.value);(void)realWait(state.controller.value,5000);}
     ::SetEvent(ownerResume);
    }
   });
#else
   ++state.stopCalls;
#endif
   returned=executeDestroyExitPath()==0;
   finalDone=executeMainFinally()==0;finalReturned=true;
   if(controller.joinable())controller.join();
   check(returned&&finalDone,"both complete production exit fragments returned");
   check(postQuitCalls==1&&sealCalls==1&&coUninitCalls==1,"actual quit and final cleanup leaves reached");
#if FIXTURE_TYPED_EXIT
   actualOwnerStops=state.waitCount;
   check(g_captureExitReleased.load()&&g_exitCleanupCompleted&&!g_exitCleanupThread,"actual gate consumed actual background owner completion");
   check(cleanupCreated==1&&cleanupClosed==1&&cleanupJoinProofs==1,"production cleanup owner created joined and closed once");
   check(sealProbe==WAIT_OBJECT_0&&uninitProbe==WAIT_OBJECT_0,"final seal and COM teardown follow real capture thread completion");
   check(!state.hostWhileWorkerLive,"actual Stop never runs Host leaf over live producer");
   check(!(held||childHeld)||gateHeldProven.load(),"actual final gate remained blocked during retained debt");
   check(!held||state.productWaits[0].result==WAIT_TIMEOUT,"held worker produced a genuine kernel timeout");
   unsigned ownershipRows=0;
   for(const auto& log:state.logs){
    if(log.value("event","")=="input-capture-exit-ownership"){
     ++ownershipRows;check(log.value("version",0)==1&&log.value("scope","")=="capture-resource-only;Host-return-separate"&&log.value("baseLane",false),"actual ownership row keeps capture-only scope version and ordinary log admission");
    }
    if(log.value("event","")=="input-capture-exit-retained"){retainedLogged=true;check(log.value("baseLane",false),"actual retained diagnostic belongs to ordinary logging");}
   }
   check(ownershipRows>0&&nativeLifecycleEventIsBase("input-host-exit-capture-neutral"),"actual default classifier includes all new bounded capture exit events");
   check(!(held||childHeld)||retainedLogged,"actual 30s retained diagnostic executed on explicit memory clock");
#else
   check(state.waitCount==1&&state.productWaits[0].budget==2000,"historical destroy called complete production Stop");
   check(sealProbe==(held?WAIT_TIMEOUT:WAIT_OBJECT_0)&&uninitProbe==sealProbe,"original quit-before-settlement failure preserved");
#endif
   state.releaseAndJoin();requireSetup(state.joined,"controller positively joined worker");
   if(g_inputCaptureThread)invokeStop(state);
  }catch(const std::exception& e){error=e.what();check(false,"exit consumer failure");}
  if(controller.joinable()){::SetEvent(state.release.value);::SetEvent(ownerResume);controller.join();}
#if FIXTURE_TYPED_EXIT
  // Failure retains ownership; a process return can never be the cleanup proof.
  if(g_exitCleanupThread){if(realWait(g_exitCleanupThread,5000).result==WAIT_OBJECT_0){closeCleanupHandle(g_exitCleanupThread);g_exitCleanupThread=nullptr;}else owner.release();}
#endif
 }
 const bool workerJoined=state.joined&&state.workerDone.load();
 check(workerJoined&&state.handlesRemaining()==0,"fixture product threads events and handles disposed after join");
 bool observationEventsClosed=true;
 for(HANDLE* h:{&ownerPaused,&ownerResume})if(*h){if(::CloseHandle(*h))*h=nullptr;else observationEventsClosed=false;}
 check(observationEventsClosed,"owner observation events closed explicitly");
 const bool gap=held&&sealProbe!=WAIT_OBJECT_0;
 json row={{"held",held},{"memoryChildHeld",childHeld},{"actualDestroyExitPathExecuted",returned},{"actualMainFinallyExecuted",finalDone},
 {"actualExitGateAndBackgroundOwnerExecuted",bool(FIXTURE_TYPED_EXIT)},{"gateBlockedWithRetainedDebt",gateHeldProven.load()},
 {"quitBeforeThreadJoin",quitProbe!=WAIT_OBJECT_0},{"sealBeforeThreadJoin",sealProbe!=WAIT_OBJECT_0},{"coUninitializeBeforeThreadJoin",uninitProbe!=WAIT_OBJECT_0},
 {"productionExitContinuationGapObserved",gap},{"postQuitIsMessageOnly",bool(FIXTURE_TYPED_EXIT)},{"actualOwnerWorkerWaits",actualOwnerStops},
 {"cleanupCreated",cleanupCreated.load()},{"cleanupJoinedBeforeClose",cleanupJoinProofs.load()},{"cleanupClosed",cleanupClosed.load()},
 {"lifecycleLogs",state.logs},{"retainedDiagnosticExecuted",retainedLogged},{"hostCleanupWhileWorkerLive",state.hostWhileWorkerLive},
 {"ownedThreadJoined",workerJoined},{"ownedHandlesRemaining",state.handlesRemaining()+unsigned(!observationEventsClosed)},
 {"ownedEventsRemaining",state.eventsRemaining()+unsigned(!observationEventsClosed)},{"processExitUsedAsCleanup",false},
 {"wholeLifecycleAcceptance",false},{"realChildResourcesExecuted",false},{"error",error},{"fixturePass",failures==before}};
 row["contextRetained"]=!owner;if(owner){current=nullptr;g_inputCaptureThread=nullptr;}return row;
}
int main(){json cases=json::array();cases.push_back(replay(false,false));if(!cases.back().value("contextRetained",true))cases.push_back(replay(true,false));
#if FIXTURE_TYPED_EXIT
 if(!cases.back().value("contextRetained",true))cases.push_back(replay(false,true));
#endif
 std::cout<<json({{"fixturePass",failures==0},{"checks",checks},{"failures",failures},{"cases",cases},
 {"wholeLifecycleAcceptance",false},{"realPrivateKernelObjectsOnly",true},{"installedApplicationExecuted",false}}).dump()<<'\n';return failures?1:0;}


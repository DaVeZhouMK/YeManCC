static BOOL fixtureClose(HANDLE handle){
 if(!handle||handle!=loop->ownedCleanup)throw std::runtime_error("invalid or stale fixture handle close");
 ++loop->closeAttempts;
 if(g_exitCleanupCompleted)loop->completionBeforeClose=true;
 if(!inputCaptureExitOwnershipReleased()||!steamOriginalRecoveryStopped())loop->closeWithoutPermits=true;
 if(::WaitForSingleObject(loop->controller,0)!=WAIT_OBJECT_0)throw std::runtime_error("close before cleanup thread signal");
 if(loop->closeFailures.load()<loop->configuredCloseFailures){++loop->closeFailures;::SetLastError(ERROR_ACCESS_DENIED);return FALSE;}
 const BOOL ok=::CloseHandle(handle);if(ok){++loop->closeSuccesses;loop->ownedCleanup=nullptr;}return ok;
}

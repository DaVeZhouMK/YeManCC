    need(retried.at("nativeObserverCloseSucceeded")==true&&retried.at("nativeObserverCloseError")==ERROR_SUCCESS,"same-owner retry receipt must show actual close");
    DWORD exitCode=99;need(GetExitCodeProcess(child.process,&exitCode)&&exitCode==0,"private process exit is actual fixture preparation");
    const HANDLE process=child.process,primary=child.primary,release=child.release,job=child.job;
    need(::CloseHandle(process)&&::CloseHandle(primary)&&::CloseHandle(release)&&::CloseHandle(job),"close only remaining fixture-owned child preparation handles");
    child.process=nullptr;child.primary=nullptr;child.release=nullptr;child.job=nullptr;
    const bool closed=!open(process)&&!open(primary)&&!open(release)&&!open(job);
    need(closed,"observer-only private preparation handles closed before RAII cleanup");
    json observedChecks=json::array();for(const auto& item:observer::checks)observedChecks.push_back({{"passed",item.first},{"assertion",item.second}});
    return {{"scopedLocalOwnerPass",true},{"scenario","coordinator-observer-close"},{"originalConsumerOnly",true},
      {"normalClose",normalResult},{"protectedClose",failedResult},{"sameOwnerRetry",retried},{"originalCheckRows",observedChecks},
      {"protectedCloseFailureExpected",true},{"sameRetainedHandleRetried",true},{"originalDefaultCasesExecuted",false},
      {"privateChildExitPreparation","existing private child release thread; child already exited before observer checks; not product release proof"},
      {"fixtureCleanup",{{"privateHandlesClosed",closed},{"childKillOrEventBackstop",false},{"observerGuardFallbackUsedForSuccess",false}}},
      {"assertionsPassed",fixtureAssertionCount.load()},{"actualProductExitExecuted",false},{"fullApplicationExitAccepted",false}};

// Test-only clock changes only explicit production GetTickCount64/Sleep ports;
// real process/thread/pipe ownership and kernel waits remain real.
static std::atomic<bool> fixtureStepClock{false};
static std::atomic<ULONGLONG> fixtureClockOffset{0};
static std::atomic<unsigned> steppedSleeps{0};
static HANDLE fixtureParked=nullptr,fixtureContinue=nullptr;
static std::atomic<bool> fixtureParkEnabled{false},fixtureParkHit{false};
static bool fixtureParkOnHost=false;
static std::atomic<ULONGLONG> fixtureHostAwaitBegan{0},fixtureCaptureAwaitBegan{0};
static ULONGLONG fixtureNow(const char* caller=nullptr){
    const auto now=::GetTickCount64()+fixtureClockOffset.load();
    if(caller){
        auto* first=std::strcmp(caller,"inputHostAwaitLocalRetirementForExit")==0?&fixtureHostAwaitBegan:
            std::strcmp(caller,"inputCaptureAwaitStopForExit")==0?&fixtureCaptureAwaitBegan:nullptr;
        if(first){ULONGLONG zero=0;(void)first->compare_exchange_strong(zero,now);}
    }
    return now;
}
static void fixtureSleep(DWORD ms,const char* caller=nullptr){
    if(!fixtureStepClock){::Sleep(ms);return;}
    fixtureClockOffset.fetch_add(ms);++steppedSleeps;
    if(fixtureParkEnabled&&caller){
        const bool sameStage=std::strcmp(caller,fixtureParkOnHost?"inputHostAwaitLocalRetirementForExit":"inputCaptureAwaitStopForExit")==0;
        const auto began=fixtureParkOnHost?fixtureHostAwaitBegan.load():fixtureCaptureAwaitBegan.load();
        if(sameStage&&began&&fixtureNow()-began>=31000&&!fixtureParkHit.exchange(true)){
            need(SetEvent(fixtureParked)!=FALSE,"signal retained checkpoint observation");
            need(::WaitForSingleObject(fixtureContinue,10000)==WAIT_OBJECT_0,"bounded fixture release of 31s late completion");
        }
    }
}

struct ScopedObserverOracle {
    HANDLE value=nullptr;
    ~ScopedObserverOracle(){
        DWORD flags=0;
        if(value&&GetHandleInformation(value,&flags)){
            SetHandleInformation(value,HANDLE_FLAG_PROTECT_FROM_CLOSE,0);
            ::CloseHandle(value); // failure cleanup only; never a passing oracle
        }
    }
};
static json coordinatorObserverCloseCase(){
    namespace observer=coordinatorObserverFixture;
    Child child;child.exitByThread();
    need(::WaitForSingleObject(child.primary,2000)==WAIT_OBJECT_0,"observer test private primary exited before helper");
    wchar_t directory[32768]{};const DWORD length=GetCurrentDirectoryW(32768,directory);
    need(length>0&&length<32768,"observer test cwd is original private profile directory");
    const std::wstring receipt=std::wstring(directory)+L"\\coordinator-observer-receipt.json";
    const char body[]="{\"status\":\"OBSERVED\",\"failure\":null,\"scope\":\"fixture-observer-only-no-managed-behavior\"}";
    HANDLE file=CreateFileW(receipt.c_str(),GENERIC_WRITE,0,nullptr,CREATE_NEW,FILE_ATTRIBUTE_NORMAL,nullptr);
    need(file!=INVALID_HANDLE_VALUE,"observer private receipt CreateNew");DWORD written=0;
    const BOOL wrote=WriteFile(file,body,static_cast<DWORD>(sizeof(body)-1),&written,nullptr);const BOOL flushed=FlushFileBuffers(file);const BOOL fileClosed=::CloseHandle(file);
    need(wrote&&written==sizeof(body)-1&&flushed&&fileClosed,"observer private receipt durable write and checked close");
    observer::fullPipeReceipts.push_back(receipt);
    ScopedObserverOracle normal;
    need(DuplicateHandle(GetCurrentProcess(),child.process,GetCurrentProcess(),&normal.value,0,FALSE,DUPLICATE_SAME_ACCESS)!=FALSE,"normal observation duplicate");
    observer::fullPipeChildObservers.push_back(normal.value);
    const auto normalResult=observer::fullPipeChildOutcome();
    need(observer::fullPipeChildObservers.empty()&&!open(normal.value),"successful close must retire exact observation owner");normal.value=nullptr;
    ScopedObserverOracle protectedOwner;
    need(DuplicateHandle(GetCurrentProcess(),child.process,GetCurrentProcess(),&protectedOwner.value,0,FALSE,DUPLICATE_SAME_ACCESS)!=FALSE,"protected observation duplicate");
    need(SetHandleInformation(protectedOwner.value,HANDLE_FLAG_PROTECT_FROM_CLOSE,HANDLE_FLAG_PROTECT_FROM_CLOSE)!=FALSE,"protect only own observation HANDLE");
    observer::fullPipeChildObservers.push_back(protectedOwner.value);
    const auto failedResult=observer::fullPipeChildOutcome();
    need(observer::fullPipeChildObservers.size()==1&&observer::fullPipeChildObservers.front()==protectedOwner.value&&open(protectedOwner.value),"failed close lost sole observation owner");
    need(failedResult.at("nativeObserverCloseSucceeded")==false&&failedResult.at("nativeObserverCloseError").get<DWORD>()!=ERROR_SUCCESS,"failed close must preserve actual Win32 error");
    need(normalResult.at("nativeObserverCloseSucceeded")==true&&normalResult.at("nativeObserverCloseError")==ERROR_SUCCESS,"normal close receipt must reflect actual success");
    const auto retainedErrors=std::count_if(observer::checks.begin(),observer::checks.end(),[](const auto& row){return !row.first;});
    need(retainedErrors==1&&std::any_of(observer::checks.begin(),observer::checks.end(),[](const auto& row){return !row.first&&row.second=="owned managed Host observation handle checked closed";}),"original check must record exactly one protected-close failure");
    need(SetHandleInformation(protectedOwner.value,HANDLE_FLAG_PROTECT_FROM_CLOSE,0)!=FALSE,"remove only fixture observation protection");
    const auto retried=observer::fullPipeChildOutcome();

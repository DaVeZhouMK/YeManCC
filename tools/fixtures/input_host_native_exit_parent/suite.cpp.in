// Explicit opt-in bridge: retain the original private-child scenario while the
// child executes the existing managed terminal consumer before native OS return.
static std::wstring managedChildEnv(const wchar_t* name){
    wchar_t value[32768]{};const DWORD length=GetEnvironmentVariableW(name,value,32768);
    need(length<32768,"managed child environment too long");return length?std::wstring(value,length):std::wstring{};
}
static bool managedChildRequested(){return !managedChildEnv(L"YMCC_NATIVE_EXIT_MANAGED_PROGRAM").empty();}
static void configureManagedChild(std::wstring& application,std::wstring& command){
    const auto program=managedChildEnv(L"YMCC_NATIVE_EXIT_MANAGED_PROGRAM");if(program.empty())return;
    const auto assembly=managedChildEnv(L"YMCC_NATIVE_EXIT_MANAGED_ASSEMBLY"),proof=managedChildEnv(L"YMCC_NATIVE_EXIT_MANAGED_PROOF"),nonce=managedChildEnv(L"YMCC_NATIVE_EXIT_MANAGED_NONCE");
    const auto quote=[](const std::wstring& value){need(!value.empty()&&value.find(L'"')==std::wstring::npos&&value.back()!=L'\\',"managed child explicit file argument");return L"\""+value+L"\"";};
    need(nonce.size()==32&&std::all_of(nonce.begin(),nonce.end(),[](wchar_t c){return (c>=L'0'&&c<=L'9')||(c>=L'a'&&c<=L'f');}),"managed child nonce format");
    application=program;command=quote(program)+L" "+quote(assembly)+L" --retained-owner-child "+quote(proof)+L" "+nonce+L" "+std::to_wstring(GetCurrentProcessId());
}
static unsigned long long managedBirthTicks(HANDLE process){
    FILETIME birth{},exit{},kernel{},user{};need(GetProcessTimes(process,&birth,&exit,&kernel,&user)!=FALSE,"managed handoff process creation time");
    ULARGE_INTEGER value{};value.HighPart=birth.dwHighDateTime;value.LowPart=birth.dwLowDateTime;
    return value.QuadPart+504911232000000000ULL;
}
static json readManagedRetainedProof(HANDLE process){
    const auto file=managedChildEnv(L"YMCC_NATIVE_EXIT_MANAGED_PROOF");const auto started=::GetTickCount64();
    while(::GetTickCount64()-started<8000){
        HANDLE input=CreateFileW(file.c_str(),GENERIC_READ,0,nullptr,OPEN_EXISTING,FILE_FLAG_OPEN_REPARSE_POINT,nullptr);
        if(input==INVALID_HANDLE_VALUE){
            const auto error=GetLastError();need(error==ERROR_FILE_NOT_FOUND||error==ERROR_PATH_NOT_FOUND||error==ERROR_SHARING_VIOLATION,"managed retained proof open");
            need(::WaitForSingleObject(process,0)==WAIT_TIMEOUT,"managed child exited before retained proof");::Sleep(10);continue;
        }
        BY_HANDLE_FILE_INFORMATION info{};LARGE_INTEGER size{};
        const bool valid=GetFileInformationByHandle(input,&info)&&!(info.dwFileAttributes&FILE_ATTRIBUTE_REPARSE_POINT)&&GetFileSizeEx(input,&size)&&size.QuadPart>0&&size.QuadPart<=1024*1024;
        if(!valid){::CloseHandle(input);need(false,"managed retained proof bounded regular file");}
        std::string bytes(static_cast<std::size_t>(size.QuadPart),'\0');DWORD count=0;
        const bool read=ReadFile(input,bytes.data(),static_cast<DWORD>(bytes.size()),&count,nullptr)!=FALSE;
        const bool closed=::CloseHandle(input)!=FALSE;need(read&&closed&&count==bytes.size(),"managed retained proof complete read and close");
        return json::parse(bytes);
    }
    throw std::runtime_error("managed retained proof deadline");
}
static void verifyManagedRetainedProof(const json& delivered,HANDLE process){
    json proof=delivered;const auto mutation=managedChildEnv(L"YMCC_NATIVE_EXIT_MANAGED_PROOF_MUTATION");
    need(mutation.empty()||mutation==L"nonce","unknown managed retained proof mutation");
    if(mutation==L"nonce")proof["nonce"]="deliberately-wrong-native-consumer-nonce";
    const auto expected=managedChildEnv(L"YMCC_NATIVE_EXIT_MANAGED_NONCE");
    need(proof.at("schemaVersion")==1&&proof.at("kind")=="ymcc-managed-retained-proof-v1","managed retained proof contract");
    std::string expectedAscii;for(const auto c:expected)expectedAscii.push_back(static_cast<char>(c));
    need(proof.at("nonce")==expectedAscii,"managed retained proof nonce rejected");
    need(proof.at("pid")==GetProcessId(process)&&proof.at("nativeParentPid")==GetCurrentProcessId(),"managed retained proof exact process owners");
    need(std::stoull(proof.at("managedBirthUtcTicks").get<std::string>())==managedBirthTicks(process)&&std::stoull(proof.at("nativeParentBirthUtcTicks").get<std::string>())==managedBirthTicks(GetCurrentProcess()),"managed retained proof exact creation identities");
    const auto& result=proof.at("caseResult");
    need(result.at("name")=="terminal-shutdown-output-fixed"&&result.at("pass")==true&&result.at("exit")==7,"managed original terminal error preserved");
    const auto& receipts=result.at("receipts");need(receipts.is_array()&&receipts.size()==1,"managed original single terminal receipt");
    const auto& receipt=receipts.at(0);
    need(receipt.at("ManagedReleaseComplete")==false&&receipt.at("ResourceDisposition")=="owner-retained"&&receipt.at("ExitCode")==7&&receipt.at("ReleaseAttempts")==2&&receipt.at("DirectReleaseAttempts")==1&&receipt.at("Retried")==true,"managed retained terminal debt not success");
    const auto& resources=result.at("beforeFixtureCleanup");const auto& workers=resources.at("workers");
    need(workers.is_array()&&!workers.empty()&&resources.at("ContextCalls")==0,"managed original live owner resource snapshot");
    for(const auto& worker:workers)need(worker.at("outputAlive")==true&&worker.at("outputCtsClosed")==false&&worker.at("outputFinallyRan")==false&&worker.at("sdkDisposedFlag")==false&&worker.at("callbacks")==0,"managed retained worker not fixture-released");
    need(::WaitForSingleObject(process,0)==WAIT_TIMEOUT,"managed retained process still owned and live");
}


// Explicit typed capture Stop port. Healthy/legacy cases pre-retire capture;
// R8 injects receipt debts. This does NOT execute the physical Stop/COM/DSU leaves.
// Actual AwaitStop, producer getter, authority and exit worker consume every receipt.
static ymcc::captureLifecycle::StopReceipt inputCaptureStop(bool,DWORD workerWaitMs){
    need(workerWaitMs<=2000,"capture worker wait budget capped");
    ++captureStopCalls;if(captureThrows)throw std::runtime_error("explicit-capture-stop-fault");
    ymcc::captureLifecycle::StopReceipt receipt;
    receipt.generation=captureReceiptGeneration;receipt.debts=captureReceiptDebts;
    receipt.workerExited=captureWorkerExited;receipt.workerHandleClosed=captureHandleClosed;
    receipt.classify();return receipt;
}

// Premise: capture's owned resources were already retired, independently of Host.
// Actual receipt type/classifier, actual AwaitStop/ExitOwnershipReleased consume it.
static ymcc::captureLifecycle::StopReceipt inputCaptureStop(bool){
    ++captureStopCalls;ymcc::captureLifecycle::StopReceipt receipt;
    receipt.generation=7;receipt.workerExited=true;receipt.workerHandleClosed=true;receipt.classify();return receipt;
}

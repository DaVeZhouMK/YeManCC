// OS windows/message/COM leaves are explicit in-memory ports, no User32/COM IO.
static DWORD memoryMessageWait(DWORD count,const HANDLE* handles,DWORD,DWORD,DWORD){
    if(count==1)return ::WaitForSingleObject(*handles,12000);
    throw std::runtime_error("ensure needed a new wait cycle; stop diagnostic without inventing exit policy");
}

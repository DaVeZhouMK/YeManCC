using namespace SteamOriginalRecovery;
static unsigned checks=0;static std::vector<U64> realDurations;
static void check(bool good,const char* why){++checks;if(!good)throw std::runtime_error(why);}
static void awaitClock(U64 count){
 if(!hasDeadline)return; // Old-source control: assert its actual early dispatch, not a missing clock callback.
 std::unique_lock<std::mutex> lock(clockMx);
 check(clockCv.wait_for(lock,1500ms,[&]{return clockCalls>=count;}),"worker-did-not-reach-real-wait-helper");
}
struct Worker {
 std::shared_ptr<Control> c;std::mutex mx;std::condition_variable cv;
 std::vector<Pending> seen;std::vector<U64> at;std::thread thread;
 explicit Worker(std::shared_ptr<Control> owner):c(std::move(owner)){
  currentPort=c;
  thread=std::thread([this]{Pending p;while(takeNext(c,p)){
   {std::lock_guard<std::mutex> lock(mx);seen.push_back(p);at.push_back(realClock?realTick():tickValue.load());}cv.notify_all();
  }});
 }
 void halt(){if(thread.joinable()){steamOriginalRecoveryRequestStop();thread.join();currentPort.reset();}}
 ~Worker(){halt();}
 bool countAtLeast(std::size_t n,std::chrono::milliseconds ms=1500ms){std::unique_lock<std::mutex> lock(mx);return cv.wait_for(lock,ms,[&]{return seen.size()>=n;});}
 std::size_t count(){std::lock_guard<std::mutex> lock(mx);return seen.size();}
};
static void resetClock(){realClock=false;tickValue=1000;clockCalls=0;}
static void advanceTick(const std::shared_ptr<Control>& c,U64 now){
 {std::lock_guard<std::mutex> lock(c->mx);tickValue=now;}c->cv.notify_all();
}
#if !FIXTURE_COMMAND_READY
static void burst(){
 resetClock();auto c=std::make_shared<Control>();enqueue(c,Trigger::TargetChanged);
 Worker w(c);awaitClock(2);check(!w.countAtLeast(1,10ms),"ordinary-ran-before-fixed-window");
 for(U64 n:{1010ull,1020ull,1049ull}){advanceTick(c,n);enqueue(c,Trigger::TargetChanged);}
 advanceTick(c,1099);check(!w.countAtLeast(1,15ms),"ordinary-ran-before-100ms");
 advanceTick(c,1100);check(w.countAtLeast(1),"ordinary-not-released-at-100ms");
 check(!w.countAtLeast(2,20ms),"burst-started-more-than-one-round");
 check(c->sequence==1&&c->observationSequence==1,"duplicate-changed-sequences");
 check(w.seen[0].sequence==1&&!w.seen[0].startupFresh,"ordinary-suffix-or-sequence-changed");
}
static void continuous(){
 resetClock();auto c=std::make_shared<Control>();enqueue(c,Trigger::TargetChanged);Worker w(c);awaitClock(2);
 for(U64 n=1010;n<=1090;n+=10){advanceTick(c,n);enqueue(c,Trigger::TargetChanged);}
 advanceTick(c,1099);enqueue(c,Trigger::TargetChanged);
 check(!w.countAtLeast(1,10ms),"continuous-ran-early");
 advanceTick(c,1100);check(w.countAtLeast(1,200ms),"duplicates-refreshed-original-deadline");
 check(c->sequence==1,"continuous-duplicate-created-new-sequence");
}
static void urgent(Trigger kind){
 resetClock();auto c=std::make_shared<Control>();enqueue(c,Trigger::TargetChanged,1);enqueue(c,Trigger::TargetChanged,2);
 Worker w(c);awaitClock(3);check(!w.countAtLeast(1,10ms),"ordinary-predecessor-ran-early");
 enqueue(c,kind,(kind==Trigger::Wake||kind==Trigger::SuspendCapture)?10:0);
 check(w.countAtLeast(3,200ms),"urgent-waited-for-ordinary-deadline");
 check(w.seen[0].kind==Trigger::TargetChanged&&w.seen[0].generation==1&&w.seen[1].generation==2&&w.seen[2].kind==kind,"urgent-reordered-fifo");
 check(w.seen[0].sequence==1&&w.seen[1].sequence==2&&w.seen[2].sequence==3,"urgent-sequence-order-changed");
 check(tickValue==1000,"urgent-test-advanced-clock");
}
static void urgentStartup(){urgent(Trigger::Startup);}
static void urgentSteam(){urgent(Trigger::SteamChanged);}
static void urgentSuspend(){urgent(Trigger::SuspendCapture);}
static void urgentWake(){urgent(Trigger::Wake);}
static void suffix(){
 resetClock();auto c=std::make_shared<Control>();auto s=std::make_shared<StartupFreshWait>();
 // Four-field aggregate is the exact-flight completion enqueue shape.
 c->pending.push_back({Trigger::TargetChanged,0,77,s});
 {Worker w(c);check(w.countAtLeast(1,200ms),"front-suffix-was-delayed");check(w.seen[0].startupFresh==s&&w.seen[0].sequence==77,"suffix-qualification-changed");check(clockCalls==0,"suffix-read-clock");}
 c=std::make_shared<Control>();enqueue(c,Trigger::TargetChanged);auto calls=clockCalls.load();
 c->pending.push_back({Trigger::TargetChanged,0,88,s});
 {Worker w(c);check(w.countAtLeast(2,200ms),"tail-suffix-did-not-release-predecessor");check(w.seen[0].sequence==1&&w.seen[1].sequence==88&&w.seen[1].startupFresh==s,"tail-suffix-reordered-or-rebound");check(clockCalls==calls,"urgent-suffix-read-clock");}
}
static void cancellationAndBound(){
 {
  auto held=std::make_shared<Control>();currentPort=held;
  held->boundGame={1604,1,134392591369607798ULL,L"D:\\game\\kitty.exe"};
  held->boundSteam={15164,1,134391926586954109ULL,L"D:\\game\\steam.exe"};
  held->active=true;held->bindingQualified=true;held->ownsRunning=true;held->bindingSerial=10;
  held->boundSleepRequest=std::make_shared<int>(1);
  auto request=std::make_shared<ActiveGroupRequest>();request->cancellation=std::make_shared<CancellationPort>();held->activeGroupRequest=request;
  // Both cases model caller complete=true/status=removed. The old boolean
  // API can express only exact=false; the new API carries that existing fact.
#if YMCC_TRACKER_HAS_ABSENCE
  steamOriginalRecoveryTrackerObserved(1604,134392591369607798ULL,15164,134391926586954109ULL,"",0,false,true);
#else
  steamOriginalRecoveryTrackerObserved(1604,134392591369607798ULL,15164,134391926586954109ULL,"",0,false);
#endif
  check(!held->bindingQualified&&!held->ownsRunning&&held->bindingSerial==11&&request->cancellation->cancels==1,"definitive-removal-not-revoked");
  check(held->pending.empty()&&held->sequence==0,"removal-created-recovery-work");
  currentPort.reset();
 }
 // Same production revocation callback, before any queue work. Unavailable
 // shared observations contain no contrary identity and cannot cancel an
 // already qualified original. Exact conflicting identities still revoke.
 for(const bool sleeping:{false,true})for(const bool exact:{false,true}){
  auto held=std::make_shared<Control>();currentPort=held;
  held->boundGame={1604,1,134392591369607798ULL,L"D:\\game\\kitty.exe"};
  held->boundSteam={15164,1,134391926586954109ULL,L"D:\\game\\steam.exe"};
  held->boundGameId="15669115425508032512";held->boundAppId=3648250230u;
  held->active=true;held->bindingQualified=true;held->ownsRunning=true;held->bindingSerial=10;
  if(sleeping)held->boundSleepRequest=std::make_shared<int>(1);
  auto request=std::make_shared<ActiveGroupRequest>();request->cancellation=std::make_shared<CancellationPort>();
  held->activeGroupRequest=request;
  const auto beforeClock=clockCalls.load();
  // Original exact mapping, then an incomplete read (or exact contradiction).
  steamOriginalRecoveryTrackerObserved(1604,134392591369607798ULL,15164,134391926586954109ULL,
      held->boundGameId,held->boundAppId,true);
  check(held->bindingQualified&&held->bindingSerial==10&&request->cancellation->cancels==0,"matching-tracker-revoked-original");
  steamOriginalRecoveryTrackerObserved(1604,134392591369607798ULL,15164,134391926586954109ULL,
      exact?"17454939209159671808":"",exact?4064044731u:0u,exact);
  if(exact)check(!held->bindingQualified&&!held->ownsRunning&&held->bindingSerial==11&&request->cancellation->cancels==1,"exact-conflicting-tracker-not-revoked");
  else check(held->bindingQualified&&held->ownsRunning&&held->bindingSerial==10&&request->cancellation->cancels==0,"unknown-tracker-revoked-qualified-original");
  check(held->pending.empty()&&held->sequence==0&&held->observationSequence==0&&clockCalls==beforeClock,"tracker-observation-created-work-or-budget");
  if(!exact){
   steamOriginalRecoveryTrackerObserved(1700,134392591369607799ULL,15164,134391926586954109ULL,
       "17454939209159671808",4064044731u,true);
   if(sleeping)check(held->bindingQualified&&held->bindingSerial==10&&request->cancellation->cancels==0,"other-global-target-cancelled-sleep-original");
   else check(!held->bindingQualified&&held->bindingSerial==11&&request->cancellation->cancels==1,"ordinary-target-change-not-revoked");
  }
  currentPort.reset();
 }
 resetClock();auto c=std::make_shared<Control>();
 auto request=std::make_shared<StartupFreshRequest>();auto s=std::make_shared<StartupFreshWait>();
 c->startupFreshRequest=request;c->startupFreshWaits[0]=s;
 auto closeCount=std::make_shared<std::atomic<int>>(0);HANDLE event=CreateEventW(nullptr,TRUE,FALSE,nullptr);check(event!=nullptr,"event-create-failed");
 c->observationEvent=std::shared_ptr<void>(event,[closeCount](void* h){if(CloseHandle(h))++*closeCount;});
 enqueue(c,Trigger::TargetChanged);
 check(request->cancelled&&s->phase==StartupFreshPhase::Cancelled&&s->subscription.cancels==1,"accepted-enqueue-did-not-cancel-immediately");
 check(c->startupFreshRequest==request&&c->startupFreshWaits[0]==s,"enqueue-released-retained-owners");
 check(WaitForSingleObject(event,0)==WAIT_OBJECT_0,"observation-event-not-signalled-immediately");
 auto calls=clockCalls.load();enqueue(c,Trigger::TargetChanged);
 check(c->sequence==1&&c->observationSequence==1&&s->subscription.cancels==1&&clockCalls==calls,"duplicate-admission-contract-changed");
 for(U64 n=1;n<16;++n)enqueue(c,Trigger::TargetChanged,n);
 calls=clockCalls.load();enqueue(c,Trigger::TargetChanged,16);
 check(c->pending.size()==16&&c->sequence==16&&c->observationSequence==16&&clockCalls==calls,"queue-cap-or-drop-contract-changed");
 c->latestPower=30;enqueue(c,Trigger::Wake,29);enqueue(c,Trigger::SuspendCapture,0);
 check(c->pending.size()==16&&c->latestPower==30&&c->sequence==16,"stale-generation-was-admitted");
 currentPort=c;steamOriginalRecoveryRequestStop();
 check(c->stop&&c->pending.empty()&&s->subscription.cancels==17,"stop-did-not-cancel-and-drain");
 calls=clockCalls.load();enqueue(c,Trigger::TargetChanged,90);check(c->pending.empty()&&c->sequence==16&&clockCalls==calls,"stopped-owner-enqueued-work");
 currentPort.reset();c.reset();check(*closeCount==1,"observation-handle-not-returned");
}
static void generations(){
 resetClock();auto c=std::make_shared<Control>();c->latestPower=20;
 enqueue(c,Trigger::Wake,19);enqueue(c,Trigger::SuspendCapture,0);
 check(c->sequence==0&&c->pending.empty()&&clockCalls==0,"old-power-hint-changed-queue");
 enqueue(c,Trigger::Wake,20);enqueue(c,Trigger::Wake,20);enqueue(c,Trigger::SuspendCapture,21);
 check(c->pending.size()==2&&c->latestPower==21&&c->sequence==2&&c->observationSequence==2&&clockCalls==0,"power-dedup-sequence-or-clock-changed");
 c->observationSequence=ULLONG_MAX;enqueue(c,Trigger::SteamChanged);
 check(c->observationSequence==ULLONG_MAX&&c->sequence==3,"observation-sequence-wrapped");
}
static void laterNew(){
 resetClock();auto c=std::make_shared<Control>();enqueue(c,Trigger::TargetChanged);Worker w(c);awaitClock(2);
 advanceTick(c,1100);check(w.countAtLeast(1),"first-window-not-consumed");
 advanceTick(c,1200);enqueue(c,Trigger::TargetChanged);check(!w.countAtLeast(2,15ms),"new-notification-reused-old-window");
 advanceTick(c,1299);check(!w.countAtLeast(2,10ms),"new-notification-ran-early");
 advanceTick(c,1300);check(w.countAtLeast(2),"genuinely-new-notification-lost");
 check(w.seen[0].sequence==1&&w.seen[1].sequence==2&&c->observationSequence==2,"new-notification-sequences-changed");
}
static void idleStop(){
 resetClock();auto c=std::make_shared<Control>();Worker w(c);
 for(int i=0;i<5;++i)c->cv.notify_all();
 check(!w.countAtLeast(1,40ms)&&clockCalls==0,"empty-queue-clock-polled-or-dispatched");
 const auto began=std::chrono::steady_clock::now();w.halt();
 check(std::chrono::steady_clock::now()-began<500ms&&clockCalls==0,"empty-stop-delayed-or-clock-polled");
}
static void deferredStop(){
 resetClock();auto c=std::make_shared<Control>();enqueue(c,Trigger::TargetChanged);Worker w(c);awaitClock(2);
 auto req=std::make_shared<ActiveGroupRequest>();req->cancellation=std::make_shared<CancellationPort>();c->activeGroupRequest=req;
 const auto began=std::chrono::steady_clock::now();w.halt();
 check(std::chrono::steady_clock::now()-began<500ms&&w.count()==0&&req->cancellation->cancels==1,"deferred-stop-not-immediate-or-cancelled");
}
static void saturation(){
 resetClock();tickValue=ULLONG_MAX-30;auto c=std::make_shared<Control>();enqueue(c,Trigger::TargetChanged);Worker w(c);awaitClock(2);
 check(!w.countAtLeast(1,10ms),"saturating-add-wrapped");
 advanceTick(c,ULLONG_MAX-1);check(!w.countAtLeast(1,10ms),"saturated-deadline-ran-early");
 advanceTick(c,ULLONG_MAX);check(w.countAtLeast(1),"saturated-deadline-never-released");
}
static void shortRealTiming(){
 resetClock();realClock=true;auto c=std::make_shared<Control>();const auto tick=realTick();const auto began=std::chrono::steady_clock::now();
 enqueue(c,Trigger::TargetChanged);Worker w(c);check(w.countAtLeast(1,1500ms),"real-boundary-did-not-complete");
 const auto elapsed=std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now()-began).count();
 check(w.at[0]>=tick+100&&elapsed>=90&&elapsed<1500,"real-short-window-outside-boundary");realDurations.push_back(static_cast<U64>(elapsed));
 w.halt();realClock=false;
}

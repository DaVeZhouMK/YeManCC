@@COMMAND_TYPES@@
#else
// Original legacy storage port remains default-constructible for unchanged cases.
struct StartupFreshRequest {std::atomic<bool> cancelled{false};
#if FIXTURE_NATIVE_COMMAND_CLOSURE
 std::atomic<bool> terminal{false};
 U64 sequence=0,configEpoch=0,rulesEpoch=0,powerGeneration=0;
 NativeGameSelectionReceipt selection;
 std::shared_ptr<ymcc::steamnative::ReadScope> operationReadScope;
#endif
};
@@PHASE@@
struct SubscriptionPort {std::atomic<int> cancels{0};void cancel()noexcept{++cancels;}};
struct StartupFreshWait {StartupFreshPhase phase=StartupFreshPhase::Watching;SubscriptionPort subscription;
#if FIXTURE_NATIVE_COMMAND_CLOSURE
 std::shared_ptr<StartupFreshRequest> request;
 ymcc::steamOriginal::RecoveryRoute route=ymcc::steamOriginal::RecoveryRoute::LegacyDynamic;
 std::shared_ptr<ymcc::steamnative::ReadScope> nativeReadScope;
 ymcc::steamgamefacts::TrackerCompletionWitness witness;
#endif
};
@@PENDING@@
enum class GroupRequestTarget {GlobalSelection,SleepOriginal};
struct CancellationPort {std::atomic<int> cancels{0};void cancel()noexcept{++cancels;}};
struct ActiveGroupRequest {std::shared_ptr<CancellationPort> cancellation;GroupRequestTarget targetDomain=GroupRequestTarget::GlobalSelection;};
// Control storage port: precisely the fields accessed by the extracted functions.
// No runOne, tracker, route, SourceLease or engine implementation is replaced here.
struct Control {
 std::mutex mx;std::condition_variable cv;bool stop=false;std::deque<Pending> pending;
 std::shared_ptr<void> observationEvent;
#if FIXTURE_NATIVE_COMMAND_CLOSURE
 std::shared_ptr<ymcc::steamcommand::AvailabilityEvent> mutationAvailability;
 std::shared_ptr<StartupCommandWait> startupCommandWait;
#endif
 std::shared_ptr<ActiveGroupRequest> activeGroupRequest;
 std::shared_ptr<StartupFreshRequest> startupFreshRequest;
 std::array<std::shared_ptr<StartupFreshWait>,2> startupFreshWaits;
 U64 sequence=0,observationSequence=0,latestPower=0;std::atomic<bool> ownsRunning{false};
 ymcc::steamOriginal::Identity boundGame,boundSteam;
 std::atomic<bool> active{false};bool bindingQualified=false;U64 bindingSerial=0;
 std::string boundGameId;std::uint32_t boundAppId=0;
 std::shared_ptr<void> boundSleepRequest;
};
#endif
static std::shared_ptr<Control> currentPort;
static std::shared_ptr<Control> current(){return currentPort;}

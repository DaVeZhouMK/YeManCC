#if FIXTURE_COMMAND_READY
namespace SC=ymcc::steamcommand;
struct CommandGap {
 const void* owner=nullptr;std::mutex mx;std::condition_variable cv;
 bool armed=true,reached=false,release=false,returned=false,timedOut=false;
 std::atomic<unsigned> order{0},attempt{0},completed{0},predicateExit{0};
};
static CommandGap* commandGap=nullptr;
static void fixtureCommandPredicate(const void* owner,bool observed)noexcept {
 auto* gate=commandGap;if(!gate||owner!=gate->owner||observed)return;
 std::unique_lock<std::mutex> lock(gate->mx);if(!gate->armed)return;gate->armed=false;gate->reached=true;gate->cv.notify_all();
 if(!gate->cv.wait_for(lock,2000ms,[&]{return gate->release;}))gate->timedOut=true;
 gate->predicateExit=++gate->order;gate->returned=true;gate->cv.notify_all();
}
static void gapReached(CommandGap& gap){std::unique_lock<std::mutex> lock(gap.mx);check(gap.cv.wait_for(lock,1500ms,[&]{return gap.reached;}),"predicate-did-not-read-false-under-Control-mx");}
static void gapRelease(CommandGap& gap){{std::lock_guard<std::mutex> lock(gap.mx);gap.release=true;}gap.cv.notify_all();}
static void gapReturned(CommandGap& gap){std::unique_lock<std::mutex> lock(gap.mx);check(gap.cv.wait_for(lock,1500ms,[&]{return gap.returned;}),"predicate-did-not-return");check(!gap.timedOut,"fixture-predicate-barrier-timeout");}
struct GapReset {~GapReset(){commandGap=nullptr;}};
static SC::Target commandTarget(){return {123,456,LR"(X:\InertSteam)"};}
struct CommandScene {
 SC::Coordinator coordinator;std::shared_ptr<Control> control=std::make_shared<Control>();
 SC::Ticket holder;std::shared_ptr<StartupCommandWait> wait;
 CommandScene(){
  currentPort=control;control->sequence=7;
  auto request=std::make_shared<StartupFreshRequest>(7,1,1,0,NativeGameSelectionReceipt{},std::shared_ptr<ymcc::steamnative::ReadScope>{});control->startupFreshRequest=request;
  holder=coordinator.reserve(commandTarget(),SC::Plan::Single);check(bool(holder),"ordinary-parent-reserved");
  auto signal=std::make_shared<StartupCommandSignal>(control);auto intent=coordinator.prepareIntent(commandTarget(),signal);check(bool(intent),"actual-core-intent-prepared");
  wait=std::make_shared<StartupCommandWait>(request,Pending{Trigger::Startup,0,7},RecoveryRoute::LegacyDynamic,Scope{},"fixture",1,0,false,signal,intent);wait->phase=StartupCommandPhase::Watching;control->startupCommandWait=wait;
  check(intent->promote()==SC::IntentStatus::Waiting,"actual-core-waiter-registered");
 }
 ~CommandScene(){currentPort.reset();}
};
static void commandReadyRegistration(){
 resetClock();json results=json::array();
 const auto boundary=[&](const char* name,const std::function<void()>& body){body();results.push_back({{"name",name},{"passed",true}});};
 try{
 boundary("predicate-false-before-wait-registration",[&]{
  CommandScene scene;auto c=scene.control;CommandGap gap;gap.owner=c.get();commandGap=&gap;GapReset clear;
  Worker worker(c);gapReached(gap);std::thread notifier([&]{gap.attempt=++gap.order;gap.cv.notify_all();scene.holder.parentReturned();gap.completed=++gap.order;gap.cv.notify_all();});
  struct Join {std::thread& t;CommandGap& gap;~Join(){gapRelease(gap);if(t.joinable())t.join();}}join{notifier,gap};
  {std::unique_lock<std::mutex> lock(gap.mx);check(gap.cv.wait_for(lock,1500ms,[&]{return gap.attempt.load()!=0;}),"notifier-attempt-not-observed");
#if !FIXTURE_SIGNAL_LOCKS_CONTROL
   check(gap.cv.wait_for(lock,1500ms,[&]{return gap.completed.load()!=0;}),"r1-callback-did-not-complete-while-worker-held-Control-mx");
#endif
  }
  // r2 deliberately waits for attempt only. Its callback may acquire c.mx only
  // after this original predicate returns and the original cv.wait unlocks.
  gapRelease(gap);gapReturned(gap);{std::lock_guard<std::mutex> lock(c->mx);}
  const bool timely=worker.countAtLeast(1,FIXTURE_SIGNAL_LOCKS_CONTROL?1500ms:200ms);
  notifier.join();const auto ready=scene.wait->intent->status();const auto beforeCleanup=worker.count();
  const unsigned attempt=gap.attempt.load(),complete=gap.completed.load(),predicate=gap.predicateExit.load();
  results.push_back({{"name","registration-order"},{"signalLocksControl",FIXTURE_SIGNAL_LOCKS_CONTROL!=0},{"notifierAttemptOrder",attempt},{"notifierCompleteOrder",complete},{"predicateExitOrder",predicate},{"timelyDispatch",timely},{"dispatchCountBeforeCleanup",beforeCleanup},{"intentReadyBeforeCleanup",ready==SC::IntentStatus::Ready},{"windowMs",FIXTURE_SIGNAL_LOCKS_CONTROL?1500:200},{"cleanupCannotChangeTimelyResult",true}});
  worker.halt();check(!gap.timedOut,"bounded-gap-missed-release");check(attempt&&complete&&predicate,"notifier-order-incomplete");
#if FIXTURE_SIGNAL_LOCKS_CONTROL
  check(complete>predicate&&timely&&beforeCleanup==1,"r2-did-not-close-real-predicate-to-wait-registration-gap");
#else
  check(complete<predicate&&ready==SC::IntentStatus::Ready&&!timely&&beforeCleanup==0,"r1-necessary-interleaving-not-observed");
  check(false,"P1-ready-command-lost-notification-before-original-wait-registration");
#endif
 });
 boundary("notify-before-first-wait",[&]{
  CommandScene scene;scene.holder.parentReturned();check(scene.wait->signal->notified&&scene.wait->intent->status()==SC::IntentStatus::Ready,"ready-before-first-worker");Worker worker(scene.control);check(worker.countAtLeast(1)&&worker.seen[0].startupCommand==scene.wait,"first-wait-consumes-existing-ready-signal");worker.halt();
 });
 boundary("readiness-after-wait-registration",[&]{
  CommandScene scene;CommandGap gap;gap.owner=scene.control.get();commandGap=&gap;GapReset clear;Worker worker(scene.control);gapReached(gap);gapRelease(gap);gapReturned(gap);{std::lock_guard<std::mutex> lock(scene.control->mx);}
  std::thread release([&]{scene.holder.parentReturned();});release.join();check(worker.countAtLeast(1)&&worker.seen[0].startupCommand==scene.wait,"registered-original-cv-wakes-for-real-promotion");worker.halt();
 });
 boundary("cancel-before-takeReady-no-suffix",[&]{
  CommandScene scene;scene.holder.parentReturned();scene.wait->request->cancelled=true;Pending next{Trigger::Startup};check(!takeReadyStartupCommand(scene.control,next)&&!next.startupCommand,"cancelled-request-cannot-dispatch-ready-suffix");check(!scene.control->startupCommandWait&&scene.wait->phase==StartupCommandPhase::Cancelled&&scene.wait->intent->status()==SC::IntentStatus::Revoked,"original-retirement-cancels-intent-after-Control-lock");
 });
 boundary("permanent-old-command-debt-does-not-block-local-cancel",[&]{
  CommandScene scene;check(scene.holder.attachChild(91)&&scene.holder.grant(SC::Effect::Mutation,0),"old-child-grant-debt");scene.holder.parentReturned();enqueue(scene.control,Trigger::SteamChanged);Pending next{Trigger::Startup};check(takeNext(scene.control,next)&&next.kind==Trigger::SteamChanged&&!next.startupCommand,"ordinary-enqueue-does-not-wait-for-old-command-debt");check(scene.wait->intent->status()==SC::IntentStatus::Revoked&&!scene.control->startupCommandWait,"local-waiter-cancelled");check(scene.holder.held()&&!scene.coordinator.reserve(commandTarget(),SC::Plan::Single),"old-permanent-logical-debt-neither-cleared-nor-refunded");
 });
 boundary("ordinary-enqueue-prioritizes-and-retires-ready-suffix",[&]{
  CommandScene scene;scene.holder.parentReturned();check(scene.wait->intent->status()==SC::IntentStatus::Ready,"suffix-ready-before-ordinary-enqueue");enqueue(scene.control,Trigger::SteamChanged);Pending next{Trigger::Startup};check(takeNext(scene.control,next)&&next.kind==Trigger::SteamChanged&&!next.startupCommand,"original-queue-picks-ordinary-after-original-cancel");check(scene.wait->cancelled&&scene.wait->phase==StartupCommandPhase::Cancelled&&!scene.control->startupCommandWait,"old-ready-suffix-retired-not-rebound");
 });
 std::cerr<<json{{"selected","command-ready-registration"},{"passed",true},{"boundaries",results},{"qualificationLeaf","exact fixture-current memory only; not real scope/account"},{"runOneOrEngineExecuted",false}}.dump()<<'\n';
 }catch(...){std::cerr<<json{{"selected","command-ready-registration"},{"passed",false},{"boundaries",results},{"qualificationLeaf","exact fixture-current memory only; not real scope/account"},{"runOneOrEngineExecuted",false}}.dump()<<'\n';throw;}
}
#endif

struct Case {const char* name;void(*run)();};
static const Case cases[]={
#if FIXTURE_COMMAND_READY
 {"command-ready-registration",commandReadyRegistration},
#else
 {"ordinary-burst",burst},{"continuous-deadline",continuous},
 {"urgent-startup",urgentStartup},{"urgent-steam-changed",urgentSteam},
 {"urgent-suspend-capture",urgentSuspend},{"urgent-wake",urgentWake},
 {"exact-flight-suffix",suffix},{"immediate-cancel-and-cap",cancellationAndBound},
 {"generation-and-sequences",generations},{"later-new-notification",laterNew},
 {"idle-no-clock-and-stop",idleStop},{"deferred-stop",deferredStop},
 {"saturating-deadline",saturation},{"short-real-timing",shortRealTiming}
#endif
};
int main(int argc,char** argv){
 if(argc!=3||std::string(argv[1])!="--case"||std::string(argv[2]).empty()){std::cerr<<"invalid-selection\n";return 2;}
 std::string selection=argv[2];bool known=selection=="all";
 for(const auto& c:cases)if(selection==c.name)known=true;
 if(!known){std::cerr<<"unknown-selection\n";return 2;}
 bool first=true;unsigned failed=0;std::cout<<"{\"cases\":[";
 for(const auto& c:cases)if(selection=="all"||selection==c.name){
  if(!first)std::cout<<',';first=false;const auto before=checks;
  std::string error;try{c.run();}catch(const std::exception& e){error=e.what();++failed;}
  std::cout<<"{\"name\":\""<<c.name<<"\",\"passed\":"<<(error.empty()?"true":"false")<<",\"checks\":"<<(checks-before)<<",\"error\":\""<<error<<"\"}";
 }
 std::cout<<"],\"checks\":"<<checks<<",\"failed\":"<<failed<<",\"realTimingMs\":[";
 for(std::size_t i=0;i<realDurations.size();++i){if(i)std::cout<<',';std::cout<<realDurations[i];}
 std::cout<<"],\"clockIsControlledLeaf\":true,\"physicalSleepActions\":0,\"engineRouteExecutions\":0}\n";
 return failed?1:0;
}

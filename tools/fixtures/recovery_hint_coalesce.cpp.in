using namespace std::chrono_literals;
using U64=unsigned long long;
static U64 realTick(){return GetTickCount64();}
static std::atomic<U64> tickValue{1000},clockCalls{0};
static std::atomic<bool> realClock{false};
static constexpr bool hasDeadline=@@HAS_DEADLINE@@;
static std::mutex clockMx;static std::condition_variable clockCv;
static U64 fixtureTick(){
 {std::lock_guard<std::mutex> lock(clockMx);++clockCalls;}clockCv.notify_all();
 return realClock?realTick():tickValue.load();
}
#define GetTickCount64 fixtureTick
namespace SteamOriginalRecovery {
using Trigger=ymcc::steamOriginal::Trigger;

#define NOMINMAX
#include <windows.h>
#include <iostream>
#include <string>
#include <vector>
#include <stdexcept>
#include "json.hpp"
#include "input_host_exit_retirement.h"
using json=nlohmann::json;
namespace er=ymcc::inputHost::exitRetirement;
static void need(bool v,const char* m){if(!v)throw std::runtime_error(m);}
struct Child {
 HANDLE process=nullptr,primary=nullptr,event=nullptr;bool eventBackstop=false;
 Child(){SECURITY_ATTRIBUTES sa{sizeof(sa),nullptr,TRUE};event=CreateEventW(&sa,TRUE,FALSE,nullptr);need(event!=nullptr,"child event");wchar_t path[32768]{};need(GetModuleFileNameW(nullptr,path,32768)!=0,"self path");std::wstring command=L"\""+std::wstring(path)+L"\" --private-child "+std::to_wstring(reinterpret_cast<std::uintptr_t>(event));STARTUPINFOW si{};si.cb=sizeof(si);PROCESS_INFORMATION pi{};need(CreateProcessW(path,command.data(),nullptr,nullptr,TRUE,CREATE_NO_WINDOW,nullptr,nullptr,&si,&pi)!=FALSE,"private child creation");process=pi.hProcess;primary=pi.hThread;}
 void naturalExit(){eventBackstop=true;need(SetEvent(event)!=FALSE,"fixture event release");need(WaitForSingleObject(process,2000)==WAIT_OBJECT_0,"fixture process join");need(WaitForSingleObject(primary,2000)==WAIT_OBJECT_0,"fixture primary join");}
 void finish(bool processClosed=false){if(!processClosed&&WaitForSingleObject(process,0)!=WAIT_OBJECT_0)naturalExit();need(WaitForSingleObject(primary,2000)==WAIT_OBJECT_0,"primary kernel exit observed");if(!processClosed){SetHandleInformation(process,HANDLE_FLAG_PROTECT_FROM_CLOSE,0);need(CloseHandle(process)!=FALSE,"process checked cleanup");}need(CloseHandle(primary)!=FALSE&&CloseHandle(event)!=FALSE,"primary/event cleanup");process=primary=event=nullptr;}
 ~Child(){if(process){if(WaitForSingleObject(process,0)!=WAIT_OBJECT_0){SetEvent(event);WaitForSingleObject(process,2000);}SetHandleInformation(process,HANDLE_FLAG_PROTECT_FROM_CLOSE,0);CloseHandle(process);}if(primary){WaitForSingleObject(primary,2000);CloseHandle(primary);}if(event)CloseHandle(event);}
};
struct Port {
 HANDLE expected;er::WindowsPort os;unsigned forceCalls=0,inspectCalls=0,closeCalls=0;std::vector<DWORD> waits;
 DWORD initialFailure=0;bool unexpected=false,invalidIdentity=false,acceptWithoutExit=false,rejectForce=false;
 Port(HANDLE h):expected(h){}
 ymcc::inputHost::processRetirement::WaitResult observe(HANDLE h,DWORD ms){need(h==expected,"same original HANDLE in wait");waits.push_back(ms);if(initialFailure)return {WAIT_FAILED,initialFailure};if(unexpected)return {WAIT_ABANDONED_0,0};return os.observe(h,ms);}
 er::Identity inspect(HANDLE h){need(h==expected,"same original HANDLE in inspect");++inspectCalls;if(invalidIdentity)return {0,0,ERROR_ACCESS_DENIED,false};return os.inspect(h);}
 er::ForceResult force(HANDLE h){need(h==expected,"same original HANDLE in force");++forceCalls;if(acceptWithoutExit)return {true,0};if(rejectForce)return {false,ERROR_ACCESS_DENIED};return os.force(h);}
 ymcc::inputHost::processRetirement::CloseResult close(HANDLE h){need(h==expected,"same original HANDLE in close");++closeCalls;return os.close(h);}
};
static json observe(const er::Receipt& r){return {{"authorityAccepted",r.authorityAccepted},{"identityVerified",r.identityVerified},{"initialWaitState",r.initialWaitState},{"initialWaitError",r.initialWaitError},{"forceAttempted",r.forceAttempted},{"forceAccepted",r.forceAccepted},{"forceSpent",r.forceBudgetSpent},{"waitBudgetMs",r.waitBudgetMs},{"exitConfirmed",r.process.exitConfirmed},{"handleClosed",r.process.handleClosed},{"closeError",r.process.closeError}};}
static json rows=json::array();static unsigned failures=0;
template<class F>static void test(const char* name,F f){try{rows.push_back({{"name",name},{"pass",true},{"evidence",f()}});}catch(const std::exception& e){++failures;rows.push_back({{"name",name},{"pass",false},{"error",e.what()}});}}
static er::Authority allowed(){return {true,true,true,true};}
int wmain(int argc,wchar_t** argv){
 if(argc==3&&std::wstring(argv[1])==L"--private-child"){auto h=reinterpret_cast<HANDLE>(static_cast<std::uintptr_t>(std::stoull(argv[2])));auto wait=WaitForSingleObject(h,30000);CloseHandle(h);return wait==WAIT_OBJECT_0?0:9;}
 test("real-once-force-exits-process-and-creation-thread-checked-close",[]{Child child;auto identity=er::identity(child.process);need(identity.valid,"real pid+creation stamp");HANDLE owner=child.process;bool spent=false;Port port(owner);HANDLE oracle=nullptr;need(DuplicateHandle(GetCurrentProcess(),owner,GetCurrentProcess(),&oracle,0,FALSE,DUPLICATE_SAME_ACCESS)!=FALSE,"process observation duplicate");auto r=er::retire(owner,identity,allowed(),spent,5000,port);need(r.identityVerified&&r.forceAttempted&&r.forceAccepted&&spent&&r.waitBudgetMs==2000&&r.process.exitConfirmed&&r.process.handleClosed&&!owner&&port.forceCalls==1,"real force/exit/close proof");need(WaitForSingleObject(oracle,0)==WAIT_OBJECT_0&&WaitForSingleObject(child.primary,2000)==WAIT_OBJECT_0,"both kernel objects exited");DWORD code=0;need(GetExitCodeProcess(oracle,&code)&&code==ERROR_PROCESS_ABORTED,"production termination exit code");need(WaitForSingleObject(child.event,0)==WAIT_TIMEOUT&&!child.eventBackstop,"fixture did not release child");auto repeat=er::retire(owner,identity,allowed(),spent,2000,port);need(!repeat.hadProcess&&port.forceCalls==1,"null owner retried force");need(CloseHandle(oracle)!=FALSE,"oracle checked close");child.finish(true);return json{{"receipt",observe(r)},{"processExitCode",code},{"forceCalls",1},{"processAndThreadJoined",true},{"allPrivateHandlesClosed",true},{"fixtureKillOrNaturalBackstop",false}};});
 for(unsigned missing=0;missing<4;++missing)test(("missing-authority-gate-"+std::to_string(missing)).c_str(),[missing]{Child child;HANDLE owner=child.process;auto stamp=er::identity(owner);auto authority=allowed();if(missing==0)authority.appExit=false;if(missing==1)authority.exitFence=false;if(missing==2)authority.producerReturned=false;if(missing==3)authority.ordinaryStopAttempted=false;bool spent=false;Port port(owner);auto r=er::retire(owner,stamp,authority,spent,2000,port);need(!r.authorityAccepted&&!spent&&owner==child.process&&port.forceCalls==0&&port.waits.empty()&&port.closeCalls==0,"missing authority forced/closed/waited");child.finish();return observe(r);});
 for(unsigned mode=0;mode<3;++mode)test(("identity-reject-"+std::to_string(mode)).c_str(),[mode]{Child child;HANDLE owner=child.process;auto stamp=er::identity(owner);Port port(owner);if(mode==0)++stamp.pid;if(mode==1)++stamp.creation;if(mode==2)port.invalidIdentity=true;bool spent=false;auto r=er::retire(owner,stamp,allowed(),spent,2000,port);need(!r.identityVerified&&!r.forceAttempted&&!spent&&owner==child.process&&port.forceCalls==0&&port.closeCalls==0,"unverified identity forced");child.finish();return observe(r);});
 test("real-wait-failed-without-synchronize-never-force",[]{Child child;auto stamp=er::identity(child.process);HANDLE restricted=nullptr;need(DuplicateHandle(GetCurrentProcess(),child.process,GetCurrentProcess(),&restricted,PROCESS_QUERY_LIMITED_INFORMATION,FALSE,0)!=FALSE,"restricted private process");HANDLE owner=restricted;bool spent=false;Port port(owner);auto r=er::retire(owner,stamp,allowed(),spent,2000,port);need(r.initialWaitState==WAIT_FAILED&&r.initialWaitError==ERROR_ACCESS_DENIED&&!spent&&owner==restricted&&port.forceCalls==0&&port.closeCalls==0&&port.inspectCalls==0,"WAIT_FAILED forced");need(CloseHandle(restricted)!=FALSE,"restricted cleanup");child.finish();return observe(r);});
 test("explicit-unknown-wait-never-force",[]{Child child;HANDLE owner=child.process;auto stamp=er::identity(owner);Port port(owner);port.unexpected=true;bool spent=false;auto r=er::retire(owner,stamp,allowed(),spent,2000,port);need(!spent&&!r.forceAttempted&&port.forceCalls==0&&owner==child.process&&port.closeCalls==0,"unknown wait forced");child.finish();return observe(r);});
 test("accepted-force-without-exit-retains-owner-and-never-renews-budget",[]{Child child;HANDLE owner=child.process;auto stamp=er::identity(owner);Port port(owner);port.acceptWithoutExit=true;bool spent=false;auto r=er::retire(owner,stamp,allowed(),spent,9000,port);need(r.forceAccepted&&spent&&r.waitBudgetMs==2000&&!r.process.exitConfirmed&&!r.process.handleClosed&&owner==child.process&&port.forceCalls==1,"accepted-only force fabricated exit/close");const auto waits=port.waits.size();for(unsigned n=0;n<3;++n){auto again=er::retire(owner,stamp,allowed(),spent,9000,port);need(!again.forceAttempted&&again.waitBudgetMs==0&&owner==child.process,"spent budget renewed");}need(port.forceCalls==1&&port.waits.size()==waits+3&&port.waits[waits]==0&&port.closeCalls==0,"later calls added wait/force");child.finish();return json{{"first",observe(r)},{"forceCalls",port.forceCalls},{"waits",port.waits},{"port","explicit accepted-without-exit; private child remains real/live until fixture event cleanup"}};});
 test("rejected-force-spends-once-and-rechecks-with-zero-budget",[]{Child child;HANDLE owner=child.process;Port port(owner);port.rejectForce=true;auto stamp=er::identity(owner);bool spent=false;auto r=er::retire(owner,stamp,allowed(),spent,2000,port);need(r.forceAttempted&&!r.forceAccepted&&spent&&r.waitBudgetMs==0&&port.waits.size()==2&&port.waits[1]==0&&owner==child.process,"rejected force renewed wait or lost owner");auto again=er::retire(owner,stamp,allowed(),spent,2000,port);need(!again.forceAttempted&&port.forceCalls==1,"rejected force retried");child.finish();return observe(r);});
 test("real-process-close-failure-after-force-retains-owner-then-closes-without-force",[]{Child child;HANDLE owner=child.process;auto stamp=er::identity(owner);need(SetHandleInformation(owner,HANDLE_FLAG_PROTECT_FROM_CLOSE,HANDLE_FLAG_PROTECT_FROM_CLOSE)!=FALSE,"protect process owner");bool spent=false;Port port(owner);auto first=er::retire(owner,stamp,allowed(),spent,2000,port);need(first.forceAccepted&&first.process.exitConfirmed&&!first.process.handleClosed&&first.process.closeError!=0&&owner==child.process&&spent,"failed close discarded exited owner");need(SetHandleInformation(owner,HANDLE_FLAG_PROTECT_FROM_CLOSE,0)!=FALSE,"unprotect owner");auto retry=er::retire(owner,stamp,allowed(),spent,2000,port);need(retry.process.handleClosed&&!owner&&!retry.forceAttempted&&retry.waitBudgetMs==0&&port.forceCalls==1,"close retry re-forced or lost owner");child.finish(true);return json{{"failedClose",observe(first)},{"retry",observe(retry)},{"forceCalls",port.forceCalls}};});
 std::cout<<json{{"failures",failures},{"rows",rows},{"realHostSdkOrPipeExecuted",false},{"permanentOsBlockStatus","UNKNOWN"}}.dump()<<"\n";return failures?2:0;
}

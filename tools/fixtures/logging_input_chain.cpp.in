static unsigned long long newSinkCalls=0;
static unsigned long long currentPowerGeneration(){++fixturePowerReads;return fixturePower;}
static unsigned long long inputHostEpochToken(){++fixtureEpochReads;return fixtureEpoch;}
static bool physicalReleaseWindowActive(){++fixtureGateReads;return false;}
static void appendNativeLifecycleLog(const char* event,const json& detail){
 SetLastError(1777);
 if(std::strcmp(event,"wake-input-chain-first-nonneutral")==0){++newSinkCalls;if(failNewSink)throw std::runtime_error("optional sink failed");}
 json row=detail;row["event"]=event;fixtureRows.push_back(std::move(row));
}


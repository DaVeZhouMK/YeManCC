static void appendNativeLifecycleLog(const char* event,const json& detail){
 SetLastError(1777);
 if(std::strcmp(event,"wake-input-chain-first-nonneutral")==0){++newSinkCalls;if(failNewSink)throw std::runtime_error("optional sink failed");}

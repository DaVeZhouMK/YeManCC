namespace current {
static unsigned long long fixturePower=1,fixtureEpoch=2,fixturePowerReads=0,fixtureEpochReads=0,fixtureGateReads=0;
static bool g_inputHostPrepared=true,g_inputHostNeutralized=true,g_inputHostActive=true,g_xinputPhysicalSourceLocked=true;
static HANDLE g_inputHostProcess=reinterpret_cast<HANDLE>(1);

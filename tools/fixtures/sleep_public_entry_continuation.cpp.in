using json=nlohmann::json;using ULONGLONG=unsigned long long;using DWORD=unsigned long;
enum class PowerLifecycle {Ready,Resuming,Suspending,Suspended};
static std::atomic<PowerLifecycle> g_powerLifecycle{PowerLifecycle::Ready};
static std::atomic<unsigned long long> g_sleepRecoveryAutoConfigEpoch{1};
static std::atomic<bool> g_sleepRecoveryAutoPending{false},g_exitRequested{false};
static bool fixtureAllowed=true,fixtureRetrying=false,fixtureClassified=true;
static ULONGLONG fixtureNow=134392908258301446ULL,fixtureTick=1000,fixtureGeneration=7;
static bool sleepSteamRecoveryAllows(unsigned long long g,unsigned long long e){return fixtureAllowed&&!g_exitRequested&&g==fixtureGeneration&&e==g_sleepRecoveryAutoConfigEpoch;}
static bool sgSleepRetryActive(){return fixtureRetrying;}
static bool sharedSleepWakeClassified(unsigned long long g){return fixtureClassified&&g==fixtureGeneration;}
static ULONGLONG sgNowFileTime(){return fixtureNow;}
static ULONGLONG GetTickCount64(){return fixtureTick;}
static ULONGLONG currentPowerGeneration(){return fixtureGeneration;}
static bool sgModernStandbyRepairSupported(){return true;}
static void sgNotifyWork(){}
static void sgRecordFact(const char*,const json&){}
static void steamOriginalRecoveryWake(unsigned long long){}
static unsigned queued=0;
static bool poolSubmit(std::function<void()>){++queued;return true;}
namespace SleepSteamRecovery {
struct Signal {bool value=true;bool current()const{return value;}};
struct Request {ULONGLONG serial=9,rulesEpoch=1;bool revoked=false;std::shared_ptr<Signal> cancellation=std::make_shared<Signal>();};
struct ProcessPort {bool live=true;bool processCurrent()const{return live;}};
struct Identity {ULONGLONG epoch=1;};
struct Game {DWORD pid=10708;ULONGLONG created=134392903158823114ULL;};
struct Captured {ULONGLONG generation=7,configEpoch=1,boundaryGeneration=7,powerBoundaryFileTime=134392907000000000ULL;Game game;
 std::shared_ptr<Request> request=std::make_shared<Request>();std::shared_ptr<ProcessPort> selectedProcess=std::make_shared<ProcessPort>();std::shared_ptr<Identity> identitySnapshot=std::make_shared<Identity>();};
static Captured captured;
static bool originalRulesCurrent(const Captured& v,ULONGLONG e){return v.request&&captured.request==v.request&&!v.request->revoked&&v.request->serial==9&&e==1&&v.generation==fixtureGeneration&&v.configEpoch==g_sleepRecoveryAutoConfigEpoch;}
static Captured capturedFor(ULONGLONG g){return g==captured.generation&&captured.configEpoch==g_sleepRecoveryAutoConfigEpoch&&captured.request&&!captured.request->revoked&&captured.request->cancellation->current()?captured:Captured{};}
static Captured wakeBoundaryFor(ULONGLONG g){return capturedFor(g);}
static json capturedPauseState(ULONGLONG){return {{"available",true},{"manualPauseHeld",false},{"waitForSleepRelease",false}};}
}
struct ObserverPort {bool current=true;bool sameIdentityEpoch(const std::shared_ptr<SleepSteamRecovery::Identity>& v)const{return current&&v&&v->epoch==1;}}g_steamSettingsObserver;

 ++fixtureSends;fixtureRepaired=true;
 if(fixtureBeforeReply){
  fixtureBeforeReply();fixtureReplyCurrent=current();
  if(!fixtureReplyCurrent)return {{"ok",false},{"reason","live-transport-uncertain"},{"mutated",true},{"requestDispatched",true}};
 }
 auto result=fixtureReply.is_object()?fixtureReply:Json{{"ok",true},{"runtimeAccepted",true},{"mutated",true},{"requestDispatched",true},{"actionAcknowledged",true},{"reason","controlled-network-success"},{"stage","sleep-input-resume"}};
 dispatch.complete(result.value("ok",false));return result;
}

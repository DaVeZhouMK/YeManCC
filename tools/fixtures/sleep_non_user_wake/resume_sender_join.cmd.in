@echo off
call {{VCVARS}} >nul
if errorlevel 1 exit /b 1
set "INCLUDE={{INCLUDE}};%INCLUDE%"
set "LIB={{LIB}};%LIB%"
cl /nologo /std:c++20 /EHsc /utf-8 /O1 /W3 /MT /D_CRT_SECURE_NO_WARNINGS /I{{JSON_ROOT}} /I{{NATIVE_ROOT}} {{CPP}} /sourceDependencies {{DEPENDENCIES}} /Fo{{OBJECT}} /Fe{{EXE}} /link /VERBOSE:LIB
exit /b %errorlevel%

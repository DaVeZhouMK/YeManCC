internal sealed class OwnedWorkers : IDisposable
{
    internal static readonly List<OwnedWorkers> All=new();
    internal static bool BlockClock,BlockOutput,OutputNeverStarted;
    internal readonly CancellationTokenSource Cts=new();
    internal readonly ManualResetEventSlim Gate=new(),Entered=new();
    internal readonly DeviceClock<StreamTick> Clock;
    internal readonly Thread Output;
    internal readonly HMController Controller;
    internal readonly SafeWaitHandle CtsHandle,ClockHandle;
    private OwnedWorkers()
    {
        CtsHandle=Cts.Token.WaitHandle.SafeWaitHandle;
        Clock=new DeviceClock<StreamTick>(blocked:BlockClock);
        ClockHandle=Clock.ProofHandle;
        bool blocked=BlockOutput;
        Output=new Thread(()=>Controller!.RunOutput()){IsBackground=true,Name="managed-lifecycle-owned-reader"};
        Controller=new HMController(Cts,Output,view:(nint)1,clock:Clock,poll:()=>{
            Entered.Set(); if(blocked)Gate.Wait(); else Cts.Token.WaitHandle.WaitOne();
        });
        if(!OutputNeverStarted){Output.Start();Program.Assert(Entered.Wait(2000),"output startup");}
    }
    internal static HMController Create(){var w=new OwnedWorkers();All.Add(w);return w.Controller;}
    internal static void Reset()
    {
        Program.Assert(All.Count==0,"prior fixture resources not cleaned");
        BlockClock=BlockOutput=OutputNeverStarted=false;
        ManagedAdmission.Idle.TerminationFails=false;World.ContextCalls=World.UnsafeFakeUnmaps=World.UnsafeNeutralWrites=0;World.ThrowContextDispose=false;World.AfterContextDispose=null;World.Trace.Clear();
    }
    internal bool Closed => !Output.IsAlive&&!Clock.Thread.IsAlive&&CtsHandle.IsClosed&&ClockHandle.IsClosed;
    public void Dispose()
    {
        Gate.Set(); Clock.Finish();
        if((Output.ThreadState&ThreadState.Unstarted)!=0)Controller.CloseOutputForTest();
        else {if(!CtsHandle.IsClosed)Cts.Cancel();Program.Assert(Output.Join(2000),"fixture output leak");}
        Cts.Dispose();Gate.Dispose();Entered.Dispose();
    }
    internal static void Cleanup(){foreach(var w in All)w.Dispose();All.Clear();}
}
internal static class ManagedAdmission
{

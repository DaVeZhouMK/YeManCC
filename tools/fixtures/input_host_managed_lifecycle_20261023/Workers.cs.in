    internal static bool StopClock(HMController c,out string d){Program.Fixture.Events.Add("idle-stop");return IdleGuard.TryStopInputClockAgainstRuntime(c,Idle,out d);}
    internal static bool Capture(HMController c,out IdleGuard.Captured? capture,out string d){Program.Fixture.Events.Add("idle-capture");return IdleGuard.TryCaptureAgainstRuntime(c,Idle,out capture,out d);}

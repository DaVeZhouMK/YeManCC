    {
        public Type ControllerType=>typeof(HMController);public Type CancellationSourceType=>typeof(CancellationTokenSource);public Type ReaderType=>typeof(Thread);
        public bool IsPinnedCore(Type t)=>true;public int ReadJoinBudgetMilliseconds(Type t)=>500;
        public bool IsCurrentReader(object t)=>ReferenceEquals(t,Thread.CurrentThread);public ThreadState ReadThreadState(object t)=>((Thread)t).ThreadState;
        public bool TryEnterCancellationLock(object g,int ms){Program.Assert(ms<=500,"output budget");return Monitor.TryEnter(g,ms);}
        public void ExitCancellationLock(object g)=>Monitor.Exit(g);public void Cancel(object c)=>((CancellationTokenSource)c).Cancel();
        public bool Join(object t,int ms){Program.Assert(ms<=500,"output join budget");return ((Thread)t).Join(ms);}
    }
    internal sealed class ClockRuntime:IdleGuard.IRuntime
    {
        public Type ControllerType=>typeof(HMController);public Type ClockInterfaceType=>typeof(IDeviceClock);public Type ReaderType=>typeof(Thread);
        public bool IsPinnedCore(Type t)=>true;public bool IsPinnedClock(Type t)=>t==typeof(DeviceClock<StreamTick>);public int ReadJoinBudgetMilliseconds(Type t)=>500;
        public bool IsCurrentReader(object t)=>ReferenceEquals(t,Thread.CurrentThread);public ThreadState ReadThreadState(object t)=>((Thread)t).ThreadState;
        internal bool TerminationFails; public bool HasTerminated(object t)=>TerminationFails?throw new Exception("injected-final-proof"):((Thread)t).Join(0);public object ReadClockThread(object c)=>((IDeviceClock)c).Thread;

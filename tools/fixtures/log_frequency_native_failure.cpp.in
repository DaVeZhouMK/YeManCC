    g_gyroSensor.revokeKind=0;inputCaptureUnsubscribeWinRtSensorsImpl();flushNativeLifecycleLogs(false);
    rows=readRecoveryRows(root);check(rows.size()==stable+3&&rows.back()["failure"]["kind"]=="unknown-exception"&&
        !rows.back()["failure"].contains("message"),"nonstandard exception preserves unknown kind without raw text");
    const char* events[]={"gyro-power-unsubscribe-failed","gyro-power-unsubscribe-failed","gyro-power-interval-reset-failed","gyro-power-interval-reset-failed"};
    const json payloads[]={sensorErrorFixtureDetail("gyro",0),sensorErrorFixtureDetail("accel",1),
        sensorErrorFixtureDetail("gyro",1),sensorErrorFixtureDetail("accel",1)};
    const auto beforeHot=rows.size();ymcc::testing::allocationFault::failAfter(0);
    for(unsigned i=0;i<50000;++i)for(unsigned slot=0;slot<4;++slot)appendNativeLifecycleLog(events[slot],payloads[slot]);
    const auto hotArm=ymcc::testing::allocationFault::countdown.load();ymcc::testing::allocationFault::failAfter(-1);
    check(hotArm==0&&readRecoveryRows(root).size()==beforeHot,"50000 repeats per typed slot allocate no C++ heap in Native selection and add no resident rows");
    g_domainLogEnabled[1]=true;inputCaptureUnsubscribeWinRtSensorsImpl();flushNativeLifecycleLogs(false);g_domainLogEnabled[1]=false;
    {std::ifstream in(root/L"native-detail.log");std::string line;unsigned count=0;bool detailed=true;
     while(std::getline(in,line))if(!line.empty()){++count;detailed=detailed&&json::parse(line).contains("failure");}
     check(count==4&&detailed&&readRecoveryRows(root).size()==beforeHot,"original detail gate retains all four typed repeat receipts");}
    g_gyroSensor.failRevoke=false;inputCaptureUnsubscribeWinRtSensorsImpl();g_gyroSensor.failRevoke=true;g_gyroReadingChangedSubscribed=true;
    inputCaptureUnsubscribeWinRtSensorsImpl();flushNativeLifecycleLogs(false);

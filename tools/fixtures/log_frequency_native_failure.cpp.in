static void appendDomainLog(const char* domain,const char* event,const json& detail){
    if(!domainLogEnabled(domain))return;
    if((!std::strcmp(event,"gyro-power-unsubscribe-failed")||!std::strcmp(event,"gyro-power-interval-reset-failed"))&&detail.contains("failure")){
        if(!std::strcmp(domain,"gyro"))++gyroDomainRows;
        if(!std::strcmp(domain,"virtual"))++virtualDomainRows;
    }
}

static json sensorErrorFixtureDetail(const char* sensor,unsigned kind,unsigned long code=0x80070005UL){
    const char* name=kind==1?"winrt-hresult":kind==2?"allocation-exception":kind==3?"standard-exception":"unknown-exception";
    return {{"sensor",sensor},{"failure",{{"schema",1},{"kind",name},{"codeKnown",kind==1},
        {"codeDomain",kind==1?json("HRESULT-from-caught-WinRT-exception"):json(nullptr)},{"code",kind==1?json(code):json(nullptr)}}}};
}
struct SensorPort {
    bool available=true,failRevoke=true,failInterval=true;
    unsigned revokeCalls=0,intervalCalls=0,revokeKind=0,intervalKind=0;
    unsigned long revokeHresult=0x80070005UL,intervalHresult=0x80070005UL;
    explicit operator bool()const{return available;}
    static void fail(unsigned kind,unsigned long code){
        if(kind==1)throw winrt::hresult_error(winrt::hresult(static_cast<int32_t>(code)));
        if(kind==2)throw std::bad_alloc();
        if(kind==3)throw std::runtime_error("opaque-fixture-exception");
        throw 1;
    }
    void ReadingChanged(unsigned){++revokeCalls;if(failRevoke)fail(revokeKind,revokeHresult);}
    void ReportInterval(unsigned value){++intervalCalls;if(value!=0||failInterval)fail(intervalKind,intervalHresult);}
};

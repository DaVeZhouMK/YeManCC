using Failure=ymcc::logging::NativeLogFailureEvidence;
static unsigned long long count(Failure::Kind kind){return ymcc::logging::nativeLogFailureEvidence().snapshot()["buckets"][size_t(kind)]["observedFailures"].get<unsigned long long>();}
static void closeStreams(){g_nativeLifecycleLog.exceptions(std::ios::goodbit);g_nativeDetailLog.exceptions(std::ios::goodbit);g_nativeLifecycleLog.clear();g_nativeDetailLog.clear();g_nativeLifecycleLog.close();g_nativeDetailLog.close();g_nativeLifecycleLog.clear();g_nativeDetailLog.clear();}
struct ControlledBuffer:std::streambuf {
    enum class Mode{writeFail,flushFail,throwing};Mode mode;
    explicit ControlledBuffer(Mode value):mode(value){}
    std::streamsize xsputn(const char*,std::streamsize n)override{if(mode==Mode::throwing)throw std::runtime_error("write injection");return mode==Mode::writeFail?0:n;}
    int_type overflow(int_type value)override{if(mode==Mode::throwing)throw std::runtime_error("write injection");return mode==Mode::writeFail?traits_type::eof():value;}
    int sync()override{return mode==Mode::flushFail?-1:0;}
};
struct BufferLease {
    std::ofstream& stream;std::streambuf* previous;
    BufferLease(std::ofstream& value,ControlledBuffer& buffer):stream(value),previous(static_cast<std::ostream&>(value).rdbuf(&buffer)){}
    ~BufferLease(){stream.exceptions(std::ios::goodbit);static_cast<std::ostream&>(stream).rdbuf(previous);stream.clear();}
};
static json readRecoveryRows(const fspath::path& root){
    std::ifstream input(root/L"native-lifecycle.log");json rows=json::array();std::string line;
    while(std::getline(input,line))if(!line.empty())rows.push_back(json::parse(line));return rows;
}
int wmain(int argc,wchar_t** argv){try{
    if(argc!=2)return 3;const fspath::path root(argv[1]);fspath::create_directories(root);g_testRoot=(root/L"missing"/L"parent").wstring();
    (void)ymcc::sleepfactlog::writerIdentity();
#ifdef YMCC_SENSOR_RETIREMENT_ONLY
    // Warm the actual C++/WinRT exception support before the handle baseline.
    try{throw winrt::hresult_error(E_ACCESSDENIED);}catch(const winrt::hresult_error&){}
#endif
    DWORD before=0,after=0;
    if(!GetProcessHandleCount(GetCurrentProcess(),&before))return 3;
    const json detail={{"reason","controlled"}};
#ifdef YMCC_SENSOR_RETIREMENT_ONLY
    g_testRoot=root.wstring();
#if defined(YMCC_SENSOR_SOURCE_GATE_ONLY)
    inputCaptureUnsubscribeWinRtSensorsImpl();flushNativeLifecycleLogs(false);
    check(readRecoveryRows(root).size()==4&&g_gyroReadingChangedSubscribed&&g_accelReadingChangedSubscribed,
        "source preflight does not consume the original four first-failure selections");
    const auto preparationBefore=count(Failure::preparationException);
    ymcc::testing::allocationFault::failAfter(0);
    for(unsigned i=0;i<50000;++i)inputCaptureUnsubscribeWinRtSensorsImpl();
    const auto sourceArm=ymcc::testing::allocationFault::countdown.load();ymcc::testing::allocationFault::failAfter(-1);
    check(sourceArm==0&&count(Failure::preparationException)==preparationBefore&&readRecoveryRows(root).size()==4&&
        g_gyroSensor.revokeCalls==50001&&g_accelSensor.revokeCalls==50001&&g_gyroSensor.intervalCalls==50001&&g_accelSensor.intervalCalls==50001,
        "50000 actual original four-API retirement calls skip repeated JSON without consuming a C++ allocation fault");
#ifndef YMCC_SENSOR_SOURCE_GATE_OLD_PREFIX_ONLY
    check(modelObserverEntered==0&&virtualObserverEntered==0,"actual adaptation rejection guards exclude both sensor retirement event names");
    const auto mirrorBefore=gyroDomainRows;g_domainLogEnabled[0]=true;
    inputCaptureUnsubscribeWinRtSensorsImpl();flushNativeLifecycleLogs(false);g_domainLogEnabled[0]=false;
    check(gyroDomainRows==mirrorBefore+4&&readRecoveryRows(root).size()==4,
        "actual gyro-only gate and mirror routing keep all four repeat offers while Native detail remains OFF");
    g_domainLogEnabled[1]=true;inputCaptureUnsubscribeWinRtSensorsImpl();flushNativeLifecycleLogs(false);g_domainLogEnabled[1]=false;
    {std::ifstream in(root/L"native-detail.log");std::string line;unsigned rows=0;while(std::getline(in,line))if(!line.empty())++rows;
     check(rows==4&&readRecoveryRows(root).size()==4,"actual virtual gate retains four Native detailed repeats");}
    ymcc::testing::allocationFault::failAfter(0);inputCaptureUnsubscribeWinRtSensorsImpl();
    const auto gateOffArm=ymcc::testing::allocationFault::countdown.load();ymcc::testing::allocationFault::failAfter(-1);
    check(gateOffArm==0&&readRecoveryRows(root).size()==4,"turning both detail gates OFF returns to the same known repeat without JSON");
    g_gyroSensor.revokeKind=1;inputCaptureUnsubscribeWinRtSensorsImpl();flushNativeLifecycleLogs(false);
    auto rows=readRecoveryRows(root);
    check(rows.size()==5&&rows.back()["failure"]["kind"]=="winrt-hresult"&&rows.back()["failure"]["code"]==0x80070005UL,
        "exception kind change bypasses source repeat suppression");
    g_gyroSensor.revokeHresult=0x80070057UL;inputCaptureUnsubscribeWinRtSensorsImpl();flushNativeLifecycleLogs(false);
    rows=readRecoveryRows(root);check(rows.size()==6&&rows.back()["failure"]["code"]==0x80070057UL,
        "HRESULT change bypasses source repeat suppression");
    g_gyroSensor.failRevoke=false;inputCaptureUnsubscribeWinRtSensorsImpl();g_gyroSensor.failRevoke=true;g_gyroReadingChangedSubscribed=true;
    inputCaptureUnsubscribeWinRtSensorsImpl();flushNativeLifecycleLogs(false);
    check(readRecoveryRows(root).size()==7,"original API success rearms source preflight through the same existing scalar slot");
    g_gyroSensor.available=false;inputCaptureUnsubscribeWinRtSensorsImpl();g_gyroSensor.available=true;
    inputCaptureUnsubscribeWinRtSensorsImpl();flushNativeLifecycleLogs(false);
    check(readRecoveryRows(root).size()==7,"skipping an absent sensor does not manufacture source recovery");
    ++g_powerGeneration;inputCaptureUnsubscribeWinRtSensorsImpl();flushNativeLifecycleLogs(false);
    check(readRecoveryRows(root).size()==11,"power change retains all four original failures after source preflight");
    const auto preparationStart=count(Failure::preparationException);
    g_gyroSensor.revokeHresult=0x80004005UL;timestampAllocationFault=true;inputCaptureUnsubscribeWinRtSensorsImpl();timestampAllocationFault=false;
    check(count(Failure::preparationException)==preparationStart+1&&ymcc::logging::nativeLogFailureEvidence().sensorRetirementPreparationFailurePending.load(),
        "changed failure still reaches original Native preparation failure accounting");
    ymcc::testing::allocationFault::failAfter(0);for(unsigned i=0;i<1000;++i)inputCaptureUnsubscribeWinRtSensorsImpl();
    const auto pendingArm=ymcc::testing::allocationFault::countdown.load();ymcc::testing::allocationFault::failAfter(-1);
    check(pendingArm==0&&readRecoveryRows(root).size()==11,"original pending-preparation guard remains quiet before real event recovery");
    appendNativeLifecycleLog("session-clean-exit",{{"sourceGateFixture",true}});
    inputCaptureUnsubscribeWinRtSensorsImpl();flushNativeLifecycleLogs(false);
    check(readRecoveryRows(root).size()==16&&!ymcc::logging::nativeLogFailureEvidence().sensorRetirementPreparationFailurePending.load(),
        "original good event append rearms all four current failure offers without replaying a lost row");
    ymcc::logging::SensorRetirementLogState pure;
    check(!pure.repeatKnown(0,1)&&pure.retain(0,1)&&pure.repeatKnown(0,1)&&!pure.retain(0,1)&&!pure.repeatKnown(99,1),
        "repeat lookup is nonmutating and never grants suppression to unknown slots");

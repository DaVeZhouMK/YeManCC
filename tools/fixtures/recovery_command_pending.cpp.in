using U64=std::uint64_t;
namespace InertRoles {
using namespace ymcc::steamgamefacts;
struct OwnedHandle {
    HANDLE value=nullptr;
    OwnedHandle()=default;
    explicit OwnedHandle(HANDLE h):value(h){}
    OwnedHandle(const OwnedHandle&)=delete;
    OwnedHandle& operator=(const OwnedHandle&)=delete;
    ~OwnedHandle(){if(value&&value!=INVALID_HANDLE_VALUE)CloseHandle(value);}
    bool close()noexcept {
        if(!value||value==INVALID_HANDLE_VALUE){value=nullptr;return true;}
        if(!CloseHandle(value))return false;value=nullptr;return true;
    }
};
static std::uint64_t birth(HANDLE process) {
    FILETIME b{},e{},k{},u{};
    if(!GetProcessTimes(process,&b,&e,&k,&u))throw std::runtime_error("group-role actual process birth");
    return (std::uint64_t(b.dwHighDateTime)<<32)|b.dwLowDateTime;
}
struct ChildManifest {DWORD magic=0,pid=0;std::uint64_t created=0;};
static_assert(sizeof(ChildManifest)==16);
static std::optional<int> childMain(int argc,wchar_t** argv) {
    if(argc>=2&&std::wstring_view(argv[1])==L"--group-role-leaf") {
        if(argc!=3)return 20;
        OwnedHandle stop(OpenEventW(SYNCHRONIZE,FALSE,argv[2]));
        if(!stop.value)return 21;
        return WaitForSingleObject(stop.value,30000)==WAIT_OBJECT_0?0:22;
    }
    if(argc<2||std::wstring_view(argv[1])!=L"--group-role-root")return {};
    if(argc!=7)return 23;
    OwnedHandle rootStop(OpenEventW(SYNCHRONIZE,FALSE,argv[2]));
    OwnedHandle leafStop(OpenEventW(SYNCHRONIZE|EVENT_MODIFY_STATE,FALSE,argv[3]));
    OwnedHandle ready(OpenEventW(EVENT_MODIFY_STATE,FALSE,argv[4]));
    if(!rootStop.value||!leafStop.value||!ready.value)return 24;
    // The real parent must have a strictly earlier creation stamp.
    Sleep(15);
    std::wstring command=L"\""+std::wstring(argv[6])+L"\" --group-role-leaf \""+argv[3]+L"\"";
    STARTUPINFOW si{sizeof(si)};PROCESS_INFORMATION pi{};
    if(!CreateProcessW(argv[6],command.data(),nullptr,nullptr,FALSE,CREATE_NO_WINDOW,nullptr,nullptr,&si,&pi))return 25;
    OwnedHandle thread(pi.hThread),process(pi.hProcess);thread.close();
    const auto fail=[&](int code){SetEvent(leafStop.value);WaitForSingleObject(process.value,3000);return std::optional<int>(code);};
    ChildManifest manifest{0x47524f4cU,pi.dwProcessId,0};
    try{manifest.created=birth(process.value);}catch(...){return fail(26);}
    OwnedHandle file(CreateFileW(argv[5],GENERIC_WRITE,0,nullptr,CREATE_NEW,FILE_ATTRIBUTE_NORMAL,nullptr));
    if(file.value==INVALID_HANDLE_VALUE)return fail(27);
    DWORD written=0;
    if(!WriteFile(file.value,&manifest,sizeof(manifest),&written,nullptr)||written!=sizeof(manifest)||!file.close())return fail(28);
    if(!SetEvent(ready.value))return fail(29);
    const HANDLE waits[]={rootStop.value,process.value};
    const auto ended=WaitForMultipleObjects(2,waits,FALSE,30000);
    // Deliberate root-only normal exit leaves shipping for its original owner.
    if(ended==WAIT_OBJECT_0||ended==WAIT_OBJECT_0+1)return 0;
    return fail(30);
}
struct InertTree {
    OwnedHandle job,rootProcess,shippingProcess,rootStop,shippingStop,ready;
    DWORD rootPid=0,shippingPid=0;
    std::uint64_t rootCreated=0,shippingCreated=0;
    bool forced=false,zero=false,closed=false;
    std::wstring marker;
    inline static std::atomic<unsigned> sequence{0};
    static HANDLE event(const std::wstring& name) {
        HANDLE h=CreateEventW(nullptr,TRUE,FALSE,name.c_str());
        const auto error=GetLastError();
        if(!h||error==ERROR_ALREADY_EXISTS){if(h)CloseHandle(h);throw std::runtime_error("group-role exclusive event");}
        return h;
    }
    InertTree(const std::wstring& root,const std::wstring& rootExe,const std::wstring& shippingExe) {
        const auto unique=std::to_wstring(GetCurrentProcessId())+L"-"+std::to_wstring(GetTickCount64())+L"-"+std::to_wstring(++sequence);
        marker=root+L"\\group-role-child-"+unique+L".bin";
        const auto prefix=L"Local\\YMCCSteamObserverTest-GroupRoles-"+unique;
        const auto rootName=prefix+L"-root",shipName=prefix+L"-shipping",readyName=prefix+L"-ready";
        try {
            rootStop.value=event(rootName);shippingStop.value=event(shipName);ready.value=event(readyName);
            job.value=CreateJobObjectW(nullptr,nullptr);
            JOBOBJECT_EXTENDED_LIMIT_INFORMATION limit{};limit.BasicLimitInformation.LimitFlags=JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE;
            if(!job.value||!SetInformationJobObject(job.value,JobObjectExtendedLimitInformation,&limit,sizeof(limit)))throw std::runtime_error("group-role local Job");
            STARTUPINFOW si{sizeof(si)};PROCESS_INFORMATION pi{};
            std::wstring command=L"\""+rootExe+L"\" --group-role-root \""+rootName+L"\" \""+shipName+L"\" \""+readyName+L"\" \""+marker+L"\" \""+shippingExe+L"\"";
            if(!CreateProcessW(rootExe.c_str(),command.data(),nullptr,nullptr,FALSE,CREATE_NO_WINDOW|CREATE_SUSPENDED,nullptr,nullptr,&si,&pi))throw std::runtime_error("group-role actual root start");
            rootProcess.value=pi.hProcess;OwnedHandle thread(pi.hThread);rootPid=pi.dwProcessId;
            if(!AssignProcessToJobObject(job.value,rootProcess.value)) {
                forced=true;TerminateProcess(rootProcess.value,31);WaitForSingleObject(rootProcess.value,3000);
                throw std::runtime_error("group-role root Job assign");
            }
            if(ResumeThread(thread.value)==static_cast<DWORD>(-1))throw std::runtime_error("group-role root resume");
            if(!thread.close())throw std::runtime_error("group-role root thread close");
            if(WaitForSingleObject(ready.value,3000)!=WAIT_OBJECT_0)throw std::runtime_error("group-role root child ready");
            OwnedHandle file(CreateFileW(marker.c_str(),GENERIC_READ,FILE_SHARE_READ,nullptr,OPEN_EXISTING,FILE_ATTRIBUTE_NORMAL,nullptr));
            ChildManifest manifest{};DWORD read=0;LARGE_INTEGER size{};
            if(file.value==INVALID_HANDLE_VALUE||!GetFileSizeEx(file.value,&size)||size.QuadPart!=sizeof(manifest)||
                !ReadFile(file.value,&manifest,sizeof(manifest),&read,nullptr)||read!=sizeof(manifest)||manifest.magic!=0x47524f4cU||!manifest.pid||!manifest.created)
                throw std::runtime_error("group-role child manifest");
            shippingProcess.value=OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION|SYNCHRONIZE,FALSE,manifest.pid);
            if(!shippingProcess.value||GetProcessId(shippingProcess.value)!=manifest.pid||birth(shippingProcess.value)!=manifest.created)
                throw std::runtime_error("group-role actual shipping identity");
            shippingPid=manifest.pid;shippingCreated=manifest.created;rootCreated=birth(rootProcess.value);
        }catch(...){finish();throw;}
    }
    bool finishRoot() {
        return rootStop.value&&SetEvent(rootStop.value)&&WaitForSingleObject(rootProcess.value,3000)==WAIT_OBJECT_0;
    }
    bool finishShipping() {
        return shippingStop.value&&SetEvent(shippingStop.value)&&WaitForSingleObject(shippingProcess.value,3000)==WAIT_OBJECT_0;
    }
    bool finish()noexcept {
        if(closed)return zero&&!forced;
        if(rootStop.value)SetEvent(rootStop.value);
        if(shippingStop.value)SetEvent(shippingStop.value);
        bool ended=(!rootProcess.value||WaitForSingleObject(rootProcess.value,3000)==WAIT_OBJECT_0)&&
            (!shippingProcess.value||WaitForSingleObject(shippingProcess.value,3000)==WAIT_OBJECT_0);
        if(job.value) {
            const auto end=GetTickCount64()+3000;
            do {
                JOBOBJECT_BASIC_ACCOUNTING_INFORMATION info{};
                if(QueryInformationJobObject(job.value,JobObjectBasicAccountingInformation,&info,sizeof(info),nullptr)&&!info.ActiveProcesses){zero=true;break;}
                Sleep(5);
            }while(GetTickCount64()<end);
            if(!zero){forced=true;TerminateJobObject(job.value,32);ended=false;}
        }
        bool handles=true;
        handles=shippingProcess.close()&&handles;handles=rootProcess.close()&&handles;
        handles=ready.close()&&handles;handles=shippingStop.close()&&handles;
        handles=rootStop.close()&&handles;handles=job.close()&&handles;
        closed=handles;return ended&&zero&&handles&&!forced;
    }
    ~InertTree(){finish();}
};


}
std::atomic<bool> g_sleepRecoveryAutoPending{true};
auto& g_powerGeneration=fixturePowerGeneration;
bool sgSleepRetryActive(){return false;}
bool sharedSleepWakeClassified(U64 value){return value&&value==currentPowerGeneration()&&!g_exitRequested.load();}
bool sleepSteamRecoveryAllows(U64 value,U64 epoch){return value==currentPowerGeneration()&&epoch==g_sleepRecoveryAutoConfigEpoch.load()&&g_sleepRecoveryAutoEnabled.load()&&!g_exitRequested.load();}
const std::wstring MONITOR_GAME_TARGET_JSON=L"fixture-target.json";
std::wstring yemancc_data_dir(){return L"fixture-in-memory-evidence";}
std::string nativeLifecycleTimestamp(){return "2026-11-13T00:00:00Z";}
bool focusQueryProcessIdentity(DWORD pid,std::wstring* path,ULONGLONG* created){
    ymcc::steamgamefacts::detail::Handle process(OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION|SYNCHRONIZE,FALSE,pid));
    *path=ymcc::steamgamefacts::detail::image(process.value);*created=ymcc::steamgamefacts::detail::birth(process.value);
    return !path->empty()&&*created&&ymcc::steamgamefacts::detail::alive(process.value);
}
enum class NativeGameDiscoveryState {Complete};
struct NativeGameValveSnapshot {
    NativeDetectedGame game;U64 rulesEpoch=9,generation=1,identityGeneration=1;
    NativeGameDiscoveryState discoveryState=NativeGameDiscoveryState::Complete;
};
std::mutex g_gameValveMx;NativeGameValveSnapshot g_gameValveTarget;
struct NativeGameSelectionReceipt {
    NativeGameValveSnapshot target;
    unsigned long long powerGeneration = 0;
    // Observation metadata only. Cached selection never proves OS liveness.
    bool processValidated = false;
};
static std::function<void()> fixtureBeforeCurrentSelection;
static bool nativeValveSelectionCurrent(const NativeGameSelectionReceipt& receipt) {
    const auto& selection = receipt.target;
    std::lock_guard<std::mutex> lock(g_gameValveMx);
    return selection.game.pid && selection.game.processCreated && !selection.game.path.empty() &&
        selection.discoveryState == NativeGameDiscoveryState::Complete && selection.identityGeneration &&
        selection.rulesEpoch && selection.rulesEpoch == g_gameRulesEpoch.load(std::memory_order_acquire) &&
        receipt.powerGeneration && receipt.powerGeneration == currentPowerGeneration() &&
        g_gameValveTarget.discoveryState == NativeGameDiscoveryState::Complete &&
        g_gameValveTarget.identityGeneration == selection.identityGeneration &&
        g_gameValveTarget.rulesEpoch == selection.rulesEpoch &&
        g_gameValveTarget.game.pid == selection.game.pid &&
        g_gameValveTarget.game.processCreated == selection.game.processCreated &&
        _wcsicmp(g_gameValveTarget.game.path.c_str(), selection.game.path.c_str()) == 0;
}
bool nativeValveReadCurrentTarget(NativeDetectedGame* game,unsigned long long* touch=nullptr){
    std::lock_guard<std::mutex> lock(g_gameValveMx);*game=g_gameValveTarget.game;if(touch)*touch=1;return game->pid!=0;
}
static bool nativeValveReadCurrentSelection(NativeGameSelectionReceipt* receipt) {
    if (!receipt) return false;
    if(fixtureBeforeCurrentSelection)fixtureBeforeCurrentSelection();
    *receipt = {};
    NativeGameSelectionReceipt before;
    before.powerGeneration = currentPowerGeneration();
    { std::lock_guard<std::mutex> lock(g_gameValveMx); before.target = g_gameValveTarget; }
    NativeDetectedGame checked;
    // Reuse the existing fresh rule/process/session validation, once. A->B->A
    // or a complete sleep/resume during this read revokes the captured receipt.
    // The owner's qualificationPower is for no-game proof, not positive targets.
    if (!nativeValveReadCurrentTarget(&checked) || !nativeValveSelectionCurrent(before) ||
        checked.pid != before.target.game.pid || checked.processCreated != before.target.game.processCreated ||
        _wcsicmp(checked.path.c_str(), before.target.game.path.c_str()) != 0) return false;
    before.processValidated = true;
    *receipt = before;
    return true;
}
static bool nativeValveReadCachedSelection(NativeGameSelectionReceipt* receipt) {
    if (!receipt) return false;
    *receipt = {};
    NativeGameSelectionReceipt before;
    before.powerGeneration = currentPowerGeneration();
    { std::lock_guard<std::mutex> lock(g_gameValveMx); before.target = g_gameValveTarget; }
    if (g_exitRequested.load(std::memory_order_acquire) ||
        g_powerLifecycle.load(std::memory_order_acquire) != PowerLifecycle::Ready ||
        !nativeValveSelectionCurrent(before)) return false;
    *receipt = before;
    return true;
}
namespace SleepRecoveryAuto {
std::mutex mx;
struct State {ULONGLONG generation=7,configEpoch=5,armed=100000;json wakeAdmission;} state;
struct KernelWake {ULONGLONG generation=7,configEpoch=5,boundaryFileTime=0,eventFileTime=0;int eventId=507;bool uiWakeRequested=true;ULONGLONG requestGeneration=7;} kernelWake;
struct KernelSleepEntry {ULONGLONG configEpoch=5,generation=7,eventFileTime=0;} kernelSleepEntry;
struct InteractiveResume {unsigned long long generation=0,configEpoch=0;ULONGLONG boundaryFileTime=0,eventFileTime=0,receiptTick=0;};
struct CompletedResume {unsigned long long generation=0,configEpoch=0;ULONGLONG boundaryFileTime=0,eventFileTime=0;int eventId=0,reason=0;};
struct ReadyCommit {unsigned long long generation=0,configEpoch=0;ULONGLONG boundaryFileTime=0;};
struct WakeOperationObservation {
    const char* rejectedGuard=nullptr;
    unsigned long long generation=0,configEpoch=0;
    ULONGLONG proofNowFileTime=0,interactiveFileTime=0,exitFileTime=0,proofLimitMs=0;
    ULONGLONG nowTick=0,armedTick=0,kernelEventFileTime=0,kernelProofNowFileTime=0;
    int sharedPhase=0;
    bool interactiveProofEvaluated=false,kernelProofEvaluated=false,sharedPhaseEvaluated=false;
};
InteractiveResume interactiveResume;CompletedResume completedResume;ReadyCommit readyCommit;
static bool followsWakeBoundary(unsigned long long observed,unsigned long long gen,unsigned long long boundaryGeneration) {
    return observed==gen||(observed&&observed!=ULLONG_MAX&&observed+1==gen&&boundaryGeneration==observed);
}
static bool completedInteractiveResumeLocked(unsigned long long gen,unsigned long long epoch,ULONGLONG boundary,unsigned long long boundaryGeneration,WakeOperationObservation* observation=nullptr) {
    if(observation){observation->generation=gen;observation->configEpoch=epoch;observation->rejectedGuard="interactive-identity-ready-or-retry";}
    if(!boundary||!sleepSteamRecoveryAllows(gen,epoch)||sgSleepRetryActive()||g_powerLifecycle.load()!=PowerLifecycle::Ready||
        readyCommit.generation!=gen||readyCommit.configEpoch!=epoch||readyCommit.boundaryFileTime!=boundary||
        interactiveResume.configEpoch!=epoch||completedResume.configEpoch!=epoch||
        !followsWakeBoundary(interactiveResume.generation,gen,boundaryGeneration)||
        !followsWakeBoundary(completedResume.generation,gen,boundaryGeneration)||
        interactiveResume.boundaryFileTime!=boundary||completedResume.boundaryFileTime!=boundary)return false;
    const auto proofNowFileTime=sgNowFileTime(),interactive=interactiveResume.eventFileTime,exit=completedResume.eventFileTime;
    const auto entry=kernelSleepEntry.configEpoch==epoch?kernelSleepEntry.eventFileTime:0;
    if(observation){observation->interactiveProofEvaluated=true;observation->proofNowFileTime=proofNowFileTime;
        observation->interactiveFileTime=interactive;observation->exitFileTime=exit;
        observation->proofLimitMs=ymcc::sleepsteam::kWakeObserveLimitMs;observation->rejectedGuard="interactive-proof-window";}
    if(interactive<=boundary||exit<=boundary||interactive<=entry||exit<=entry||interactive>proofNowFileTime||exit>proofNowFileTime||
        proofNowFileTime-interactive>=ymcc::sleepsteam::kWakeObserveLimitMs*10000ULL)return false;
    if(completedResume.eventId==107){if(observation)observation->rejectedGuard=nullptr;return true;} // S4 event time may predate actual hiberfile return.
    if(observation)observation->rejectedGuard="completed-exit-kind-or-window";
    if(completedResume.eventId!=507||proofNowFileTime-exit>=ymcc::sleepsteam::kWakeObserveLimitMs*10000ULL)return false;
    // Callback receive time can precede session accounting (Win5:170ms).
    // An entry-time intermediate PBT must not stand in for a much later exit.
    const bool allowed=interactive>=exit||exit-interactive<=5000ULL*10000ULL;
    if(observation)observation->rejectedGuard=allowed?nullptr:"interactive-exit-gap";
    return allowed;
}
using ymcc::sleeprecovery::flag;using ymcc::sleeprecovery::number;
static bool proofSupersededLocked() {
    const auto event=state.wakeAdmission.value("eventFileTime",json());std::uint64_t at=0;
    return (flag(state.wakeAdmission,"kernelWakeConfirmed")||flag(state.wakeAdmission,"interactiveWakeConfirmed"))&&event.is_string()&&ymcc::sleepsteam::unsignedDecimal(event.get<std::string>(),at)&&
        kernelSleepEntry.configEpoch==state.configEpoch&&kernelSleepEntry.eventFileTime&&at<=kernelSleepEntry.eventFileTime;
}
static bool wakeOperationAllowedLocked(unsigned long long gen,unsigned long long epoch,WakeOperationObservation* observation=nullptr) {
    if(observation){*observation=WakeOperationObservation{};observation->generation=gen;observation->configEpoch=epoch;
        observation->rejectedGuard="wake-classification-consumer-or-retry";}
    if(!sharedSleepWakeClassified(gen)||!sleepSteamRecoveryAllows(gen,epoch)||sgSleepRetryActive())return false;
    if(state.wakeAdmission.is_object()&&state.wakeAdmission.value("source",std::string())=="interactive-resume-committed-ready"){
        std::uint64_t boundary=0;const auto value=state.wakeAdmission.value("boundaryFileTime",json());
        if(observation)observation->rejectedGuard="interactive-admission-identity-or-boundary";
        if(state.generation!=gen||state.configEpoch!=epoch||proofSupersededLocked()||!value.is_string()||
            !ymcc::sleepsteam::unsignedDecimal(value.get<std::string>(),boundary)||
            !completedInteractiveResumeLocked(gen,epoch,boundary,number(state.wakeAdmission,"boundaryGeneration"),observation))return false;
    }
    const auto phase=g_powerLifecycle.load();
    if(observation){observation->sharedPhaseEvaluated=true;observation->sharedPhase=static_cast<int>(phase);}
    if(phase==PowerLifecycle::Ready){if(observation)observation->rejectedGuard=nullptr;return true;} // unchanged S3 / direct prechecks
    if(observation)observation->rejectedGuard="resuming-admission-or-superseded";
    if(phase!=PowerLifecycle::Resuming||!g_sleepRecoveryAutoPending.load()||state.generation!=gen||state.configEpoch!=epoch||
        !flag(state.wakeAdmission,"kernelWakeConfirmed")||!flag(state.wakeAdmission,"proofFresh")||
        state.wakeAdmission.value("status",std::string())!="admitted"||proofSupersededLocked())return false;
    const auto source=state.wakeAdmission.value("source",std::string());
    if(observation)observation->rejectedGuard="kernel-source";
    if(source!="kernel-power-507-reason-1"&&source!="kernel-power-107-target-5")return false;
    std::uint64_t event=0,boundary=0;const auto at=state.wakeAdmission.value("eventFileTime",json()),sleep=state.wakeAdmission.value("boundaryFileTime",json());
    if(observation)observation->rejectedGuard="kernel-admission-boundary";
    if(!at.is_string()||!sleep.is_string()||!ymcc::sleepsteam::unsignedDecimal(at.get<std::string>(),event)||
        !ymcc::sleepsteam::unsignedDecimal(sleep.get<std::string>(),boundary)||!boundary||event<=boundary)return false;
    // Keep the native witness in the join, not only exported admission JSON.
    if(observation)observation->rejectedGuard="kernel-native-witness";
    if(kernelWake.configEpoch!=epoch||kernelWake.eventFileTime!=event||!kernelWake.uiWakeRequested||kernelWake.requestGeneration!=gen||
        kernelWake.generation!=number(state.wakeAdmission,"proofObservedGeneration")||
        (kernelWake.boundaryFileTime&&kernelWake.boundaryFileTime!=boundary)||
        (source=="kernel-power-507-reason-1"?kernelWake.eventId!=507:kernelWake.eventId!=107))return false;
    const auto now=GetTickCount64(),utc=sgNowFileTime();
    if(observation){observation->kernelProofEvaluated=true;observation->nowTick=now;observation->armedTick=state.armed;
        observation->kernelProofNowFileTime=utc;observation->kernelEventFileTime=event;observation->proofLimitMs=ymcc::sleepsteam::kWakeObserveLimitMs;}
    const bool allowed=now>=state.armed&&now-state.armed<ymcc::sleepsteam::kWakeObserveLimitMs&&event<=utc&&
        utc-event<=ymcc::sleepsteam::kWakeObserveLimitMs*10000ULL;
    if(observation)observation->rejectedGuard=allowed?nullptr:"kernel-operation-or-proof-window";
    return allowed;
}
static bool wakeOperationAllows(unsigned long long gen,unsigned long long epoch) {
    std::lock_guard<std::mutex> lock(mx);return wakeOperationAllowedLocked(gen,epoch);
}
}
constexpr std::uint32_t fixtureApp=2399932135U;
constexpr U64 fixtureFull=(U64(fixtureApp)<<32)|0x02000000ULL;
static std::function<void()> fixtureBeforeCompletionWatch,fixtureBeforeSubscriptionInstall,fixtureBeforeBindingRegister;
static HWND g_hwnd=nullptr;
#define WM_GAMEPAD_SERIAL_EVENT (WM_USER + 16)
static constexpr WPARAM kSteamTrackerCompletionMessageTag=0x535443;
static std::unique_ptr<ymcc::steamcompletion::Dispatcher> fixtureDispatcher=std::make_unique<ymcc::steamcompletion::Dispatcher>();
static auto* g_steamTrackerCompletionDispatcher=fixtureDispatcher.get();
static bool postSteamTrackerCompletionDispatch(std::function<void()> consume) {
    try {
        if(!consume||!g_hwnd||g_exitRequested.load(std::memory_order_acquire))return false;
        return g_steamTrackerCompletionDispatcher->post(std::move(consume),[](std::uintptr_t token){
            if(!g_hwnd||g_exitRequested.load(std::memory_order_acquire))return false;
            return PostMessageW(g_hwnd,WM_GAMEPAD_SERIAL_EVENT,kSteamTrackerCompletionMessageTag,static_cast<LPARAM>(token))!=FALSE;
        });
    }catch(...){return false;}
}
static LRESULT CALLBACK completionWindow(HWND window,UINT msg,WPARAM w,LPARAM l){
    if(msg==WM_GAMEPAD_SERIAL_EVENT){
        if(w==kSteamTrackerCompletionMessageTag){
            if(g_exitRequested.load(std::memory_order_acquire))g_steamTrackerCompletionDispatcher->retire();
            else (void)g_steamTrackerCompletionDispatcher->drain(static_cast<std::uintptr_t>(l));
        }
        return 0;
    }
    return DefWindowProcW(window,msg,w,l);
}
static unsigned pumpCompletion(){
    MSG msg{};unsigned count=0;
    while(PeekMessageW(&msg,nullptr,WM_GAMEPAD_SERIAL_EVENT,WM_GAMEPAD_SERIAL_EVENT,PM_REMOVE)){
        TranslateMessage(&msg);DispatchMessageW(&msg);++count;
    }
    return count;
}
struct CompletionWindow {
    std::wstring name=L"YMCCStartupCompletionFixture-"+std::to_wstring(GetCurrentProcessId());
    CompletionWindow(){
        WNDCLASSW wc{};wc.lpfnWndProc=completionWindow;wc.hInstance=GetModuleHandleW(nullptr);wc.lpszClassName=name.c_str();
        if(!RegisterClassW(&wc))throw std::runtime_error("fixture window registration");
        g_hwnd=CreateWindowExW(0,name.c_str(),L"",0,0,0,0,0,HWND_MESSAGE,nullptr,wc.hInstance,nullptr);
        if(!g_hwnd)throw std::runtime_error("fixture message-only window");
    }
    ~CompletionWindow(){
        pumpCompletion();if(g_hwnd)DestroyWindow(g_hwnd);g_hwnd=nullptr;
        UnregisterClassW(name.c_str(),GetModuleHandleW(nullptr));
    }
};

static unsigned preparationPrivateReads=0;

using json=nlohmann::json;namespace fspath=std::filesystem;
static std::wstring fixtureRoot;
static std::mutex g_fanLogMtx;
static bool timestampThrows=false;
static unsigned rotations=0;
static std::wstring yemancc_data_dir(){return fixtureRoot;}
static std::string nativeLifecycleTimestamp(){if(timestampThrows)throw std::runtime_error("owned-timestamp");return "2000-01-01T00:00:00.000";}
static void rotateOneLogFile(const std::wstring&){++rotations;}
enum class OutputFault {none,openException,writeFailure,writeException,flushFailure,flushException};
static OutputFault outputFault=OutputFault::none;
struct FailureOutput:std::ofstream {
 struct Buffer:std::streambuf {
  std::streambuf* original=nullptr;
  std::streamsize xsputn(const char* text,std::streamsize size)override{if(outputFault==OutputFault::writeFailure)return 0;if(outputFault==OutputFault::writeException)throw std::runtime_error("owned-write");return original->sputn(text,size);}
  int_type overflow(int_type value)override{return traits_type::eq_int_type(value,traits_type::eof())?traits_type::not_eof(value):original->sputc(traits_type::to_char_type(value));}
  int sync()override{if(outputFault==OutputFault::flushFailure)return -1;if(outputFault==OutputFault::flushException)throw std::runtime_error("owned-flush");return original->pubsync();}
 } buffer;
 bool attached=false;
 FailureOutput(){buffer.original=std::ofstream::rdbuf();if(outputFault==OutputFault::openException)exceptions(std::ios::failbit|std::ios::badbit);else if(outputFault==OutputFault::writeException||outputFault==OutputFault::flushException)exceptions(std::ios::badbit);}
 FailureOutput& operator<<(const std::string& value){if(outputFault!=OutputFault::none&&outputFault!=OutputFault::openException&&!attached){static_cast<std::ostream&>(*this).rdbuf(&buffer);attached=true;}static_cast<std::ostream&>(*this)<<value;return *this;}
 FailureOutput& operator<<(char value){static_cast<std::ostream&>(*this)<<value;return *this;}
 ~FailureOutput(){exceptions(std::ios::goodbit);if(attached)static_cast<std::ostream&>(*this).rdbuf(buffer.original);}
};

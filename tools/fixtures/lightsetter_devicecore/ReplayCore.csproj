<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>YeManLightDeviceCore</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- Production functions/API/orchestration; only the HID terminal differs. -->
    <Compile Include="../../../FanLab/LightSetter/DeviceCore/LightingDeviceCore.cs" Link="LightingDeviceCore.cs" />
    <Compile Include="../../../FanLab/LightSetter/DeviceCore/PinnedOneXHidV1.g.cs" Link="PinnedOneXHidV1.g.cs" />
    <Compile Include="../../../FanLab/LightSetter/DeviceCore/PinnedX2MiniProProtocol.cs" Link="PinnedX2MiniProProtocol.cs" Condition="'$(ReplayX2ProtocolSource)' == ''" />
    <Compile Include="$(ReplayX2ProtocolSource)" Link="PinnedX2MiniProProtocol.cs" Condition="'$(ReplayX2ProtocolSource)' != ''" />
    <Compile Include="../../../FanLab/LightSetter/DeviceCore/X2MiniProDeviceCore.cs" Link="X2MiniProDeviceCore.cs" />
    <Compile Include="ReplayHidTransport.cs" />
  </ItemGroup>
</Project>

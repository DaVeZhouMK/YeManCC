#include "environment.hpp"
@@PRODUCTION@@
#undef CloseHandle
#undef WaitForSingleObject
#undef TerminateProcess
using namespace ymcc::inputHost::processRetirement;
// No fake Host: this executable's --private-child only waits on an inherited
// event and naturally exits. A real private thread signals that event on demand.
struct Child {
    HANDLE process=nullptr,release=nullptr;
    Child(){
        SECURITY_ATTRIBUTES sa{sizeof(sa),nullptr,TRUE};
        release=CreateEventW(&sa,TRUE,FALSE,nullptr);need(release!=nullptr,"create private release event");
        wchar_t exe[32768]{};need(GetModuleFileNameW(nullptr,exe,32768)>0,"fixture executable path");
        std::wstring command=L"\""+std::wstring(exe)+L"\" --private-child "+std::to_wstring(reinterpret_cast<std::uintptr_t>(release));
        STARTUPINFOW si{};si.cb=sizeof(si);PROCESS_INFORMATION pi{};
        need(CreateProcessW(exe,command.data(),nullptr,nullptr,TRUE,CREATE_NO_WINDOW,nullptr,nullptr,&si,&pi)!=FALSE,"create private child");
        process=pi.hProcess;need(::CloseHandle(pi.hThread)!=FALSE,"close child primary thread");
    }
    static DWORD WINAPI signal(LPVOID event){return SetEvent(event)?0:1;}
    void exitByThread(){
        HANDLE thread=CreateThread(nullptr,0,signal,release,0,nullptr);need(thread!=nullptr,"create private release thread");
        need(::WaitForSingleObject(thread,2000)==WAIT_OBJECT_0,"release thread exit");DWORD code=1;
        need(GetExitCodeThread(thread,&code)&&code==0,"release thread success");need(::CloseHandle(thread)!=FALSE,"close private release thread");
        need(::WaitForSingleObject(process,2000)==WAIT_OBJECT_0,"private child naturally exited");
    }
    ~Child(){
        if(release)SetEvent(release);
        if(process){
            DWORD flags=0;
            // A successful production close invalidates this non-owning guard
            // alias. No kernel object is created before this validity check.
            if(GetHandleInformation(process,&flags)){
                ::WaitForSingleObject(process,2000);
                SetHandleInformation(process,HANDLE_FLAG_PROTECT_FROM_CLOSE,0);
                ::CloseHandle(process);
            }
        }
        if(release)::CloseHandle(release);
    }
};
static void reset(Child& child){
    ports=Ports{};ports.childRelease=child.release;
    g_inputHostProcess=child.process;g_inputHostServerPipe=nullptr;
    g_inputHostHello=true;g_inputHostPrepared=true;g_inputHostPrepareMayHaveReachedHost=true;
    g_inputHostNeutralized=true;g_inputHostActive=true;g_inputHostTransportFault=false;
    g_inputHostPipeRetired=false;g_inputHostPipeConnected=true;g_inputHostReleaseQuarantined=false;g_inputHostStartBlocked=false;
    g_inputHostRunId="old-private-run";g_inputHostEpoch=41;g_inputHostEpochMirror=41;
    g_inputHostStartupNonce="old-private-nonce";g_inputHostHostInstanceId="private-child-identity";
    g_inputHostPipeName=L"explicit-memory-pipe";g_inputHostBoundPersona="steamdeck";
    g_inputHostLifecycle="active";g_inputHostReleaseDisposition.clear();
    g_hidHideVisibilityJournal.active=true;g_msiSteamDeckReleaseDebt.clear();g_msiSteamDeckReleaseFence.clear();g_psEndpointOwnership.debt=false;
    g_msiDinputReturnOwed=false;g_msiDinputRouteDinputArmed=false;g_realStickTest.virtualTargetEnabled=false;
    g_wakeHoldPhysicalUnhide=false;g_inputHostLastQuarantineProbeTick=0;
    g_xinputPhysicalSourceLocked=true;g_xinputPhysicalSourceMask=1;g_xinputConnectedMask=1;
}
static bool tupleRetained(HANDLE original){return g_inputHostProcess==original&&g_inputHostRunId=="old-private-run"&&g_inputHostEpoch==41&&g_inputHostHello&&g_inputHostPrepared&&g_inputHostPrepareMayHaveReachedHost;}
static json lastLog(const char* event){for(auto i=ports.logs.rbegin();i!=ports.logs.rend();++i)if(i->at("event")==event)return i->at("data");throw std::runtime_error("missing actual consumer receipt");}
static json receiptJson(const Receipt& r){return {{"hadHandle",r.hadHandle},{"waitState",r.waitState},{"waitError",r.waitError},{"exitConfirmed",r.exitConfirmed},{"closeAttempted",r.closeAttempted},{"handleClosed",r.handleClosed},{"closeError",r.closeError}};}
static json rows=json::array(),gaps=json::array(),baselineFailures=json::array();static unsigned failures=0;
template<class F>static void run(const char* name,F&& f){try{json evidence=f();rows.push_back({{"name",name},{"pass",true},{"evidence",evidence}});}catch(const std::exception& e){++failures;rows.push_back({{"name",name},{"pass",false},{"error",e.what()}});}}
static void helperCases(){
    run("helper-private-live-process-retains-same-handle",[]{Child child;ports=Ports{};HANDLE owner=child.process;auto r=retire(owner,0);need(owner==child.process&&!r.exitConfirmed&&!r.closeAttempted&&ports.closes==0,"live process closed");return receiptJson(r);});
    run("helper-real-protected-close-failure-then-same-handle-retry",[]{Child child;child.exitByThread();ports=Ports{};HANDLE owner=child.process;need(SetHandleInformation(owner,HANDLE_FLAG_PROTECT_FROM_CLOSE,HANDLE_FLAG_PROTECT_FROM_CLOSE)!=FALSE,"protect process");auto first=retire(owner);need(first.exitConfirmed&&first.closeAttempted&&!first.handleClosed&&first.closeError!=ERROR_SUCCESS&&owner==child.process,"protected close lost owner");need(SetHandleInformation(owner,HANDLE_FLAG_PROTECT_FROM_CLOSE,0)!=FALSE,"unprotect process");auto second=retire(owner);need(second.exitConfirmed&&second.handleClosed&&!owner,"same-handle retry failed");child.process=nullptr;auto empty=retire(owner);need(!empty.hadHandle&&!empty.exitConfirmed&&!empty.closeAttempted&&ports.closes==2,"double retirement reused closed handle");return json{{"first",receiptJson(first)},{"retry",receiptJson(second)},{"repeat",receiptJson(empty)}};});
    run("helper-real-wait-failed-without-synchronize-right",[]{Child child;child.exitByThread();ports=Ports{};HANDLE restricted=nullptr;need(DuplicateHandle(GetCurrentProcess(),child.process,GetCurrentProcess(),&restricted,PROCESS_QUERY_LIMITED_INFORMATION,FALSE,0)!=FALSE,"duplicate restricted process");HANDLE owner=restricted;auto r=retire(owner);need(r.waitState==WAIT_FAILED&&r.waitError==ERROR_ACCESS_DENIED&&!r.exitConfirmed&&!r.closeAttempted&&owner==restricted,"WAIT_FAILED became exit proof");need(::CloseHandle(restricted)!=FALSE,"restricted cleanup");return receiptJson(r);});
    for(bool waitFailure:{true,false})run(waitFailure?"helper-explicit-memory-wait-failure":"helper-explicit-memory-close-failure",[waitFailure]{Child child;child.exitByThread();ports=Ports{};if(waitFailure)ports.waitError=ERROR_NOT_ENOUGH_MEMORY;else ports.closeError=ERROR_NOT_ENOUGH_MEMORY;HANDLE owner=child.process;auto r=retire(owner);need(owner==child.process&&!r.handleClosed&&r.exitConfirmed==!waitFailure&&r.closeAttempted==!waitFailure,"memory failure erased owner/proof");need((waitFailure?r.waitError:r.closeError)==ERROR_NOT_ENOUGH_MEMORY,"memory error lost");ports.waitError=ports.closeError=0;return receiptJson(r);});
}


namespace sourceNotificationFixture {
using json=nlohmann::json;
inline bool failLog=false;
inline unsigned offered=0, forwarded=0, snapshots=0;
inline std::vector<json> cleanLog;
inline std::vector<int> forwardedPresence;
inline std::vector<ymcc::steamsession::Session> forwardedSession;
inline std::vector<std::string> deliveredOrder;
inline std::vector<ymcc::steamsession::Session> observedSessions;
inline ymcc::deckysetup::SteamRestartRequirement g_deckySteamRestartRequired;
struct Observer {
    std::shared_ptr<const ymcc::steamsession::IdentitySnapshot> source;
    auto identitySnapshot() { ++snapshots;return source; }
} g_steamSettingsObserver;
struct Consumer {
    const char* name;
    void observe(const ymcc::steamsession::Session& session) { deliveredOrder.emplace_back(name);observedSessions.push_back(session); }
    void observeSteam(const ymcc::steamsession::Session& session) { observe(session); }
};
inline Consumer g_steamLinkAdmission{"link"},g_steamModeObserver{"mode"},g_steamCssGuard{"css-guard"},g_steamCssUse{"css-use"};
struct Runtime {
    ymcc::deckysidebar::Runtime actual;
    void observeSteam(int presence,const ymcc::steamsession::Session& session) {
        deliveredOrder.emplace_back("decky");
        ++forwarded;forwardedPresence.push_back(presence);forwardedSession.push_back(session);
        actual.observeSteam(presence,session);
    }
} g_deckySidebarRuntime;
inline void deckySidebarDiagnostic(const char* event,const json& detail) {
    ++offered;
    if(failLog)throw std::bad_alloc();
    cleanLog.push_back(ymcc::deckydiag::record(event,detail));
}
@@DIAGNOSTIC@@
@@WRAPPER@@
inline void invoke(unsigned caller,const std::shared_ptr<const ymcc::steamsession::IdentitySnapshot>& presenceSource,
    const std::shared_ptr<const ymcc::steamsession::IdentitySnapshot>& initial) {
    if(caller==0) { @@SESSION_FANOUT@@ }
    else if(caller==1) { const auto& source=presenceSource; @@PRESENCE_CALL@@ }
    else { @@INITIAL_CALL@@ }
}
inline json run() {
    // All cases are event-source observations with Decky disabled; actual Runtime

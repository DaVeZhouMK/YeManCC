    const auto handles=[] { DWORD value=0;ymcc::deckybinding::fixture::need(GetProcessHandleCount(GetCurrentProcess(),&value)!=FALSE,"source-count");return value; };
    const auto baseline=handles();json cases=json::array();bool allDelivered=true;
    ymcc::steamsession::Session full;full.root=L"C:\\fixture-steam";full.pid=123;full.created=456;full.account=789;
    deckySidebarSessionDiagnostic(full,"binding-identity-incomplete");
    ymcc::deckybinding::fixture::need(cleanLog.size()==1&&cleanLog[0].value("stage",std::string{})=="binding-identity-incomplete","original-diagnostic-helper-control");
    const char* expectedStages[]{"observer-session","observer-presence","observer-initial"};
    const std::vector<std::string> ordered{"link","mode","decky","css-guard","css-use"};
    const auto restartSource=[&](int presence,DWORD pid,ULONGLONG created,std::uint64_t revision) {
        auto source=std::make_shared<ymcc::steamsession::IdentitySnapshot>();
        source->session=full;source->session.pid=pid;source->session.created=created;
        source->presence=presence;source->revision=revision;
        return source;
    };
    const auto originalSource=restartSource(1,full.pid,full.created,10);
    const auto noNewReceipt=[] { return std::shared_ptr<const ymcc::steamsession::IdentitySnapshot>{}; };
    const auto clearFanout=[&] {
        deliveredOrder.clear();observedSessions.clear();
        g_deckySteamRestartRequired.markerCreated(full.root,500,[&]{return originalSource;});
    };
    const auto latched=[&] { return g_deckySteamRestartRequired.requiredFor(full.root,noNewReceipt); };
    const auto checkFanout=[&](unsigned caller,int presence,const ymcc::steamsession::Session& session){
        const auto expected=caller==0?ordered:std::vector<std::string>{"decky"};
        ymcc::deckybinding::fixture::need(deliveredOrder==expected,"source-fanout-order");
        ymcc::deckybinding::fixture::need(observedSessions.size()==(caller==0?4u:0u)&&
            std::all_of(observedSessions.begin(),observedSessions.end(),[&](const auto& state){return state==session;}),"source-fanout-single-session");
        ymcc::deckybinding::fixture::need(latched()==(caller!=0||presence!=0),"source-fanout-ordinary-session-preserves-restart-until-absence");
    };
    for(unsigned caller=0;caller<3;++caller) {
        for(unsigned variant=0;variant<4;++variant) {
            auto session=full;if(variant==1)session.account=0;
            const int presence=variant==2?-1:variant==3?0:1;
            auto writable=std::make_shared<ymcc::steamsession::IdentitySnapshot>();
            writable->session=session;writable->presence=presence;writable->revision=11;
            std::shared_ptr<const ymcc::steamsession::IdentitySnapshot> source=writable,initial=writable;
            g_steamSettingsObserver.source=source;clearFanout();
            cleanLog.clear();offered=forwarded=snapshots=0;forwardedPresence.clear();forwardedSession.clear();failLog=false;
            invoke(caller,source,initial);
            ymcc::deckybinding::fixture::need(forwarded==1&&forwardedPresence[0]==presence&&forwardedSession[0]==session,"source-original-forwarding-changed");
            ymcc::deckybinding::fixture::need(snapshots==(caller==0?1u:0u),"source-new-session-query");
            checkFanout(caller,presence,session);
            const auto state=g_deckySidebarRuntime.actual.snapshot();
            ymcc::deckybinding::fixture::need(!state.enabled&&state.pid==0&&state.steamKnown==(presence>=0)&&state.steamRunning==(presence==1),"source-runtime-state");
            const bool delivered=cleanLog.size()==1&&cleanLog[0].value("stage",std::string{})==expectedStages[caller]&&
                cleanLog[0].value("accountPresent",true)==(session.account!=0);
            allDelivered=allDelivered&&delivered;
            cases.push_back({{"caller",caller},{"variant",variant},{"delivered",delivered},{"snapshots",snapshots},{"forwarded",forwarded},{"enabled",state.enabled},{"pid",state.pid}});
        }
        cleanLog.clear();offered=forwarded=snapshots=0;forwardedPresence.clear();forwardedSession.clear();failLog=true;
        auto writable=restartSource(1,full.pid,full.created,11);
        std::shared_ptr<const ymcc::steamsession::IdentitySnapshot> source=writable;
        g_steamSettingsObserver.source=source;clearFanout();
        invoke(caller,source,source);
        failLog=false;
        ymcc::deckybinding::fixture::need(forwarded==1&&forwardedSession[0]==full&&snapshots==(caller==0?1u:0u),"optional-log-blocked-original-action");
        checkFanout(caller,1,full);
        cases.push_back({{"caller",caller},{"variant","logger-bad-alloc"},{"forwarded",forwarded},{"offered",offered},{"logRows",cleanLog.size()}});
    }
    clearFanout();g_steamSettingsObserver.source.reset();snapshots=offered=forwarded=0;
    invoke(0,{},{});
    ymcc::deckybinding::fixture::need(snapshots==1&&offered==0&&forwarded==0&&deliveredOrder.empty()&&
        latched(),"missing-source-does-not-invent-notification");
    const json old{{"stage","binding-identity-incomplete"},{"accountPresent",false}};
    ymcc::deckybinding::fixture::need(ymcc::deckydiag::record("steam-session-check",old).at("stage")=="binding-identity-incomplete","old-stage-regressed");
    unsigned badRejected=0;

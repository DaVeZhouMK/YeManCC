@@SETTING_COMPARE@@
@@SETTING_ENABLED@@
@@SETTING_PERSONA@@
@@SETTING_RECEIPT@@
@@SETTING_REARM@@
}
// Actual post-old-Host Start gates, ending BEFORE assets, creation and I/O.
inline bool startAdmissionOnly(){
@@START_GATES@@
    return true;
}
// Stop transport ACKs/exit/quarantine are supplied facts. Its actual receipt
// callsite and subsequent Clear are replayed without running Stop's I/O.
inline void stopReceiptAndClear(const char* reason,bool localReleaseAck,bool shutdownAck,
                               bool hostExitConfirmed,ULONGLONG msiStopPower){
@@STOP_RECEIPT@@

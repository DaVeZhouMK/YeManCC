 if(c=="QUIESCE")return model.quiesce;if(c=="SUBMIT_NEUTRAL")return model.neutral;
 if(c=="RELEASE_TARGET"){if(model.release)model.ownsTarget=false;return model.release;}
 if(c=="SHUTDOWN"){model.shutdownRequested=true;return model.shutdown;}
 if(c=="RECREATE_TARGET")return model.recreate;return false;
}

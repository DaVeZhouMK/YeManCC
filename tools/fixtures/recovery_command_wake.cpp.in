class ReadScope final {
 Current frozenCurrent_;HANDLE power_,identity_;
public:
 ReadScope(Current c,HANDLE p,HANDLE i):frozenCurrent_(std::move(c)),power_(p),identity_(i){}
 bool current()const noexcept{try{return frozenCurrent_&&frozenCurrent_()&&power_&&identity_&&power_!=identity_&&WaitForSingleObject(power_,0)==WAIT_TIMEOUT&&WaitForSingleObject(identity_,0)==WAIT_TIMEOUT;}catch(...){return false;}}
 sleeppower::MemoryPower power()const noexcept{return current()?sleeppower::MemoryPower::Admitted:sleeppower::MemoryPower::Revoked;}
 HANDLE powerCancellationEvent()const noexcept{return power_;}
 HANDLE identityCancellationEvent()const noexcept{return identity_;}
};

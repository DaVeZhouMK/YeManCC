 J close(){
  if(stopped)return cleanup;
  owned_resource::initial.strictSuccess=false;cleanupCompleted=false;
  stopped=true;J errors=J::array();bool processWideOnly=false,bodyReachedEnd=false;
  const auto error=[&](const char* text){if(!processWideOnly)directCleanupFault=true;try{errors.push_back(text);}catch(...){cleanupJsonFault=true;}};
  try{
   if(stopPeer&&!SetEvent(stopPeer))error("peer-stop-set-failed");
   if(peer&&peer->joinable()){
    try{peer->join();peerJoined=!peer->joinable();resource_diag::note(resource_diag::ThreadJoin,diagnosticPeerHandle,0,peerJoined?1:0,GetLastError());}catch(...){error("peer-join-exception");}
    if(peer->joinable()){(void)peer.release();error("peer-thread-retained-join-debt");}
   }else peerJoined=true;
   peer.reset();
   try{afterPeer();}catch(const std::exception& e){error(e.what());}catch(...){error("peer-unknown-exception");}
   if(intent)intent->cancel();
   blocker.parentReturned();intent.reset();provider.reset();coordinator.reset();publication.reset();
   if(availability){
    const auto borrowedBeforeClose=availability->event();
    if(!availability->close())error("availability-close-refused");
    const auto status=availability->status();
    if(status.opened||status.closeError||status.signalError||status.resetError||availability->event())error("availability-resource-or-api-error");
    cleanup["availability"]={{"opened",status.opened},{"closeError",status.closeError},{"signalError",status.signalError},{"resetError",status.resetError}};
    if(status.opened){
     if(debtSlot<availabilityDebtSlots.size()){
      auto& slot=availabilityDebtSlots[debtSlot];slot.exact=borrowedBeforeClose;slot.lease=std::move(availability);
      closeControl.initialDebt=bool(slot.lease);closeControl.firstCloseError=status.closeError;
      closeControl.initialRefusal=closeControl.requested&&closeControl.applied&&slot.exact==closeControl.exact&&status.closeError==ERROR_INVALID_HANDLE;
     }
     error("availability-retained-close-debt");
    }

  catch(...){const auto closed=CloseHandle(h);if(!closed)std::cerr<<"unrecorded-owned-event-close-refused "<<GetLastError()<<std::endl;throw;}
  return h;
 }
 bool exactTupleCurrent()const{
  if(!fixture.identityAllowed||!fixture.frozenEvent.is_object()||!power||!identity||
      WaitForSingleObject(power,0)!=WAIT_TIMEOUT||WaitForSingleObject(identity,0)!=WAIT_TIMEOUT)return false;
  const std::array<const char*,4> names{"steam","game","ymcc","cef"};
  for(std::size_t i=0;i<4;++i){
   const auto& b=fixture.bindings[i];const auto& frozen=fixture.frozenEvent.at(names[i]);
   if(b.event!=roles[i]||b.pid!=dword(frozen.at("pid"))||b.born!=decimal(frozen.at("birthFileTime"))||
       b.path!=utf16(frozen.at("path").get<std::string>())||b.session!=dword(frozen.at("session"),true))return false;

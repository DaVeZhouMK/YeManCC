  if(!closeControl.requested)return;
  if(!availability||(closeControl.exact=availability->event())==nullptr){directCleanupFault=true;return;}
  closeControl.protectResult=SetHandleInformation(closeControl.exact,HANDLE_FLAG_PROTECT_FROM_CLOSE,HANDLE_FLAG_PROTECT_FROM_CLOSE);
  closeControl.protectError=GetLastError();closeControl.applied=closeControl.protectResult!=FALSE;
  if(!closeControl.applied)directCleanupFault=true;

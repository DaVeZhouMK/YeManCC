     case WakeCase::PowerCancelled:need(SetEvent(power),"owned-power-cancel-set");blocker.parentReturned();break;
     case WakeCase::IdentityCancelled:need(SetEvent(identity),"owned-identity-cancel-set");blocker.parentReturned();break;
     case WakeCase::ProcessExited:need(SetEvent(roles[1]),"owned-role-exit-set");blocker.parentReturned();break;
     case WakeCase::InvalidEvent:invalidCloseConfirmed=closeOne(roles[0]);need(invalidCloseConfirmed,"owned-invalid-close-failed");break;
     case WakeCase::Expired:break;
     default:blocker.parentReturned();break;
    }
   }catch(...){std::lock_guard lock(peerMutex);peerException=std::current_exception();}
   if(!SetEvent(done)){std::lock_guard lock(peerMutex);if(!peerException)peerException=std::make_exception_ptr(std::runtime_error("owned-peer-done-set"));}
  });

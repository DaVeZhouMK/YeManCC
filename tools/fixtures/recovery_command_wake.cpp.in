    else{row.closeError=GetLastError();error("owned-event-close-refused");}
   }
   DWORD after=0;if(!GetProcessHandleCount(GetCurrentProcess(),&after))error("owned-handle-count-after-failed");
   resource_diag::capture(resource_diag::after);
   cleanup["handleCountBefore"]=handlesBefore;cleanup["handleCountAfter"]=after;
   processWideOnly=true;
   if(after!=handlesBefore)error("owned-handle-count-not-restored");
   processWideOnly=false;
   cleanup["events"]=J::array();
   for(const auto& row:events)cleanup["events"].push_back({{"name",row.name},{"handle",std::to_string(reinterpret_cast<std::uintptr_t>(row.handle))},{"closed",row.closed},{"closeError",row.closeError}});
   cleanup["peerJoined"]=peerJoined;if(!peerJoined)error("owned-peer-not-joined");
   bodyReachedEnd=true;
  }catch(const std::exception& e){error(e.what());}catch(...){error("cleanup-unknown-exception");}
  try{cleanup["errors"]=errors;cleanup["success"]=errors.empty()&&!cleanupJsonFault&&bodyReachedEnd;}catch(...){cleanupJsonFault=true;}
  cleanupCompleted=bodyReachedEnd&&!cleanupJsonFault;
  return cleanup;
 }
 ~WakeCaseOwner(){
  if(!stopped){try{(void)close();}catch(...){std::cerr<<"owned-owner-emergency-close-exception"<<std::endl;}std::cerr<<"owned-owner-emergency-close"<<std::endl;}
  if(closeControl.requested)lateAvailabilityControlCleanup();
  if(debtSlot<availabilityDebtSlots.size()&&!availabilityDebtSlots[debtSlot].lease)availabilityDebtSlots[debtSlot].reserved=false;
  // A still-retained slot remains a strong, exact debt until process teardown;
  // permanent refusal is never reported as return or global resource success.
 }
};
DWORD pairedWaitForMultipleObjects(DWORD count,const HANDLE* handles,BOOL all,DWORD delay){
 auto* owner=activeOwner;need(owner!=nullptr,"owned-wait-owner-unavailable");
 need(count==7&&all==FALSE&&handles[0]==owner->power&&handles[1]==owner->identity,"owned-wait-cancellation-shape");
 for(std::size_t i=0;i<4;++i)need(handles[i+2]==owner->roles[i],"owned-wait-role-shape");
 need(handles[6]==owner->availability->event()&&handles[6]!=owner->hint,"availability-not-independent-observation-hint");
 need(ledgerCount()==0&&fixture.queries==0&&fixture.source==0&&fixture.drivers==0,"command-wait-acquired-source-or-spent-budget");
 ++fixture.waits;++owner->commandWaits;owner->lastDelay=delay;
 need(SetEvent(owner->entered),"owned-wait-entered-set");
 need(WaitForSingleObject(owner->done,5000)==WAIT_OBJECT_0,"owned-peer-done-wait");owner->afterPeer();
 if(owner->mode==WakeCase::ReadyHealthy)fixture.flags=8196;
 // All original parameters are forwarded to the REAL API, with no virtual
 // timeout or substituted handle. The peer completes before this call.
 const auto result=::WaitForMultipleObjects(count,handles,all,delay);const auto error=GetLastError();
 owner->lastWait=result;owner->waitError=error;SetLastError(error);return result;
}
J eventFor(const fp::path& dir){
 J e;const std::array<const char*,4> names{"steam","game","ymcc","cef"};
 for(std::size_t i=0;i<4;++i)e[names[i]]={{"pid",4000u+static_cast<DWORD>(i)},{"birthFileTime",std::to_string(134370000000000001ULL+i)},{"session",1},{"path","D:\\owned-fixture\\"+std::string(names[i])+".exe"}};
 e["target"]=e["game"];e["target"]["gameId"]="10260559608980439040";e["target"]["appid"]=2388972698u;
 e["dataRoot"]=utf8((dir/L"data").wstring());e["evidenceRoot"]=utf8((dir/L"evidence").wstring());e["logRoot"]=utf8((dir/L"logs").wstring());e["account64"]="76561198000000001";e["recoveryAllowed"]=true;
 e["trigger"]={{"kind","wake"},{"generation","7"},{"id","original-command-wake"},{"rulesEpoch","1"},{"powerEventFileTime",std::to_string(nowFileTime())}};return e;
}
void freezeFixture(const J& e,WakeCaseOwner& owner){
 fixture=Fixture{};fixture.data=absolute(e.at("dataRoot"));fixture.frozenEvent=e;fixture.identityAllowed=true;
 const std::array<const char*,4> names{"steam","game","ymcc","cef"};
 for(std::size_t i=0;i<4;++i){const auto& v=e.at(names[i]);fixture.bindings[i]={owner.roles[i],dword(v.at("pid")),dword(v.at("session"),true),decimal(v.at("birthFileTime")),utf16(v.at("path").get<std::string>())};}
 embedded::sha256=digest(embedded::image,sizeof embedded::image);
}
J invokeCommandWakeOnly(const J& event,WakeCaseOwner& owner){
 check(event.at("trigger").at("kind")=="wake","non-wake-selector-refused");
 const auto frozen=fixture.frozenEvent;const auto tupleCurrent=[&owner,frozen]{return fixture.frozenEvent==frozen&&owner.exactTupleCurrent();};
 auto result=handle(event,{},tupleCurrent,tupleCurrent,reinterpret_cast<WakeSignal>(owner.hint),reinterpret_cast<WakeSignal>(owner.power),reinterpret_cast<WakeSignal>(owner.identity),owner.publication,{}, {},owner.intent,owner.availability,{},{},{},{});
 fixture.lastReceipt=result;
 check(!gActive.load()&&!gEmit&&!gCurrent&&!gObservationCurrent&&!gOriginalSteam&&!gPublicationScope&&!gGroupRequestCancellation&&!gWakeSignal&&!gCancelSignal&&!gIdentityCancelSignal&&!gCleanupMode,"full-handle-per-job-cleanup-leaked");return result;
}
void makeHealthyReference(J event,WakeCaseOwner& owner){
 event["recoveryAllowed"]=false;fixture.flags=8196;
 const auto receipt=invokeCommandWakeOnly(event,owner);
 check(receipt.at("status")=="healthy"&&receipt.value("referenceCaptured",false)&&!receipt.at("consumed").get<bool>(),"wake-healthy-reference-not-captured");
 check(ledgerCount()==0&&fixture.queries==0&&fixture.source==0&&fixture.drivers==0,"wake-healthy-reference-mutated");
 fixture.snapshots=0;fixture.order.clear();fixture.lastReceipt=nullptr;
}
struct CaseSpec{const char* name;WakeCase mode;};
constexpr CaseSpec commandWakeCases[]{
 {"occupied-release-ready-still-4",WakeCase::Recovered},
 {"occupied-release-ready-now-8196",WakeCase::ReadyHealthy},
 {"original-physical-remainder-expires",WakeCase::Expired},
 {"power-cancel-and-availability",WakeCase::PowerCancelled},
 {"identity-cancel-and-availability",WakeCase::IdentityCancelled},
 {"process-event-and-availability",WakeCase::ProcessExited},
 {"actual-closed-event-wait-failed",WakeCase::InvalidEvent},
 {"driver-readonly-preflight-no-durable-consume",WakeCase::DriverReadonlyRefusal},
 {"healthy-wake-no-consume",WakeCase::Healthy},
 {"memory-tuple-mismatch-refused",WakeCase::IdentityMismatch}
};
J runCommandWakeCase(const fp::path& dir,const CaseSpec& spec){
 WakeCaseOwner owner(spec.mode);J row={{"name",spec.name},{"passed",false}};activeOwner=&owner;
 try{
  owner.open();auto event=eventFor(dir);freezeFixture(event,owner);makeHealthyReference(event,owner);
  const ymcc::steamcommand::Target target{fixture.bindings[0].pid,fixture.bindings[0].born,fp::path(fixture.bindings[0].path).parent_path().wstring()};
  owner.blocker=owner.coordinator->reserve(target,ymcc::steamcommand::Plan::Single);check(bool(owner.blocker),"original-occupied-slot-not-held");
  owner.intent=ymcc::steamcommand::prepareIntent(target,owner.availability);
  check(bool(owner.intent)&&owner.intent->status()==ymcc::steamcommand::IntentStatus::Observing,"passive-intent-wrong-state");
  fixture.flags=spec.mode==WakeCase::Healthy?8196:4;fixture.failPreflight=spec.mode==WakeCase::DriverReadonlyRefusal;
  event["trigger"]["powerEventFileTime"]=std::to_string(spec.mode==WakeCase::Expired?nowFileTime()-58500ULL*10000ULL:nowFileTime());
  const auto originalEpisode=event.at("trigger").at("powerEventFileTime");
  if(spec.mode==WakeCase::Healthy)event["recoveryAllowed"]=false;
  if(spec.mode==WakeCase::IdentityMismatch)event["steam"]["birthFileTime"]="134370000000999999";
  if(spec.mode!=WakeCase::Healthy&&spec.mode!=WakeCase::IdentityMismatch){
   owner.availability->notify();
   check(WaitForSingleObject(owner.availability->event(),0)==WAIT_OBJECT_0,"stale-availability-not-primed");
   owner.startPeer();
  }
  const auto receipt=invokeCommandWakeOnly(event,owner);row["receipt"]=receipt;
  check(event.at("trigger").at("powerEventFileTime")==originalEpisode,"physical-episode-renewed");
  check(WaitForSingleObject(owner.hint,0)==WAIT_TIMEOUT,"availability-changed-original-observation-hint");
  if(spec.mode==WakeCase::Recovered){
   check(receipt.at("status")=="recovered-native"&&receipt.at("consumed")==true&&ledgerCount()==2,"command-wake-recovery-not-single-durable-commit");
   check(fixture.queries==1&&fixture.source==1&&fixture.drivers==1&&fixture.queryEnds==1&&fixture.queryFinishes==1,"command-wake-source-not-single-or-not-returned");
   check(fixture.order.size()>=2&&fixture.order[0]=="snapshot:4"&&fixture.order[1]=="snapshot:4","ready-did-not-repeat-complete-lost-snapshot");
   check(receipt.at("commandCoordination").at("observationCadenceChanged")==false,"command-availability-altered-wake-cadence");
  }else if(spec.mode==WakeCase::ReadyHealthy){
   check(receipt.at("status")=="healthy"&&!receipt.at("consumed").get<bool>()&&ledgerCount()==0,"ready-healthy-consumed");
   check(fixture.snapshots==2&&fixture.order==std::vector<std::string>{"snapshot:4","snapshot:8196"},"ready-healthy-did-not-fresh-read");
   check(fixture.queries==0&&fixture.source==0&&fixture.drivers==0,"ready-healthy-acquired-query-source-driver");
  }else if(spec.mode==WakeCase::DriverReadonlyRefusal){
   check(receipt.value("reason",std::string())=="loaded-client-ui-compatibility-contract"&&receipt.at("consumptionPreflightPassed")==true&&!receipt.at("consumed").get<bool>()&&ledgerCount()==0,"readonly-driver-refusal-spent-durable-budget");
   check(fixture.queries==1&&fixture.source==1&&fixture.drivers==0&&fixture.queryEnds==1,"readonly-driver-refusal-bad-memory-port-counts");
  }else{
   check(!receipt.value("consumed",false)&&ledgerCount()==0&&fixture.queries==0&&fixture.source==0&&fixture.drivers==0,"rejected-or-healthy-wake-mutated");
   if(spec.mode==WakeCase::Healthy)check(receipt.at("status")=="healthy"&&owner.commandWaits==0,"healthy-wake-requested-command");
   else if(spec.mode==WakeCase::IdentityMismatch)check(receipt.value("reason",std::string())=="memory-role-not-exact-frozen-tuple"&&owner.commandWaits==0,"nonexact-memory-identity-admitted");
   else if(spec.mode==WakeCase::InvalidEvent)check(owner.invalidCloseConfirmed&&owner.lastWait==WAIT_FAILED&&owner.waitError==ERROR_INVALID_HANDLE&&receipt.value("reason",std::string())=="wake-event-wait-failed","actual-invalid-event-accepted");
   else if(spec.mode==WakeCase::ProcessExited)check(owner.lastWait==WAIT_OBJECT_0+3&&receipt.value("reason",std::string())=="public-steam-command-wait-ended","process-not-before-availability");
   else if(spec.mode==WakeCase::PowerCancelled)check(owner.lastWait==WAIT_OBJECT_0&&receipt.value("reason",std::string())=="native-current-guard-revoked","power-cancel-not-before-availability");
   else if(spec.mode==WakeCase::IdentityCancelled)check(owner.lastWait==WAIT_OBJECT_0+1&&receipt.value("reason",std::string())=="native-current-guard-revoked","identity-cancel-not-before-availability");
   else if(spec.mode==WakeCase::Expired)check(owner.lastWait==WAIT_TIMEOUT&&owner.commandWaits==1&&owner.lastDelay<=1500&&receipt.value("reason",std::string())=="native-current-guard-revoked","physical-remainder-was-renewed-or-not-expired");
  }
  if(spec.mode!=WakeCase::Healthy&&spec.mode!=WakeCase::IdentityMismatch)check(owner.commandWaits==1&&owner.registeredWaiting&&owner.availabilityResetSeen,"original-command-wait-or-reset-order-not-observed");
  row["passed"]=true;
 }catch(const std::exception& e){row["failure"]=e.what();}catch(...){row["failure"]="unknown-case-exception";}
 row["counts"]={{"snapshots",fixture.snapshots},{"queries",fixture.queries},{"source",fixture.source},{"drivers",fixture.drivers},{"queryEnds",fixture.queryEnds},{"kernelWaits",owner.commandWaits}};
 row["wait"]={{"result",owner.lastWait},{"error",owner.waitError},{"delayMs",owner.lastDelay}};
 row["trace"]=fixture.order;
 const bool businessPassed=row.value("passed",false);row["businessPassed"]=businessPassed;row["passed"]=false;
 owner.protectAvailabilityForControl();
 try{
  row["cleanup"]=owner.close();
  const bool quiescent=owner.peerJoined&&(!owner.peer||!owner.peer->joinable());
  const auto end=resource_diag::apiCount.load(std::memory_order_acquire);
  owned_resource::evaluate(owned_resource::initial,owner.accountingBegin,end,quiescent);
  if(owner.directCleanupFault||owner.cleanupJsonFault||!owner.cleanupCompleted)owned_resource::fault(owned_resource::initial,"owner-cleanup-incomplete-or-diagnostic-fault",end);
  if(owner.closeControl.requested){
   for(unsigned i=0;i<owned_resource::initial.used;++i){const auto& l=owned_resource::initial.lives[i];
    if(l.domain==owned_resource::Event&&l.handle==reinterpret_cast<std::uintptr_t>(owner.closeControl.exact)&&l.live&&l.refused)owner.closeControl.debtCreationSerial=l.serial;
   }
   if(!owner.closeControl.initialRefusal||!owner.closeControl.initialDebt||!owner.closeControl.debtCreationSerial)
    owned_resource::fault(owned_resource::initial,"expected-real-availability-close6-not-observed",end);
  }
  // Initial POD verdict/debt/refusal are frozen BEFORE any fixture-only repair.
  const bool initialScopedSuccess=owned_resource::initial.strictSuccess;
  if(owner.closeControl.requested){
   owner.lateAvailabilityControlCleanup();
   owned_resource::evaluate(owned_resource::afterLate,owner.accountingBegin,resource_diag::apiCount.load(std::memory_order_acquire),quiescent);
  }
  const auto before=row["cleanup"].value("handleCountBefore",DWORD(0));const auto after=row["cleanup"].value("handleCountAfter",DWORD(0));
  row["cleanup"]["processWide"]={{"scope","Original whole-process count, independent diagnostic"},{"before",before},{"after",after},
   {"restored",after==before},{"legacyCountError",after!=before?J("owned-handle-count-not-restored"):J()},
   {"status","UNKNOWN"},{"resourcePass",false},{"legacyCleanupSuccess",row["cleanup"].value("success",false)}};
  row["cleanup"]["directOwned"]=directOwnedReport(owned_resource::initial);
  row["resultScope"]="Original business checks plus strict direct API-owned lifecycle ONLY; process-wide resources UNKNOWN";
  if(owner.closeControl.requested){
   const auto& c=owner.closeControl;
   row["availabilityProtectClose6"]={{"protectResult",c.protectResult},{"protectLastError",c.protectError},{"exactBorrowedHandle",std::to_string(reinterpret_cast<std::uintptr_t>(c.exact))},
    {"initialRefusal",c.initialRefusal},{"firstCloseError",c.firstCloseError},{"initialStrongDebt",c.initialDebt},{"debtCreationSerial",c.debtCreationSerial},
    {"lateAttempted",c.lateAttempted},{"clearResult",c.clearResult},{"clearLastError",c.clearError},{"lateCloseReturned",c.lateClosed},{"lateCloseError",c.lateCloseError},
    {"lateNotQuiescent",c.notQuiescent},{"initialVerdictNotRecomputed",true},{"afterLate",directOwnedReport(owned_resource::afterLate)}};
  }
  row["passed"]=businessPassed&&initialScopedSuccess;
 }
 catch(const std::exception& e){row["passed"]=false;row["cleanupException"]=e.what();}
 catch(...){row["passed"]=false;row["cleanupException"]="unknown-cleanup-exception";}
 row["resourceDiagnostic"]=diagnosticReport();
 activeOwner=nullptr;fixture.identityAllowed=false;return row;
}
int main(int argc,char** argv){
 if((argc!=3&&argc!=5&&argc!=6)||std::string(argv[2])!="--command-wake-only")return 64;
 std::string selected;
 if(argc>=5){
  if(std::string(argv[3])!="--case"||!argv[4][0])return 64;
  selected=argv[4];
  if(std::none_of(std::begin(commandWakeCases),std::end(commandWakeCases),[&](const auto& spec){return selected==spec.name;}))return 64;
 }
 if(argc==6){
  if(std::string(argv[5])!="--owned-availability-protect-close=6"||selected!="occupied-release-ready-still-4")return 64;
  availabilityProtectCloseControlRequested=true;
 }
 try{
  const auto root=fp::absolute(fp::path(argv[1])).lexically_normal();need(!fp::exists(root),"wake-output-must-be-new");fp::create_directories(root);
  J cases=J::array();for(const auto& spec:commandWakeCases){
   if(!selected.empty()&&selected!=spec.name)continue;
   cases.push_back(runCommandWakeCase(root/std::to_wstring(cases.size()),spec));
   if(cases.back().at("passed")!=true)break;
  }
  const auto passed=std::count_if(cases.begin(),cases.end(),[](const auto& row){return row.at("passed")==true;});
  const J report={{"schema","ymcc.steam-recovery-success-chain-consumer.v1"},{"selector","--command-wake-only"},{"tests",cases.size()},{"passed",passed},{"checks",checks},{"cases",cases},{"success",static_cast<std::size_t>(passed)==cases.size()},{"applicationIdentityAndSdk","explicit frozen memory leaves; no Steam authority"},{"liveSteamOperations",0},{"extraGameProcesses",0},{"sleepActions",0},{"fieldRecoveryVerified",false},{"resultScope","business plus direct API-owned lifecycle only"},{"processWideResources","UNKNOWN"},{"processWideResourcePass",false},{"sourceReady",false},{"independentReviewRequiredBeforeExecution",true}};
  std::cout<<report.dump(2)<<std::endl;return report.at("success")==true?0:1;
 }catch(const std::exception& e){std::cerr<<e.what()<<std::endl;return 1;}
}

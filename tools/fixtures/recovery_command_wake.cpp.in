class WakeCaseOwner final{
public:
 WakeCase mode;std::vector<EventRow> events;
 std::array<HANDLE,4> roles{};HANDLE power=nullptr,identity=nullptr,hint=nullptr,entered=nullptr,done=nullptr,stopPeer=nullptr;
 std::shared_ptr<ymcc::steamcommand::AvailabilityEvent> availability;
 std::unique_ptr<ymcc::steamcommand::Coordinator> coordinator;
 std::unique_ptr<ymcc::steamcommand::Provider> provider;
 std::shared_ptr<ymcc::steamcommand::Intent> intent;

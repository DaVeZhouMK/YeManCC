class RequestCancellation final {
 HANDLE borrowed_=nullptr;Current frozenCurrent_;
public:
 RequestCancellation(HANDLE h,Current c):borrowed_(h),frozenCurrent_(std::move(c)){}
 HANDLE event()const noexcept{return borrowed_;}
 bool current()const noexcept{try{return borrowed_&&frozenCurrent_&&frozenCurrent_()&&WaitForSingleObject(borrowed_,0)==WAIT_TIMEOUT;}catch(...){return false;}}
 void cancel()noexcept{if(borrowed_)(void)SetEvent(borrowed_);}
};
// Group objects are typed, but openScope and runTrial explicitly refuse their
// use in this strict single-tuple fixture. No group authority is synthesized.
class ProcessGroupLease final {
public:
 struct Member{DWORD pid=0;};struct Graph{unsigned count=0;std::array<Member,2> members{};};
 struct Inspection{steamgameroles::State state=steamgameroles::State::ExactSelected;unsigned reason=0;};
private:
 Graph graph_;Current frozenCurrent_;
public:
 ProcessGroupLease(Graph g,Current c):graph_(g),frozenCurrent_(std::move(c)){}
 // The strict memory fixture never admits a group; this branch lends no handle.
 std::span<const HANDLE> additionalProcessLiveness()const noexcept{return {};}
 const Graph& graph()const noexcept{return graph_;}
 bool processCurrent()const noexcept{try{return graph_.count>0&&graph_.count<=2&&frozenCurrent_&&frozenCurrent_();}catch(...){return false;}}
 bool originalProcessesCurrent()const noexcept{return processCurrent();}
 std::optional<Inspection> inspectNativeRoles(DWORD primary,DWORD foreground)const{
  if(!processCurrent())return {};
  bool p=false,f=false;
  for(unsigned i=0;i<graph_.count;++i){p=p||graph_.members[i].pid==primary;f=f||graph_.members[i].pid==foreground;}
  if(!p||!f)return {};
  return Inspection{graph_.count==1?steamgameroles::State::ExactSelected:steamgameroles::State::VerifiedGroupRoles,0};
 }
};
}

 void lateAvailabilityControlCleanup()noexcept{
  if(!closeControl.requested||closeControl.lateAttempted)return;
  closeControl.lateAttempted=true;
  if(!peerJoined){closeControl.notQuiescent=true;return;}
  if(debtSlot>=availabilityDebtSlots.size())return;
  auto& slot=availabilityDebtSlots[debtSlot];
  if(!closeControl.applied||!slot.lease||slot.exact!=closeControl.exact)return;
  closeControl.clearResult=SetHandleInformation(slot.exact,HANDLE_FLAG_PROTECT_FROM_CLOSE,0);
  closeControl.clearError=GetLastError();if(closeControl.clearResult==FALSE)return;
  closeControl.lateClosed=slot.lease->close();const auto status=slot.lease->status();closeControl.lateCloseError=status.closeError;
  if(closeControl.lateClosed&&!status.opened&&status.closeError==ERROR_SUCCESS){slot.lease.reset();slot.exact=nullptr;}

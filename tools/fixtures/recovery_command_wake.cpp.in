   try{
    const HANDLE starts[]{stopPeer,entered};const auto start=::WaitForMultipleObjects(2,starts,FALSE,5000);
    if(start==WAIT_OBJECT_0)return;
    need(start==WAIT_OBJECT_0+1,"owned-peer-registration-wait");

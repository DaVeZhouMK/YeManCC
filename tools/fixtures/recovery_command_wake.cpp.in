 std::shared_ptr<ymcc::steamnative::ReadScope> publication;
 std::unique_ptr<std::thread> peer;
 std::exception_ptr peerException;std::mutex peerMutex;
 DWORD handlesBefore=0,lastWait=WAIT_FAILED,lastDelay=0,waitError=0;unsigned commandWaits=0;
 std::uintptr_t diagnosticPeerHandle=0;
 bool stopped=false,peerJoined=false;
 bool directCleanupFault=false,cleanupJsonFault=false,cleanupCompleted=false;

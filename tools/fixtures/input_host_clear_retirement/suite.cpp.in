@@BUS_QUARANTINE@@
@@LIFECYCLE_QUARANTINE@@
static json pipeState(){auto* owner=tr::existingProcessRuntime();if(!owner)return {{"owner",false}};
 const auto s=owner->snapshot();return {{"owner",true},{"available",s.available},{"pending",s.pending},{"active",s.activeLeases},
 {"cached",s.cachedOperations},{"originals",s.ownedOriginals},{"duplicates",s.ownedDuplicates},{"events",s.ownedEvents},
 {"failedCloseDebt",s.failedCloseDebt},{"stopped",s.stopped}};}
static void clearCall(){std::lock_guard<InputHostMutex> lock(g_inputHostMx);inputHostClearLocked();}
static void seed(){
 require(memoryApi::live.empty(),"prior case kernel handles remain");memoryApi::clear();ports=Ports{};
 require(g_inputHostPrimaryThread==nullptr,"previous primary-thread owner not returned");
 g_inputHostProcess=nullptr;g_inputHostServerPipe=nullptr;g_inputHostUnadoptedPipe=nullptr;
 g_inputHostHello=true;g_inputHostPrepared=true;g_inputHostPrepareMayHaveReachedHost=true;
 g_inputHostNeutralized=true;g_inputHostActive=true;g_inputHostTransportFault=false;
 g_inputHostReleaseQuarantined=false;g_inputHostStartBlocked=false;g_inputHostPipeConnected=true;
 g_inputHostPipeRetired=false;g_inputHostMsiStageRequested=true;g_inputHostHidHideStateQuery=true;
 g_inputHostRunId="old-run";g_inputHostHostInstanceId="old-host";g_inputHostStartupNonce="old-nonce";
 g_inputHostBoundPersona="steamdeck";g_inputHostPipeName=L"old-pipe";g_inputHostEpoch=17;g_inputHostEpochMirror=17;
 g_inputHostBoundPowerGeneration=9;g_inputHostLifecycle="active";
 g_hidHideVisibilityJournal.active=true;g_msiSteamDeckReleaseDebt.owed=false;g_psEndpointOwnership.owed=false;
 g_msiDinputReturnOwed=false;g_msiVirtualReleaseRearmEligible=false;g_realStickTest.virtualTargetEnabled=false;
 g_wakeHoldPhysicalUnhide=false;g_xinputPhysicalSourceLocked=true;g_xinputPhysicalSourceMask=1;
 g_xinputConnectedMask=1;g_inputHostLastQuarantineProbeTick=0;
}
static void retained(const char* reason){
 check(g_inputHostRunId=="old-run"&&g_inputHostEpoch==17,reason);
 check(g_inputHostHello&&g_inputHostPrepared&&g_inputHostPrepareMayHaveReachedHost,"unsettled Clear retains HELLO PREPARE and creation history");
 check(g_inputHostHostInstanceId=="old-host"&&g_inputHostStartupNonce=="old-nonce"&&g_inputHostBoundPersona=="steamdeck","unsettled Clear retains exact session identity");
 check(g_inputHostReleaseQuarantined&&g_inputHostStartBlocked,"unsettled Clear closes future writer gate");
 check(!g_inputHostNeutralized&&!g_inputHostActive&&g_inputHostTransportFault,"unsettled Clear revokes publish health");
 check(g_inputHostLifecycle=="release-pending","unsettled lifecycle remains release-pending");
 check(ports.durableHistoryWrites==0,"local Clear never deletes independent persisted history");
}
static void noEarlyRestore(const char* reason){
 const auto before=ports.restores;const auto rearm=ports.rearmCalls;
 inputHostReconcileQuarantineOnLifecycleThread();
 check(ports.restores==before,reason);check(ports.rearmCalls==rearm,"unsettled pipe cannot call downstream rearm");
}
static void cleanPrivateOwner(){
 // A deliberately broken Clear can leave this known owner parked without a
 // lifecycle continuation. Count that before explicit negative-only salvage;
 // no current positive may need it or use process exit as cleanup.
 if(g_inputHostUnadoptedPipe){++negativeOnlyRawSalvage;require(memoryApi::close(g_inputHostUnadoptedPipe)!=FALSE,"negative-only raw salvage");g_inputHostUnadoptedPipe=nullptr;}
 if(auto* owner=tr::existingProcessRuntime())for(unsigned i=0;i<6&&!owner->stopped();++i)owner->maintenance();
 require(memoryApi::live.empty(),"case real handles not returned before exit");
 if(auto* owner=tr::existingProcessRuntime())require(owner->stopped(),"Runtime did not retire case resources");
 memoryApi::clear();
}
static void reconciled(bool explicitOn){
 check(cleared(),"same-owner retirement permits clearing old tuple");
 check(!g_inputHostReleaseQuarantined,"proved session exits quarantine");
 check(ports.restores>=1,"physical memory restore occurs after pipe retirement");
 check(ports.rearmBeforeClear==0,"all rearm gates run only after Clear closes old tuple");
 check(ports.retiredRun=="old-run"&&ports.retiredEpoch==17,"return gates receive original retired tuple");
 check(ports.createTargets==0,"Clear and reconciliation never create a target");
 check(g_inputHostStartBlocked!=explicitOn,"fault stays blocked unless explicit existing intent gate accepts");
 check(ports.rearmAdmitted==(explicitOn?1u:0u),"explicit requested rearm is distinct from target creation");
 check(!ports.historySettled&&!inputHostOwnedCleanupProvenLocked(),"independent durable debt still blocks Owned after local Clear");
 ports.historySettled=true;check(inputHostOwnedCleanupProvenLocked(),"all separately proven obligations finally settle Owned");
 const auto calls=ports.rearmCalls,restores=ports.restores;inputHostReconcileQuarantineOnLifecycleThread();
 check(ports.rearmCalls==calls&&ports.restores==restores,"late repeated lifecycle callback cannot rearm or restore again");
}
static HANDLE adopt(tr::Runtime& owner,const wchar_t* name){auto h=memoryApi::source();DWORD error=0;bool taken=false;
 require(owner.adopt(h,name,error,&taken)&&taken,"private lease admitted");g_inputHostServerPipe=h;return h;}
static void rawSlot(){seed();const auto h=memoryApi::source();g_inputHostUnadoptedPipe=h;
 memoryApi::failRoles=memoryApi::Original;clearCall();retained("raw Close failure keeps run and epoch");
 check(g_inputHostUnadoptedPipe==h&&memoryApi::live.count(h)==1,"failed pre-adoption close preserves sole owner");
 noEarlyRestore("raw close debt blocks lifecycle physical restore");
 memoryApi::failRoles=0;inputHostReconcileQuarantineOnLifecycleThread();reconciled(false);
 check(!g_inputHostUnadoptedPipe,"successful raw close clears owner once");cleanPrivateOwner();
 cases.push_back({{"case","raw-slot-close-failure-then-actual-lifecycle-resume"}});
}
static void originalClose(tr::Runtime& owner){seed();adopt(owner,L"clear-original");memoryApi::failRoles=memoryApi::Original;
 clearCall();const auto debt=pipeState();retained("failed original Close keeps old tuple");
 check(g_inputHostServerPipe==nullptr&&debt["pending"]==0&&debt["failedCloseDebt"]==1,"borrowed pointer null does not retire original owner");
 const auto before=ports.restores;inputHostReconcileQuarantine();check(ports.queued==1,"actual BUS queues source-only quarantine continuation");
 check(ports.restores==before,"BUS observation does not perform physical restore");
 noEarlyRestore("failed original Close prevents physical restore");retained("failed Close lifecycle keeps same tuple");
 clearCall();retained("repeated Clear does not consume unpaid tuple");
 memoryApi::failRoles=0;inputHostReconcileQuarantineOnLifecycleThread();reconciled(false);cleanPrivateOwner();
 cases.push_back({{"case","original-close-debt-source-only-quarantine-resumes"},{"debt",debt}});
}
static void terminalEventClose(tr::Runtime& owner){seed();const auto h=adopt(owner,L"clear-event");unsigned char bytes[8]{};
 const auto r=owner.run(h,tr::Kind::Read,bytes,sizeof(bytes),1,0);require(r.ok,"controlled complete operation");
 memoryApi::failRoles=memoryApi::Event;clearCall();const auto debt=pipeState();retained("terminal event failure keeps old tuple");
 check(debt["pending"]==0&&debt["events"]==1&&debt["failedCloseDebt"]==1,"terminal event with zero pending remains owned");
 noEarlyRestore("terminal event failure blocks physical restore");
 memoryApi::failRoles=0;inputHostReconcileQuarantineOnLifecycleThread();reconciled(false);cleanPrivateOwner();
 cases.push_back({{"case","cached-event-close-failure-actual-clear"},{"debt",debt}});
}
static void pendingIo(tr::Runtime& owner){seed();const auto h=adopt(owner,L"clear-pending");memoryApi::startPending=true;
 unsigned char bytes[8];std::memset(bytes,0xA5,sizeof(bytes));const auto original=owner.run(h,tr::Kind::Read,bytes,sizeof(bytes),1,0);
 require(original.retired&&!original.terminal,"controlled pending operation");clearCall();const auto debt=pipeState();
 retained("pending query keeps old tuple");check(debt["pending"]==1&&debt["duplicates"]==1,"unproved pending IO retains issuing duplicate");
 noEarlyRestore("cancel failure and pending IO block lifecycle physical restore");
 memoryApi::complete();inputHostReconcileQuarantineOnLifecycleThread();reconciled(false);
 check(original.error==WAIT_TIMEOUT&&!original.terminal&&bytes[0]==0xA5,"late completion cannot rewrite old caller evidence or data");
 cleanPrivateOwner();cases.push_back({{"case","pending-io-late-terminal-clear-resumes"},{"debt",debt}});
}
static void busySnapshot(tr::Runtime& owner){seed();const auto h=adopt(owner,L"clear-busy");
 // The previous request still owns Runtime. The global pointer is only a
 // borrowed view and is already absent; no blind direct close is fabricated.
 g_inputHostServerPipe=nullptr;
 memoryApi::entered=::CreateEventW(nullptr,TRUE,FALSE,nullptr);memoryApi::release=::CreateEventW(nullptr,TRUE,FALSE,nullptr);
 require(memoryApi::entered&&memoryApi::release,"contention control events");
 tr::Result result;std::thread worker([&]{unsigned char bytes[8]{};result=owner.run(h,tr::Kind::Read,bytes,8,1,0);});
 if(::WaitForSingleObject(memoryApi::entered,2000)!=WAIT_OBJECT_0){::SetEvent(memoryApi::release);worker.join();throw std::runtime_error("issue helper did not enter");}
 const auto began=std::chrono::steady_clock::now();clearCall();retained("busy snapshot never means tuple may clear");
 noEarlyRestore("busy pipe snapshot blocks restore and rearm");
 check(std::chrono::steady_clock::now()-began<std::chrono::milliseconds(500),"Clear and lifecycle do not wait for busy Runtime observation");
 ::SetEvent(memoryApi::release);worker.join();require(result.ok,"real private issue helper completed");
 require(::CloseHandle(memoryApi::entered)&&::CloseHandle(memoryApi::release),"contention controls returned");memoryApi::entered=memoryApi::release=nullptr;
 inputHostPipeCloseOwned(h);inputHostReconcileQuarantineOnLifecycleThread();reconciled(false);cleanPrivateOwner();
 cases.push_back({{"case","unknown-busy-snapshot-retains-and-resumes"}});
}
static void externalGates(tr::Runtime& owner){seed();adopt(owner,L"clear-external-gates");memoryApi::failRoles=memoryApi::Original;clearCall();
 memoryApi::failRoles=0;g_xinputConnectedMask=3;inputHostReconcileQuarantineOnLifecycleThread();
 check(ports.restores==0&&g_inputHostReleaseQuarantined,"pipe retired still requires independent endpoint absence");
 g_xinputConnectedMask=1;g_wakeHoldPhysicalUnhide=true;inputHostReconcileQuarantineOnLifecycleThread();
 check(ports.restores==0&&g_inputHostReleaseQuarantined,"wake hold still prevents independent physical restore");
 g_wakeHoldPhysicalUnhide=false;ports.restore=false;inputHostReconcileQuarantineOnLifecycleThread();
 check(g_inputHostReleaseQuarantined&&g_inputHostRunId=="old-run"&&ports.rearmCalls==0,"failed restore retains tuple and rearm gate");
 ports.restore=true;inputHostReconcileQuarantineOnLifecycleThread();reconciled(false);cleanPrivateOwner();
 cases.push_back({{"case","endpoint-wake-and-restore-gates-remain-independent"}});
}
static void psCommit(tr::Runtime& owner){seed();adopt(owner,L"clear-ps");g_psEndpointOwnership.owed=true;
 memoryApi::failRoles=memoryApi::Original;clearCall();memoryApi::failRoles=0;ports.commit=false;
 inputHostReconcileQuarantineOnLifecycleThread();
 check(g_inputHostReleaseQuarantined&&g_inputHostRunId=="old-run"&&ports.confirmations==0,"PS durable commit failure cannot consume owner tuple");
 ports.commit=true;ports.confirm=false;inputHostReconcileQuarantineOnLifecycleThread();
 check(g_inputHostReleaseQuarantined&&g_psEndpointOwnership.owed&&ports.rearmCalls==0,"PS readback confirmation failure cannot permit rearm");
 ports.confirm=true;inputHostReconcileQuarantineOnLifecycleThread();reconciled(false);cleanPrivateOwner();
 cases.push_back({{"case","PS-commit-and-confirm-separate-from-pipe-close"}});
}
static void explicitIntent(tr::Runtime& owner){seed();adopt(owner,L"clear-rearm");ports.explicitOn=true;g_realStickTest.virtualTargetEnabled=true;
 memoryApi::failRoles=memoryApi::Original;clearCall();retained("explicit ON does not waive pipe return debt");
 noEarlyRestore("explicit ON cannot overtake unfinished pipe");memoryApi::failRoles=0;
 inputHostReconcileQuarantineOnLifecycleThread();reconciled(true);
 check(!inputHostDisabledCleanupProvenLocked(),"ON intent remains distinct from Disabled completion");cleanPrivateOwner();
 cases.push_back({{"case","explicit-intent-rearm-only-after-actual-Clear"}});
}
int main(){try{
 DWORD before=0,after=0;require(::GetProcessHandleCount(::GetCurrentProcess(),&before)!=FALSE,"initial kernel census");
 rawSlot();auto& owner=tr::processRuntime();originalClose(owner);terminalEventClose(owner);pendingIo(owner);
 busySnapshot(owner);externalGates(owner);psCommit(owner);explicitIntent(owner);
 cleanPrivateOwner();require(::GetProcessHandleCount(::GetCurrentProcess(),&after)!=FALSE,"final kernel census");
 check(before==after,"all private handles returned before process exit");
 const bool pass=failures.empty();std::cout<<json({{"pass",pass},{"checks",checks},{"failures",failures},{"cases",cases},
 {"negativeOnlyRawSalvage",negativeOnlyRawSalvage},{"oracleLiveBeforeExit",memoryApi::live.size()},{"handlesBefore",before},{"handlesAfter",after},
 {"productOrSdkOrDeviceExecuted",false},{"physicalEndpointFacts","named memory ports only"}}).dump(2)<<'\n';return pass?0:2;
 }catch(const std::exception& e){std::cerr<<e.what()<<'\n';return 3;}}

// Complete production functions are inserted by the runner. IO operations and
// external physical/target facts are named memory ports; owned HANDLE leaves
// and the pipe Runtime are real. Caller serializes with the actual mutex shape.
@@PIPE_LEAVES@@
#include "input_host_process_retirement.h"
using json=nlohmann::json;
namespace tr=ymcc::inputHost::pipeTransport;
using InputHostMutex=std::mutex;
static InputHostMutex g_inputHostMx;
static unsigned checks=0,negativeOnlyRawSalvage=0;
static json failures=json::array(),cases=json::array();
static void check(bool value,const char* name){++checks;if(!value)failures.push_back(name);}
static void require(bool value,const char* name){if(!value)throw std::runtime_error(name);}
struct Ports {
 bool msi=false,historySettled=false,endpointAbsent=true,restore=true,commit=true,confirm=true,explicitOn=false;
 unsigned forget=0,revoke=0,rawInvalidations=0,restores=0,commits=0,confirmations=0,queued=0;
 unsigned rearmCalls=0,rearmBeforeClear=0,rearmAdmitted=0;
 unsigned durableHistoryWrites=0,createTargets=0;
 std::string retiredRun;ULONGLONG retiredEpoch=0;
 json logs=json::array();
};static Ports ports;
static HANDLE g_inputHostProcess=nullptr,g_inputHostServerPipe=nullptr;
// Explicit unused primary-thread owner port for the original pipe-only cases.
static HANDLE g_inputHostPrimaryThread=nullptr;
static bool g_inputHostHello=false,g_inputHostPrepared=false,g_inputHostPrepareMayHaveReachedHost=false;
static bool g_inputHostNeutralized=false,g_inputHostActive=false,g_inputHostTransportFault=false;
static bool g_inputHostReleaseQuarantined=false,g_inputHostStartBlocked=false,g_inputHostPipeConnected=false;
static bool g_inputHostPipeRetired=false,g_inputHostMsiStageRequested=false,g_inputHostHidHideStateQuery=false;
static std::string g_inputHostRunId,g_inputHostHostInstanceId,g_inputHostStartupNonce,g_inputHostBoundPersona,g_inputHostLifecycle;
static std::wstring g_inputHostPipeName;
static ULONGLONG g_inputHostEpoch=0,g_inputHostBoundPowerGeneration=0,g_inputHostSequence=0,g_inputHostSampleSequence=0;
static ULONGLONG g_inputHostLastKeepAliveTick=0,g_inputHostLastPhysicalIdentityCheckTick=0,g_inputHostLastQuarantineProbeTick=0;
static std::atomic<ULONGLONG> g_inputHostHealthySinceTick{0},g_inputHostEpochMirror{0},g_inputHostLastKeepAliveRequestTick{0};
static std::atomic<bool> g_wakeHoldPhysicalUnhide{false},g_msiDinputReturnOwed{false},g_msiVirtualReleaseRearmEligible{false};
static bool g_inputHostFreshNeutralAdmitted=false,g_inputHostAnalogAnchorInitialized=false,g_inputHostSourceCandidateLogged=false;
static unsigned g_inputHostFreshNeutralFrames=0,g_inputHostFreshNeutralMask=0,g_inputHostAnalogStableFrames=0;
static int g_inputHostAnalogAnchor=0,g_inputHostRecreatedWakePowerProof=0;
static bool g_xinputPhysicalSourceLocked=false,g_xinputReconfirmRejectLogged=false;
static unsigned g_xinputPhysicalSourceMask=0,g_xinputPreTargetSlots=0,g_xinputAdmittedMask=0,g_xinputLoggedAdmittedMask=0;
static unsigned g_xinputReconfirmMsiGeneration=0,g_xinputConnectedMask=0;
static std::atomic<unsigned> g_xinputSourceReconfirmMask{0};
static std::atomic<bool> g_xinputPreTargetBoundaryScanned{false};
static std::string g_xinputReconfirmIdentity;
static struct {bool active=false;} g_hidHideVisibilityJournal;
struct Debt {
 bool owed=false;void clear(){owed=false;}bool required()const{return owed;}
 bool verified(const std::string&,ULONGLONG)const{return ports.endpointAbsent;}
 std::string run()const{return g_inputHostRunId;}ULONGLONG epoch()const{return g_inputHostEpoch;}
};static Debt g_msiSteamDeckReleaseDebt,g_msiSteamDeckReleaseFence;
struct PsDebt {
 bool owed=false;bool retirementRequired()const{return owed;}int retirement()const{return 1;}
 bool confirmRetirement(const std::string&,ULONGLONG){++ports.confirmations;if(!ports.confirm)return false;owed=false;return true;}
 void clear(){owed=false;}
};static PsDebt g_psEndpointOwnership;
static struct {bool virtualTargetEnabled=false;} g_realStickTest;
static struct {void revoke(){++ports.revoke;}} g_inputHostGameMotorInbox;
static std::atomic<unsigned> g_inputHostGameMotorBindingGeneration{0};
static bool msiClawKnownBoardAuthority(){return ports.msi;}
static bool inputHostTargetReturnHistorySettledLocked(){return ports.historySettled;}
static void inputHostSwitchVerificationForgetAcceptedLocked(){++ports.forget;}
static void gamepadSerialRevokeGameFeedback(){}
namespace ymcc::screenpads {inline void observeNativeTransport(ULONGLONG,bool){}}
static void hidHideInvalidateRawInputIdentityCache(){++ports.rawInvalidations;}
static void inputHostClearBoundPersona(){g_inputHostBoundPersona.clear();}
static void appendNativeLifecycleLog(const char* event,const json& data){ports.logs.push_back({{"event",event},{"data",data}});}
static bool hidHideRestorePhysicalTransaction(const char*){++ports.restores;if(!ports.restore)return false;g_hidHideVisibilityJournal.active=false;return true;}
static bool inputHostTargetReturnAfterPsQuarantineLocked(int,bool){++ports.commits;return ports.commit;}
static bool psRetiredReturnProvenLocked(){return ports.endpointAbsent;}
static bool msiSteamDeckRecheckOwnedRemovalDebt(){return ports.endpointAbsent;}
static bool inputHostQueueLifecycleWork(const char*){++ports.queued;return true;}
static bool cleared(){return g_inputHostRunId.empty()&&g_inputHostEpoch==0&&!g_inputHostHello&&!g_inputHostPrepared&&!g_inputHostPrepareMayHaveReachedHost&&!g_inputHostTransportFault;}
static bool msiExplicitRearmRestoredLocked(){
 ++ports.rearmCalls;const bool ready=cleared();if(!ready)++ports.rearmBeforeClear;
 if(ports.explicitOn&&ready){g_inputHostStartBlocked=false;++ports.rearmAdmitted;return true;}return false;
}
static bool inputHostSwitchExecutionReturnedLocked(ULONGLONG epoch,const std::string& run){ports.retiredEpoch=epoch;ports.retiredRun=run;++ports.rearmCalls;if(!cleared())++ports.rearmBeforeClear;return false;}
static bool inputHostSwitchExecutionPreserveMsiIntentLocked(std::uint64_t,ULONGLONG,const std::string&,bool){++ports.rearmCalls;if(!cleared())++ports.rearmBeforeClear;return false;}
static bool inputHostSwitchRecoveryReturnedLocked(ULONGLONG,const std::string&){++ports.rearmCalls;if(!cleared())++ports.rearmBeforeClear;return false;}
static bool inputHostWakeReturnedLocked(ULONGLONG,const std::string&){++ports.rearmCalls;if(!cleared())++ports.rearmBeforeClear;return false;}
static ULONGLONG inputHostStartProtectionNow(){return GetTickCount64();}
static struct {struct View{std::uint64_t requestId=7;};View view(ULONGLONG)const{return {};}} g_virtualStartProtection;
enum class InputHostPublicationStage{Unknown};
static void inputHostNotePublicationStage(InputHostPublicationStage){}
@@PIPE_CLOSE@@
#define CloseHandle memoryApi::close
@@PIPE_WRAPPER@@
#undef CloseHandle
@@PRIMARY_HELPER@@
